        <field name="name">pack_station.entry: own company only</field>
        <field name="model_id" ref="model_pack_station_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_pack_station_item_company" model="ir.rule">
        <field name="name">pack_station.item: own company only</field>
        <field name="model_id" ref="model_pack_station_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
