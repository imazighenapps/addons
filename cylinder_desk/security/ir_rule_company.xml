<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_cylinder_type_company" model="ir.rule">
        <field name="name">cylinder.type: own company only</field>
        <field name="model_id" ref="model_cylinder_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_cylinder_custody_company" model="ir.rule">
        <field name="name">cylinder.custody: own company only</field>
        <field name="model_id" ref="model_cylinder_custody"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
