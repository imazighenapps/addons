<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cylinder_custody_list" model="ir.ui.view">
        <field name="name">cylinder.custody.list</field>
        <field name="model">cylinder.custody</field>
        <field name="arch" type="xml">
            <list string="Cylinder Custody" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="received_on"/>
                <field name="supplier_id"/>
                <field name="cylinder_type_id"/>
                <field name="received_qty"/>
                <field name="returned_qty"/>
                <field name="on_site_qty"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cylinder_custody_form" model="ir.ui.view">
        <field name="name">cylinder.custody.form</field>
        <field name="model">cylinder.custody</field>
        <field name="arch" type="xml">
            <form string="Cylinder Custody">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="supplier_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Custody">
    <field name="name"/>
    <field name="cylinder_type_id"/>
    <field name="supplier_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Quantities">
    <field name="received_qty"/>
    <field name="returned_qty"/>
    <field name="on_site_qty"/>
    <field name="state"/>
                        </group>
                        <group string="Dates">
    <field name="received_on"/>
    <field name="returned_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cylinder_custody_search" model="ir.ui.view">
        <field name="name">cylinder.custody.search</field>
        <field name="model">cylinder.custody</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="cylinder_type_id"/>
                <filter name="open" string="On Site" domain="[('state','=','open')]"/>
                <filter name="closed" string="Returned" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="group_supplier" string="Supplier" context="{'group_by': 'supplier_id'}"/>
                <filter name="group_type" string="Cylinder Type" context="{'group_by': 'cylinder_type_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_cylinder_custody_kanban" model="ir.ui.view">
        <field name="name">cylinder.custody.kanban</field>
        <field name="model">cylinder.custody</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="supplier_id"/>
                <field name="cylinder_type_id"/>
                <field name="received_on"/>
                <field name="on_site_qty"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="supplier_id"/>
                        <field name="cylinder_type_id"/>
                        <field name="received_on"/>
                        <field name="on_site_qty"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_cylinder_custody" model="ir.actions.act_window">
        <field name="name">Cylinder Custody</field>
        <field name="res_model">cylinder.custody</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Who sent what, when it arrived, and what is still on site.</p>
        </field>
    </record>

</odoo>
