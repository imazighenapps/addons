<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cfo_dashboard" model="res.groups.privilege">
        <field name="name">CFO Dashboard</field>
        <field name="description">Smart Financial Dashboard</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_cfo_dashboard_user" model="res.groups">
        <field name="name">CFO Dashboard / User</field>
        <field name="privilege_id" ref="module_category_cfo_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_cfo_dashboard_manager" model="res.groups">
        <field name="name">CFO Dashboard / Manager (Full Access)</field>
        <field name="privilege_id" ref="module_category_cfo_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_cfo_dashboard_user'))]"/>
    </record>
</odoo>
