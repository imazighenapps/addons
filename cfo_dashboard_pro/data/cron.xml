<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_rebuild_cashflow" model="ir.cron">
        <field name="name">CFO Dashboard: Rebuild Cash Flow Projections</field>
        <field name="model_id" ref="model_cfo_cashflow_projection"/>
        <field name="state">code</field>
        <field name="code">model.rebuild_projections()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- <field name="numbercall">-1</field> -->
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_compute_monthly_snapshot" model="ir.cron">
        <field name="name">CFO Dashboard: Compute Monthly KPI Snapshot</field>
        <field name="model_id" ref="model_cfo_kpi_snapshot"/>
        <field name="state">code</field>
        <field name="code">model.compute_monthly_snapshot()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- <field name="numbercall">-1</field> -->
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=2, minute=0, second=0)"/>
    </record>

    <record id="ir_cron_check_alerts" model="ir.cron">
        <field name="name">CFO Dashboard: Check Financial Alerts</field>
        <field name="model_id" ref="model_cfo_alert"/>
        <field name="state">code</field>
        <field name="code">model.check_all_alerts()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <!-- <field name="numbercall">-1</field> -->
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_rebuild_profitability_cube" model="ir.cron">
        <field name="name">CFO Dashboard: Rebuild Profitability Cube</field>
        <field name="model_id" ref="model_cfo_profitability_cube"/>
        <field name="state">code</field>
        <field name="code">model.rebuild_cube()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- <field name="numbercall">-1</field> -->
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=3, minute=0, second=0)"/>
    </record>

    <record id="ir_cron_recompute_risk_scores" model="ir.cron">
        <field name="name">CFO Dashboard: Recompute Risk Scores</field>
        <field name="model_id" ref="model_cfo_risk_score"/>
        <field name="state">code</field>
        <field name="code">model.recompute_all_scores()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- <field name="numbercall">-1</field> -->
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=4, minute=0, second=0)"/>
    </record>
</odoo>
