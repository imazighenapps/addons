<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_freight_bill_overcharge_list" model="ir.ui.view">
        <field name="name">freight.bill.line.list</field>
        <field name="model">freight.bill.line</field>
        <field name="arch" type="xml">
            <list string="Overcharges" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="bill_date"/>
                <field name="name"/>
                <field name="carrier_name"/>
                <field name="billed_amount"/>
                <field name="overcharge_amount"/>
                <field name="disputed"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_freight_bill_overcharge_form" model="ir.ui.view">
        <field name="name">freight.bill.line.form</field>
        <field name="model">freight.bill.line</field>
        <field name="arch" type="xml">
            <form string="Overcharges">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Bill Line">
    <field name="name"/>
    <field name="tariff_id"/>
    <field name="carrier_name"/>
    <field name="bill_date"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amounts">
    <field name="billed_amount"/>
    <field name="overcharge_amount"/>
    <field name="currency_id"/>
    <field name="is_overcharged"/>
    <field name="disputed"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_freight_bill_overcharge_search" model="ir.ui.view">
        <field name="name">freight.bill.line.search</field>
        <field name="model">freight.bill.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="carrier_name"/>
                <separator/>
                <filter name="group_carrier" string="Carrier" context="{'group_by': 'carrier_name'}"/>
            </search>
        </field>
    </record>

    <record id="action_freight_bill_overcharge" model="ir.actions.act_window">
        <field name="name">Overcharges</field>
        <field name="res_model">freight.bill.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Freight bill lines charged above the negotiated tariff.</p>
        </field>
    </record>

</odoo>
