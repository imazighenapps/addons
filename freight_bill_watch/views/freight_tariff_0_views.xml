<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_freight_tariff_list" model="ir.ui.view">
        <field name="name">freight.tariff.list</field>
        <field name="model">freight.tariff</field>
        <field name="arch" type="xml">
            <list string="Freight Tariffs">
                <field name="name"/>
                <field name="carrier_name"/>
                <field name="lane"/>
                <field name="agreed_amount"/>
                <field name="line_count"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_freight_tariff_form" model="ir.ui.view">
        <field name="name">freight.tariff.form</field>
        <field name="model">freight.tariff</field>
        <field name="arch" type="xml">
            <form string="Freight Tariffs">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Tariff">
    <field name="name"/>
    <field name="carrier_name"/>
    <field name="lane"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amount">
    <field name="agreed_amount"/>
    <field name="currency_id"/>
    <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_freight_tariff_search" model="ir.ui.view">
        <field name="name">freight.tariff.search</field>
        <field name="model">freight.tariff</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="carrier_name"/>
                <field name="lane"/>
                <separator/>
                <filter name="group_carrier" string="Carrier" context="{'group_by': 'carrier_name'}"/>
            </search>
        </field>
    </record>

    <record id="view_freight_tariff_kanban" model="ir.ui.view">
        <field name="name">freight.tariff.kanban</field>
        <field name="model">freight.tariff</field>
        <field name="arch" type="xml">
            <kanban default_group_by="carrier_name" sample="1">
                <field name="carrier_name"/>
                <field name="name"/>
                <field name="lane"/>
                <field name="agreed_amount"/>
                <field name="line_count"/>
                <templates>
                    <t t-name="card">
                        <field name="carrier_name" class="fw-bold"/>
                        <field name="name"/>
                        <field name="lane"/>
                        <field name="agreed_amount"/>
                        <field name="line_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_freight_tariff" model="ir.actions.act_window">
        <field name="name">Freight Tariffs</field>
        <field name="res_model">freight.tariff</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Negotiated freight tariffs to compare billed transport against.</p>
        </field>
    </record>

</odoo>
