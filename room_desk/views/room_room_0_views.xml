<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_room_room_list" model="ir.ui.view">
        <field name="name">room.room.list</field>
        <field name="model">room.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="code"/>
                <field name="name"/>
                <field name="location"/>
                <field name="capacity"/>
                <field name="equipment"/>
                <field name="booking_count"/>
                <field name="upcoming_count"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_room_room_form" model="ir.ui.view">
        <field name="name">room.room.form</field>
        <field name="model">room.room</field>
        <field name="arch" type="xml">
            <form string="Rooms">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Room">
    <field name="code"/>
    <field name="name"/>
    <field name="location"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Capacity">
    <field name="capacity"/>
    <field name="equipment"/>
                        </group>
                        <group string="Counters">
    <field name="booking_count"/>
    <field name="upcoming_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_room_room_search" model="ir.ui.view">
        <field name="name">room.room.search</field>
        <field name="model">room.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="location"/>
                <field name="equipment"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_location" string="Location" context="{'group_by': 'location'}"/>
            </search>
        </field>
    </record>

    <record id="view_room_room_kanban" model="ir.ui.view">
        <field name="name">room.room.kanban</field>
        <field name="model">room.room</field>
        <field name="arch" type="xml">
            <kanban default_group_by="location" sample="1">
                <field name="location"/>
                <field name="name"/>
                <field name="capacity"/>
                <field name="equipment"/>
                <field name="upcoming_count"/>
                <templates>
                    <t t-name="card">
                        <field name="location" class="fw-bold"/>
                        <field name="name"/>
                        <field name="capacity"/>
                        <field name="equipment"/>
                        <field name="upcoming_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_room_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">room.room</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register every meeting room with its capacity and equipment.</p>
        </field>
    </record>

</odoo>
