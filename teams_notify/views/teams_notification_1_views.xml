<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_teams_notification_list" model="ir.ui.view">
        <field name="name">teams.notification.list</field>
        <field name="model">teams.notification</field>
        <field name="arch" type="xml">
            <list string="Notifications" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="create_date"/>
                <field name="name"/>
                <field name="channel_id"/>
                <field name="event_type"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_teams_notification_form" model="ir.ui.view">
        <field name="name">teams.notification.form</field>
        <field name="model">teams.notification</field>
        <field name="arch" type="xml">
            <form string="Notifications">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Notification">
    <field name="name"/>
    <field name="channel_id"/>
    <field name="rule_id"/>
    <field name="event_type"/>
    <field name="state"/>
    <field name="error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_teams_notification_search" model="ir.ui.view">
        <field name="name">teams.notification.search</field>
        <field name="model">teams.notification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="channel_id"/>
                <filter name="sent" string="Sent" domain="[('state','=','sent')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_teams_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">teams.notification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Notifications sent to Teams.</p>
        </field>
    </record>

</odoo>
