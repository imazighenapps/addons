<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_teams_channel_list" model="ir.ui.view">
        <field name="name">teams.channel.list</field>
        <field name="model">teams.channel</field>
        <field name="arch" type="xml">
            <list string="Channels" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="company_id"/>
                <field name="state" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_teams_channel_form" model="ir.ui.view">
        <field name="name">teams.channel.form</field>
        <field name="model">teams.channel</field>
        <field name="arch" type="xml">
            <form string="Channels">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_test" type="object" string="Send Test" class="btn-secondary" invisible="False"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Channel">
    <field name="name"/>
    <field name="company_id"/>
    <field name="webhook_url"/>
    <field name="state"/>
    <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rules" name="ruleids">
                            <field name="rule_ids"><list editable="bottom"><field name="name"/><field name="event_type"/>
                    <field name="model_name"/><field name="condition_text"/><field name="active"/></list></field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_teams_channel_search" model="ir.ui.view">
        <field name="name">teams.channel.search</field>
        <field name="model">teams.channel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_teams_channel" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="res_model">teams.channel</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure Microsoft Teams webhooks.</p>
        </field>
    </record>

</odoo>
