<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_phone_item_company" model="ir.rule">
        <field name="name">phone.item: own company only</field>
        <field name="model_id" ref="model_phone_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_phone_assignment_company" model="ir.rule">
        <field name="name">phone.assignment: own company only</field>
        <field name="model_id" ref="model_phone_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
