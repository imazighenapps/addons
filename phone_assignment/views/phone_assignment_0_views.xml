<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_phone_assignment_list" model="ir.ui.view">
        <field name="name">phone.assignment.list</field>
        <field name="model">phone.assignment</field>
        <field name="arch" type="xml">
            <list string="Assignments" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="item_id"/>
                <field name="employee_id"/>
                <field name="date_issue"/>
                <field name="date_return"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_phone_assignment_form" model="ir.ui.view">
        <field name="name">phone.assignment.form</field>
        <field name="model">phone.assignment</field>
        <field name="arch" type="xml">
            <form string="Assignments">
                <header>
                    <button name="action_return" type="object" string="Mark Returned" class="btn-primary" invisible="state != 'assigned'"/>
                    <button name="action_lost" type="object" string="Mark Lost" class="btn-secondary" invisible="state != 'assigned'"/>
                    <button name="action_reset" type="object" string="Reset to Assigned" class="btn-link" invisible="state == 'assigned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="assigned,returned,lost"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Assignment">
    <field name="name"/>
    <field name="item_id"/>
    <field name="employee_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Dates">
    <field name="date_issue"/>
    <field name="date_return"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_phone_assignment_search" model="ir.ui.view">
        <field name="name">phone.assignment.search</field>
        <field name="model">phone.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="item_id"/>
                <field name="employee_id"/>
                <filter name="assigned" string="Assigned" domain="[('state','=','assigned')]"/>
                <filter name="returned" string="Returned" domain="[('state','=','returned')]"/>
                <filter name="lost" string="Lost" domain="[('state','=','lost')]"/>
                <separator/>
                <filter name="group_item" string="Item" context="{'group_by': 'item_id'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_phone_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">phone.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track phone and SIM assignments to employees.</p>
        </field>
    </record>

</odoo>
