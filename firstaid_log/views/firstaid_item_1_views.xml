<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_firstaid_item_list" model="ir.ui.view">
        <field name="name">firstaid.item.list</field>
        <field name="model">firstaid.item</field>
        <field name="arch" type="xml">
            <list string="Kit Contents">
                <field name="name"/>
                <field name="kit_id"/>
                <field name="qty_required"/>
                <field name="qty_on_hand"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>

    <record id="view_firstaid_item_form" model="ir.ui.view">
        <field name="name">firstaid.item.form</field>
        <field name="model">firstaid.item</field>
        <field name="arch" type="xml">
            <form string="Kit Contents">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Item">
    <field name="name"/>
    <field name="kit_id"/>
    <field name="qty_required"/>
    <field name="qty_on_hand"/>
    <field name="expiry_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_firstaid_item_search" model="ir.ui.view">
        <field name="name">firstaid.item.search</field>
        <field name="model">firstaid.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="kit_id"/>
                <separator/>
                <filter name="group_kit" string="Kit" context="{'group_by': 'kit_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_firstaid_item_kanban" model="ir.ui.view">
        <field name="name">firstaid.item.kanban</field>
        <field name="model">firstaid.item</field>
        <field name="arch" type="xml">
            <kanban default_group_by="kit_id" sample="1">
                <field name="kit_id"/>
                <field name="name"/>
                <field name="qty_required"/>
                <field name="qty_on_hand"/>
                <field name="expiry_date"/>
                <templates>
                    <t t-name="card">
                        <field name="kit_id" class="fw-bold"/>
                        <field name="name"/>
                        <field name="qty_required"/>
                        <field name="qty_on_hand"/>
                        <field name="expiry_date"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_firstaid_item" model="ir.actions.act_window">
        <field name="name">Kit Contents</field>
        <field name="res_model">firstaid.item</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Items stored in each first aid kit with quantity and expiry.</p>
        </field>
    </record>

</odoo>
