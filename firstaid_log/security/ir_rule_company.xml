    </record>
    <record id="rule_firstaid_refill_company" model="ir.rule">
        <field name="name">firstaid.refill: own company only</field>
        <field name="model_id" ref="model_firstaid_refill"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
