<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bounce_scan_wizard_form" model="ir.ui.view">
        <field name="name">bounce.scan.wizard.form</field>
        <field name="model">bounce.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Scan Bounces">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Scan">
    <field name="date_from"/>
    <field name="date_to"/>
    <field name="rule_ids"/>
                        </group>
                    </group>
                </sheet>
                <footer><button name="action_scan" type="object" string="Scan" class="btn-primary"/><button string="Cancel" class="btn-secondary" special="cancel"/></footer>
            </form>
        </field>
    </record>

    <record id="action_bounce_scan_wizard" model="ir.actions.act_window">
        <field name="name">Scan Bounces</field>
        <field name="res_model">bounce.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">File every bounced notification as an event.</p>
        </field>
    </record>

</odoo>
