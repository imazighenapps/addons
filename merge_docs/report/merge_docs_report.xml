<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_doc_merge" model="report.paperformat">
        <field name="name">Dossier A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">14</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_doc_merge" model="ir.actions.report">
        <field name="name">Document Dossier</field>
        <field name="model">doc.merge</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">merge_docs.report_doc_merge</field>
        <field name="paperformat_id" ref="paperformat_doc_merge"/>
        <field name="print_report_name">'Dossier - %s' % object.partner_id.name</field>
    </record>

    <template id="report_doc_merge">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" t-if="o.cover_page">
                        <h1 class="text-center mt-5">Customer Dossier</h1>
                        <h3 class="text-center text-muted" t-field="o.partner_id.name"/>
                        <p class="text-center"><span t-field="o.name"/></p>
                        <p class="text-center">
                            <span t-field="o.document_count"/> documents -
                            total <span t-field="o.total_amount"/>
                        </p>
                        <div t-if="o.toc" class="mt-5">
                            <h4>Contents</h4>
                            <ol>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <li><span t-field="line.label"/> -
                                        <span t-field="line.reference"/></li>
                                </t>
                            </ol>
                        </div>
                    </div>
                    <div class="page" t-foreach="o.line_ids" t-as="line"
                         style="page-break-before: always;">
                        <h3><span t-field="line.label"/> <span t-field="line.reference"/></h3>
                        <p>Date: <span t-field="line.document_date"/></p>
                        <div t-out="line.snapshot_html"/>
                        <p class="text-end fw-bold" t-if="line.amount">
                            Total: <span t-field="line.amount"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
