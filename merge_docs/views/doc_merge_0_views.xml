<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_doc_merge_list" model="ir.ui.view">
        <field name="name">doc.merge.list</field>
        <field name="model">doc.merge</field>
        <field name="arch" type="xml">
            <list string="Dossiers" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="document_count"/>
                <field name="total_amount" sum="Total Total Amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_doc_merge_form" model="ir.ui.view">
        <field name="name">doc.merge.form</field>
        <field name="model">doc.merge</field>
        <field name="arch" type="xml">
            <form string="Dossiers">
                <header>
                    <button name="action_load" type="object" string="Load Documents" class="btn-primary" invisible="False"/>
                    <button name="action_generate" type="object" string="Generate PDF" class="btn-primary" invisible="not line_ids"/>
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary" invisible="not line_ids"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,loaded,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Customer">
    <field name="partner_id"/>
    <field name="date"/>
    <field name="date_from"/>
    <field name="date_to"/>
    <field name="company_id"/>
                        </group>
                        <group string="Contents">
    <field name="include_quotes"/>
    <field name="include_orders"/>
    <field name="include_invoices"/>
    <field name="include_deliveries"/>
    <field name="cover_page"/>
    <field name="toc"/>
                        </group>
                        <group string="Result">
    <field name="document_count"/>
    <field name="total_amount"/>
    <field name="attachment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents" name="lineids">
                            <field name="line_ids" readonly="1"><list><field name="document_date"/><field name="label"/><field name="reference"/><field name="amount" sum="Total"/><field name="currency_id" column_invisible="1"/></list></field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_doc_merge_search" model="ir.ui.view">
        <field name="name">doc.merge.search</field>
        <field name="model">doc.merge</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="done" string="Generated" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_doc_merge" model="ir.actions.act_window">
        <field name="name">Dossiers</field>
        <field name="res_model">doc.merge</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build one PDF with every document of a customer.</p>
        </field>
    </record>

</odoo>
