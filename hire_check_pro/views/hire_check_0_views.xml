<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hire_check_list" model="ir.ui.view">
        <field name="name">hire.check.list</field>
        <field name="model">hire.check</field>
        <field name="arch" type="xml">
            <list string="Checklists" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="start_date"/>
                <field name="employee_id"/>
                <field name="kind"/>
                <field name="line_count"/>
                <field name="todo_count"/>
                <field name="company_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hire_check_form" model="ir.ui.view">
        <field name="name">hire.check.form</field>
        <field name="model">hire.check</field>
        <field name="arch" type="xml">
            <form string="Checklists">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state == 'draft'"/>
                    <button name="action_done" type="object" string="Close File" class="btn-primary" invisible="state == 'in_progress'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" invisible="state == 'done'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('draft', 'in_progress')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="employee_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Checklist">
    <field name="name"/>
    <field name="kind"/>
    <field name="employee_id"/>
    <field name="start_date"/>
    <field name="company_id"/>
                        </group>
                        <group string="Counters">
    <field name="line_count"/>
    <field name="todo_count"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                    <notebook><page string="Tasks"><field name="line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="category"/><field name="responsible_id"/><field name="due_date"/><field name="state" widget="badge"/><field name="done_date" optional="hide"/></list></field></page></notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hire_check_search" model="ir.ui.view">
        <field name="name">hire.check.search</field>
        <field name="model">hire.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="onboarding" string="Onboarding" domain="[('kind','=','onboarding')]"/>
                <filter name="offboarding" string="Offboarding" domain="[('kind','=','offboarding')]"/>
                <separator/>
                <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_hire_check_kanban" model="ir.ui.view">
        <field name="name">hire.check.kanban</field>
        <field name="model">hire.check</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="employee_id"/>
                <field name="kind"/>
                <field name="start_date"/>
                <field name="todo_count"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="employee_id"/>
                        <field name="kind"/>
                        <field name="start_date"/>
                        <field name="todo_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hire_check" model="ir.actions.act_window">
        <field name="name">Checklists</field>
        <field name="res_model">hire.check</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every arrival and departure with its task list and its progress, nothing starts from memory any more.</p>
        </field>
    </record>

</odoo>
