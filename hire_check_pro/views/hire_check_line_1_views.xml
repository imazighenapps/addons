<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hire_check_line_list" model="ir.ui.view">
        <field name="name">hire.check.line.list</field>
        <field name="model">hire.check.line</field>
        <field name="arch" type="xml">
            <list string="Tasks" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="check_id"/>
                <field name="kind"/>
                <field name="category"/>
                <field name="responsible_id"/>
                <field name="due_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hire_check_line_form" model="ir.ui.view">
        <field name="name">hire.check.line.form</field>
        <field name="model">hire.check.line</field>
        <field name="arch" type="xml">
            <form string="Tasks">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Task">
    <field name="name"/>
    <field name="category"/>
    <field name="note"/>
    <field name="company_id"/>
                        </group>
                        <group string="Follow Up">
    <field name="check_id"/>
    <field name="responsible_id"/>
    <field name="due_date"/>
    <field name="state"/>
    <field name="done_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hire_check_line_search" model="ir.ui.view">
        <field name="name">hire.check.line.search</field>
        <field name="model">hire.check.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="check_id"/>
                <filter name="todo" string="To Do" domain="[('state','=','todo')]"/>
                <filter name="onboarding" string="Onboarding" domain="[('kind','=','onboarding')]"/>
                <filter name="offboarding" string="Offboarding" domain="[('kind','=','offboarding')]"/>
                <separator/>
                <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                <filter name="group_check" string="Checklist" context="{'group_by': 'check_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hire_check_line" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">hire.check.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The whole to-do book of every arrival and departure in one list.</p>
        </field>
    </record>

</odoo>
