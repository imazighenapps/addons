<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hire_check_company" model="ir.rule">
        <field name="name">hire.check: own company only</field>
        <field name="model_id" ref="model_hire_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_hire_check_line_company" model="ir.rule">
        <field name="name">hire.check.line: own company only</field>
        <field name="model_id" ref="model_hire_check_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
