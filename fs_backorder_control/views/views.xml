<odoo>
  <record id="view_fs_backorder_control_list" model="ir.ui.view">
    <field name="name">fs.backorder.control.list</field>
    <field name="model">fs.backorder.control</field>
    <field name="arch" type="xml">
      <list decoration-danger="severity == 'critical'" decoration-warning="severity == 'aging'">
        <field name="picking_id"/>
        <field name="partner_id"/>
        <field name="warehouse_id"/>
        <field name="remaining_qty"/>
        <field name="age_days"/>
        <field name="severity"/>
        <field name="state"/>
        <field name="active" optional="hide"/>
      </list>
    </field>
  </record>
  <record id="view_fs_backorder_control_form" model="ir.ui.view">
    <field name="name">fs.backorder.control.form</field>
    <field name="model">fs.backorder.control</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_open_picking" type="object" string="Open Transfer" class="btn-primary"/>
          <button name="action_open_backorder_chain" type="object" string="Backorder Chain"/>
          <button name="action_schedule_review" type="object" string="Schedule Review" class="btn-secondary" invisible="not active"/>
          <button name="action_cancel_picking" type="object" string="Cancel Backorder" class="btn-secondary" groups="stock.group_stock_manager"/>
        </header>
        <sheet>
          <group>
            <field name="picking_id"/>
            <field name="backorder_id"/>
            <field name="partner_id"/>
            <field name="warehouse_id"/>
            <field name="remaining_qty"/>
            <field name="product_count"/>
            <field name="age_days"/>
            <field name="severity"/>
            <field name="state"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_fs_backorder_control_search" model="ir.ui.view">
    <field name="name">fs.backorder.control.search</field>
    <field name="model">fs.backorder.control</field>
    <field name="arch" type="xml">
      <search>
        <field name="picking_id"/>
        <field name="partner_id"/>
        <field name="warehouse_id"/>
        <filter name="filter_critical" string="Critical" domain="[('severity','=','critical')]"/>
        <filter name="filter_aging" string="Aging" domain="[('severity','=','aging')]"/>
        <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
        <group>
          <filter name="group_warehouse" string="Warehouse" context="{'group_by':'warehouse_id'}"/>
          <filter name="group_severity" string="Severity" context="{'group_by':'severity'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_fs_backorder_config_search" model="ir.ui.view"><field name="name">fs.backorder.control.config.search</field><field name="model">fs.backorder.control.config</field><field name="arch" type="xml"><search><field name="company_id"/></search></field></record>
  <record id="action_fs_backorder_control" model="ir.actions.act_window">
    <field name="name">Backorder Control</field>
    <field name="res_model">fs.backorder.control</field>
    <field name="view_mode">list,kanban,form</field>
  </record>
  <record id="view_fs_backorder_control_kanban" model="ir.ui.view">
    <field name="name">fs.backorder.control.kanban</field>
    <field name="model">fs.backorder.control</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <strong>
                <field name="picking_id"/>
              </strong>
              <div>
                <field name="severity"/> · <field name="age_days"/> days</div>
              <div>Remaining: <field name="remaining_qty"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <menuitem id="menu_fs_backorder_control_root" name="Backorder Control" parent="stock.menu_stock_root" sequence="91" groups="stock.group_stock_user"/>
  <menuitem id="menu_fs_backorder_control" name="Backorders" parent="menu_fs_backorder_control_root" action="action_fs_backorder_control"/>
  <menuitem id="menu_fs_backorder_config_root" name="Configuration" parent="menu_fs_backorder_control_root" groups="stock.group_stock_manager" sequence="90"/>
  <record id="action_fs_backorder_config" model="ir.actions.act_window">
    <field name="name">Configuration</field>
    <field name="res_model">fs.backorder.control.config</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_fs_backorder_config" name="Thresholds" parent="menu_fs_backorder_config_root" action="action_fs_backorder_config"/>
  <record id="view_fs_backorder_config_list" model="ir.ui.view">
    <field name="name">fs.backorder.control.config.list</field>
    <field name="model">fs.backorder.control.config</field>
    <field name="arch" type="xml">
      <list>
        <field name="company_id"/>
        <field name="aging_days"/>
        <field name="critical_days"/>
      </list>
    </field>
  </record>
  <record id="view_fs_backorder_config_form" model="ir.ui.view">
    <field name="name">fs.backorder.control.config.form</field>
    <field name="model">fs.backorder.control.config</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="company_id"/>
            <field name="aging_days"/>
            <field name="critical_days"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_server_schedule_backorder_review" model="ir.actions.server">
    <field name="name">Schedule Backorder Review</field>
    <field name="model_id" ref="model_fs_backorder_control"/>
    <field name="binding_model_id" ref="model_fs_backorder_control"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">records.action_schedule_review()</field>
  </record>
  <record id="action_server_cancel_backorder" model="ir.actions.server">
    <field name="name">Cancel Backorder</field>
    <field name="model_id" ref="model_fs_backorder_control"/>
    <field name="binding_model_id" ref="model_fs_backorder_control"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">records.action_cancel_picking()</field>
  </record>
</odoo>
