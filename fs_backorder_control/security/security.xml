<odoo>
  <record id="rule_backorder_company_user" model="ir.rule">
    <field name="name">Backorder control: company scope</field>
    <field name="model_id" ref="model_fs_backorder_control"/>
    <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_backorder_company_manager" model="ir.rule">
    <field name="name">Backorder control manager: company scope</field>
    <field name="model_id" ref="model_fs_backorder_control"/>
    <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_backorder_config_company" model="ir.rule">
    <field name="name">Backorder configuration: company scope</field>
    <field name="model_id" ref="model_fs_backorder_control_config"/>
    <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
