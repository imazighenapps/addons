<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_contract" model="ir.module.category">
        <field name="name">Contracts</field>
        <field name="description">Contract Lifecycle Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_contract_user" model="res.groups.privilege">
        <field name="name">Contract User</field>
        <field name="category_id" ref="module_category_contract"/>
    </record>

    <record id="privilege_contract_manager" model="res.groups.privilege">
        <field name="name">Contract Manager</field>
        <field name="category_id" ref="module_category_contract"/>
    </record>

    <record id="group_contract_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_contract_user"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_contract_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_contract_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_contract_user'))]"/>
    </record>

    <record id="rule_contract_user" model="ir.rule">
        <field name="name">Contracts: multi-company user access</field>
        <field name="model_id" ref="model_contract_contract"/>
        <field name="groups" eval="[(4, ref('group_contract_user'))]"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False),
                  ('company_id', 'in', company_ids)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_contract_manager_all" model="ir.rule">
        <field name="name">Contracts: full manager access</field>
        <field name="model_id" ref="model_contract_contract"/>
        <field name="groups" eval="[(4, ref('group_contract_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_contract_portal" model="ir.rule">
        <field name="name">Contracts: portal — own contracts only</field>
        <field name="model_id" ref="model_contract_contract"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id]),
             ('state', 'not in', ['cancelled', 'draft'])]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_milestone_portal" model="ir.rule">
        <field name="name">Milestones: portal — via own contracts only</field>
        <field name="model_id" ref="model_contract_milestone"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('contract_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
