<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="doc"/>
                    <div class="page">
                        <div style="border-bottom: 3px solid #714AB7; padding-bottom: 16px; margin-bottom: 24px;">
                            <div class="row">
                                <div class="col-8">
                                    <h1 style="color: #714AB7; font-size: 24px; margin-bottom: 4px;">
                                        <t t-esc="doc.title"/>
                                    </h1>
                                    <p style="color: #666; font-size: 14px; margin: 0;">
                                        Reference: <strong><t t-esc="doc.name"/></strong>
                                        &amp;nbsp;|&amp;nbsp;
                                        Version <t t-esc="doc.version"/>
                                        &amp;nbsp;|&amp;nbsp;
                                        <t t-esc="dict(doc._fields['contract_type'].selection).get(doc.contract_type, doc.contract_type)"/>
                                    </p>
                                </div>
                                <div class="col-4 text-end">
                                    <div style="background: #714AB7; color: white; padding: 8px 16px; border-radius: 6px; display: inline-block; font-size: 13px; font-weight: bold;">
                                        <t t-esc="dict(doc._fields['state'].selection).get(doc.state, doc.state).upper()"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <div style="background: #f8f4ff; padding: 16px; border-radius: 8px; border-left: 4px solid #714AB7;">
                                    <h4 style="color: #714AB7; margin-bottom: 8px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em;">Our Company</h4>
                                    <p style="margin: 0; font-weight: bold; font-size: 15px;">
                                        <t t-esc="doc.company_id.name"/>
                                    </p>
                                    <p style="margin: 0; color: #666; font-size: 12px;">
                                        <t t-if="doc.company_id.street">
                                            <t t-esc="doc.company_id.street"/><br/>
                                        </t>
                                        <t t-if="doc.company_id.city">
                                            <t t-esc="doc.company_id.zip"/> <t t-esc="doc.company_id.city"/>
                                        </t>
                                    </p>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="background: #f0f8f0; padding: 16px; border-radius: 8px; border-left: 4px solid #2e7d32;">
                                    <h4 style="color: #2e7d32; margin-bottom: 8px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em;">
                                        <t t-if="doc.contract_type == 'customer'">Customer</t>
                                        <t t-elif="doc.contract_type == 'supplier'">Vendor</t>
                                        <t t-else="">Partner</t>
                                    </h4>
                                    <p style="margin: 0; font-weight: bold; font-size: 15px;">
                                        <t t-esc="doc.partner_id.name"/>
                                    </p>
                                    <p style="margin: 0; color: #666; font-size: 12px;">
                                        <t t-if="doc.partner_id.street">
                                            <t t-esc="doc.partner_id.street"/><br/>
                                        </t>
                                        <t t-if="doc.partner_id.city">
                                            <t t-esc="doc.partner_id.zip"/> <t t-esc="doc.partner_id.city"/>
                                        </t>
                                        <t t-if="doc.partner_contact_id">
                                            <br/>Contact: <t t-esc="doc.partner_contact_id.name"/>
                                        </t>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <table class="table table-sm" style="border: 1px solid #ddd; border-radius: 8px; overflow: hidden; margin-bottom: 24px;">
                            <thead style="background: #714AB7; color: white;">
                                <tr>
                                    <th colspan="4" style="padding: 10px 16px; font-size: 13px;">
                                        Contract Summary
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding: 8px 12px; background: #fafafa; font-weight: bold; width: 25%;">Start Date</td>
                                    <td style="padding: 8px 12px; width: 25%;"><t t-esc="doc.date_start" t-options='{"widget": "date"}'/></td>
                                    <td style="padding: 8px 12px; background: #fafafa; font-weight: bold; width: 25%;">End Date</td>
                                    <td style="padding: 8px 12px; width: 25%;">
                                        <t t-if="doc.date_end">
                                            <t t-esc="doc.date_end" t-options='{"widget": "date"}'/>
                                        </t>
                                        <t t-else="">Indefinite</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 8px 12px; background: #fafafa; font-weight: bold;">Signature Date</td>
                                    <td style="padding: 8px 12px;">
                                        <t t-if="doc.date_signed">
                                            <t t-esc="doc.date_signed" t-options='{"widget": "date"}'/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td style="padding: 8px 12px; background: #fafafa; font-weight: bold;">Total Value</td>
                                    <td style="padding: 8px 12px; font-weight: bold; color: #714AB7;">
                                        <t t-esc="doc.amount_total"
                                           t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 8px 12px; background: #fafafa; font-weight: bold;">Responsible</td>
                                    <td style="padding: 8px 12px;"><t t-esc="doc.user_id.name"/></td>
                                    <td style="padding: 8px 12px; background: #fafafa; font-weight: bold;">Renewal</td>
                                    <td style="padding: 8px 12px;">
                                        <t t-esc="dict(doc._fields['renewal_type'].selection).get(doc.renewal_type, '')"/>
                                    </td>
                                </tr>
                                <t t-if="doc.notice_days and doc.date_end">
                                    <tr>
                                        <td style="padding: 8px 12px; background: #fafafa; font-weight: bold;">Notice Period</td>
                                        <td colspan="3" style="padding: 8px 12px;">
                                            <t t-esc="doc.notice_days"/> days
                                            (notice date: <t t-esc="doc.date_notice" t-options='{"widget": "date"}'/>)
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-if="doc.description">
                            <div style="margin-bottom: 24px;">
                                <h3 style="color: #714AB7; border-bottom: 2px solid #714AB7; padding-bottom: 8px; font-size: 16px;">
                                    Purpose and Terms
                                </h3>
                                <div style="text-align: justify; line-height: 1.7; font-size: 13px;">
                                    <t t-raw="doc.description"/>
                                </div>
                            </div>
                        </t>

                        <t t-if="doc.milestone_ids">
                            <div style="margin-bottom: 24px;">
                                <h3 style="color: #714AB7; border-bottom: 2px solid #714AB7; padding-bottom: 8px; font-size: 16px;">
                                    Milestones and Deliverables
                                </h3>
                                <table class="table table-sm table-bordered">
                                    <thead style="background: #f0ebff;">
                                        <tr>
                                            <th>Milestone</th>
                                            <th>Due Date</th>
                                            <th>Responsible</th>
                                            <th class="text-end">Amount</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.milestone_ids" t-as="ms">
                                            <tr>
                                                <td><t t-esc="ms.name"/></td>
                                                <td><t t-esc="ms.date_due" t-options='{"widget": "date"}'/></td>
                                                <td><t t-if="ms.responsible_id"><t t-esc="ms.responsible_id.name"/></t></td>
                                                <td class="text-end">
                                                    <t t-if="ms.amount">
                                                        <t t-esc="ms.amount"
                                                           t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                    </t>
                                                </td>
                                                <td><t t-esc="dict(ms._fields['state'].selection).get(ms.state, ms.state)"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>

                        <div style="margin-top: 48px; page-break-inside: avoid;">
                            <h3 style="color: #714AB7; border-bottom: 2px solid #714AB7; padding-bottom: 8px; font-size: 16px;">
                                Signatures
                            </h3>
                            <div class="row">
                                <div class="col-6">
                                    <div style="border: 1px solid #ddd; border-radius: 8px; padding: 16px; min-height: 100px;">
                                        <p style="font-weight: bold; color: #444; margin-bottom: 4px;">
                                            For <t t-esc="doc.company_id.name"/>
                                        </p>
                                        <p style="color: #666; font-size: 12px;">
                                            Name: <t t-esc="doc.user_id.name"/>
                                        </p>
                                        <t t-if="doc.signature_our">
                                            <img t-att-src="'data:image/png;base64,%s' % doc.signature_our.decode()"
                                                 style="max-height: 60px; max-width: 150px;"/>
                                        </t>
                                        <p style="color: #666; font-size: 11px; margin-top: 40px; border-top: 1px solid #ddd; padding-top: 4px;">
                                            Date and signature
                                        </p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div style="border: 1px solid #ddd; border-radius: 8px; padding: 16px; min-height: 100px;">
                                        <p style="font-weight: bold; color: #444; margin-bottom: 4px;">
                                            For <t t-esc="doc.partner_id.name"/>
                                        </p>
                                        <t t-if="doc.partner_contact_id">
                                            <p style="color: #666; font-size: 12px;">
                                                Name: <t t-esc="doc.partner_contact_id.name"/>
                                            </p>
                                        </t>
                                        <t t-if="doc.signature_partner">
                                            <img t-att-src="'data:image/png;base64,%s' % doc.signature_partner.decode()"
                                                 style="max-height: 60px; max-width: 150px;"/>
                                        </t>
                                        <p style="color: #666; font-size: 11px; margin-top: 40px; border-top: 1px solid #ddd; padding-top: 4px;">
                                            Date and signature
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div style="margin-top: 32px; padding-top: 16px; border-top: 1px solid #ddd; text-align: center; color: #999; font-size: 11px;">
                            Contract generated on
                            <t t-esc="context_timestamp(datetime.datetime.now())" t-options='{"widget": "datetime"}'/>
                            — <t t-esc="doc.name"/> — Smart Contract Lifecycle
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_contract_list_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div style="border-bottom:3px solid #714AB7; padding-bottom:12px; margin-bottom:20px;">
                        <div class="row">
                            <div class="col-8">
                                <h2 style="color:#714AB7; margin:0;">Contract Status Report</h2>
                                <p style="color:#666; font-size:12px; margin:4px 0 0;">
                                    Generated on <t t-esc="context_timestamp(datetime.datetime.now())"
                                                  t-options='{"widget":"date"}'/>
                                    — <t t-esc="len(docs)"/> contract(s)
                                </p>
                            </div>
                            <div class="col-4 text-end">
                                <t t-set="total_value" t-value="sum(d.amount_total for d in docs)"/>
                                <div style="background:#714AB7;color:white;padding:8px 14px;border-radius:6px;display:inline-block;">
                                    <div style="font-size:11px;">Total Value</div>
                                    <div style="font-size:18px;font-weight:bold;">
                                        <t t-esc="'{:,.0f}'.format(total_value)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4" style="gap:0;">
                        <t t-set="active_count" t-value="len(docs.filtered(lambda d: d.state=='active'))"/>
                        <t t-set="expiring_count" t-value="len(docs.filtered(lambda d: d.is_near_expiry))"/>
                        <t t-set="expired_count" t-value="len(docs.filtered(lambda d: d.state=='expired'))"/>
                        <t t-set="draft_count" t-value="len(docs.filtered(lambda d: d.state in ('draft','negotiation','pending_approval')))"/>
                        <div class="col-3">
                            <div style="background:#e8f5e9;border-radius:8px;padding:12px;text-align:center;border-left:4px solid #2e7d32;">
                                <div style="font-size:24px;font-weight:bold;color:#2e7d32;"><t t-esc="active_count"/></div>
                                <div style="font-size:11px;color:#555;">Active</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div style="background:#fff8e1;border-radius:8px;padding:12px;text-align:center;border-left:4px solid #f57f17;">
                                <div style="font-size:24px;font-weight:bold;color:#f57f17;"><t t-esc="expiring_count"/></div>
                                <div style="font-size:11px;color:#555;">Expiring Soon</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div style="background:#fce4ec;border-radius:8px;padding:12px;text-align:center;border-left:4px solid #c62828;">
                                <div style="font-size:24px;font-weight:bold;color:#c62828;"><t t-esc="expired_count"/></div>
                                <div style="font-size:11px;color:#555;">Expired</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div style="background:#e8eaf6;border-radius:8px;padding:12px;text-align:center;border-left:4px solid #3949ab;">
                                <div style="font-size:24px;font-weight:bold;color:#3949ab;"><t t-esc="draft_count"/></div>
                                <div style="font-size:11px;color:#555;">In Progress</div>
                            </div>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered" style="font-size:11px;">
                        <thead style="background:#714AB7;color:white;">
                            <tr>
                                <th style="padding:6px 8px;">Reference</th>
                                <th style="padding:6px 8px;">Title</th>
                                <th style="padding:6px 8px;">Partner</th>
                                <th style="padding:6px 8px;">Type</th>
                                <th style="padding:6px 8px;">Start</th>
                                <th style="padding:6px 8px;">End</th>
                                <th style="padding:6px 8px;">Days Left</th>
                                <th style="padding:6px 8px; text-align:right;">Value</th>
                                <th style="padding:6px 8px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="doc">
                                <t t-set="row_bg" t-value="
                                    '#fce4ec' if doc.state in ('expired','cancelled')
                                    else '#fff8e1' if doc.is_near_expiry
                                    else '#e8f5e9' if doc.state == 'active'
                                    else 'white'
                                "/>
                                <tr t-attf-style="background:#{row_bg}">
                                    <td style="padding:5px 8px; font-family:monospace; font-weight:bold;">
                                        <t t-esc="doc.name"/>
                                    </td>
                                    <td style="padding:5px 8px;">
                                        <t t-esc="doc.title[:40] + ('...' if len(doc.title)>40 else '')"/>
                                    </td>
                                    <td style="padding:5px 8px;"><t t-esc="doc.partner_id.name"/></td>
                                    <td style="padding:5px 8px;">
                                        <t t-esc="dict(doc._fields['contract_type'].selection).get(doc.contract_type,'')"/>
                                    </td>
                                    <td style="padding:5px 8px;">
                                        <t t-esc="doc.date_start" t-options='{"widget":"date"}'/>
                                    </td>
                                    <td style="padding:5px 8px;">
                                        <t t-if="doc.date_end">
                                            <t t-esc="doc.date_end" t-options='{"widget":"date"}'/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td style="padding:5px 8px; text-align:center;">
                                        <t t-if="doc.date_end">
                                            <t t-esc="doc.days_remaining"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td style="padding:5px 8px; text-align:right; font-weight:bold;">
                                        <t t-esc="'{:,.0f}'.format(doc.amount_total)"/>
                                        <t t-esc="doc.currency_id.symbol"/>
                                    </td>
                                    <td style="padding:5px 8px;">
                                        <t t-esc="dict(doc._fields['state'].selection).get(doc.state,'')"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot style="background:#f5f5f5; font-weight:bold;">
                            <tr>
                                <td colspan="7" style="padding:6px 8px; text-align:right;">TOTAL</td>
                                <td style="padding:6px 8px; text-align:right; color:#714AB7;">
                                    <t t-esc="'{:,.0f}'.format(sum(d.amount_total for d in docs))"/>
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
