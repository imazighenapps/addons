<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_contract" model="ir.actions.report">
        <field name="name">Contract</field>
        <field name="model">contract.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">smart_contract_lifecycle.report_contract_document</field>
        <field name="report_file">smart_contract_lifecycle.report_contract_document</field>
        <field name="print_report_name">'Contract_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_contract_contract"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_contract_list" model="ir.actions.report">
        <field name="name">Contract Status Report</field>
        <field name="model">contract.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">smart_contract_lifecycle.report_contract_list_document</field>
        <field name="report_file">smart_contract_lifecycle.report_contract_list_document</field>
        <field name="print_report_name">'Contract_status_%s' % (datetime.date.today())</field>
        <field name="binding_model_id" ref="model_contract_contract"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
