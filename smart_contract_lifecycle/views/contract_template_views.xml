<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_template_form" model="ir.ui.view">
        <field name="name">contract.template.form</field>
        <field name="model">contract.template</field>
        <field name="arch" type="xml">
            <form string="Contract Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contracts" type="object"
                                class="oe_stat_button" icon="fa-file-text">
                            <field name="usage_count" widget="statinfo" string="Usages"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label class="o_form_label" for="name"/>
                        <h1><field name="name" placeholder="Template name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_type"/>
                            <field name="notice_days"/>
                        </group>
                        <group string="Renewal">
                            <field name="renewal_type"/>
                            <field name="renewal_duration" invisible="renewal_type == 'none'"/>
                            <field name="renewal_duration_unit" invisible="renewal_type == 'none'"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle"/>
                        Variables available in the content:
                        <code>{{partner_name}}</code>, <code>{{date_start}}</code>,
                        <code>{{date_end}}</code>, <code>{{amount_total}}</code>,
                        <code>{{company_name}}</code>, <code>{{user_name}}</code>,
                        <code>{{contract_ref}}</code>
                    </div>
                    <separator string="Template Content"/>
                    <field name="content" widget="html"
                           placeholder="Write the template content here..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_contract_template_list" model="ir.ui.view">
        <field name="name">contract.template.list</field>
        <field name="model">contract.template</field>
        <field name="arch" type="xml">
            <list string="Contract Templates">
                <field name="name"/>
                <field name="contract_type"/>
                <field name="renewal_type"/>
                <field name="notice_days"/>
                <field name="usage_count"/>
            </list>
        </field>
    </record>

    <record id="action_contract_template" model="ir.actions.act_window">
        <field name="name">Contract Templates</field>
        <field name="res_model">contract.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
