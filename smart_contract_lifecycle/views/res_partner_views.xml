<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_contract_button" model="ir.ui.view">
        <field name="name">res.partner.contract.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_contracts" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        groups="smart_contract_lifecycle.group_contract_user">
                    <div class="o_stat_info">
                        <field name="contract_count" class="o_stat_value"/>
                        <span class="o_stat_text">Contracts</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
