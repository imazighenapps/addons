<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_contract" name="Portal My Home: contracts"
              customize_show="True" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Contracts</t>
                <t t-set="url">/my/contracts</t>
                <t t-set="placeholder_count">contract_count</t>
            </t>
        </xpath>
    </template>

    <template id="portal_my_contracts" name="My Contracts">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Contracts</t>
            </t>
            <t t-if="not contracts">
                <div class="alert alert-warning mt-3">
                    You do not have any contracts yet.
                </div>
            </t>
            <t t-if="contracts" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th>Title</th>
                        <th>Start</th>
                        <th>End</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="contracts" t-as="contract">
                        <tr>
                            <td>
                                <a t-att-href="'/my/contracts/%s' % contract.id">
                                    <t t-esc="contract.name"/>
                                </a>
                            </td>
                            <td><t t-esc="contract.title"/></td>
                            <td>
                                <span t-field="contract.date_start"
                                      t-options='{"widget":"date"}'/>
                            </td>
                            <td>
                                <t t-if="contract.date_end">
                                    <span t-field="contract.date_end"
                                          t-options='{"widget":"date"}'/>
                                </t>
                                <t t-else="">—</t>
                            </td>
                            <td class="text-end">
                                <span t-field="contract.amount_total"
                                      t-options='{"widget":"monetary","display_currency":contract.currency_id}'/>
                            </td>
                            <td>
                                <span t-attf-class="badge #{
                                    'bg-success' if contract.state == 'active'
                                    else 'bg-warning text-dark' if contract.state in ('negotiation','pending_approval')
                                    else 'bg-danger' if contract.state in ('expired','cancelled')
                                    else 'bg-secondary'
                                }">
                                    <t t-esc="dict(contract._fields['state'].selection).get(contract.state,'')"/>
                                </span>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_contract_detail" name="Contract Detail">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" groups="smart_contract_lifecycle.group_contract_user">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url"
                       t-value="'/odoo/contracts/%s' % contract.id"/>
                </t>
            </t>

            <div class="container mt-4 mb-5">
                <div class="row">
                    <div class="col-12 col-lg-8">
                        <div class="card shadow-sm">
                            <div class="card-header"
                                 style="background:#714AB7; color:white;">
                                <h4 class="mb-0">
                                    <i class="fa fa-file-text me-2"/>
                                    <t t-esc="contract.name"/> — <t t-esc="contract.title"/>
                                </h4>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <span t-attf-class="badge fs-6 #{
                                        'bg-success' if contract.state == 'active'
                                        else 'bg-warning text-dark' if contract.state in ('negotiation','pending_approval')
                                        else 'bg-danger' if contract.state in ('expired','cancelled')
                                        else 'bg-secondary'
                                    }">
                                        <t t-esc="dict(contract._fields['state'].selection).get(contract.state,'')"/>
                                    </span>
                                    <t t-if="contract.is_near_expiry">
                                        <span class="badge bg-warning text-dark ms-2">
                                            Expires in <t t-esc="contract.days_remaining"/> days
                                        </span>
                                    </t>
                                </div>

                                <table class="table table-sm table-bordered">
                                    <tr>
                                        <th class="table-light" style="width:35%;">Type</th>
                                        <td>
                                            <t t-esc="dict(contract._fields['contract_type'].selection).get(contract.contract_type,'')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="table-light">Start Date</th>
                                        <td>
                                            <span t-field="contract.date_start"
                                                  t-options='{"widget":"date"}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="table-light">End Date</th>
                                        <td>
                                            <t t-if="contract.date_end">
                                                <span t-field="contract.date_end"
                                                      t-options='{"widget":"date"}'/>
                                            </t>
                                            <t t-else="">Indefinite term</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="table-light">Contract Value</th>
                                        <td>
                                            <strong>
                                                <span t-field="contract.amount_total"
                                                      t-options='{"widget":"monetary","display_currency":contract.currency_id}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="table-light">Responsible</th>
                                        <td><t t-esc="contract.user_id.name"/></td>
                                    </tr>
                                </table>

                                <t t-if="contract.description">
                                    <h5 class="mt-4">Contract Purpose</h5>
                                    <div t-field="contract.description"/>
                                </t>

                                <t t-if="contract.milestone_ids">
                                    <h5 class="mt-4">Milestones and Deliverables</h5>
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Milestone</th>
                                                <th>Due Date</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="contract.milestone_ids" t-as="ms">
                                                <tr>
                                                    <td><t t-esc="ms.name"/></td>
                                                    <td>
                                                        <span t-field="ms.date_due"
                                                              t-options='{"widget":"date"}'/>
                                                    </td>
                                                    <td>
                                                        <span t-attf-class="badge #{
                                                            'bg-success' if ms.state == 'done'
                                                            else 'bg-danger' if ms.state == 'late'
                                                            else 'bg-secondary'
                                                        }">
                                                            <t t-esc="dict(ms._fields['state'].selection).get(ms.state,'')"/>
                                                        </span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>

                                <div class="mt-4">
                                    <a t-att-href="'/report/pdf/smart_contract_lifecycle.action_report_contract/%s' % contract.id"
                                       class="btn btn-outline-primary" target="_blank">
                                        <i class="fa fa-download me-2"/>
                                        Download Contract (PDF)
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-4 mt-3 mt-lg-0">
                        <div class="card shadow-sm">
                            <div class="card-header">
                                <h6 class="mb-0">Signature</h6>
                            </div>
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <i t-attf-class="fa me-2 #{
                                        'fa-check-circle text-success' if contract.signed_by_us
                                        else 'fa-times-circle text-muted'
                                    }"/>
                                    Our Company
                                </div>
                                <div class="d-flex align-items-center">
                                    <i t-attf-class="fa me-2 #{
                                        'fa-check-circle text-success' if contract.signed_by_partner
                                        else 'fa-times-circle text-muted'
                                    }"/>
                                    <t t-esc="contract.partner_id.name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
