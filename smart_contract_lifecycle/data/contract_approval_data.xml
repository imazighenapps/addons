<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="approval_rule_low" model="contract.approval.rule">
            <field name="name">Low Amount (&lt; 10,000)</field>
            <field name="sequence">10</field>
            <field name="amount_min">0</field>
            <field name="amount_max">10000</field>
        </record>
        <record id="approval_rule_low_level_1" model="contract.approval.rule.level">
            <field name="rule_id" ref="approval_rule_low"/>
            <field name="sequence">10</field>
            <field name="name">Manager Approval</field>
            <field name="group_id" ref="group_contract_manager"/>
        </record>

        <record id="approval_rule_medium" model="contract.approval.rule">
            <field name="name">Medium Amount (10,000 — 50,000)</field>
            <field name="sequence">20</field>
            <field name="amount_min">10000</field>
            <field name="amount_max">50000</field>
        </record>
        <record id="approval_rule_medium_level_1" model="contract.approval.rule.level">
            <field name="rule_id" ref="approval_rule_medium"/>
            <field name="sequence">10</field>
            <field name="name">Manager Approval</field>
            <field name="group_id" ref="group_contract_manager"/>
        </record>
        <record id="approval_rule_medium_level_2" model="contract.approval.rule.level">
            <field name="rule_id" ref="approval_rule_medium"/>
            <field name="sequence">20</field>
            <field name="name">Finance Approval</field>
            <field name="group_id" ref="account.group_account_manager"/>
        </record>

        <record id="approval_rule_high" model="contract.approval.rule">
            <field name="name">High Amount (&gt; 50,000)</field>
            <field name="sequence">30</field>
            <field name="amount_min">50000</field>
            <field name="amount_max">0</field>
        </record>
        <record id="approval_rule_high_level_1" model="contract.approval.rule.level">
            <field name="rule_id" ref="approval_rule_high"/>
            <field name="sequence">10</field>
            <field name="name">Manager Approval</field>
            <field name="group_id" ref="group_contract_manager"/>
        </record>
        <record id="approval_rule_high_level_2" model="contract.approval.rule.level">
            <field name="rule_id" ref="approval_rule_high"/>
            <field name="sequence">20</field>
            <field name="name">Finance Approval</field>
            <field name="group_id" ref="account.group_account_manager"/>
        </record>
        <record id="approval_rule_high_level_3" model="contract.approval.rule.level">
            <field name="rule_id" ref="approval_rule_high"/>
            <field name="sequence">30</field>
            <field name="name">Executive Approval</field>
            <field name="group_id" ref="base.group_system"/>
        </record>

    </data>
</odoo>
