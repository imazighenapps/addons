<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_contract" model="ir.sequence">
            <field name="name">Contract Sequence</field>
            <field name="code">contract.contract</field>
            <field name="prefix">CTR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_amendment" model="ir.sequence">
            <field name="name">Amendment Sequence</field>
            <field name="code">contract.amendment</field>
            <field name="prefix">AMD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
