<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_key_custody_list" model="ir.ui.view">
        <field name="name">key.custody.list</field>
        <field name="model">key.custody</field>
        <field name="arch" type="xml">
            <list string="Custody Records" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="item_id"/>
                <field name="employee_id"/>
                <field name="date_issue"/>
                <field name="date_return"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_key_custody_form" model="ir.ui.view">
        <field name="name">key.custody.form</field>
        <field name="model">key.custody</field>
        <field name="arch" type="xml">
            <form string="Custody Records">
                <header>
                    <button name="action_return" type="object" string="Mark Returned" class="btn-primary" invisible="state != 'issued'"/>
                    <button name="action_lost" type="object" string="Mark Lost" class="btn-secondary" invisible="state != 'issued'"/>
                    <button name="action_reset" type="object" string="Reset to Issued" class="btn-link" invisible="state == 'issued'"/>
                    <field name="state" widget="statusbar" statusbar_visible="issued,returned,lost"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Custody">
    <field name="name"/>
    <field name="item_id"/>
    <field name="employee_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Dates">
    <field name="date_issue"/>
    <field name="date_return"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_key_custody_search" model="ir.ui.view">
        <field name="name">key.custody.search</field>
        <field name="model">key.custody</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="item_id"/>
                <field name="employee_id"/>
                <filter name="issued" string="Issued" domain="[('state','=','issued')]"/>
                <filter name="returned" string="Returned" domain="[('state','=','returned')]"/>
                <filter name="lost" string="Lost" domain="[('state','=','lost')]"/>
                <separator/>
                <filter name="group_item" string="Item" context="{'group_by': 'item_id'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_key_custody" model="ir.actions.act_window">
        <field name="name">Custody Records</field>
        <field name="res_model">key.custody</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track key and badge issuance and returns.</p>
        </field>
    </record>

</odoo>
