<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_gdpr_user" model="res.groups">
        <field name="name">GDPR User</field>
        <field name="comment">Work on GDPR registers and requests.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_gdpr_manager" model="res.groups">
        <field name="name">GDPR Manager</field>
        <field name="comment">Full GDPR administration.</field>
        <field name="implied_ids" eval="[(4, ref('gdpr_sme_pack.group_gdpr_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
