<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gdpr_activity_list" model="ir.ui.view">
        <field name="name">gdpr.activity.list</field>
        <field name="model">gdpr.activity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="role"/>
                <field name="legal_basis"/>
                <field name="owner_id"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'draft'" decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>
    <record id="view_gdpr_activity_form" model="ir.ui.view">
        <field name="name">gdpr.activity.form</field>
        <field name="model">gdpr.activity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Activity">
                            <field name="role"/>
                            <field name="legal_basis"/>
                            <field name="legal_justification"/>
                            <field name="owner_id"/>
                            <field name="state"/>
                            <field name="version"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Data &amp; Transfers">
                            <field name="data_categories"/>
                            <field name="subject_categories"/>
                            <field name="recipients"/>
                            <field name="transfer_country_id"/>
                            <field name="safeguard"/>
                            <field name="subcontractor_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="purposes"/>
                    <field name="retention_summary"/>
                    <field name="security_measures"/>
                    <field name="retention_rule_ids">
                        <list>
                            <field name="data_category"/>
                            <field name="duration_months"/>
                            <field name="trigger"/>
                            <field name="legal_hold"/>
                            <field name="action"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_gdpr_activity" model="ir.actions.act_window">
        <field name="name">Processing Register (Art.30)</field>
        <field name="res_model">gdpr.activity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
