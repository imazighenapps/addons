<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gdpr_dsar_list" model="ir.ui.view">
        <field name="name">gdpr.dsar.list</field>
        <field name="model">gdpr.dsar</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="requester_name"/>
                <field name="right"/>
                <field name="deadline"/>
                <field name="state" widget="badge" decoration-success="state == 'answered'" decoration-info="state in ('processing', 'identity', 'search')" decoration-warning="state == 'new'" decoration-danger="state in ('overdue', 'refused')"/>
                <field name="assignee_id"/>
            </list>
        </field>
    </record>
    <record id="view_gdpr_dsar_form" model="ir.ui.view">
        <field name="name">gdpr.dsar.form</field>
        <field name="model">gdpr.dsar</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_answer" string="Answer" type="object" class="btn-primary"/>
                    <button name="action_refuse" string="Refuse" type="object"/>
                    <button name="action_extend" string="Extend +2 Months" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,processing,answered,refused"/>
                </header>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Request">
                            <field name="partner_id"/>
                            <field name="requester_name"/>
                            <field name="requester_email"/>
                            <field name="channel"/>
                            <field name="right"/>
                            <field name="assignee_id"/>
                        </group>
                        <group string="Deadlines">
                            <field name="receipt_date"/>
                            <field name="deadline"/>
                            <field name="extension"/>
                            <field name="extension_reason"/>
                            <field name="identity_state"/>
                        </group>
                    </group>
                    <field name="response_doc"/>
                    <field name="refusal_reason"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_gdpr_dsar" model="ir.actions.act_window">
        <field name="name">DSAR Requests</field>
        <field name="res_model">gdpr.dsar</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
