<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gdpr_dpia_list" model="ir.ui.view">
        <field name="name">gdpr.dpia.list</field>
        <field name="model">gdpr.dpia</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="activity_id"/>
                <field name="score"/>
                <field name="need_dpia" widget="boolean_toggle"/>
                <field name="residual"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_gdpr_dpia_form" model="ir.ui.view">
        <field name="name">gdpr.dpia.form</field>
        <field name="model">gdpr.dpia</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_analysis" string="Start Analysis" type="object"/>
                    <button name="action_decide" string="Decide" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="screening,analysis,decided"/>
                </header>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Screening (9 criteria)">
                            <field name="crit_evaluation"/>
                            <field name="crit_auto"/>
                            <field name="crit_monitoring"/>
                            <field name="crit_sensitive"/>
                            <field name="crit_scale"/>
                            <field name="crit_matching"/>
                            <field name="crit_vulnerable"/>
                            <field name="crit_innovative"/>
                            <field name="crit_hamper"/>
                        </group>
                        <group string="Result">
                            <field name="activity_id"/>
                            <field name="company_id"/>
                            <field name="score"/>
                            <field name="need_dpia"/>
                            <field name="residual"/>
                            <field name="consultation"/>
                            <field name="consultation_date"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="necessity"/>
                    <field name="risks"/>
                    <field name="measures"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_gdpr_dpia" model="ir.actions.act_window">
        <field name="name">DPIA</field>
        <field name="res_model">gdpr.dpia</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
