<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_visit_report_list" model="ir.ui.view">
        <field name="name">customer.visit.report.list</field>
        <field name="model">customer.visit.report</field>
        <field name="arch" type="xml">
            <list string="Visit Reports" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="purpose"/>
                <field name="followup_needed" widget="boolean"/>
                <field name="followup_date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_customer_visit_report_form" model="ir.ui.view">
        <field name="name">customer.visit.report.form</field>
        <field name="model">customer.visit.report</field>
        <field name="arch" type="xml">
            <form string="Visit Reports">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Mark Reviewed" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,reviewed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Visit">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="user_id"/>
    <field name="date"/>
    <field name="purpose"/>
    <field name="attendees"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Follow-up">
    <field name="followup_needed"/>
    <field name="followup_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary" name="summary">
                            <field name="summary"/>
                        </page>
                        <page string="Outcomes" name="outcome">
                            <field name="outcome"/>
                        </page>
                        <page string="Follow-up Actions" name="followupaction">
                            <field name="followup_action"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_customer_visit_report_search" model="ir.ui.view">
        <field name="name">customer.visit.report.search</field>
        <field name="model">customer.visit.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="purpose"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="reviewed" string="Reviewed" domain="[('state','=','reviewed')]"/>
                <filter name="followup" string="Follow-up Needed" domain="[('followup_needed','=',True)]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_customer_visit_report" model="ir.actions.act_window">
        <field name="name">Visit Reports</field>
        <field name="res_model">customer.visit.report</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record and review customer visit reports.</p>
        </field>
    </record>

</odoo>
