<odoo>
    <record id="view_pest_document_profile_list" model="ir.ui.view">
        <field name="name">pest.document.profile.list</field>
        <field name="model">pest.document.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="country_id"/>
                <field name="language_id"/>
                <field name="secondary_language_id"/>
                <field name="currency_id"/>
                <field name="bilingual"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pest_document_profile_form" model="ir.ui.view">
        <field name="name">pest.document.profile.form</field>
        <field name="model">pest.document.profile</field>
        <field name="arch" type="xml">
            <form string="PestOps Document Profile">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="company_id"/>
                            <field name="active"/>
                            <field name="country_id"/>
                            <field name="language_id"/>
                            <field name="secondary_language_id"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="service_title"/>
                            <field name="treatment_title"/>
                            <field name="inspection_title"/>
                            <field name="show_currency"/>
                            <field name="show_country"/>
                            <field name="show_customer_language"/>
                            <field name="bilingual"/>
                        </group>
                    </group>
                    <group>
                        <field name="footer_text"/>
                        <field name="legal_notice"/>
                        <field name="contact_text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pest_document_profile" model="ir.actions.act_window">
        <field name="name">Document Profiles</field>
        <field name="res_model">pest.document.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
