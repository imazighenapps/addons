<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_gift_expire" model="ir.cron">
        <field name="name">GiftWallet: expire gift cards</field>
        <field name="model_id" ref="model_gift_card"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
