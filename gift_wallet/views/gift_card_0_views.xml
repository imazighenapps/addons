<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gift_card_list" model="ir.ui.view">
        <field name="name">gift.card.list</field>
        <field name="model">gift.card</field>
        <field name="arch" type="xml">
            <list string="Gift Cards" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="initial_amount" sum="Total Initial Amount"/>
                <field name="balance" sum="Total Balance"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_gift_card_form" model="ir.ui.view">
        <field name="name">gift.card.form</field>
        <field name="model">gift.card</field>
        <field name="arch" type="xml">
            <form string="Gift Cards">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,used,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Card">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="company_id"/>
    <field name="expiry_date"/>
    <field name="state"/>
                        </group>
                        <group string="Balance">
    <field name="initial_amount"/>
    <field name="balance"/>
    <field name="transaction_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions" name="transactionids">
                            <field name="transaction_ids" readonly="1"><list><field name="date"/><field name="type"/><field name="amount" sum="Total"/><field name="reference"/><field name="user_id"/><field name="currency_id" column_invisible="1"/></list></field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gift_card_search" model="ir.ui.view">
        <field name="name">gift.card.search</field>
        <field name="model">gift.card</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="used" string="Used" domain="[('state','=','used')]"/>
                <filter name="expired" string="Expired" domain="[('state','=','expired')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_gift_card" model="ir.actions.act_window">
        <field name="name">Gift Cards</field>
        <field name="res_model">gift.card</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Issue your first gift card.</p>
        </field>
    </record>

</odoo>
