<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_canteen_meal_log_list" model="ir.ui.view">
        <field name="name">canteen.meal.log.list</field>
        <field name="model">canteen.meal.log</field>
        <field name="arch" type="xml">
            <list string="Canteen Logs" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="meal_type"/>
                <field name="headcount" sum="Total Headcount"/>
                <field name="cost" sum="Total Cost"/>
                <field name="subsidy" sum="Total Subsidy"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_canteen_meal_log_form" model="ir.ui.view">
        <field name="name">canteen.meal.log.form</field>
        <field name="model">canteen.meal.log</field>
        <field name="arch" type="xml">
            <form string="Canteen Logs">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Log">
    <field name="name"/>
    <field name="date"/>
    <field name="meal_type"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Counts &amp; Cost">
    <field name="headcount"/>
    <field name="currency_id"/>
    <field name="cost"/>
    <field name="subsidy"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_canteen_meal_log_search" model="ir.ui.view">
        <field name="name">canteen.meal.log.search</field>
        <field name="model">canteen.meal.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <separator/>
                <filter name="group_meal_type" string="Meal Type" context="{'group_by': 'meal_type'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_canteen_meal_log" model="ir.actions.act_window">
        <field name="name">Canteen Logs</field>
        <field name="res_model">canteen.meal.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record and confirm canteen meal logs.</p>
        </field>
    </record>

</odoo>
