<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_maintenance_plan_entry_company" model="ir.rule">
        <field name="name">maintenance_plan.entry: own company only</field>
        <field name="model_id" ref="model_maintenance_plan_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_maintenance_plan_item_company" model="ir.rule">
        <field name="name">maintenance_plan.item: own company only</field>
        <field name="model_id" ref="model_maintenance_plan_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
