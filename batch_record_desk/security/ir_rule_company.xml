<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_batch_record_entry_company" model="ir.rule">
        <field name="name">batch_record.entry: own company only</field>
        <field name="model_id" ref="model_batch_record_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_batch_record_item_company" model="ir.rule">
        <field name="name">batch_record.item: own company only</field>
        <field name="model_id" ref="model_batch_record_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
