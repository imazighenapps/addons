<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_batch_record_item_list" model="ir.ui.view">
        <field name="name">batch_record.item.list</field>
        <field name="model">batch_record.item</field>
        <field name="arch" type="xml">
            <list string="BatchRecord Lines">
                <field name="entry_id"/>
                <field name="sequence"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="price"/>
                <field name="subtotal" sum="Total Subtotal"/>
            </list>
        </field>
    </record>

    <record id="view_batch_record_item_form" model="ir.ui.view">
        <field name="name">batch_record.item.form</field>
        <field name="model">batch_record.item</field>
        <field name="arch" type="xml">
            <form string="BatchRecord Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="entry_id"/>
    <field name="sequence"/>
    <field name="name"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amounts">
    <field name="quantity"/>
    <field name="price"/>
    <field name="subtotal"/>
    <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_batch_record_item_search" model="ir.ui.view">
        <field name="name">batch_record.item.search</field>
        <field name="model">batch_record.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="entry_id"/>
                <separator/>
                <filter name="group_entry" string="Entry" context="{'group_by': 'entry_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_batch_record_item" model="ir.actions.act_window">
        <field name="name">BatchRecord Lines</field>
        <field name="res_model">batch_record.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Line details.</p>
        </field>
    </record>

</odoo>
