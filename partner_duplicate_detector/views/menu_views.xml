<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <record id="action_duplicate_dashboard" model="ir.actions.client">
        <field name="name">Duplicate Detector</field>
        <field name="tag">partner_duplicate_detector.dashboard</field>
    </record>



    <!-- Top-level menu under Contacts -->
    <menuitem id="menu_duplicate_detector_root"
              name="Duplicate Detector"
              parent="contacts.menu_contacts"
              sequence="30"/>
    <menuitem id="menu_duplicate_dashboard"
              name="Dashboard"
              parent="menu_duplicate_detector_root"
              action="action_duplicate_dashboard"
              sequence="5"/>
    <menuitem id="menu_duplicate_groups"
              name="Duplicate Groups"
              parent="menu_duplicate_detector_root"
              action="action_duplicate_groups"
              sequence="10"/>

    <menuitem id="menu_run_scan"
              name="Run Scan Now"
              parent="menu_duplicate_detector_root"
              action="action_run_scan"
              sequence="20"
              groups="base.group_partner_manager"/>

</odoo>
