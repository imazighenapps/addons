<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_aging_wizard_form" model="ir.ui.view">
        <field name="name">partner.aging.wizard.form</field>
        <field name="model">partner.aging.wizard</field>
        <field name="arch" type="xml">
            <form string="Aging AR/AP avancé">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="aging_type"/>
                        <field name="as_of_date"/>
                    </group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="total_due" readonly="1"/>
                        <field name="dso_dpo" readonly="1"/>
                    </group>
                </group>
                <group string="Totaux par tranche">
                    <group>
                        <field name="total_0_30" readonly="1"/>
                        <field name="total_31_60" readonly="1"/>
                    </group>
                    <group>
                        <field name="total_61_90" readonly="1"/>
                        <field name="total_90p" readonly="1"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0">
                        <field name="partner_id"/>
                        <field name="amount_0_30"/>
                        <field name="amount_31_60"/>
                        <field name="amount_61_90"/>
                        <field name="amount_90p"/>
                        <field name="total_due"/>
                        <field name="recommended_action"/>
                    </list>
                </field>
                <footer>
                    <button name="action_compute" type="object" string="Calculer" class="btn-primary"/>
                    <button name="action_print" type="object" string="PDF"/>
                    <button name="action_export_csv" type="object" string="Exporter CSV"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
