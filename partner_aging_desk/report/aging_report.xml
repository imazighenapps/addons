<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_partner_aging" model="ir.actions.report">
        <field name="name">Aging AR/AP</field>
        <field name="model">partner.aging.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partner_aging_desk.report_partner_aging_template</field>
        <field name="print_report_name">'aging_%s_%s' % (object.aging_type, object.as_of_date)</field>
    </record>
    <template id="report_partner_aging_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Aging <t t-esc="doc.aging_type == 'receivable' and 'Clients (AR)' or 'Fournisseurs (AP)'"/></h2>
                        <p>Date d'analyse : <t t-esc="doc.as_of_date"/> — Société : <t t-esc="doc.company_id.name"/></p>
                        <p>Total : <t t-esc="'%.2f' % doc.total_due"/> — DSO/DPO : <t t-esc="'%.1f' % doc.dso_dpo"/> j</p>
                        <table class="table table-sm">
                            <thead><tr><th>Partenaire</th><th class="text-end">0-30</th><th class="text-end">31-60</th><th class="text-end">61-90</th><th class="text-end">&gt;90</th><th class="text-end">Total</th><th>Action</th></tr></thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="l">
                                    <tr>
                                        <td t-esc="l.partner_id.display_name"/>
                                        <td class="text-end" t-esc="'%.2f' % l.amount_0_30"/>
                                        <td class="text-end" t-esc="'%.2f' % l.amount_31_60"/>
                                        <td class="text-end" t-esc="'%.2f' % l.amount_61_90"/>
                                        <td class="text-end" t-esc="'%.2f' % l.amount_90p"/>
                                        <td class="text-end" t-esc="'%.2f' % l.total_due"/>
                                        <td t-esc="l.recommended_action"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
