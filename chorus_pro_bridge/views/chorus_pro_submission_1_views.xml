<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chorus_pro_submission_list" model="ir.ui.view">
        <field name="name">chorus.pro.submission.list</field>
        <field name="model">chorus.pro.submission</field>
        <field name="arch" type="xml">
            <list string="Submissions" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="submission_date"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="amount_total" sum="Total Amount Total"/>
                <field name="chorus_number"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_chorus_pro_submission_form" model="ir.ui.view">
        <field name="name">chorus.pro.submission.form</field>
        <field name="model">chorus.pro.submission</field>
        <field name="arch" type="xml">
            <form string="Submissions">
                <header>
                    <button name="action_prepare" type="object" string="Prepare" class="btn-primary" invisible="state not in ('draft','rejected')"/>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'ready'"/>
                    <button name="action_mark_accepted" type="object" string="Mark Accepted" class="btn-secondary" invisible="state != 'submitted'"/>
                    <button name="action_mark_rejected" type="object" string="Mark Rejected" class="btn-secondary" invisible="state != 'submitted'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid" class="btn-secondary" invisible="state != 'accepted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,submitted,accepted,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Submission">
    <field name="name"/>
    <field name="connection_id"/>
    <field name="company_id"/>
    <field name="state"/>
    <field name="submission_date"/>
                        </group>
                        <group string="Invoice">
    <field name="move_id"/>
    <field name="partner_id"/>
    <field name="amount_total"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Chorus Pro">
    <field name="engagement_code"/>
    <field name="service_code"/>
    <field name="chorus_number"/>
    <field name="rejection_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload"/>
                        </page>
                        <page string="Status History" name="statuslogids">
                            <field name="status_log_ids" readonly="1">
                        <list><field name="create_date"/><field name="status"/><field name="message"/></list>
                     </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_chorus_pro_submission_search" model="ir.ui.view">
        <field name="name">chorus.pro.submission.search</field>
        <field name="model">chorus.pro.submission</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="chorus_number"/>
                <field name="engagement_code"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="accepted" string="Accepted" domain="[('state','=','accepted')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_chorus_pro_submission" model="ir.actions.act_window">
        <field name="name">Submissions</field>
        <field name="res_model">chorus.pro.submission</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Prepare and track Chorus Pro invoice submissions.</p>
        </field>
    </record>

</odoo>
