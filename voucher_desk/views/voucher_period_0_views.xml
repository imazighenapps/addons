<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_voucher_period_list" model="ir.ui.view">
        <field name="name">voucher.period.list</field>
        <field name="model">voucher.period</field>
        <field name="arch" type="xml">
            <list string="Voucher Periods" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="date_start"/>
                <field name="name"/>
                <field name="working_days"/>
                <field name="voucher_value"/>
                <field name="total_vouchers"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_voucher_period_form" model="ir.ui.view">
        <field name="name">voucher.period.form</field>
        <field name="model">voucher.period</field>
        <field name="arch" type="xml">
            <form string="Voucher Periods">
                <header>
                    <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state == 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-secondary" invisible="state == 'validated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="s,t,a,t,e"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Period">
    <field name="name"/>
    <field name="date_start"/>
    <field name="date_end"/>
    <field name="company_id"/>
                        </group>
                        <group string="Rules">
    <field name="working_days"/>
    <field name="voucher_value"/>
    <field name="currency_id"/>
    <field name="total_vouchers"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocations" name="lineids">
                            <field name="line_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_voucher_period_search" model="ir.ui.view">
        <field name="name">voucher.period.search</field>
        <field name="model">voucher.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="validated" string="Validated" domain="[('state','=','validated')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_voucher_period_kanban" model="ir.ui.view">
        <field name="name">voucher.period.kanban</field>
        <field name="model">voucher.period</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_vouchers"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="total_vouchers"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_voucher_period" model="ir.actions.act_window">
        <field name="name">Voucher Periods</field>
        <field name="res_model">voucher.period</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Monthly voucher periods and their allocations.</p>
        </field>
    </record>

</odoo>
