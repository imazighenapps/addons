<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_voucher_period_company" model="ir.rule">
        <field name="name">voucher.period: own company only</field>
        <field name="model_id" ref="model_voucher_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_voucher_allocation_company" model="ir.rule">
        <field name="name">voucher.allocation: own company only</field>
        <field name="model_id" ref="model_voucher_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
