<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_contract_partner" model="res.partner">
        <field name="name">Demo Contract Partner</field>
        <field name="is_company">True</field>
    </record>
    <record id="demo_contract_1" model="contract.expiry.log">
        <field name="name">CTR-DEMO-001</field>
        <field name="partner_id" ref="demo_contract_partner"/>
        <field name="contract_type">supplier</field>
        <field name="start_date" eval="(DateTime.now() - relativedelta(months=10)).strftime('%Y-%m-%d')"/>
        <field name="end_date" eval="(DateTime.now() + relativedelta(days=30)).strftime('%Y-%m-%d')"/>
        <field name="notice_date" eval="(DateTime.now() + relativedelta(days=15)).strftime('%Y-%m-%d')"/>
        <field name="state">active</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="demo_contract_2" model="contract.expiry.log">
        <field name="name">CTR-DEMO-002</field>
        <field name="partner_id" ref="demo_contract_partner"/>
        <field name="contract_type">customer</field>
        <field name="start_date" eval="(DateTime.now() - relativedelta(months=6)).strftime('%Y-%m-%d')"/>
        <field name="end_date" eval="(DateTime.now() - relativedelta(days=10)).strftime('%Y-%m-%d')"/>
        <field name="state">closed</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
</odoo>
