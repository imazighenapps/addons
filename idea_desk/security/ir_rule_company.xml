<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_idea_proposal_company" model="ir.rule">
        <field name="name">idea.proposal: own company only</field>
        <field name="model_id" ref="model_idea_proposal"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_idea_review_company" model="ir.rule">
        <field name="name">idea.review: own company only</field>
        <field name="model_id" ref="model_idea_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
