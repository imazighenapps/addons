<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_idea_open_list" model="ir.ui.view">
        <field name="name">idea.proposal.list</field>
        <field name="model">idea.proposal</field>
        <field name="arch" type="xml">
            <list string="Open Ideas">
                <field name="submitted_on"/>
                <field name="name"/>
                <field name="author_id"/>
                <field name="area"/>
                <field name="expected_gain"/>
            </list>
        </field>
    </record>

    <record id="view_idea_open_form" model="ir.ui.view">
        <field name="name">idea.proposal.form</field>
        <field name="model">idea.proposal</field>
        <field name="arch" type="xml">
            <form string="Open Ideas">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Idea">
    <field name="name"/>
    <field name="author_id"/>
    <field name="area"/>
    <field name="company_id"/>
                        </group>
                        <group string="Value">
    <field name="expected_gain"/>
    <field name="state"/>
    <field name="review_count"/>
                        </group>
                        <group string="Timeline">
    <field name="submitted_on"/>
    <field name="evaluated_on"/>
    <field name="implemented_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_idea_open_search" model="ir.ui.view">
        <field name="name">idea.proposal.search</field>
        <field name="model">idea.proposal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author_id"/>
                <field name="area"/>
                <separator/>
                <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_idea_open" model="ir.actions.act_window">
        <field name="name">Open Ideas</field>
        <field name="res_model">idea.proposal</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Everything still waiting for an answer, before good ideas fade away.</p>
        </field>
    </record>

</odoo>
