<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_lone_worker_entry_company" model="ir.rule">
        <field name="name">lone_worker.entry: own company only</field>
        <field name="model_id" ref="model_lone_worker_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_lone_worker_item_company" model="ir.rule">
        <field name="name">lone_worker.item: own company only</field>
        <field name="model_id" ref="model_lone_worker_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
