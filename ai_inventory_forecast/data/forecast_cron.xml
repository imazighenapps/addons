<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily: Generate predictions -->
        <record id="ir_cron_generate_predictions" model="ir.cron">
            <field name="name">AI Forecast: Generate Daily Predictions</field>
            <field name="model_id" ref="model_forecast_prediction"/>
            <field name="state">code</field>
            <field name="code">model.generate_predictions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Hourly: Check alerts -->
        <record id="ir_cron_check_alerts" model="ir.cron">
            <field name="name">AI Forecast: Check Alerts</field>
            <field name="model_id" ref="model_forecast_alert"/>
            <field name="state">code</field>
            <field name="code">model.check_and_create_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Daily: Compute reorder rules -->
        <record id="ir_cron_compute_reorder" model="ir.cron">
            <field name="name">AI Forecast: Compute Reorder Rules</field>
            <field name="model_id" ref="model_forecast_reorder"/>
            <field name="state">code</field>
            <field name="code">model.compute_optimal_rules()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Monthly: Cleanup -->
        <record id="ir_cron_cleanup" model="ir.cron">
            <field name="name">AI Forecast: Cleanup Old Data</field>
            <field name="model_id" ref="model_forecast_prediction"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_predictions(365)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
