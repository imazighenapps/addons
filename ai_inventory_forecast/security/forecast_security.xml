<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups -->
    <record id="module_category_inventory_inventory" model="res.groups.privilege">
        <field name="name">AI inventory forecast</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_forecast_user" model="res.groups">
        <field name="name">Forecast User</field>
        <field name="privilege_id" ref="module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_forecast_manager" model="res.groups">
        <field name="name">Forecast Manager</field>
        <field name="privilege_id" ref="module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('group_forecast_user'))]"/>
    </record>

    <record id="group_forecast_admin" model="res.groups">
        <field name="name">Forecast Admin</field>
        <field name="privilege_id" ref="module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('group_forecast_manager'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="forecast_config_user_rule" model="ir.rule">
        <field name="name">Forecast Config: User</field>
        <field name="model_id" ref="model_forecast_config"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_forecast_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="forecast_config_manager_rule" model="ir.rule">
        <field name="name">Forecast Config: Manager</field>
        <field name="model_id" ref="model_forecast_config"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_forecast_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
