<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_equipment_inspection_log_list" model="ir.ui.view">
        <field name="name">equipment.inspection.log.list</field>
        <field name="model">equipment.inspection.log</field>
        <field name="arch" type="xml">
            <list string="Equipment Inspections" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="inspection_date"/>
                <field name="equipment_id"/>
                <field name="inspector_id"/>
                <field name="condition"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_inspection_log_form" model="ir.ui.view">
        <field name="name">equipment.inspection.log.form</field>
        <field name="model">equipment.inspection.log</field>
        <field name="arch" type="xml">
            <form string="Equipment Inspections">
                <header>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_issue" type="object" string="Issue Found" class="btn-secondary" invisible="state not in ('planned','done')"/>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state not in ('done','issue_found')"/>
                    <button name="action_reset" type="object" string="Reset to Planned" class="btn-link" invisible="state == 'planned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done,issue_found,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Inspection">
    <field name="name"/>
    <field name="inspection_date"/>
    <field name="equipment_id"/>
    <field name="inspector_id"/>
    <field name="condition"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Findings" name="findings">
                            <field name="findings"/>
                        </page>
                        <page string="Follow-up Action" name="followupaction">
                            <field name="followup_action"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_inspection_log_search" model="ir.ui.view">
        <field name="name">equipment.inspection.log.search</field>
        <field name="model">equipment.inspection.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="inspector_id"/>
                <filter name="planned" string="Planned" domain="[('state','=','planned')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="issue_found" string="Issue Found" domain="[('state','=','issue_found')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="group_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                <filter name="group_inspector" string="Inspector" context="{'group_by': 'inspector_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_equipment_inspection_log" model="ir.actions.act_window">
        <field name="name">Equipment Inspections</field>
        <field name="res_model">equipment.inspection.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log and track equipment inspections.</p>
        </field>
    </record>

</odoo>
