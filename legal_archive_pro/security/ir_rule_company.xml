<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_archive_document_company" model="ir.rule">
        <field name="name">archive.document: own company only</field>
        <field name="model_id" ref="model_archive_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_archive_log_company" model="ir.rule">
        <field name="name">archive.log: own company only</field>
        <field name="model_id" ref="model_archive_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
