<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_archive_log_list" model="ir.ui.view">
        <field name="name">archive.log.list</field>
        <field name="model">archive.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log">
                <field name="date"/>
                <field name="document_id"/>
                <field name="action" widget="badge"/>
                <field name="user_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_archive_log_form" model="ir.ui.view">
        <field name="name">archive.log.form</field>
        <field name="model">archive.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="document_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Log">
    <field name="document_id"/>
    <field name="date"/>
    <field name="action"/>
    <field name="user_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Detail">
    <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_archive_log_search" model="ir.ui.view">
        <field name="name">archive.log.search</field>
        <field name="model">archive.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="document_id"/>
                <field name="note"/>
                <field name="user_id"/>
                <filter name="sealed" string="Sealed" domain="[('action','=','sealed')]"/>
                <filter name="verified" string="Verified" domain="[('action','=','verified')]"/>
                <filter name="purged" string="Purged" domain="[('action','=','purged')]"/>
                <separator/>
                <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                <filter name="group_document" string="Document" context="{'group_by': 'document_id'}"/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_archive_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">archive.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every creation, sealing, verification, archiving and purge, with the user and the date.</p>
        </field>
    </record>

</odoo>
