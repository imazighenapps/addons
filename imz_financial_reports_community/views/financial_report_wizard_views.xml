<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fr_report_wizard_form" model="ir.ui.view">
        <field name="name">fr.report.wizard.form</field>
        <field name="model">fr.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Financial Report">
                <group>
                    <group>
                        <field name="report_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="detailed"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="compare"/>
                        <field name="compare_from" invisible="not compare" required="compare"/>
                        <field name="compare_to" invisible="not compare" required="compare"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view" type="object" string="View" class="btn-primary"/>
                    <button name="action_print" type="object" string="Print PDF" class="btn-secondary"/>
                    <button name="action_export_csv" type="object" string="Export CSV" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_fr_report_result_form" model="ir.ui.view">
        <field name="name">fr.report.result.form</field>
        <field name="model">fr.report.result</field>
        <field name="arch" type="xml">
            <form string="Financial Report Result">
                <sheet>
                    <group>
                        <field name="report_id" readonly="1"/>
                    </group>
                    <field name="html_preview" readonly="1" nolabel="1"/>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
