<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Définition des états -->
        <record id="view_fr_report_list" model="ir.ui.view">
            <field name="name">fr.report.list</field>
            <field name="model">fr.report</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="report_type"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_fr_report_form" model="ir.ui.view">
            <field name="name">fr.report.form</field>
            <field name="model">fr.report</field>
            <field name="arch" type="xml">
                <form string="État financier">
                    <header>
                        <button name="action_open_wizard" type="object"
                                string="Exécuter" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Nom de l'état"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="report_type"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="note"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lignes">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="line_type"/>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="parent_id"/>
                                        <field name="sign"/>
                                        <field name="invert"/>
                                        <field name="internal_group"/>
                                        <field name="account_ids" widget="many2many_tags"/>
                                        <field name="code_prefixes"/>
                                        <field name="report_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Assistant d'exécution -->
        <record id="view_fr_report_wizard_form" model="ir.ui.view">
            <field name="name">fr.report.wizard.form</field>
            <field name="model">fr.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Exécuter l'état">
                    <group>
                        <field name="report_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="detailed"/>
                        <field name="compare"/>
                        <field name="compare_from" invisible="not compare"/>
                        <field name="compare_to" invisible="not compare"/>
                    </group>
                    <footer>
                        <button name="action_view" type="object" string="Afficher"
                                class="btn-primary"/>
                        <button name="action_print" type="object" string="PDF"/>
                        <button name="action_export_csv" type="object" string="CSV"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Résultat affiché -->
        <record id="view_fr_report_result_form" model="ir.ui.view">
            <field name="name">fr.report.result.form</field>
            <field name="model">fr.report.result</field>
            <field name="arch" type="xml">
                <form string="Résultat">
                    <field name="html" widget="html"/>
                    <footer>
                        <button string="Fermer" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
