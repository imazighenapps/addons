<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fr_report_list" model="ir.ui.view">
        <field name="name">fr.report.list</field>
        <field name="model">fr.report</field>
        <field name="arch" type="xml">
            <list string="Financial Reports">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="report_type"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fr_report_form" model="ir.ui.view">
        <field name="name">fr.report.form</field>
        <field name="model">fr.report</field>
        <field name="arch" type="xml">
            <form string="Financial Report">
                <header>
                    <button name="action_open_wizard" type="object" string="Generate Report" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="report_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="line_type"/>
                                    <field name="parent_id"/>
                                    <field name="sign"/>
                                    <field name="invert"/>
                                    <field name="internal_group"/>
                                    <field name="account_ids" widget="many2many_tags" optional="show"/>
                                    <field name="code_prefixes" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fr_report" model="ir.actions.act_window">
        <field name="name">Financial Report Definitions</field>
        <field name="res_model">fr.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
