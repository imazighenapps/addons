<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_financial_reports_privilege" model="res.groups.privilege"><field name="name">Financial Reports Community</field><field name="sequence">10</field></record>

    <record id="group_financial_report_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="module_category_financial_reports_privilege"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="group_financial_report_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="module_category_financial_reports_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_financial_report_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="fr_report_company_rule" model="ir.rule">
        <field name="name">Financial Report: multi-company</field>
        <field name="model_id" ref="model_fr_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
