<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_referral_payout_list" model="ir.ui.view">
        <field name="name">referral.payout.list</field>
        <field name="model">referral.case</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="referrer_id"/>
                <field name="employee_id"/>
                <field name="retention_due"/>
                <field name="state" widget="badge" decoration-success="state == 'retained'" decoration-info="state == 'hired'" decoration-muted="state == 'rejected'"/>
                <field name="paid_amount" widget="monetary"/>
            </list>
        </field>
    </record>
    <record id="action_referral_payout" model="ir.actions.act_window">
        <field name="name">Bonus Payouts</field>
        <field name="res_model">referral.case</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','in',('hired','retained'))]</field>
    </record>
</odoo>