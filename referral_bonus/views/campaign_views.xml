<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_referral_campaign_list" model="ir.ui.view">
        <field name="name">referral.campaign.list</field>
        <field name="model">referral.campaign</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="hired_count"/>
                <field name="total_paid" widget="monetary"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_referral_campaign_form" model="ir.ui.view">
        <field name="name">referral.campaign.form</field>
        <field name="model">referral.campaign</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Bonuses">
                            <field name="company_id"/>
                            <field name="currency_id"/>
                            <field name="bonus_on_hire"/>
                            <field name="bonus_on_retention"/>
                            <field name="probation_days"/>
                            <field name="active"/>
                        </group>
                        <group string="Results">
                            <field name="hired_count"/>
                            <field name="total_paid" widget="monetary"/>
                        </group>
                    </group>
                    <group>
                        <field name="job_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="eligible_employee_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Referrals" name="refs">
                            <field name="referral_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="candidate_name"/>
                                    <field name="referrer_id"/>
                                    <field name="state" widget="badge" decoration-success="state in ('hired','retained')" decoration-danger="state == 'rejected'" decoration-info="state == 'screening'"/>
                                    <field name="paid_amount" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_referral_campaign" model="ir.actions.act_window">
        <field name="name">Referral Campaigns</field>
        <field name="res_model">referral.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>