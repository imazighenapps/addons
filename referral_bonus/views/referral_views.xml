<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_referral_case_list" model="ir.ui.view">
        <field name="name">referral.case.list</field>
        <field name="model">referral.case</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="candidate_name"/>
                <field name="referrer_id"/>
                <field name="job_id"/>
                <field name="state" widget="badge" decoration-success="state in ('hired','retained')" decoration-danger="state == 'rejected'" decoration-info="state == 'screening'" decoration-muted="state == 'submitted'"/>
                <field name="retention_due"/>
                <field name="paid_amount" widget="monetary"/>
            </list>
        </field>
    </record>
    <record id="view_referral_case_form" model="ir.ui.view">
        <field name="name">referral.case.form</field>
        <field name="model">referral.case</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_screening" string="Move to Screening" type="object"/>
                    <button name="action_confirm_retention" string="Confirm Retention" type="object" class="btn-primary"/>
                    <button name="action_reject" string="Not Hired" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,screening,hired,retained"/>
                </header>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Candidate">
                            <field name="candidate_name"/>
                            <field name="candidate_email"/>
                            <field name="candidate_phone"/>
                            <field name="job_id"/>
                            <field name="campaign_id"/>
                        </group>
                        <group string="Referral">
                            <field name="referrer_id"/>
                            <field name="application_id"/>
                            <field name="employee_id"/>
                            <field name="retention_due"/>
                        </group>
                    </group>
                    <group string="Bonuses">
                        <field name="currency_id" invisible="1"/>
                        <field name="bonus_on_hire"/>
                        <field name="bonus_on_retention"/>
                        <field name="paid_amount" widget="monetary"/>
                    </group>
                    <field name="rejection_reason" placeholder="Why was the candidate not hired?"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_referral_case" model="ir.actions.act_window">
        <field name="name">Referrals</field>
        <field name="res_model">referral.case</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>