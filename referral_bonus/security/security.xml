<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_referral_user" model="res.groups">
        <field name="name">Referral User</field>
        <field name="comment">Submit and follow own referrals.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_referral_manager" model="res.groups">
        <field name="name">Referral Manager</field>
        <field name="comment">Configure campaigns and confirm bonuses.</field>
        <field name="implied_ids" eval="[(4, ref('referral_bonus.group_referral_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>