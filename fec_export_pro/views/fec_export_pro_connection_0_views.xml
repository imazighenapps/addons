<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fec_export_pro_connection_list" model="ir.ui.view">
        <field name="name">fec_export_pro.connection.list</field>
        <field name="model">fec_export_pro.connection</field>
        <field name="arch" type="xml">
            <list string="Connections" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="company_id"/>
                <field name="state" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fec_export_pro_connection_form" model="ir.ui.view">
        <field name="name">fec_export_pro.connection.form</field>
        <field name="model">fec_export_pro.connection</field>
        <field name="arch" type="xml">
            <form string="Connections">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_archive_state" type="object" string="Archive" class="btn-secondary" invisible="False"/>
                    <button name="action_reset" type="object" string="Reset" class="btn-secondary" invisible="False"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Connection">
    <field name="name"/>
    <field name="company_id"/>
    <field name="endpoint"/>
                        </group>
                        <group string="Settings">
    <field name="api_key"/>
    <field name="active"/>
    <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Records" name="recordids">
                            <field name="record_ids"/>
                        </page>
                        <page string="Logs" name="logids">
                            <field name="log_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fec_export_pro_connection_search" model="ir.ui.view">
        <field name="name">fec_export_pro.connection.search</field>
        <field name="model">fec_export_pro.connection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <filter name="active_conn" string="Active" domain="[('state','=','active')]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_fec_export_pro_connection" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">fec_export_pro.connection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first connection.</p>
        </field>
    </record>

</odoo>
