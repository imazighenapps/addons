        <field name="model_id" ref="model_fec_export_pro_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_fec_export_pro_record_company" model="ir.rule">
        <field name="name">fec_export_pro.record: own company only</field>
        <field name="model_id" ref="model_fec_export_pro_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
