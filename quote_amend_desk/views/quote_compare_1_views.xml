<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quote_compare_list" model="ir.ui.view">
        <field name="name">quote.change.line.list</field>
        <field name="model">quote.change.line</field>
        <field name="arch" type="xml">
            <list string="Revision Compare">
                <field name="amendment_id"/>
                <field name="field_label"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_quote_compare_form" model="ir.ui.view">
        <field name="name">quote.change.line.form</field>
        <field name="model">quote.change.line</field>
        <field name="arch" type="xml">
            <form string="Revision Compare">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="field_label" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Change">
    <field name="amendment_id"/>
    <field name="field_label"/>
    <field name="old_value"/>
    <field name="new_value"/>
    <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_quote_compare_search" model="ir.ui.view">
        <field name="name">quote.change.line.search</field>
        <field name="model">quote.change.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="field_label"/>
                <separator/>
                <filter name="group_amendment" string="Amendment" context="{'group_by': 'amendment_id'}"/>
                <filter name="group_item" string="Changed Item" context="{'group_by': 'field_label'}"/>
            </search>
        </field>
    </record>

    <record id="action_quote_compare" model="ir.actions.act_window">
        <field name="name">Revision Compare</field>
        <field name="res_model">quote.change.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">What changed, from the value the customer had to the value they now see.</p>
        </field>
    </record>

</odoo>
