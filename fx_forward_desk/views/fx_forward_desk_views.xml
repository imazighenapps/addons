<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="view_fx_forward_desk_form" model="ir.ui.view">
  <field name="name">fx.forward.desk.form</field><field name="model">fx.forward.desk</field>
  <field name="arch" type="xml"><form string="Contrat à terme FX">
    <header>
      <button name="action_open" type="object" string="Ouvrir" class="btn-primary" invisible="state!='draft'"/>
      <button name="action_settle" type="object" string="Dénouer" invisible="state!='open'"/>
      <button name="action_cancel" type="object" string="Annuler" invisible="state in ('settled','cancelled')"/>
      <field name="state" widget="statusbar" statusbar_visible="draft,open,settled"/>
    </header>
    <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group>
        <field name="company_id" groups="base.group_multi_company"/><field name="partner_id"/><field name="invoice_id"/>
        <field name="currency_id"/><field name="counter_currency_id"/><field name="amount"/>
      </group><group>
        <field name="spot_rate"/><field name="forward_rate"/><field name="settlement_rate"/>
        <field name="maturity_date"/><field name="hedge_gain_loss"/>
      </group></group>
      <group string="Notes"><field name="notes" nolabel="1"/></group>
    </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
  </form></field>
</record>
<record id="view_fx_forward_desk_list" model="ir.ui.view">
  <field name="name">fx.forward.desk.list</field><field name="model">fx.forward.desk</field>
  <field name="arch" type="xml"><list decoration-success="state=='settled'">
    <field name="name"/><field name="currency_id"/><field name="amount"/><field name="forward_rate"/>
    <field name="maturity_date"/><field name="hedge_gain_loss"/><field name="state"/>
  </list></field>
</record>
</data></odoo>
