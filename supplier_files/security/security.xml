<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sfiles_user" model="res.groups">
        <field name="name">Supplier Files User</field>
        <field name="comment">Provide and verify supplier documents.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_sfiles_manager" model="res.groups">
        <field name="name">Supplier Files Manager</field>
        <field name="comment">Configure required documents and blocking rules.</field>
        <field name="implied_ids" eval="[(4, ref('supplier_files.group_sfiles_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>