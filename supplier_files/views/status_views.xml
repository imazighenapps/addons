<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sstatus_form" model="ir.ui.view">
        <field name="name">supplier.file.status.form</field>
        <field name="model">supplier.file.status</field>
        <field name="arch" type="xml">
            <form string="File Completeness">
                <group>
                    <field name="partner_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="score"/>
                    <field name="complete"/>
                    <field name="blocking"/>
                </group>
                <group string="Missing">
                    <field name="missing_ids" widget="many2many_tags"/>
                </group>
                <group string="Expired">
                    <field name="expired_ids" widget="many2many_tags"/>
                </group>
                <group string="Blocking Payment">
                    <field name="blocking_ids" widget="many2many_tags"/>
                </group>
            </form>
        </field>
    </record>
</odoo>