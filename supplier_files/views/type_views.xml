<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stype_list" model="ir.ui.view">
        <field name="name">supplier.document.type.list</field>
        <field name="model">supplier.document.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="required"/>
                <field name="has_expiry"/>
                <field name="expiry_warning_days" optional="show"/>
                <field name="blocking" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_stype_form" model="ir.ui.view">
        <field name="name">supplier.document.type.form</field>
        <field name="model">supplier.document.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Requirement">
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="required"/>
                            <field name="active"/>
                        </group>
                        <group string="Expiry &amp; Blocking">
                            <field name="has_expiry"/>
                            <field name="expiry_warning_days"/>
                            <field name="blocking"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_stype" model="ir.actions.act_window">
        <field name="name">Required Documents</field>
        <field name="res_model">supplier.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>