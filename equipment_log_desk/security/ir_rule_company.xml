<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_equipment_log_entry_company" model="ir.rule">
        <field name="name">equipment_log.entry: own company only</field>
        <field name="model_id" ref="model_equipment_log_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_equipment_log_item_company" model="ir.rule">
        <field name="name">equipment_log.item: own company only</field>
        <field name="model_id" ref="model_equipment_log_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
