<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="global_search_config_form" model="ir.ui.view">
            <field name="name">global.search.config.form</field>
            <field name="model">global.search.config</field>
            <field name="arch" type="xml">
                <form string="Global search">
                <sheet>
                    <div class="oe_title mb24">
                        <field name="name" default_focus="1" placeholder="Keyword to Search"/>
                    </div>

                    <group>
                        <group>
                            <field name="model_ids" widget="many2many_tags"/>
                            <field name="result"/>
                        </group>
                        <group>
                        
                        </group>
                    </group>

                    <notebook>
                        <page name="results" string="Results">
                            <field name="line_ids">
                                <list editable="bottom" create="0" delete="0" >
                                    <field name="model_id" column_invisible="1"/> 
                                    <field name="technical_model_name" column_invisible="1"/>
                                    <field name="model_name"/> 
                                    <field name="display_name"/>
                                    <button string="Show" name="show_records" type="object" class="oe_highlight"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                   </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="global_search_config_action" model="ir.actions.act_window">
            <field name="name">Global Search</field>
            <field name="res_model">global.search.config</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            
        </record>

        
    </data>
</odoo>