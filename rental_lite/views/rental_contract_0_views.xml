<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rental_contract_list" model="ir.ui.view">
        <field name="name">rental.contract.list</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <list string="Rental Contracts" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="day_count"/>
                <field name="rental_total" sum="Total Rental Total"/>
                <field name="deposit_amount" sum="Total Deposit Amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_rental_contract_form" model="ir.ui.view">
        <field name="name">rental.contract.form</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <form string="Rental Contracts">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_pickup" type="object" string="Pick Up" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_return" type="object" string="Return" class="btn-primary" invisible="state != 'picked_up'"/>
                    <button name="action_invoice" type="object" string="Invoice" class="btn-primary" invisible="state in ('draft', 'invoiced')"/>
                    <button name="action_view_invoice" type="object" string="View Invoice" class="btn-secondary" invisible="not invoice_id"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state in ('invoiced', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,picked_up,returned,invoiced,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Customer">
    <field name="partner_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Period">
    <field name="date_start"/>
    <field name="date_end"/>
    <field name="day_count"/>
    <field name="return_date"/>
    <field name="is_overdue"/>
                        </group>
                        <group string="Amounts">
    <field name="rental_total"/>
    <field name="deposit_amount"/>
    <field name="damage_fee"/>
    <field name="deposit_refund"/>
    <field name="total_amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Return">
    <field name="return_condition"/>
    <field name="invoice_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipment" name="lineids">
                            <field name="line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="product_id"/><field name="description"/><field name="quantity"/><field name="unit_price"/><field name="subtotal" sum="Total"/><field name="currency_id" column_invisible="1"/></list></field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rental_contract_search" model="ir.ui.view">
        <field name="name">rental.contract.search</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="active" string="In Progress" domain="[('state','in',['confirmed','picked_up'])]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/>
                <filter name="returned" string="Returned" domain="[('state','=','returned')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_rental_contract" model="ir.actions.act_window">
        <field name="name">Rental Contracts</field>
        <field name="res_model">rental.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first rental contract: customer, period, equipment.</p>
        </field>
    </record>

</odoo>
