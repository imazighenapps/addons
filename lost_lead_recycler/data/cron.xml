<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_recycle" model="ir.cron">
        <field name="name">Leads: recycle dormant</field>
        <field name="model_id" ref="model_lead_recycling_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_recycle()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=7)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
