<odoo>
    <record id="module_category_qms_dashboard" model="ir.module.category">
        <field name="name">QMS Dashboard</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_qms_dashboard_user" model="res.groups">
        <field name="name">QMS Dashboard User</field>
        <field name="implied_ids" eval="[(4, ref('qms_core.group_qms_user'))]"/>
    </record>
    <record id="group_qms_dashboard_manager" model="res.groups">
        <field name="name">QMS Dashboard Manager</field>
        <field name="implied_ids" eval="[(4, ref('qms_dashboard.group_qms_dashboard_user')), (4, ref('qms_core.group_qms_manager'))]"/>
    </record>
</odoo>
