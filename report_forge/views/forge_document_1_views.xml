<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_forge_document_list" model="ir.ui.view">
        <field name="name">report.forge.document.list</field>
        <field name="model">report.forge.document</field>
        <field name="arch" type="xml">
            <list string="Generated Documents" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="template_id"/>
                <field name="record_name"/>
                <field name="generated_on"/>
                <field name="template_version"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_forge_document_form" model="ir.ui.view">
        <field name="name">report.forge.document.form</field>
        <field name="model">report.forge.document</field>
        <field name="arch" type="xml">
            <form string="Generated Documents">
                <header>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary" invisible="False"/>
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Source">
    <field name="template_id"/>
    <field name="res_model"/>
    <field name="res_id"/>
    <field name="record_name"/>
    <field name="template_version"/>
                        </group>
                        <group string="Output">
    <field name="generated_on"/>
    <field name="state"/>
    <field name="attachment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preview" name="renderedhtml">
                            <field name="rendered_html" widget="html" readonly="1"/>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_forge_document_search" model="ir.ui.view">
        <field name="name">report.forge.document.search</field>
        <field name="model">report.forge.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="record_name"/>
                <filter name="done" string="Generated" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_forge_document" model="ir.actions.act_window">
        <field name="name">Generated Documents</field>
        <field name="res_model">report.forge.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Generate a document from a contact, a quotation or an invoice.</p>
        </field>
    </record>

</odoo>
