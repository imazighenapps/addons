<odoo>
    <record id="view_qms_audit_template_list" model="ir.ui.view">
        <field name="name">qms.audit.template.list</field>
        <field name="model">qms.audit.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="standard_id"/>
                <field name="active"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="view_qms_audit_template_form" model="ir.ui.view">
        <field name="name">qms.audit.template.form</field>
        <field name="model">qms.audit.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_audit" type="object" string="Create Audit" class="btn-primary"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="standard_id"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="requirement_id"/>
                            <field name="question"/>
                            <field name="criterion"/>
                            <field name="method"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_qms_audit_template" model="ir.actions.act_window">
        <field name="name">Audit Templates</field>
        <field name="res_model">qms.audit.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
