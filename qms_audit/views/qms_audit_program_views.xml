<odoo>
    <record id="view_qms_audit_program_list" model="ir.ui.view">
        <field name="name">qms.audit.program.list</field>
        <field name="model">qms.audit.program</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="year"/>
                <field name="cycle_type"/>
                <field name="owner_id"/>
                <field name="audit_count"/>
                <field name="closed_audit_count"/>
                <field name="completion_rate" widget="progressbar"/>
            </list>
        </field>
    </record>
    <record id="view_qms_audit_program_form" model="ir.ui.view">
        <field name="name">qms.audit.program.form</field>
        <field name="model">qms.audit.program</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="cycle_type"/>
                            <field name="owner_id"/>
                            <field name="risk_review_date"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="audit_count" readonly="1"/>
                            <field name="closed_audit_count" readonly="1"/>
                            <field name="completion_rate" readonly="1"/>
                        </group>
                    </group>
                    <field name="objective"/>
                    <notebook>
                        <page string="Planned Audits">
                            <field name="audit_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="audit_type"/>
                                    <field name="lead_auditor_id"/>
                                    <field name="planned_date"/>
                                    <field name="state"/>
                                    <field name="compliance_rate"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_qms_audit_program_pivot" model="ir.ui.view">
        <field name="name">qms.audit.program.pivot</field>
        <field name="model">qms.audit.program</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="year" type="row"/>
                <field name="audit_count" type="measure"/>
                <field name="closed_audit_count" type="measure"/>
                <field name="completion_rate" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_qms_audit_program" model="ir.actions.act_window">
        <field name="name">Audit Programmes</field>
        <field name="res_model">qms.audit.program</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
</odoo>
