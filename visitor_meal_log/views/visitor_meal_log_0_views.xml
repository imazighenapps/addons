<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_visitor_meal_log_list" model="ir.ui.view">
        <field name="name">visitor.meal.log.list</field>
        <field name="model">visitor.meal.log</field>
        <field name="arch" type="xml">
            <list string="Visitor Meals" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="host_id"/>
                <field name="visitor_name"/>
                <field name="meal_date"/>
                <field name="meal_type"/>
                <field name="meal_count"/>
                <field name="location"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_visitor_meal_log_form" model="ir.ui.view">
        <field name="name">visitor.meal.log.form</field>
        <field name="model">visitor.meal.log</field>
        <field name="arch" type="xml">
            <form string="Visitor Meals">
                <header>
                    <button name="action_request" type="object" string="Request" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_serve" type="object" string="Mark Served" class="btn-primary" invisible="state != 'requested'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('served', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,requested,served,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Meal">
    <field name="name"/>
    <field name="host_id"/>
    <field name="visitor_name"/>
    <field name="partner_id"/>
    <field name="meal_date"/>
    <field name="company_id"/>
                        </group>
                        <group string="Details">
    <field name="meal_type"/>
    <field name="meal_count"/>
    <field name="location"/>
    <field name="user_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_visitor_meal_log_search" model="ir.ui.view">
        <field name="name">visitor.meal.log.search</field>
        <field name="model">visitor.meal.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="host_id"/>
                <field name="visitor_name"/>
                <field name="location"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="requested" string="Requested" domain="[('state','=','requested')]"/>
                <filter name="served" string="Served" domain="[('state','=','served')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Meal Type" context="{'group_by': 'meal_type'}"/>
                <filter name="group_host" string="Host" context="{'group_by': 'host_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_visitor_meal_log_graph" model="ir.ui.view">
        <field name="name">visitor.meal.log.graph</field>
        <field name="model">visitor.meal.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="meal_type"/>
                <field name="meal_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_visitor_meal_log" model="ir.actions.act_window">
        <field name="name">Visitor Meals</field>
        <field name="res_model">visitor.meal.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record and track visitor meals.</p>
        </field>
    </record>

</odoo>
