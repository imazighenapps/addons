<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="report_queue_daily_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="room">
            <t t-call="web.external_layout">
                <div class="page">
                    <style>
                        .wr_report_header { border-bottom: 3px solid #7c3aed; padding-bottom: 12px; margin-bottom: 20px; }
                        .wr_report_title  { font-size: 22px; font-weight: 900; color: #1a1a2e; }
                        .wr_report_sub    { font-size: 13px; color: #6b7280; }
                        .wr_stats_row     { display: flex; gap: 20px; margin-bottom: 24px; }
                        .wr_stat_box      { flex: 1; padding: 14px; border-radius: 8px; border: 1px solid #e5e7eb; text-align: center; }
                        .wr_stat_num      { font-size: 28px; font-weight: 900; color: #7c3aed; }
                        .wr_stat_lbl      { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: #9ca3af; }
                        table             { width: 100%; border-collapse: collapse; font-size: 12px; }
                        th                { background: #f3f0ff; color: #5b21b6; font-weight: 700; padding: 8px 10px; text-align: left; border-bottom: 2px solid #ddd6fe; }
                        td                { padding: 7px 10px; border-bottom: 1px solid #f3f4f6; }
                        tr:nth-child(even) td { background: #fafafa; }
                        .badge-done       { background: #d1fae5; color: #065f46; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 700; }
                        .badge-noshow     { background: #fee2e2; color: #991b1b; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 700; }
                        .badge-cancelled  { background: #f3f4f6; color: #6b7280; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 700; }
                        .badge-waiting    { background: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 700; }
                    </style>

                    <div class="wr_report_header">
                        <div class="wr_report_title">Daily Queue Report — <t t-esc="room.name"/></div>
                        <div class="wr_report_sub">
                            Generated on <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %B %Y at %H:%M')"/>
                        </div>
                    </div>

                    <!-- Summary Stats -->
                    <div class="wr_stats_row">
                        <div class="wr_stat_box">
                            <div class="wr_stat_num"><t t-esc="room.done_today_count"/></div>
                            <div class="wr_stat_lbl">Served Today</div>
                        </div>
                        <div class="wr_stat_box">
                            <div class="wr_stat_num"><t t-esc="room.waiting_count"/></div>
                            <div class="wr_stat_lbl">Still Waiting</div>
                        </div>
                        <div class="wr_stat_box">
                            <div class="wr_stat_num"><t t-esc="'%.1f' % room.avg_wait_time"/></div>
                            <div class="wr_stat_lbl">Avg Wait (min)</div>
                        </div>
                        <div class="wr_stat_box">
                            <div class="wr_stat_num" style="color:#059669">
                                <t t-esc="'OPEN' if room.is_open else 'CLOSED'"/>
                            </div>
                            <div class="wr_stat_lbl">Room Status</div>
                        </div>
                    </div>

                    <!-- Queue Table -->
                    <table>
                        <thead>
                            <tr>
                                <th>Token</th>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th>Check-in</th>
                                <th>Wait (min)</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="today_lines" t-value="room.line_ids.filtered(lambda l: l.check_in_time and l.check_in_time.date() == datetime.date.today())"/>
                            <t t-foreach="today_lines" t-as="line">
                                <tr>
                                    <td><strong><t t-esc="line.token_display"/></strong></td>
                                    <td><t t-esc="line.name"/></td>
                                    <td><t t-esc="line.department_id.name or '—'"/></td>
                                    <td><t t-esc="dict(line._fields['visitor_type'].selection).get(line.visitor_type, '')"/></td>
                                    <td><t t-esc="line.check_in_time.strftime('%H:%M') if line.check_in_time else '—'"/></td>
                                    <td><t t-esc="'%.0f' % line.wait_duration if line.wait_duration else '—'"/></td>
                                    <td>
                                        <t t-if="line.state == 'done'">
                                            <span class="badge-done">Done</span>
                                        </t>
                                        <t t-elif="line.state == 'no_show'">
                                            <span class="badge-noshow">No Show</span>
                                        </t>
                                        <t t-elif="line.state == 'cancelled'">
                                            <span class="badge-cancelled">Cancelled</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge-waiting"><t t-esc="line.state.replace('_', ' ').title()"/></span>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="not today_lines">
                                <tr><td colspan="7" style="text-align:center;color:#9ca3af;padding:20px">No visits recorded today</td></tr>
                            </t>
                        </tbody>
                    </table>

                </div>
            </t>
        </t>
    </t>
</template>

</odoo>
