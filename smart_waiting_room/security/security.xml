<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Category -->
        <record id="module_category_waiting_room" model="ir.module.category">
            <field name="name">Smart Waiting Room</field>
            <field name="description">Manage waiting rooms and queues</field>
            <field name="sequence">30</field>
        </record>

        <!-- Groups -->
        <record id="group_waiting_room_receptionist" model="res.groups">
            <field name="name">Receptionist</field>
            <field name="category_id" ref="module_category_waiting_room"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_waiting_room_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_waiting_room"/>
            <field name="implied_ids" eval="[(4, ref('group_waiting_room_receptionist'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
