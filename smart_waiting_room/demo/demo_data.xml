<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<!-- ══════════════════════════════════════════════════════════════════
     DEPARTMENTS / SERVICES
══════════════════════════════════════════════════════════════════ -->

<record id="demo_dept_dentist" model="waiting.room.department">
    <field name="name">Dentist</field>
    <field name="code">DEN</field>
    <field name="icon">fa-tooth</field>
    <field name="display_color">#3d9bff</field>
    <field name="avg_service_duration">25</field>
    <field name="sequence">10</field>
    <field name="auto_call_next" eval="False"/>
</record>

<record id="demo_dept_hygienist" model="waiting.room.department">
    <field name="name">Hygienist</field>
    <field name="code">HYG</field>
    <field name="icon">fa-smile-o</field>
    <field name="display_color">#00e676</field>
    <field name="avg_service_duration">45</field>
    <field name="sequence">20</field>
</record>

<record id="demo_dept_xray" model="waiting.room.department">
    <field name="name">X-Ray</field>
    <field name="code">XRY</field>
    <field name="icon">fa-flash</field>
    <field name="display_color">#ffab00</field>
    <field name="avg_service_duration">15</field>
    <field name="sequence">30</field>
</record>

<record id="demo_dept_reception" model="waiting.room.department">
    <field name="name">Reception</field>
    <field name="code">REC</field>
    <field name="icon">fa-info-circle</field>
    <field name="display_color">#c77dff</field>
    <field name="avg_service_duration">8</field>
    <field name="sequence">40</field>
</record>

<record id="demo_dept_specialist" model="waiting.room.department">
    <field name="name">Specialist</field>
    <field name="code">SPC</field>
    <field name="icon">fa-user-md</field>
    <field name="display_color">#ff6b6b</field>
    <field name="avg_service_duration">35</field>
    <field name="sequence">50</field>
</record>

<!-- ══════════════════════════════════════════════════════════════════
     WAITING ROOM — Main Clinic
══════════════════════════════════════════════════════════════════ -->

<record id="demo_room_main" model="waiting.room">
    <field name="name">Smart Dental Clinic</field>
    <field name="code">MAIN</field>
    <field name="location">Ground Floor — Main Entrance</field>
    <field name="is_open" eval="True"/>
    <field name="capacity">30</field>
    <field name="display_token">DEMO12345678</field>
    <field name="welcome_message">Welcome to Smart Dental Clinic — please check in at reception</field>
    <field name="footer_message">Thank you for choosing Smart Dental Clinic.</field>
    <field name="ticker_messages">Thank you for your patience. | Please remain seated until your token is called. | Watch the screen for your token number. | For emergencies, please inform reception immediately. | We appreciate your patience and understanding.</field>
    <field name="show_estimated_time" eval="True"/>
    <field name="audio_enabled" eval="True"/>
    <field name="primary_color">#05080f</field>
    <field name="accent_color">#3d9bff</field>
    <field name="department_ids" eval="[
        (4, ref('demo_dept_dentist')),
        (4, ref('demo_dept_hygienist')),
        (4, ref('demo_dept_xray')),
        (4, ref('demo_dept_reception')),
        (4, ref('demo_dept_specialist')),
    ]"/>
</record>

<!-- ══════════════════════════════════════════════════════════════════
     WAITING ROOM — Specialist Suite
══════════════════════════════════════════════════════════════════ -->

<record id="demo_room_vip" model="waiting.room">
    <field name="name">Specialist Suite</field>
    <field name="code">VIP</field>
    <field name="location">First Floor — Suite 101</field>
    <field name="is_open" eval="True"/>
    <field name="capacity">10</field>
    <field name="display_token">VIP87654321</field>
    <field name="welcome_message">Welcome to the Specialist Suite — please take a seat</field>
    <field name="footer_message">Your appointment will begin shortly.</field>
    <field name="ticker_messages">Your comfort is our priority. | Please inform us if you have any special requirements. | Thank you for your patience.</field>
    <field name="show_estimated_time" eval="True"/>
    <field name="audio_enabled" eval="True"/>
    <field name="department_ids" eval="[
        (4, ref('demo_dept_specialist')),
    ]"/>
</record>

