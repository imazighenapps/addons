<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doc_orphan_list" model="ir.ui.view">
        <field name="name">doc.storage.orphan.list</field>
        <field name="model">doc.storage.orphan</field>
        <field name="arch" type="xml">
            <list>
                <field name="scan_id"/>
                <field name="file_name"/>
                <field name="file_size"/>
                <field name="reason"/>
                <field name="state" widget="badge" decoration-success="state == 'deleted'" decoration-muted="state == 'ignored'" decoration-warning="state == 'new'"/>
            </list>
        </field>
    </record>
    <record id="view_doc_orphan_form" model="ir.ui.view">
        <field name="name">doc.storage.orphan.form</field>
        <field name="model">doc.storage.orphan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_delete" string="Delete File" type="object" class="btn-primary"/>
                    <button name="action_ignore" string="Ignore" type="object"/>
                </header>
                <sheet>
                    <group>
                        <field name="scan_id"/>
                        <field name="attachment_id"/>
                        <field name="reason"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_doc_orphan" model="ir.actions.act_window">
        <field name="name">Orphans</field>
        <field name="res_model">doc.storage.orphan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
