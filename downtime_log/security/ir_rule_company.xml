<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_downtime_machine_company" model="ir.rule">
        <field name="name">downtime.machine: own company only</field>
        <field name="model_id" ref="model_downtime_machine"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_downtime_event_company" model="ir.rule">
        <field name="name">downtime.event: own company only</field>
        <field name="model_id" ref="model_downtime_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
