<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_downtime_machine_list" model="ir.ui.view">
        <field name="name">downtime.machine.list</field>
        <field name="model">downtime.machine</field>
        <field name="arch" type="xml">
            <list string="Machines">
                <field name="code"/>
                <field name="name"/>
                <field name="planned_minutes"/>
                <field name="stop_count"/>
                <field name="open_stop_count"/>
                <field name="downtime_minutes"/>
                <field name="mttr_minutes"/>
                <field name="availability_rate"/>
            </list>
        </field>
    </record>

    <record id="view_downtime_machine_form" model="ir.ui.view">
        <field name="name">downtime.machine.form</field>
        <field name="model">downtime.machine</field>
        <field name="arch" type="xml">
            <form string="Machines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Machine">
    <field name="code"/>
    <field name="name"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Baseline">
    <field name="planned_minutes"/>
                        </group>
                        <group string="Metrics">
    <field name="stop_count"/>
    <field name="open_stop_count"/>
    <field name="downtime_minutes"/>
    <field name="mttr_minutes"/>
    <field name="availability_rate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_downtime_machine_search" model="ir.ui.view">
        <field name="name">downtime.machine.search</field>
        <field name="model">downtime.machine</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter name="group_active" string="Active" context="{'group_by': 'active'}"/>
            </search>
        </field>
    </record>

    <record id="view_downtime_machine_kanban" model="ir.ui.view">
        <field name="name">downtime.machine.kanban</field>
        <field name="model">downtime.machine</field>
        <field name="arch" type="xml">
            <kanban default_group_by="active" sample="1">
                <field name="active"/>
                <field name="name"/>
                <field name="code"/>
                <field name="stop_count"/>
                <field name="mttr_minutes"/>
                <field name="availability_rate"/>
                <templates>
                    <t t-name="card">
                        <field name="active" class="fw-bold"/>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="stop_count"/>
                        <field name="mttr_minutes"/>
                        <field name="availability_rate"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_downtime_machine" model="ir.actions.act_window">
        <field name="name">Machines</field>
        <field name="res_model">downtime.machine</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track machine availability and review downtime performance indicators.</p>
        </field>
    </record>

</odoo>
