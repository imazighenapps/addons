<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_assettransfe_user" model="res.groups">
        <field name="name">Asset Transfer Log User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_assettransfe_manager" model="res.groups">
        <field name="name">Asset Transfer Log Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('asset_transfer_log.group_assettransfe_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
