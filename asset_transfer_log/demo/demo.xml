<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_atl_equipment" model="maintenance.equipment">
        <field name="name">Demo Laptop</field>
        <field name="serial_no">LPT-DEMO-01</field>
    </record>
    <record id="demo_atl_employee_from" model="hr.employee">
        <field name="name">Demo Holder A</field>
    </record>
    <record id="demo_atl_employee_to" model="hr.employee">
        <field name="name">Demo Holder B</field>
    </record>
    <record id="demo_atl_1" model="asset.transfer.log">
        <field name="name">ATL-DEMO-001</field>
        <field name="equipment_id" ref="demo_atl_equipment"/>
        <field name="transfer_date" eval="(DateTime.now() - relativedelta(days=5)).strftime('%Y-%m-%d')"/>
        <field name="from_employee_id" ref="demo_atl_employee_from"/>
        <field name="to_employee_id" ref="demo_atl_employee_to"/>
        <field name="from_location">Office A</field>
        <field name="to_location">Office B</field>
        <field name="condition_note">Good condition, charger included.</field>
        <field name="state">done</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="demo_atl_2" model="asset.transfer.log">
        <field name="name">ATL-DEMO-002</field>
        <field name="equipment_id" ref="demo_atl_equipment"/>
        <field name="transfer_date" eval="DateTime.now().strftime('%Y-%m-%d')"/>
        <field name="from_employee_id" ref="demo_atl_employee_to"/>
        <field name="to_employee_id" ref="demo_atl_employee_from"/>
        <field name="state">draft</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
</odoo>
