<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_transfer_log_list" model="ir.ui.view">
        <field name="name">asset.transfer.log.list</field>
        <field name="model">asset.transfer.log</field>
        <field name="arch" type="xml">
            <list string="Asset Transfers" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="transfer_date"/>
                <field name="from_employee_id"/>
                <field name="to_employee_id"/>
                <field name="from_location"/>
                <field name="to_location"/>
                <field name="state" widget="badge"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_asset_transfer_log_form" model="ir.ui.view">
        <field name="name">asset.transfer.log.form</field>
        <field name="model">asset.transfer.log</field>
        <field name="arch" type="xml">
            <form string="Asset Transfers">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'progress'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Transfer">
    <field name="name"/>
    <field name="equipment_id"/>
    <field name="transfer_date"/>
    <field name="user_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Handover">
    <field name="from_employee_id"/>
    <field name="to_employee_id"/>
    <field name="from_location"/>
    <field name="to_location"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Condition / Notes" name="conditionnote">
                            <field name="condition_note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_transfer_log_search" model="ir.ui.view">
        <field name="name">asset.transfer.log.search</field>
        <field name="model">asset.transfer.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="from_employee_id"/>
                <field name="to_employee_id"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="progress" string="In Progress" domain="[('state','=','progress')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                <filter name="group_responsible" string="Responsible" context="{'group_by': 'user_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_asset_transfer_log_graph" model="ir.ui.view">
        <field name="name">asset.transfer.log.graph</field>
        <field name="model">asset.transfer.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_asset_transfer_log" model="ir.actions.act_window">
        <field name="name">Asset Transfers</field>
        <field name="res_model">asset.transfer.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record and track equipment handovers.</p>
        </field>
    </record>

</odoo>
