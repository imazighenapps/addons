<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lost_found_item_list" model="ir.ui.view">
        <field name="name">lost.found.item.list</field>
        <field name="model">lost.found.item</field>
        <field name="arch" type="xml">
            <list string="Lost &amp; Found Items" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date_found"/>
                <field name="location_found"/>
                <field name="finder_name"/>
                <field name="claimant_name"/>
                <field name="date_returned"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_lost_found_item_form" model="ir.ui.view">
        <field name="name">lost.found.item.form</field>
        <field name="model">lost.found.item</field>
        <field name="arch" type="xml">
            <form string="Lost &amp; Found Items">
                <header>
                    <button name="action_claim" type="object" string="Mark Claimed" class="btn-secondary" invisible="state != 'found'"/>
                    <button name="action_return" type="object" string="Mark Returned" class="btn-primary" invisible="state not in ('found','claimed')"/>
                    <button name="action_dispose" type="object" string="Dispose" class="btn-link" invisible="state in ('returned','disposed')"/>
                    <button name="action_reset" type="object" string="Reset to Found" class="btn-link" invisible="state not in ('returned','disposed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="found,claimed,returned,disposed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Item">
    <field name="name"/>
    <field name="date_found"/>
    <field name="location_found"/>
    <field name="finder_name"/>
    <field name="storage_location"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Claim">
    <field name="claimant_name"/>
    <field name="claimant_contact"/>
    <field name="date_returned"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lost_found_item_search" model="ir.ui.view">
        <field name="name">lost.found.item.search</field>
        <field name="model">lost.found.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="location_found"/>
                <field name="finder_name"/>
                <field name="claimant_name"/>
                <filter name="found" string="Found" domain="[('state','=','found')]"/>
                <filter name="claimed" string="Claimed" domain="[('state','=','claimed')]"/>
                <filter name="returned" string="Returned" domain="[('state','=','returned')]"/>
                <filter name="disposed" string="Disposed" domain="[('state','=','disposed')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_lost_found_item" model="ir.actions.act_window">
        <field name="name">Lost &amp; Found Items</field>
        <field name="res_model">lost.found.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register and track lost-and-found items.</p>
        </field>
    </record>

</odoo>
