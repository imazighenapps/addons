<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_parking_permit_log_list" model="ir.ui.view">
        <field name="name">parking.permit.log.list</field>
        <field name="model">parking.permit.log</field>
        <field name="arch" type="xml">
            <list string="Parking Permits" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="holder_name"/>
                <field name="permit_type"/>
                <field name="vehicle_plate"/>
                <field name="zone"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_parking_permit_log_form" model="ir.ui.view">
        <field name="name">parking.permit.log.form</field>
        <field name="model">parking.permit.log</field>
        <field name="arch" type="xml">
            <form string="Parking Permits">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state not in ('draft', 'expired')"/>
                    <button name="action_expire" type="object" string="Mark Expired" class="btn-secondary" invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state not in ('cancelled', 'expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Permit">
    <field name="name"/>
    <field name="permit_type"/>
    <field name="employee_id"/>
    <field name="partner_id"/>
    <field name="user_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Parking">
    <field name="vehicle_plate"/>
    <field name="zone"/>
    <field name="date_start"/>
    <field name="date_end"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_parking_permit_log_search" model="ir.ui.view">
        <field name="name">parking.permit.log.search</field>
        <field name="model">parking.permit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="holder_name"/>
                <field name="vehicle_plate"/>
                <field name="zone"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="expired" string="Expired" domain="[('state','=','expired')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'permit_type'}"/>
                <filter name="group_zone" string="Zone" context="{'group_by': 'zone'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_parking_permit_log_graph" model="ir.ui.view">
        <field name="name">parking.permit.log.graph</field>
        <field name="model">parking.permit.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_parking_permit_log" model="ir.actions.act_window">
        <field name="name">Parking Permits</field>
        <field name="res_model">parking.permit.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register and track parking permits.</p>
        </field>
    </record>

</odoo>
