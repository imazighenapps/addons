        <field name="model_id" ref="model_warehouse_zone_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_warehouse_zone_item_company" model="ir.rule">
        <field name="name">warehouse_zone.item: own company only</field>
        <field name="model_id" ref="model_warehouse_zone_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
