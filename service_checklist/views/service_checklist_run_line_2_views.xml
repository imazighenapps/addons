<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_checklist_run_line_list" model="ir.ui.view">
        <field name="name">service.checklist.run.line.list</field>
        <field name="model">service.checklist.run.line</field>
        <field name="arch" type="xml">
            <list string="Checklist Items">
                <field name="run_id"/>
                <field name="sequence"/>
                <field name="name"/>
                <field name="result" widget="badge"/>
                <field name="note"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_service_checklist_run_line_form" model="ir.ui.view">
        <field name="name">service.checklist.run.line.form</field>
        <field name="model">service.checklist.run.line</field>
        <field name="arch" type="xml">
            <form string="Checklist Items">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Item">
    <field name="run_id"/>
    <field name="sequence"/>
    <field name="name"/>
    <field name="result"/>
                        </group>
                        <group string="Details">
    <field name="instruction"/>
    <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_service_checklist_run_line_search" model="ir.ui.view">
        <field name="name">service.checklist.run.line.search</field>
        <field name="model">service.checklist.run.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="run_id"/>
                <field name="name"/>
                <filter name="todo" string="To Do" domain="[('result','=','todo')]"/>
                <filter name="done" string="Done" domain="[('result','=','done')]"/>
                <filter name="failed" string="Failed" domain="[('result','=','failed')]"/>
                <separator/>
                <filter name="group_run" string="Run" context="{'group_by': 'run_id'}"/>
                <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
            </search>
        </field>
    </record>

    <record id="action_service_checklist_run_line" model="ir.actions.act_window">
        <field name="name">Checklist Items</field>
        <field name="res_model">service.checklist.run.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">All checklist run items.</p>
        </field>
    </record>

</odoo>
