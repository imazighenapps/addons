<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_checklist_run_list" model="ir.ui.view">
        <field name="name">service.checklist.run.list</field>
        <field name="model">service.checklist.run</field>
        <field name="arch" type="xml">
            <list string="Checklist Runs" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="job_ref"/>
                <field name="template_id"/>
                <field name="user_id"/>
                <field name="progress"/>
                <field name="date_start"/>
                <field name="date_done"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_service_checklist_run_form" model="ir.ui.view">
        <field name="name">service.checklist.run.form</field>
        <field name="model">service.checklist.run</field>
        <field name="arch" type="xml">
            <form string="Checklist Runs">
                <header>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state in ('done','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Run">
    <field name="name"/>
    <field name="job_ref"/>
    <field name="template_id"/>
    <field name="user_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Dates">
    <field name="date_start"/>
    <field name="date_done"/>
    <field name="progress"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="lineids">
                            <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="result"/>
                            <field name="instruction" optional="hide"/>
                            <field name="note"/>
                            <field name="company_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_service_checklist_run_search" model="ir.ui.view">
        <field name="name">service.checklist.run.search</field>
        <field name="model">service.checklist.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="job_ref"/>
                <field name="template_id"/>
                <field name="user_id"/>
                <filter name="draft" string="In Progress" domain="[('state','=','draft')]"/>
                <filter name="done" string="Completed" domain="[('state','=','done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/>
                <filter name="group_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_service_checklist_run" model="ir.actions.act_window">
        <field name="name">Checklist Runs</field>
        <field name="res_model">service.checklist.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run checklists for jobs and record per-item results.</p>
        </field>
    </record>

</odoo>
