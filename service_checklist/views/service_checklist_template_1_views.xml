<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_checklist_template_list" model="ir.ui.view">
        <field name="name">service.checklist.template.list</field>
        <field name="model">service.checklist.template</field>
        <field name="arch" type="xml">
            <list string="Checklist Templates">
                <field name="name"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_service_checklist_template_form" model="ir.ui.view">
        <field name="name">service.checklist.template.form</field>
        <field name="model">service.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist Templates">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Template">
    <field name="name"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="itemids">
                            <field name="item_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="instruction"/>
                            <field name="company_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_service_checklist_template_search" model="ir.ui.view">
        <field name="name">service.checklist.template.search</field>
        <field name="model">service.checklist.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_service_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">service.checklist.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define reusable checklist templates with ordered items.</p>
        </field>
    </record>

</odoo>
