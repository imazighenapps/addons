<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_equipment_checkout_log_list" model="ir.ui.view">
        <field name="name">equipment.checkout.log.list</field>
        <field name="model">equipment.checkout.log</field>
        <field name="arch" type="xml">
            <list string="Equipment Checkouts" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="employee_id"/>
                <field name="checkout_date"/>
                <field name="expected_return_date"/>
                <field name="state" widget="badge"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_checkout_log_form" model="ir.ui.view">
        <field name="name">equipment.checkout.log.form</field>
        <field name="model">equipment.checkout.log</field>
        <field name="arch" type="xml">
            <form string="Equipment Checkouts">
                <header>
                    <button name="action_checkout" type="object" string="Check Out" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_return" type="object" string="Mark Returned" class="btn-primary" invisible="state != 'out'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('returned', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,out,returned,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Checkout">
    <field name="name"/>
    <field name="equipment_id"/>
    <field name="employee_id"/>
    <field name="user_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Dates">
    <field name="checkout_date"/>
    <field name="expected_return_date"/>
    <field name="return_date"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Condition / Notes" name="conditionnote">
                            <field name="condition_note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_equipment_checkout_log_search" model="ir.ui.view">
        <field name="name">equipment.checkout.log.search</field>
        <field name="model">equipment.checkout.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="out" string="Checked Out" domain="[('state','=','out')]"/>
                <filter name="returned" string="Returned" domain="[('state','=','returned')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                <filter name="group_borrower" string="Borrower" context="{'group_by': 'employee_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_equipment_checkout_log_graph" model="ir.ui.view">
        <field name="name">equipment.checkout.log.graph</field>
        <field name="model">equipment.checkout.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_equipment_checkout_log" model="ir.actions.act_window">
        <field name="name">Equipment Checkouts</field>
        <field name="res_model">equipment.checkout.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track equipment checkouts and returns.</p>
        </field>
    </record>

</odoo>
