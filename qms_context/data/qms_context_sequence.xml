<odoo>
    <record id="seq_qms_obligation" model="ir.sequence">
        <field name="name">QMS Compliance Obligation</field>
        <field name="code">qms.compliance.obligation</field>
        <field name="prefix">OBL/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_qms_opportunity" model="ir.sequence">
        <field name="name">QMS Opportunity</field>
        <field name="code">qms.opportunity</field>
        <field name="prefix">OPP/%(year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>
