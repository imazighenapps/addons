<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_billable_scan_form" model="ir.ui.view">
        <field name="name">billable.gap.scan.form</field>
        <field name="model">billable.gap.scan</field>
        <field name="arch" type="xml">
            <form string="Scan Unbilled Time">
                <sheet>
                    <group>
                        <group string="Period">
    <field name="date_from"/>
    <field name="date_to"/>
                        </group>
                        <group string="Scope">
    <field name="company_id"/>
    <field name="project_ids"/>
    <field name="employee_ids"/>
    <field name="min_hours"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_billable_scan" model="ir.actions.act_window">
        <field name="name">Scan Unbilled Time</field>
        <field name="res_model">billable.gap.scan</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
