<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vehicle_inspection_log_list" model="ir.ui.view">
        <field name="name">vehicle.inspection.log.list</field>
        <field name="model">vehicle.inspection.log</field>
        <field name="arch" type="xml">
            <list string="Vehicle Inspections" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="vehicle_plate"/>
                <field name="vehicle_model"/>
                <field name="inspection_date"/>
                <field name="odometer"/>
                <field name="state" widget="badge"/>
                <field name="inspector_id"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_inspection_log_form" model="ir.ui.view">
        <field name="name">vehicle.inspection.log.form</field>
        <field name="model">vehicle.inspection.log</field>
        <field name="arch" type="xml">
            <form string="Vehicle Inspections">
                <header>
                    <button name="action_pass" type="object" string="Pass Inspection" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_flag_defect" type="object" string="Flag Defect" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,passed,defect,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Vehicle">
    <field name="name"/>
    <field name="vehicle_plate"/>
    <field name="vehicle_model"/>
    <field name="odometer"/>
    <field name="company_id"/>
                        </group>
                        <group string="Inspection">
    <field name="inspection_date"/>
    <field name="inspector_id"/>
    <field name="brake_ok"/>
    <field name="tire_ok"/>
    <field name="light_ok"/>
    <field name="body_ok"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vehicle_inspection_log_search" model="ir.ui.view">
        <field name="name">vehicle.inspection.log.search</field>
        <field name="model">vehicle.inspection.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_plate"/>
                <field name="vehicle_model"/>
                <field name="inspector_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="passed" string="Passed" domain="[('state','=','passed')]"/>
                <filter name="defect" string="Defect" domain="[('state','=','defect')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_plate'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_vehicle_inspection_log_graph" model="ir.ui.view">
        <field name="name">vehicle.inspection.log.graph</field>
        <field name="model">vehicle.inspection.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_vehicle_inspection_log" model="ir.actions.act_window">
        <field name="name">Vehicle Inspections</field>
        <field name="res_model">vehicle.inspection.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track periodic vehicle inspections and defects.</p>
        </field>
    </record>

</odoo>
