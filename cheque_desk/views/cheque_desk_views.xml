<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="view_cheque_register_form" model="ir.ui.view">
  <field name="name">cheque.register.form</field><field name="model">cheque.register</field>
  <field name="arch" type="xml"><form string="Chèque">
    <header>
      <button name="action_deposit" type="object" string="Remettre en banque" class="btn-primary" invisible="state!='draft'"/>
      <button name="action_clear" type="object" string="Marquer encaissé" invisible="state!='deposited'"/>
      <button name="action_reject" type="object" string="Marquer rejeté" invisible="state!='deposited'"/>
      <field name="state" widget="statusbar" statusbar_visible="draft,deposited,cleared"/>
    </header>
    <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group>
        <field name="company_id" groups="base.group_multi_company"/><field name="partner_id"/><field name="invoice_id"/>
        <field name="cheque_number"/><field name="bank_name"/><field name="batch_ref"/>
      </group><group>
        <field name="amount"/><field name="currency_id" invisible="1"/>
        <field name="deposit_date"/><field name="due_date"/><field name="clearing_date"/><field name="reject_date"/>
        <field name="incident_count"/>
      </group></group>
      <group string="Rejet"><field name="reject_reason" nolabel="1"/></group>
      <group string="Notes"><field name="notes" nolabel="1"/></group>
    </sheet><chatter/>
  </form></field>
</record>
<record id="view_cheque_register_list" model="ir.ui.view">
  <field name="name">cheque.register.list</field><field name="model">cheque.register</field>
  <field name="arch" type="xml"><list decoration-success="state=='cleared'" decoration-danger="state=='rejected'">
    <field name="name"/><field name="cheque_number"/><field name="partner_id"/><field name="amount"/>
    <field name="deposit_date"/><field name="clearing_date"/><field name="incident_count"/><field name="state"/>
  </list></field>
</record>
</data></odoo>
