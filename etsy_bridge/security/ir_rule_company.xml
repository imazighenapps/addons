        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_etsy_order_company" model="ir.rule">
        <field name="name">etsy.order: own company only</field>
        <field name="model_id" ref="model_etsy_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
