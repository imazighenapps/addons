<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_timesheet_approval_log_list" model="ir.ui.view">
        <field name="name">timesheet.approval.log.list</field>
        <field name="model">timesheet.approval.log</field>
        <field name="arch" type="xml">
            <list string="Timesheet Approvals" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_hours"/>
                <field name="state" widget="badge"/>
                <field name="approver_id"/>
            </list>
        </field>
    </record>

    <record id="view_timesheet_approval_log_form" model="ir.ui.view">
        <field name="name">timesheet.approval.log.form</field>
        <field name="model">timesheet.approval.log</field>
        <field name="arch" type="xml">
            <form string="Timesheet Approvals">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state != 'submitted'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state not in ('rejected', 'submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Period">
    <field name="name"/>
    <field name="employee_id"/>
    <field name="project_id"/>
    <field name="date_start"/>
    <field name="date_end"/>
    <field name="company_id"/>
                        </group>
                        <group string="Approval">
    <field name="state"/>
    <field name="total_hours"/>
    <field name="approver_id"/>
    <field name="submitted_date"/>
    <field name="approved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rejection Reason" name="rejectreason">
                            <field name="reject_reason"/>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_timesheet_approval_log_search" model="ir.ui.view">
        <field name="name">timesheet.approval.log.search</field>
        <field name="model">timesheet.approval.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="approver_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_timesheet_approval_log_graph" model="ir.ui.view">
        <field name="name">timesheet.approval.log.graph</field>
        <field name="model">timesheet.approval.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="total_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_timesheet_approval_log" model="ir.actions.act_window">
        <field name="name">Timesheet Approvals</field>
        <field name="res_model">timesheet.approval.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Submit, approve and track timesheet periods.</p>
        </field>
    </record>

</odoo>
