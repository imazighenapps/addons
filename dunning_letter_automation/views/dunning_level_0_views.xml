<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dunning_level_list" model="ir.ui.view">
        <field name="name">dunning.letter.level.list</field>
        <field name="model">dunning.letter.level</field>
        <field name="arch" type="xml">
            <list string="Dunning Levels">
                <field name="sequence"/>
                <field name="name"/>
                <field name="days_after_due"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dunning_level_form" model="ir.ui.view">
        <field name="name">dunning.letter.level.form</field>
        <field name="model">dunning.letter.level</field>
        <field name="arch" type="xml">
            <form string="Dunning Levels">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Level">
    <field name="name"/>
    <field name="sequence"/>
    <field name="days_after_due"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subject" name="subject">
                            <field name="subject"/>
                        </page>
                        <page string="Letter Body" name="body">
                            <field name="body"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dunning_level_search" model="ir.ui.view">
        <field name="name">dunning.letter.level.search</field>
        <field name="model">dunning.letter.level</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_dunning_level" model="ir.actions.act_window">
        <field name="name">Dunning Levels</field>
        <field name="res_model">dunning.letter.level</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Delay and letter text of each reminder step.</p>
        </field>
    </record>

</odoo>
