<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dunning_letter_list" model="ir.ui.view">
        <field name="name">dunning.letter.list</field>
        <field name="model">dunning.letter</field>
        <field name="arch" type="xml">
            <list string="Dunning Letters" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="level_id"/>
                <field name="due_date"/>
                <field name="amount_residual"/>
                <field name="sent_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dunning_letter_form" model="ir.ui.view">
        <field name="name">dunning.letter.form</field>
        <field name="model">dunning.letter</field>
        <field name="arch" type="xml">
            <form string="Dunning Letters">
                <header>
                    <button name="action_send" type="object" string="Send" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid" class="btn-secondary" invisible="state not in ('draft', 'sent')"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,paid,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Letter">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="move_id"/>
    <field name="level_id"/>
    <field name="due_date"/>
    <field name="amount_residual"/>
    <field name="currency_id"/>
    <field name="sent_date"/>
    <field name="state"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dunning_letter_search" model="ir.ui.view">
        <field name="name">dunning.letter.search</field>
        <field name="model">dunning.letter</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="sent" string="Sent" domain="[('state','=','sent')]"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_level" string="Level" context="{'group_by': 'level_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_dunning_letter_graph" model="ir.ui.view">
        <field name="name">dunning.letter.graph</field>
        <field name="model">dunning.letter</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="amount_residual" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_dunning_letter_pivot" model="ir.ui.view">
        <field name="name">dunning.letter.pivot</field>
        <field name="model">dunning.letter</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="level_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_residual" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_dunning_letter" model="ir.actions.act_window">
        <field name="name">Dunning Letters</field>
        <field name="res_model">dunning.letter</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every reminder sent for an overdue invoice.</p>
        </field>
    </record>

</odoo>
