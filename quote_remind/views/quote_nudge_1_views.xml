<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quote_nudge_list" model="ir.ui.view">
        <field name="name">quote.nudge.list</field>
        <field name="model">quote.nudge</field>
        <field name="arch" type="xml">
            <list string="Reminders">
                <field name="nudge_on"/>
                <field name="watch_id"/>
                <field name="channel"/>
                <field name="user_id"/>
                <field name="feedback"/>
            </list>
        </field>
    </record>

    <record id="view_quote_nudge_form" model="ir.ui.view">
        <field name="name">quote.nudge.form</field>
        <field name="model">quote.nudge</field>
        <field name="arch" type="xml">
            <form string="Reminders">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="watch_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Reminder">
    <field name="watch_id"/>
    <field name="nudge_on"/>
    <field name="channel"/>
    <field name="user_id"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Outcome" name="feedback">
                            <field name="feedback"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_quote_nudge_search" model="ir.ui.view">
        <field name="name">quote.nudge.search</field>
        <field name="model">quote.nudge</field>
        <field name="arch" type="xml">
            <search>
                <field name="watch_id"/>
                <field name="user_id"/>
                <field name="feedback"/>
                <filter name="email" string="Email" domain="[('channel','=','email')]"/>
                <filter name="phone" string="Phone" domain="[('channel','=','phone')]"/>
                <filter name="meeting" string="Meeting" domain="[('channel','=','meeting')]"/>
                <separator/>
                <filter name="group_tracker" string="Quotation" context="{'group_by': 'watch_id'}"/>
                <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
                <filter name="group_user" string="Reminder By" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_quote_nudge_kanban" model="ir.ui.view">
        <field name="name">quote.nudge.kanban</field>
        <field name="model">quote.nudge</field>
        <field name="arch" type="xml">
            <kanban default_group_by="channel" sample="1">
                <field name="channel"/>
                <field name="watch_id"/>
                <field name="nudge_on"/>
                <field name="user_id"/>
                <field name="feedback"/>
                <templates>
                    <t t-name="card">
                        <field name="channel" class="fw-bold"/>
                        <field name="watch_id"/>
                        <field name="nudge_on"/>
                        <field name="user_id"/>
                        <field name="feedback"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_quote_nudge" model="ir.actions.act_window">
        <field name="name">Reminders</field>
        <field name="res_model">quote.nudge</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every reminder of every tracker, with its channel and outcome.</p>
        </field>
    </record>

</odoo>
