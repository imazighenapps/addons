<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fr_einvoicing" model="ir.ui.view">
        <field name="name">account.move.form.fr.einvoicing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="after">
                <page string="E-Invoicing FR" name="fr_einvoicing">
                    <group>
                        <group string="Compliance">
                            <field name="fr_operation_type"/>
                            <field name="fr_validation_state"/>
                            <field name="fr_validation_report"/>
                        </group>
                        <group string="Transmission">
                            <field name="fr_ereport_status"/>
                            <field name="fr_chorus_status"/>
                        </group>
                    </group>
                    <div class="oe_button_box" name="fr_buttons">
                        <button name="action_fr_validate" string="Check EN16931" type="object" class="oe_stat_button" icon="fa-check-square"/>
                        <button name="action_fr_generate_facturx" string="Factur-X XML" type="object" class="oe_stat_button" icon="fa-file-code-o"/>
                        <button name="action_fr_send_chorus" string="Send Chorus Pro" type="object" class="oe_stat_button" icon="fa-send"/>
                        <button name="action_fr_export_ereport_csv" string="E-Report CSV" type="object" class="oe_stat_button" icon="fa-download"/>
                    </div>
                    <field name="fr_ereport_line_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="flow"/>
                            <field name="amount_total"/>
                            <field name="status"/>
                            <field name="sent_on"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
