<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_fr_einvoicing" model="ir.ui.view">
        <field name="name">res.partner.form.fr.einvoicing</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group string="French E-Invoicing" name="fr_einvoicing">
                    <field name="fr_siren"/>
                    <field name="fr_siret"/>
                    <field name="fr_einvoicing_ready"/>
                    <field name="fr_einvoicing_issues"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
