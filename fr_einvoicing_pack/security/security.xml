<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_fr_einvoicing_user" model="res.groups">
        <field name="name">E-Invoicing User</field>
        <field name="comment">Read and process French e-invoicing documents and registers.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_fr_einvoicing_manager" model="res.groups">
        <field name="name">E-Invoicing Manager</field>
        <field name="comment">Full administration of French e-invoicing settings and registers.</field>
        <field name="implied_ids" eval="[(4, ref('fr_einvoicing_pack.group_fr_einvoicing_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
