<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_margin_project_list" model="ir.ui.view">
        <field name="name">margin.project.list</field>
        <field name="model">margin.project</field>
        <field name="arch" type="xml">
            <list string="Projects" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="manager_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="budget_revenue" sum="Total Budget Revenue"/>
                <field name="actual_revenue" sum="Total Actual Revenue"/>
                <field name="actual_margin" sum="Total Actual Margin"/>
                <field name="margin_rate"/>
                <field name="is_overrun" string="Over Budget" widget="boolean"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_margin_project_form" model="ir.ui.view">
        <field name="name">margin.project.form</field>
        <field name="model">margin.project</field>
        <field name="arch" type="xml">
            <form string="Projects">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'running'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'closed'"/>
                    <button name="action_recompute" type="object" string="Recompute Totals" class="btn-secondary" invisible="False"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Project">
    <field name="code"/>
    <field name="name"/>
    <field name="partner_id"/>
    <field name="project_id"/>
    <field name="manager_id"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Schedule">
    <field name="date_start"/>
    <field name="date_end"/>
    <field name="state"/>
                        </group>
                        <group string="Budget">
    <field name="currency_id"/>
    <field name="budget_revenue"/>
    <field name="budget_cost"/>
    <field name="budget_margin"/>
    <field name="alert_threshold"/>
                        </group>
                        <group string="Actuals">
    <field name="actual_revenue"/>
    <field name="actual_cost"/>
    <field name="actual_margin"/>
    <field name="margin_rate"/>
    <field name="cost_ratio"/>
    <field name="is_overrun"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost and Revenue" name="lineids">
                            <field name="line_ids" readonly="state == 'closed'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="date"/>
                            <field name="line_type"/>
                            <field name="category"/>
                            <field name="description"/>
                            <field name="partner_id" optional="show"/>
                            <field name="amount" sum="Total"/>
                            <field name="invoice_ref" optional="hide"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_margin_project_search" model="ir.ui.view">
        <field name="name">margin.project.search</field>
        <field name="model">margin.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="running" string="Running" domain="[('state','=','running')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <filter name="overrun" string="Over Budget" domain="[('is_overrun','=',True)]"/>
                <filter name="mine" string="My Projects" domain="[('manager_id','=',uid)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_manager" string="Manager" context="{'group_by': 'manager_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_margin_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">margin.project</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set the budget, record the cost and revenue lines, and watch the margin before the project ends.</p>
        </field>
    </record>

</odoo>
