<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_xero_record_list" model="ir.ui.view">
        <field name="name">xero.record.list</field>
        <field name="model">xero.record</field>
        <field name="arch" type="xml">
            <list string="Records" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="connection_id"/>
                <field name="external_ref"/>
                <field name="state" widget="badge"/>
                <field name="processed_at"/>
            </list>
        </field>
    </record>

    <record id="view_xero_record_form" model="ir.ui.view">
        <field name="name">xero.record.form</field>
        <field name="model">xero.record</field>
        <field name="arch" type="xml">
            <form string="Records">
                <header>
                    <button name="action_prepare" type="object" string="Prepare" class="btn-primary" invisible="state not in ('draft','error')"/>
                    <button name="action_run" type="object" string="Run" class="btn-primary" invisible="state not in ('ready','error')"/>
                    <button name="action_reset" type="object" string="Reset" class="btn-secondary" invisible="state == 'done'"/>
                    <button name="action_mark_error" type="object" string="Mark Error" class="btn-secondary" invisible="False"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,done,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Record">
    <field name="name"/>
    <field name="connection_id"/>
    <field name="external_ref"/>
                        </group>
                        <group string="Details">
    <field name="payload"/>
    <field name="processed_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Logs" name="logids">
                            <field name="log_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_xero_record_search" model="ir.ui.view">
        <field name="name">xero.record.search</field>
        <field name="model">xero.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="external_ref"/>
                <field name="connection_id"/>
                <filter name="state_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="state_error" string="Error" domain="[('state','=','error')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_connection" string="Connection" context="{'group_by': 'connection_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_xero_record" model="ir.actions.act_window">
        <field name="name">Records</field>
        <field name="res_model">xero.record</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first record.</p>
        </field>
    </record>

</odoo>
