<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_equipment_loan_item_list" model="ir.ui.view">
        <field name="name">equipment.loan.item.list</field>
        <field name="model">equipment.loan.item</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="name"/>
                <field name="ref"/>
                <field name="category"/>
                <field name="is_on_loan" widget="boolean"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_loan_item_form" model="ir.ui.view">
        <field name="name">equipment.loan.item.form</field>
        <field name="model">equipment.loan.item</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Equipment">
    <field name="name"/>
    <field name="ref"/>
    <field name="category"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Status">
    <field name="current_loan_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_loan_item_search" model="ir.ui.view">
        <field name="name">equipment.loan.item.search</field>
        <field name="model">equipment.loan.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ref"/>
                <field name="category"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_equipment_loan_item" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">equipment.loan.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Equipment and tools that can be loaned to employees.</p>
        </field>
    </record>

</odoo>
