    <record id="rule_churn_action_company" model="ir.rule">
        <field name="name">churn.action: own company only</field>
        <field name="model_id" ref="model_churn_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
