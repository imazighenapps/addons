<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_churn_signal_list" model="ir.ui.view">
        <field name="name">churn.signal.list</field>
        <field name="model">churn.signal</field>
        <field name="arch" type="xml">
            <list string="Churn Signals" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="last_order_date"/>
                <field name="days_silent"/>
                <field name="silence_threshold"/>
                <field name="is_at_risk"/>
                <field name="action_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_churn_signal_form" model="ir.ui.view">
        <field name="name">churn.signal.form</field>
        <field name="model">churn.signal</field>
        <field name="arch" type="xml">
            <form string="Churn Signals">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Customer">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Signal">
    <field name="last_order_date"/>
    <field name="silence_threshold"/>
    <field name="days_silent"/>
    <field name="is_at_risk"/>
    <field name="state"/>
    <field name="action_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Save Actions" name="actionids">
                            <field name="action_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_churn_signal_search" model="ir.ui.view">
        <field name="name">churn.signal.search</field>
        <field name="model">churn.signal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="at_risk" string="At Risk" domain="[('is_at_risk','=',True)]"/>
                <filter name="watching" string="Watching" domain="[('state','=','watching')]"/>
                <filter name="saved" string="Saved" domain="[('state','=','saved')]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_churn_signal_kanban" model="ir.ui.view">
        <field name="name">churn.signal.kanban</field>
        <field name="model">churn.signal</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="days_silent"/>
                <field name="is_at_risk"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="days_silent"/>
                        <field name="is_at_risk"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_churn_signal" model="ir.actions.act_window">
        <field name="name">Churn Signals</field>
        <field name="res_model">churn.signal</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Customers going quiet, ranked by silence so the save call happens before the loss.</p>
        </field>
    </record>

</odoo>
