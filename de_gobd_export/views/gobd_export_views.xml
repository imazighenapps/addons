<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_gobd_export_form" model="ir.ui.view">
            <field name="name">gobd.export.form</field>
            <field name="model">gobd.export</field>
            <field name="arch" type="xml">
                <form string="Export GoBD Allemagne">
                    <header>
                        <button name="action_generate" type="object"
                                string="Générer l'export GoBD"
                                class="btn-primary" invisible="state == 'generated'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Paramètres">
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="journal_ids" widget="many2many_tags"/>
                            </group>
                            <group string="Résultats">
                                <field name="file_name" readonly="1"/>
                                <field name="file_data" readonly="1" filename="file_name"/>
                                <field name="generated_at" readonly="1"/>
                                <field name="entry_count" readonly="1"/>
                                <field name="line_count" readonly="1"/>
                                <field name="total_debit" readonly="1"/>
                                <field name="total_credit" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <group string="Protocole de remise">
                            <field name="protocol_note" nolabel="1" readonly="1"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_gobd_export_list" model="ir.ui.view">
            <field name="name">gobd.export.list</field>
            <field name="model">gobd.export</field>
            <field name="arch" type="xml">
                <list decoration-success="state == 'generated'">
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="entry_count"/>
                    <field name="line_count"/>
                    <field name="generated_at"/>
                    <field name="state"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
