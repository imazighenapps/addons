<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_sale_plan_pay_company" model="ir.rule">
        <field name="name">sale.plan.pay: own company only</field>
        <field name="model_id" ref="model_sale_plan_pay"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_sale_plan_pay_line_company" model="ir.rule">
        <field name="name">sale.plan.pay.line: own company only</field>
        <field name="model_id" ref="model_sale_plan_pay_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
