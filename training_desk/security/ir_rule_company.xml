<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_training_session_company" model="ir.rule">
        <field name="name">training.session: own company only</field>
        <field name="model_id" ref="model_training_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_training_attendance_company" model="ir.rule">
        <field name="name">training.attendance: own company only</field>
        <field name="model_id" ref="model_training_attendance"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
