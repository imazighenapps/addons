<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_training_attendance_list" model="ir.ui.view">
        <field name="name">training.attendance.list</field>
        <field name="model">training.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance">
                <field name="session_id"/>
                <field name="employee_id"/>
                <field name="present"/>
                <field name="certificate_issued"/>
                <field name="certificate_date"/>
            </list>
        </field>
    </record>

    <record id="view_training_attendance_form" model="ir.ui.view">
        <field name="name">training.attendance.form</field>
        <field name="model">training.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Attendance">
    <field name="session_id"/>
    <field name="employee_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Status">
    <field name="present"/>
    <field name="certificate_issued"/>
    <field name="certificate_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_training_attendance_search" model="ir.ui.view">
        <field name="name">training.attendance.search</field>
        <field name="model">training.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="session_id"/>
                <field name="employee_id"/>
                <filter name="present" string="Present" domain="[('present','=',True)]"/>
                <filter name="certified" string="Certified" domain="[('certificate_issued','=',True)]"/>
                <separator/>
                <filter name="group_session" string="Session" context="{'group_by': 'session_id'}"/>
                <filter name="group_employee" string="Participant" context="{'group_by': 'employee_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_training_attendance_kanban" model="ir.ui.view">
        <field name="name">training.attendance.kanban</field>
        <field name="model">training.attendance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="session_id" sample="1">
                <field name="session_id"/>
                <field name="employee_id"/>
                <field name="present"/>
                <field name="certificate_issued"/>
                <templates>
                    <t t-name="card">
                        <field name="session_id" class="fw-bold"/>
                        <field name="employee_id"/>
                        <field name="present"/>
                        <field name="certificate_issued"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_training_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">training.attendance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record attendance and issue certificates to participants.</p>
        </field>
    </record>

</odoo>
