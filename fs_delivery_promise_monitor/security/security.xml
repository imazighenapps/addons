<odoo>
  <record id="rule_delivery_promise_company_sales" model="ir.rule">
    <field name="name">Delivery promise risk: sales company scope</field>
    <field name="model_id" ref="model_fs_delivery_promise_risk"/>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_delivery_promise_company_stock" model="ir.rule">
    <field name="name">Delivery promise risk: stock company scope</field>
    <field name="model_id" ref="model_fs_delivery_promise_risk"/>
    <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_delivery_promise_company_manager" model="ir.rule">
    <field name="name">Delivery promise risk manager: company scope</field>
    <field name="model_id" ref="model_fs_delivery_promise_risk"/>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_delivery_promise_config_company" model="ir.rule">
    <field name="name">Delivery promise configuration: company scope</field>
    <field name="model_id" ref="model_fs_delivery_promise_monitor_config"/>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
