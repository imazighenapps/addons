<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_price_shift_list" model="ir.ui.view">
        <field name="name">price.shift.list</field>
        <field name="model">price.shift</field>
        <field name="arch" type="xml">
            <list string="Price Changes" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="description"/>
                <field name="change_type"/>
                <field name="percent"/>
                <field name="effective_on"/>
                <field name="state"/>
                <field name="customer_count"/>
                <field name="applied_on" optional="hide"/>
                <field name="scope" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_price_shift_form" model="ir.ui.view">
        <field name="name">price.shift.form</field>
        <field name="model">price.shift</field>
        <field name="arch" type="xml">
            <form string="Price Changes">
                <header>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state not in ('draft', 'scheduled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,applied,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Change">
    <field name="name"/>
    <field name="description"/>
    <field name="change_type"/>
    <field name="percent"/>
    <field name="effective_on"/>
    <field name="company_id"/>
                        </group>
                        <group string="Scope">
    <field name="scope"/>
                        </group>
                        <group string="Follow Up">
    <field name="state"/>
    <field name="customer_count"/>
    <field name="applied_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customer Lines" name="lineids">
                            <field name="line_ids" readonly="state == 'applied'">
                        <list editable="bottom">
                            <field name="partner_id"/>
                            <field name="current_price" sum="Total Current"/>
                            <field name="new_price" sum="Total New"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_price_shift_search" model="ir.ui.view">
        <field name="name">price.shift.search</field>
        <field name="model">price.shift</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="scope"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="scheduled" string="Scheduled" domain="[('state','=','scheduled')]"/>
                <filter name="withcustomers" string="Ready To Apply" domain="[('state','=','scheduled'),('customer_count','&gt;',0)]"/>
                <filter name="applied" string="Applied" domain="[('state','=','applied')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <filter name="thisyear" string="Effective This Year" domain="[('effective_on','&gt;=','2026-01-01'),('effective_on','&lt;=','2026-12-31')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'change_type'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_price_shift_kanban" model="ir.ui.view">
        <field name="name">price.shift.kanban</field>
        <field name="model">price.shift</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="description"/>
                <field name="percent"/>
                <field name="effective_on"/>
                <field name="customer_count"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="description"/>
                        <field name="percent"/>
                        <field name="effective_on"/>
                        <field name="customer_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_price_shift" model="ir.actions.act_window">
        <field name="name">Price Changes</field>
        <field name="res_model">price.shift</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Decide the change once: type, percentage, effective date and one line per customer.</p>
        </field>
    </record>

</odoo>
