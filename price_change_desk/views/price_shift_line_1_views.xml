<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_price_shift_line_list" model="ir.ui.view">
        <field name="name">price.shift.line.list</field>
        <field name="model">price.shift.line</field>
        <field name="arch" type="xml">
            <list string="Customer Price Lines">
                <field name="partner_id"/>
                <field name="current_price"/>
                <field name="new_price"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_price_shift_line_form" model="ir.ui.view">
        <field name="name">price.shift.line.form</field>
        <field name="model">price.shift.line</field>
        <field name="arch" type="xml">
            <form string="Customer Price Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="shift_id"/>
    <field name="partner_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Prices">
    <field name="current_price"/>
    <field name="new_price"/>
    <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_price_shift_line_search" model="ir.ui.view">
        <field name="name">price.shift.line.search</field>
        <field name="model">price.shift.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="shift_id"/>
                <separator/>
                <filter name="group_shift" string="Price Change" context="{'group_by': 'shift_id'}"/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_price_shift_line_kanban" model="ir.ui.view">
        <field name="name">price.shift.line.kanban</field>
        <field name="model">price.shift.line</field>
        <field name="arch" type="xml">
            <kanban default_group_by="shift_id" sample="1">
                <field name="shift_id"/>
                <field name="partner_id"/>
                <field name="current_price"/>
                <field name="new_price"/>
                <templates>
                    <t t-name="card">
                        <field name="shift_id" class="fw-bold"/>
                        <field name="partner_id"/>
                        <field name="current_price"/>
                        <field name="new_price"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_price_shift_line" model="ir.actions.act_window">
        <field name="name">Customer Price Lines</field>
        <field name="res_model">price.shift.line</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every customer of every change: today's price and the computed one.</p>
        </field>
    </record>

</odoo>
