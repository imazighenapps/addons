<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_price_shift_company" model="ir.rule">
        <field name="name">price.shift: own company only</field>
        <field name="model_id" ref="model_price_shift"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_price_shift_line_company" model="ir.rule">
        <field name="name">price.shift.line: own company only</field>
        <field name="model_id" ref="model_price_shift_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
