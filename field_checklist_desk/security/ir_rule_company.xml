<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_field_checklist_entry_company" model="ir.rule">
        <field name="name">field_checklist.entry: own company only</field>
        <field name="model_id" ref="model_field_checklist_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_field_checklist_item_company" model="ir.rule">
        <field name="name">field_checklist.item: own company only</field>
        <field name="model_id" ref="model_field_checklist_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
