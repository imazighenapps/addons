<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pest_inspection_list" model="ir.ui.view">
        <field name="name">pest.inspection.list</field>
        <field name="model">pest.inspection</field>
        <field name="arch" type="xml">
            <list string="Inspections" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="inspection_date"/>
                <field name="name"/>
                <field name="station_id"/>
                <field name="contractor"/>
                <field name="result" widget="badge"/>
                <field name="finding_state" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_pest_inspection_form" model="ir.ui.view">
        <field name="name">pest.inspection.form</field>
        <field name="model">pest.inspection</field>
        <field name="arch" type="xml">
            <form string="Inspections">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Inspection">
    <field name="name"/>
    <field name="station_id"/>
    <field name="inspection_date"/>
    <field name="contractor"/>
    <field name="result"/>
                        </group>
                        <group string="Status">
    <field name="finding_state"/>
    <field name="state"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pest_inspection_search" model="ir.ui.view">
        <field name="name">pest.inspection.search</field>
        <field name="model">pest.inspection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="station_id"/>
                <field name="contractor"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="done" string="Confirmed" domain="[('state','=','done')]"/>
                <filter name="open" string="Open Findings" domain="[('finding_state','=','open')]"/>
                <filter name="activity" string="Activity Found" domain="[('result','=','activity')]"/>
                <separator/>
                <filter name="group_station" string="Station" context="{'group_by': 'station_id'}"/>
                <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
                <filter name="group_finding" string="Finding" context="{'group_by': 'finding_state'}"/>
            </search>
        </field>
    </record>

    <record id="action_pest_inspection" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">pest.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every inspection performed on every pest control station.</p>
        </field>
    </record>

</odoo>
