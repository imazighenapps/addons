<odoo>
    <record id="view_pest_category_list" model="ir.ui.view">
        <field name="name">pest.category.list</field>
        <field name="model">pest.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pest_category_form" model="ir.ui.view">
        <field name="name">pest.category.form</field>
        <field name="model">pest.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="company_id"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pest_type_list" model="ir.ui.view">
        <field name="name">pest.type.list</field>
        <field name="model">pest.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="risk_level"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pest_type_form" model="ir.ui.view">
        <field name="name">pest.type.form</field>
        <field name="model">pest.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category_id"/>
                        <field name="risk_level"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="company_id"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_treatment_method_list" model="ir.ui.view">
        <field name="name">pest.treatment.method.list</field>
        <field name="model">pest.treatment.method</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_treatment_method_form" model="ir.ui.view">
        <field name="name">pest.treatment.method.form</field>
        <field name="model">pest.treatment.method</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="company_id"/>
                    </group>
                    <field name="description"/>
                    <field name="instructions"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pest_categories" model="ir.actions.act_window">
        <field name="name">Pest Categories</field>
        <field name="res_model">pest.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_pest_types" model="ir.actions.act_window">
        <field name="name">Pests</field>
        <field name="res_model">pest.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_treatment_methods" model="ir.actions.act_window">
        <field name="name">Treatment Methods</field>
        <field name="res_model">pest.treatment.method</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
