<odoo>
    <record id="view_pest_anomaly_list" model="ir.ui.view">
        <field name="name">pest.anomaly.list</field>
        <field name="model">pest.anomaly</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="site_id"/>
                <field name="visit_id"/>
                <field name="control_point_id"/>
                <field name="severity"/>
                <field name="state"/>
                <field name="assigned_user_id"/>
                <field name="due_date"/>
                <field name="reservice_id"/>
            </list>
        </field>
    </record>

    <record id="view_pest_anomaly_form" model="ir.ui.view">
        <field name="name">pest.anomaly.form</field>
        <field name="model">pest.anomaly</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'open'"/>
                    <button name="action_create_reservice" type="object" string="Create Re-Service" class="oe_highlight" invisible="reservice_id or state == 'cancelled'"/>
                    <button name="action_done" type="object" string="Resolve" class="oe_highlight" invisible="state not in ('open', 'in_progress')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="visit_id"/>
                            <field name="inspection_id"/>
                            <field name="site_id"/>
                            <field name="zone_id"/>
                            <field name="control_point_id"/>
                            <field name="pest_id"/>
                        </group>
                        <group>
                            <field name="severity"/>
                            <field name="category"/>
                            <field name="assigned_user_id"/>
                            <field name="due_date"/>
                            <field name="detected_date"/>
                            <field name="closed_date"/>
                            <field name="reservice_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="corrective_action"/>
                        <field name="recommendation"/>
                    </group>
                    <field name="attachment_image" widget="image"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pest_anomalies" model="ir.actions.act_window">
        <field name="name">Anomalies</field>
        <field name="res_model">pest.anomaly</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
