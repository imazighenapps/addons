<odoo>
    <record id="view_pest_zone_list" model="ir.ui.view">
        <field name="name">pest.zone.list</field>
        <field name="model">pest.zone</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="site_id"/>
                <field name="zone_type"/>
                <field name="risk_level_id"/>
                <field name="surface"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pest_zone_form" model="ir.ui.view">
        <field name="name">pest.zone.form</field>
        <field name="model">pest.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="site_id"/>
                        <field name="zone_type"/>
                        <field name="risk_level_id"/>
                        <field name="surface"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pest_zones" model="ir.actions.act_window">
        <field name="name">Zones</field>
        <field name="res_model">pest.zone</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
