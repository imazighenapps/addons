<odoo>
    <record id="view_pest_site_list" model="ir.ui.view">
        <field name="name">pest.site.list</field>
        <field name="model">pest.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_type"/>
                <field name="risk_level_id"/>
                <field name="responsible_id"/>
                <field name="next_visit_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pest_site_form" model="ir.ui.view">
        <field name="name">pest.site.form</field>
        <field name="model">pest.site</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_view_visits" type="object" string="Visits" class="oe_highlight"/>
                    <button name="action_view_control_points" type="object" string="Control Points"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_visits" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                        <button name="action_view_reservices" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="open_reservice_count" widget="statinfo" string="Re-services"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="site_type"/>
                            <field name="risk_level_id"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="zip"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="latitude"/>
                        <field name="longitude"/>
                        <field name="last_visit_date"/>
                        <field name="next_visit_date"/>
                        <field name="company_id"/>
                    </group>
                    <notebook>
                        <page string="Zones">
                            <field name="zone_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="zone_type"/>
                                    <field name="risk_level_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Control Points">
                            <field name="control_point_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="zone_id"/>
                                    <field name="point_type"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Plans">
                            <field name="plan_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="frequency_type"/>
                                    <field name="frequency_number"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pest_sites" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">pest.site</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
