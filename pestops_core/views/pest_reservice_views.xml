<odoo>
    <record id="view_pest_reservice_list" model="ir.ui.view">
        <field name="name">pest.reservice.list</field>
        <field name="model">pest.reservice</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="origin_visit_id"/>
                <field name="site_id"/>
                <field name="date"/>
                <field name="reason"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_pest_reservice_form" model="ir.ui.view">
        <field name="name">pest.reservice.form</field>
        <field name="model">pest.reservice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Open" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start" class="oe_highlight" invisible="state != 'open'"/>
                    <button name="action_done" type="object" string="Done" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="origin_visit_id"/>
                        <field name="site_id"/>
                        <field name="requested_by"/>
                        <field name="date"/>
                        <field name="reason"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pest_reservices" model="ir.actions.act_window">
        <field name="name">Re-Services</field>
        <field name="res_model">pest.reservice</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
