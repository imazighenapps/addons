<odoo>
    <record id="view_pest_inspection_list" model="ir.ui.view">
        <field name="name">pest.inspection.list</field>
        <field name="model">pest.inspection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="visit_id"/>
                <field name="site_id"/>
                <field name="date"/>
                <field name="activity_level"/>
            </list>
        </field>
    </record>

    <record id="view_pest_inspection_form" model="ir.ui.view">
        <field name="name">pest.inspection.form</field>
        <field name="model">pest.inspection</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="visit_id"/>
                        <field name="site_id"/>
                        <field name="date"/>
                        <field name="technician_id"/>
                        <field name="activity_level"/>
                        <field name="action_required_count"/>
                        <field name="critical_count"/>
                    </group>
                    <field name="notes"/>
                    <field name="image_1920" widget="image"/>
                    <notebook>
                        <page string="Inspection Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="control_point_id"/>
                                    <field name="pest_id"/>
                                    <field name="activity_level"/>
                                    <field name="evidence"/>
                                    <field name="action_required"/>
                                    <field name="observation"/>
                                    <field name="recommended_action"/>
                                    <field name="anomaly_ids" widget="many2many_tags" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pest_inspections" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">pest.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
