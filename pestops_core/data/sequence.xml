        <field name="name">Pest Contract</field>
        <field name="code">pest.contract</field>
        <field name="prefix">CON/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_pest_site" model="ir.sequence">
        <field name="name">Pest Site</field>
        <field name="code">pest.site</field>
        <field name="prefix">SITE/</field>
        <field name="padding">5</field>
