<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_work_permit_list" model="ir.ui.view">
        <field name="name">work.permit.list</field>
        <field name="model">work.permit</field>
        <field name="arch" type="xml">
            <list string="Work Permits" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="start_on"/>
                <field name="name"/>
                <field name="contractor"/>
                <field name="area"/>
                <field name="work_type"/>
                <field name="end_on"/>
                <field name="is_active_now"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_work_permit_form" model="ir.ui.view">
        <field name="name">work.permit.form</field>
        <field name="model">work.permit</field>
        <field name="arch" type="xml">
            <form string="Work Permits">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Permit">
    <field name="name"/>
    <field name="contractor"/>
    <field name="area"/>
    <field name="work_type"/>
    <field name="company_id"/>
                        </group>
                        <group string="Validity">
    <field name="start_on"/>
    <field name="end_on"/>
    <field name="state"/>
    <field name="closed_on"/>
    <field name="is_active_now"/>
    <field name="is_expired"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_work_permit_search" model="ir.ui.view">
        <field name="name">work.permit.search</field>
        <field name="model">work.permit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contractor"/>
                <field name="area"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="authorised" string="Authorised" domain="[('state','=','authorised')]"/>
                <filter name="expired" string="Expired" domain="[('is_expired','=',True)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Work Type" context="{'group_by': 'work_type'}"/>
            </search>
        </field>
    </record>

    <record id="view_work_permit_kanban" model="ir.ui.view">
        <field name="name">work.permit.kanban</field>
        <field name="model">work.permit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="contractor"/>
                <field name="area"/>
                <field name="start_on"/>
                <field name="end_on"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="contractor"/>
                        <field name="area"/>
                        <field name="start_on"/>
                        <field name="end_on"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_work_permit" model="ir.actions.act_window">
        <field name="name">Work Permits</field>
        <field name="res_model">work.permit</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Contractor permits with validity and authorisation status.</p>
        </field>
    </record>

</odoo>
