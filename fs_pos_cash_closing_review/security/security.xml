<odoo>
  <record id="rule_pos_review_user_own_session" model="ir.rule"><field name="name">POS cash reviews: user's sessions</field><field name="model_id" ref="model_fs_pos_cash_review"/><field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/><field name="domain_force">[('company_id', 'in', company_ids), ('user_id', '=', user.id)]</field></record>
  <record id="rule_pos_review_manager_company" model="ir.rule"><field name="name">POS cash reviews managers: company scope</field><field name="model_id" ref="model_fs_pos_cash_review"/><field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_pos_review_line_user_own_session" model="ir.rule"><field name="name">POS cash review lines: user's sessions</field><field name="model_id" ref="model_fs_pos_cash_review_line"/><field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/><field name="domain_force">[('review_id.user_id', '=', user.id)]</field></record>
  <record id="rule_pos_review_line_manager_company" model="ir.rule"><field name="name">POS cash review lines managers: company scope</field><field name="model_id" ref="model_fs_pos_cash_review_line"/><field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_pos_review_config_company" model="ir.rule"><field name="name">POS cash review configuration: company scope</field><field name="model_id" ref="model_fs_pos_cash_review_config"/><field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>
