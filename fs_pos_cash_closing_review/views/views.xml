<odoo>
  <record id="view_fs_pos_cash_review_list" model="ir.ui.view">
    <field name="name">fs.pos.cash.review.list</field>
    <field name="model">fs.pos.cash.review</field>
    <field name="arch" type="xml">
      <list decoration-danger="state == 'rejected'" decoration-warning="state == 'reviewed'">
        <field name="session_id"/>
        <field name="user_id"/>
        <field name="state"/>
        <field name="total_difference"/>
        <field name="create_date"/>
      </list>
    </field>
  </record>
  <record id="view_fs_pos_cash_review_form" model="ir.ui.view">
    <field name="name">fs.pos.cash.review.form</field>
    <field name="model">fs.pos.cash.review</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_open_justification_wizard" type="object" string="Justify Variances" class="btn-secondary" invisible="state != 'draft' or locked"/>
          <button name="action_mark_reviewed" type="object" string="Mark Reviewed" invisible="state != 'draft' or locked"/>
          <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="point_of_sale.group_pos_manager" invisible="state == 'approved' or locked"/>
          <button name="action_reject" type="object" string="Reject" groups="point_of_sale.group_pos_manager" invisible="state in ('approved','rejected') or locked"/>
          <button name="action_open_session" type="object" string="Open Session"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,reviewed,approved,rejected"/>
          <field name="locked" invisible="1"/>
        </header>
        <sheet>
          <group>
            <field name="session_id"/>
            <field name="user_id"/>
            <field name="warning_amount"/>
            <field name="critical_amount"/>
            <field name="total_difference"/>
          </group>
          <field name="line_ids">
            <list editable="bottom" decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'">
              <field name="payment_method_id" readonly="1"/>
              <field name="expected_amount" readonly="1"/>
              <field name="actual_amount" readonly="1"/>
              <field name="difference" readonly="1"/>
              <field name="severity" readonly="1"/>
              <field name="reason"/>
            </list>
          </field>
          <field name="reason"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_fs_pos_cash_justification_wizard" model="ir.ui.view">
    <field name="name">fs.pos.cash.closing.justification.wizard.form</field>
    <field name="model">fs.pos.cash.closing.justification.wizard</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group><field name="review_id"/></group>
          <field name="line_ids">
            <list editable="bottom">
              <field name="payment_method_id" readonly="1"/>
              <field name="difference" readonly="1"/>
              <field name="reason"/>
            </list>
          </field>
          <footer>
            <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
            <button string="Cancel" special="cancel"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_fs_pos_cash_review_config_search" model="ir.ui.view"><field name="name">fs.pos.cash.review.config.search</field><field name="model">fs.pos.cash.review.config</field><field name="arch" type="xml"><search><field name="company_id"/></search></field></record>
  <record id="action_fs_pos_cash_review" model="ir.actions.act_window">
    <field name="name">POS Closing Reviews</field>
    <field name="res_model">fs.pos.cash.review</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="pos_session_view_form_fs_cash_review" model="ir.ui.view">
    <field name="name">pos.session.form.fs.cash.review</field>
    <field name="model">pos.session</field>
    <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_fs_review_cash_closing" type="object" string="Review Closing" class="btn-secondary" invisible="state not in ('closing_control', 'closed')"/>
      </xpath>
      <xpath expr="//sheet//div[@name='button_box']" position="inside">
        <button name="action_fs_review_cash_closing" type="object" class="oe_stat_button" icon="fa-balance-scale">
          <field name="fs_cash_review_count" widget="statinfo" string="Closing Reviews"/>
        </button>
      </xpath>
    </field>
  </record>
  <menuitem id="menu_fs_pos_cash_review_root" name="POS Closing Review" sequence="89" groups="point_of_sale.group_pos_user"/>
  <menuitem id="menu_fs_pos_cash_review" name="Reviews" parent="menu_fs_pos_cash_review_root" action="action_fs_pos_cash_review"/>
  <menuitem id="menu_fs_pos_cash_review_config_root" name="Configuration" parent="menu_fs_pos_cash_review_root" groups="point_of_sale.group_pos_manager" sequence="90"/>
  <record id="action_fs_pos_cash_review_config" model="ir.actions.act_window">
    <field name="name">Configuration</field>
    <field name="res_model">fs.pos.cash.review.config</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_fs_pos_cash_review_config" name="Thresholds" parent="menu_fs_pos_cash_review_config_root" action="action_fs_pos_cash_review_config"/>
  <record id="view_fs_pos_cash_review_config_list" model="ir.ui.view">
    <field name="name">fs.pos.cash.review.config.list</field>
    <field name="model">fs.pos.cash.review.config</field>
    <field name="arch" type="xml">
      <list>
        <field name="company_id"/>
        <field name="warning_amount"/>
        <field name="critical_amount"/>
        <field name="require_approval_before_close"/>
      </list>
    </field>
  </record>
  <record id="view_fs_pos_cash_review_config_form" model="ir.ui.view">
    <field name="name">fs.pos.cash.review.config.form</field>
    <field name="model">fs.pos.cash.review.config</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="company_id"/>
            <field name="warning_amount"/>
            <field name="critical_amount"/>
            <field name="require_approval_before_close"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
