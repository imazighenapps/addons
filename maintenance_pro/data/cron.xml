<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_maint_plan" model="ir.cron">
        <field name="name">MaintenancePro: generate preventive requests</field>
        <field name="model_id" ref="model_maint_plan"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_requests()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
