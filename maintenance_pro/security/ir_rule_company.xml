<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_maint_equipment_company" model="ir.rule">
        <field name="name">maint.equipment: own company only</field>
        <field name="model_id" ref="model_maint_equipment"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_maint_request_company" model="ir.rule">
        <field name="name">maint.request: own company only</field>
        <field name="model_id" ref="model_maint_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
