<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maint_plan_list" model="ir.ui.view">
        <field name="name">maint.plan.list</field>
        <field name="model">maint.plan</field>
        <field name="arch" type="xml">
            <list string="Preventive Plans" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="period_days"/>
                <field name="last_date"/>
                <field name="next_date"/>
                <field name="technician_id"/>
                <field name="request_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_maint_plan_form" model="ir.ui.view">
        <field name="name">maint.plan.form</field>
        <field name="model">maint.plan</field>
        <field name="arch" type="xml">
            <form string="Preventive Plans">
                <header>
                    <button name="action_pause" type="object" string="Pause" class="btn-secondary" invisible="state != 'active'"/>
                    <button name="action_resume" type="object" string="Resume" class="btn-primary" invisible="state != 'paused'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,paused"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Plan name"/></h1>
                    </div>
                    <group>
                        <group string="Plan">
    <field name="equipment_id"/>
    <field name="technician_id"/>
                        </group>
                        <group string="Schedule">
    <field name="period_days"/>
    <field name="last_date"/>
    <field name="next_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preventive Task" name="task">
                            <field name="task"/>
                        </page>
                        <page string="Requests" name="requestids">
                            <field name="request_ids" readonly="1"><list><field name="name"/><field name="type"/><field name="request_date"/><field name="scheduled_date"/><field name="done_date"/><field name="state" widget="badge"/></list></field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_maint_plan_search" model="ir.ui.view">
        <field name="name">maint.plan.search</field>
        <field name="model">maint.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_id"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="paused" string="Paused" domain="[('state','=','paused')]"/>
                <filter name="due" string="Due Now" domain="[('next_date','&lt;=',context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                <filter name="group_technician" string="Technician" context="{'group_by': 'technician_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_maint_plan" model="ir.actions.act_window">
        <field name="name">Preventive Plans</field>
        <field name="res_model">maint.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a period in days: the next due date and the work orders are generated for you.</p>
        </field>
    </record>

</odoo>
