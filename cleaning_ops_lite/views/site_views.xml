<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_csite_list" model="ir.ui.view">
        <field name="name">cleaning.site.list</field>
        <field name="model">cleaning.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="area"/>
                <field name="billing_mode"/>
                <field name="visit_count"/>
                <field name="last_visit_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_csite_form" model="ir.ui.view">
        <field name="name">cleaning.site.form</field>
        <field name="model">cleaning.site</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="address"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Site &amp; Pricing">
                            <field name="area"/>
                            <field name="area_uom_id"/>
                            <field name="billing_mode"/>
                            <field name="price_per_visit" invisible="billing_mode != 'visit'"/>
                            <field name="price_per_m2" invisible="billing_mode != 'area'"/>
                        </group>
                    </group>
                    <group>
                        <field name="agent_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Activity">
                        <field name="visit_count"/>
                        <field name="last_visit_date"/>
                    </group>
                    <field name="access_notes" placeholder="Keys, codes, alarm, site contact..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_csite" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">cleaning.site</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>