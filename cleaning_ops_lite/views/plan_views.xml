<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cplan_list" model="ir.ui.view">
        <field name="name">cleaning.plan.list</field>
        <field name="model">cleaning.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="site_id"/>
                <field name="frequency"/>
                <field name="next_date"/>
                <field name="agent_id"/>
                <field name="visits_done"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_cplan_form" model="ir.ui.view">
        <field name="name">cleaning.plan.form</field>
        <field name="model">cleaning.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_visit" string="New Visit" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Schedule">
                            <field name="site_id"/>
                            <field name="frequency"/>
                            <field name="weekday" invisible="frequency not in ('weekly','biweekly')"/>
                            <field name="next_date"/>
                            <field name="duration_hours"/>
                            <field name="active"/>
                        </group>
                        <group string="Assignment">
                            <field name="agent_id"/>
                            <field name="visits_done"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_cplan" model="ir.actions.act_window">
        <field name="name">Visit Plans</field>
        <field name="res_model">cleaning.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>