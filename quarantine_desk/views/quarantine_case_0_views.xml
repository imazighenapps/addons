<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quarantine_case_list" model="ir.ui.view">
        <field name="name">quarantine.case.list</field>
        <field name="model">quarantine.case</field>
        <field name="arch" type="xml">
            <list string="Quarantine Cases" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="quarantined_on"/>
                <field name="product_name"/>
                <field name="lot_name"/>
                <field name="location_name"/>
                <field name="quantity"/>
                <field name="reason"/>
                <field name="state" widget="badge"/>
                <field name="decision_date"/>
            </list>
        </field>
    </record>

    <record id="view_quarantine_case_form" model="ir.ui.view">
        <field name="name">quarantine.case.form</field>
        <field name="model">quarantine.case</field>
        <field name="arch" type="xml">
            <form string="Quarantine Cases">
                <header>
                    <button name="action_release" type="object" string="Release" class="btn-primary" invisible="state != 'quarantine'"/>
                    <button name="action_return" type="object" string="Return" class="btn-secondary" invisible="state != 'quarantine'"/>
                    <button name="action_scrap" type="object" string="Scrap" class="btn-secondary" invisible="state != 'quarantine'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" invisible="state == 'quarantine'"/>
                    <field name="state" widget="statusbar" statusbar_visible="quarantine,released,returned,scrapped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Case">
    <field name="name"/>
    <field name="quarantined_on"/>
    <field name="product_name"/>
    <field name="lot_name"/>
    <field name="quantity"/>
    <field name="location_name"/>
    <field name="reason"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Decision">
    <field name="state"/>
    <field name="decision_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Decision Note" name="decisionnote">
                            <field name="decision_note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_quarantine_case_search" model="ir.ui.view">
        <field name="name">quarantine.case.search</field>
        <field name="model">quarantine.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_name"/>
                <field name="lot_name"/>
                <field name="location_name"/>
                <filter name="in_quarantine" string="In Quarantine" domain="[('state','=','quarantine')]"/>
                <filter name="released" string="Released" domain="[('state','=','released')]"/>
                <filter name="returned" string="Returned" domain="[('state','=','returned')]"/>
                <filter name="scrapped" string="Scrapped" domain="[('state','=','scrapped')]"/>
                <separator/>
                <filter name="group_reason" string="Reason" context="{'group_by': 'reason'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_location" string="Location" context="{'group_by': 'location_name'}"/>
            </search>
        </field>
    </record>

    <record id="view_quarantine_case_kanban" model="ir.ui.view">
        <field name="name">quarantine.case.kanban</field>
        <field name="model">quarantine.case</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="product_name"/>
                <field name="location_name"/>
                <field name="quantity"/>
                <field name="reason"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="product_name"/>
                        <field name="location_name"/>
                        <field name="quantity"/>
                        <field name="reason"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_quarantine_case" model="ir.actions.act_window">
        <field name="name">Quarantine Cases</field>
        <field name="res_model">quarantine.case</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hold doubtful stock in one place and decide with a clear trail.</p>
        </field>
    </record>

</odoo>
