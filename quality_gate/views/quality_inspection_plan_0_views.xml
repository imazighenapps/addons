<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quality_inspection_plan_list" model="ir.ui.view">
        <field name="name">quality.inspection.plan.list</field>
        <field name="model">quality.inspection.plan</field>
        <field name="arch" type="xml">
            <list string="Inspection Plans" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="code"/>
                <field name="name"/>
                <field name="operation"/>
                <field name="product_id"/>
                <field name="product_category_id"/>
                <field name="point_count"/>
                <field name="state" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_quality_inspection_plan_form" model="ir.ui.view">
        <field name="name">quality.inspection.plan.form</field>
        <field name="model">quality.inspection.plan</field>
        <field name="arch" type="xml">
            <form string="Inspection Plans">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_pause" type="object" string="Pause" class="btn-secondary" invisible="state != 'running'"/>
                    <button name="action_resume" type="object" string="Resume" class="btn-primary" invisible="state != 'paused'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'paused'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,paused"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Plan">
    <field name="code"/>
    <field name="name"/>
    <field name="operation"/>
    <field name="company_id"/>
    <field name="active"/>
    <field name="state"/>
                        </group>
                        <group string="Scope">
    <field name="product_id"/>
    <field name="product_category_id"/>
                        </group>
                        <group string="Summary">
    <field name="point_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Control Points" name="pointids">
                            <field name="point_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="check_type"/>
                            <field name="min_value" optional="show"
                                   invisible="check_type not in ('measure', 'range')"/>
                            <field name="max_value" optional="show"
                                   invisible="check_type not in ('measure', 'range')"/>
                            <field name="uom_id" optional="show"
                                   invisible="check_type not in ('measure', 'range')"/>
                            <field name="required"/>
                            <field name="instruction" optional="hide"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_quality_inspection_plan_search" model="ir.ui.view">
        <field name="name">quality.inspection.plan.search</field>
        <field name="model">quality.inspection.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="product_id"/>
                <filter name="running" string="Running" domain="[('state','=','running')]"/>
                <filter name="paused" string="Paused" domain="[('state','=','paused')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_quality_inspection_plan" model="ir.actions.act_window">
        <field name="name">Inspection Plans</field>
        <field name="res_model">quality.inspection.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build a control plan once, then reuse it on every inspection.</p>
        </field>
    </record>

</odoo>
