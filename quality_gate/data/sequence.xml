<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_quality_inspection" model="ir.sequence">
        <field name="name">Quality Inspection</field>
        <field name="code">quality.inspection</field>
        <field name="prefix">QI/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_quality_issue" model="ir.sequence">
        <field name="name">Quality Non-Conformity</field>
        <field name="code">quality.issue</field>
        <field name="prefix">QN/%(year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>
