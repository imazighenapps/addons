<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_target_list" model="ir.ui.view">
        <field name="name">sales.target.list</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <list string="Sales Targets" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="user_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="target_amount"/>
                <field name="achieved_amount"/>
                <field name="progress"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_sales_target_form" model="ir.ui.view">
        <field name="name">sales.target.form</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <form string="Sales Targets">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Done" class="btn-primary" invisible="state != 'running'"/>
                    <button name="action_recompute" type="object" string="Recompute" class="btn-secondary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Owner">
    <field name="user_id"/>
    <field name="team_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Period">
    <field name="date_from"/>
    <field name="date_to"/>
                        </group>
                        <group string="Amounts">
    <field name="target_amount"/>
    <field name="achieved_amount"/>
    <field name="gap_amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Progress">
    <field name="progress"/>
    <field name="projected_amount"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sales_target_search" model="ir.ui.view">
        <field name="name">sales.target.search</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <filter name="running" string="Running" domain="[('state','=','running')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="under" string="Not achieved" domain="[('gap_amount','&gt;',0)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_owner" string="Salesperson" context="{'group_by': 'user_id'}"/>
                <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_sales_target_kanban" model="ir.ui.view">
        <field name="name">sales.target.kanban</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="progress"/>
                <field name="achieved_amount"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="progress"/>
                        <field name="achieved_amount"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sales_target_graph" model="ir.ui.view">
        <field name="name">sales.target.graph</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="user_id"/>
                <field name="target_amount" type="measure"/>
                <field name="achieved_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sales_target_pivot" model="ir.ui.view">
        <field name="name">sales.target.pivot</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="user_id" type="row"/>
                <field name="state" type="col"/>
                <field name="target_amount" type="measure"/>
                <field name="achieved_amount" type="measure"/>
                <field name="gap_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_sales_target" model="ir.actions.act_window">
        <field name="name">Sales Targets</field>
        <field name="res_model">sales.target</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">What every owner had to invoice and what is confirmed so far.</p>
        </field>
    </record>

</odoo>
