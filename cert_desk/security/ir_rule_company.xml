<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_cert_document_company" model="ir.rule">
        <field name="name">cert.document: own company only</field>
        <field name="model_id" ref="model_cert_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_cert_renewal_company" model="ir.rule">
        <field name="name">cert.renewal: own company only</field>
        <field name="model_id" ref="model_cert_renewal"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
