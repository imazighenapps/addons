<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dead_stock_scan_list" model="ir.ui.view">
        <field name="name">dead.stock.scan.list</field>
        <field name="model">dead.stock.scan</field>
        <field name="arch" type="xml">
            <list string="Scans" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="rule_id"/>
                <field name="date_ref"/>
                <field name="product_count"/>
                <field name="total_value" sum="Total Total Value"/>
                <field name="total_carrying" sum="Total Total Carrying"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_dead_stock_scan_form" model="ir.ui.view">
        <field name="name">dead.stock.scan.form</field>
        <field name="model">dead.stock.scan</field>
        <field name="arch" type="xml">
            <form string="Scans">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Scan">
    <field name="name"/>
    <field name="date_ref"/>
    <field name="rule_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Totals">
    <field name="product_count"/>
    <field name="total_value"/>
    <field name="total_carrying"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lineids">
                            <field name="line_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dead_stock_scan_search" model="ir.ui.view">
        <field name="name">dead.stock.scan.search</field>
        <field name="model">dead.stock.scan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_dead_stock_scan" model="ir.actions.act_window">
        <field name="name">Scans</field>
        <field name="res_model">dead.stock.scan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Each scan keeps a snapshot: compare the locked cash month after month.</p>
        </field>
    </record>

</odoo>
