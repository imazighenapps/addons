<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_clc_check_company" model="ir.rule">
        <field name="name">clc.check: own company only</field>
        <field name="model_id" ref="model_clc_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_clc_item_company" model="ir.rule">
        <field name="name">clc.item: own company only</field>
        <field name="model_id" ref="model_clc_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
