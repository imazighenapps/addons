<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_clc_check_list" model="ir.ui.view">
        <field name="name">clc.check.list</field>
        <field name="model">clc.check</field>
        <field name="arch" type="xml">
            <list string="Line Clearances" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="planned_on"/>
                <field name="line_area"/>
                <field name="outgoing_product"/>
                <field name="incoming_product"/>
                <field name="item_count"/>
                <field name="done_item_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_clc_check_form" model="ir.ui.view">
        <field name="name">clc.check.form</field>
        <field name="model">clc.check</field>
        <field name="arch" type="xml">
            <form string="Line Clearances">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Clearance">
    <field name="name"/>
    <field name="line_area"/>
    <field name="responsible_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Changeover">
    <field name="outgoing_product"/>
    <field name="incoming_product"/>
    <field name="planned_on"/>
    <field name="released_on"/>
    <field name="state"/>
                        </group>
                        <group string="Counters">
    <field name="item_count"/>
    <field name="done_item_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist" name="itemids">
                            <field name="item_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_clc_check_search" model="ir.ui.view">
        <field name="name">clc.check.search</field>
        <field name="model">clc.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="line_area"/>
                <field name="outgoing_product"/>
                <field name="incoming_product"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('draft', 'in_progress', 'ready'))]"/>
                <filter name="released" string="Released" domain="[('state', '=', 'released')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_area" string="Line / Area" context="{'group_by': 'line_area'}"/>
            </search>
        </field>
    </record>

    <record id="view_clc_check_kanban" model="ir.ui.view">
        <field name="name">clc.check.kanban</field>
        <field name="model">clc.check</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="line_area"/>
                <field name="planned_on"/>
                <field name="done_item_count"/>
                <field name="item_count"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="line_area"/>
                        <field name="planned_on"/>
                        <field name="done_item_count"/>
                        <field name="item_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_clc_check" model="ir.actions.act_window">
        <field name="name">Line Clearances</field>
        <field name="res_model">clc.check</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Document every changeover before the line restarts.</p>
        </field>
    </record>

</odoo>
