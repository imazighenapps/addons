<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="view_escrow_deposit_desk_form" model="ir.ui.view">
  <field name="name">escrow.deposit.desk.form</field><field name="model">escrow.deposit.desk</field>
  <field name="arch" type="xml"><form string="Compte séquestre">
    <header>
      <button name="action_hold" type="object" string="Séquestrer" class="btn-primary" invisible="state!='draft'"/>
      <button name="action_release_all" type="object" string="Libérer totalement" invisible="state not in ('held','partial')"/>
      <button name="action_cancel" type="object" string="Annuler" invisible="state in ('released','cancelled')"/>
      <field name="state" widget="statusbar" statusbar_visible="draft,held,released"/>
    </header>
    <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group>
        <field name="company_id" groups="base.group_multi_company"/><field name="partner_id"/>
        <field name="amount"/><field name="released_amount"/><field name="remaining_amount"/>
        <field name="currency_id" invisible="1"/>
      </group><group>
        <field name="condition_text"/>
      </group></group>
      <group string="Notes / justificatifs"><field name="notes" nolabel="1"/></group>
    </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
  </form></field>
</record>
<record id="view_escrow_deposit_desk_list" model="ir.ui.view">
  <field name="name">escrow.deposit.desk.list</field><field name="model">escrow.deposit.desk</field>
  <field name="arch" type="xml"><list decoration-success="state=='released'">
    <field name="name"/><field name="partner_id"/><field name="amount"/><field name="released_amount"/><field name="remaining_amount"/><field name="state"/>
  </list></field>
</record>
</data></odoo>
