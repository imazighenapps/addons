<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_water_temperature_log_list" model="ir.ui.view">
        <field name="name">water.temperature.log.list</field>
        <field name="model">water.temperature.log</field>
        <field name="arch" type="xml">
            <list string="Temperature Readings" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="point_name"/>
                <field name="point_type"/>
                <field name="reading_date"/>
                <field name="temperature_c"/>
                <field name="target_min_c"/>
                <field name="target_max_c"/>
                <field name="state" widget="badge"/>
                <field name="within_range"/>
            </list>
        </field>
    </record>

    <record id="view_water_temperature_log_form" model="ir.ui.view">
        <field name="name">water.temperature.log.form</field>
        <field name="model">water.temperature.log</field>
        <field name="arch" type="xml">
            <form string="Temperature Readings">
                <header>
                    <button name="action_record" type="object" string="Record" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_resolve" type="object" string="Mark Resolved" class="btn-primary" invisible="state != 'alert'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,recorded,alert,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Point">
    <field name="name"/>
    <field name="point_name"/>
    <field name="point_type"/>
    <field name="reading_date"/>
    <field name="reader_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Reading">
    <field name="temperature_c"/>
    <field name="target_min_c"/>
    <field name="target_max_c"/>
    <field name="within_range"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_water_temperature_log_search" model="ir.ui.view">
        <field name="name">water.temperature.log.search</field>
        <field name="model">water.temperature.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="point_name"/>
                <field name="reader_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="recorded" string="Recorded" domain="[('state','=','recorded')]"/>
                <filter name="alert" string="Alert" domain="[('state','=','alert')]"/>
                <filter name="out_of_range" string="Out of Range" domain="[('within_range','=',False)]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_point_type" string="Point Type" context="{'group_by': 'point_type'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_water_temperature_log_graph" model="ir.ui.view">
        <field name="name">water.temperature.log.graph</field>
        <field name="model">water.temperature.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_water_temperature_log" model="ir.actions.act_window">
        <field name="name">Temperature Readings</field>
        <field name="res_model">water.temperature.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track water temperatures against target ranges.</p>
        </field>
    </record>

</odoo>
