<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_timesheet_approve_entry_company" model="ir.rule">
        <field name="name">timesheet_approve.entry: own company only</field>
        <field name="model_id" ref="model_timesheet_approve_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_timesheet_approve_item_company" model="ir.rule">
        <field name="name">timesheet_approve.item: own company only</field>
        <field name="model_id" ref="model_timesheet_approve_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
