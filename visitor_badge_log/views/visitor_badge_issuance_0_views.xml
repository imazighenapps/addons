<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_visitor_badge_issuance_list" model="ir.ui.view">
        <field name="name">visitor.badge.issuance.list</field>
        <field name="model">visitor.badge.issuance</field>
        <field name="arch" type="xml">
            <list string="Badge Issuances" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="badge_id"/>
                <field name="visitor_name"/>
                <field name="visitor_company"/>
                <field name="host_id"/>
                <field name="issue_time"/>
                <field name="return_time"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_visitor_badge_issuance_form" model="ir.ui.view">
        <field name="name">visitor.badge.issuance.form</field>
        <field name="model">visitor.badge.issuance</field>
        <field name="arch" type="xml">
            <form string="Badge Issuances">
                <header>
                    <button name="action_return" type="object" string="Mark Returned" class="btn-primary" invisible="state != 'issued'"/>
                    <button name="action_lost" type="object" string="Mark Lost" class="btn-secondary" invisible="state != 'issued'"/>
                    <button name="action_reset" type="object" string="Reset to Issued" class="btn-link" invisible="state == 'issued'"/>
                    <field name="state" widget="statusbar" statusbar_visible="issued,returned,lost"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Issuance">
    <field name="name"/>
    <field name="badge_id"/>
    <field name="visitor_name"/>
    <field name="visitor_company"/>
    <field name="host_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Times">
    <field name="issue_time"/>
    <field name="return_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_visitor_badge_issuance_search" model="ir.ui.view">
        <field name="name">visitor.badge.issuance.search</field>
        <field name="model">visitor.badge.issuance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="badge_id"/>
                <field name="visitor_name"/>
                <field name="visitor_company"/>
                <field name="host_id"/>
                <filter name="issued" string="Issued" domain="[('state','=','issued')]"/>
                <filter name="returned" string="Returned" domain="[('state','=','returned')]"/>
                <filter name="lost" string="Lost" domain="[('state','=','lost')]"/>
                <separator/>
                <filter name="group_badge" string="Badge" context="{'group_by': 'badge_id'}"/>
                <filter name="group_host" string="Host" context="{'group_by': 'host_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_visitor_badge_issuance" model="ir.actions.act_window">
        <field name="name">Badge Issuances</field>
        <field name="res_model">visitor.badge.issuance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log visitor badge issuance and returns.</p>
        </field>
    </record>

</odoo>
