<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_visitor_badge_company" model="ir.rule">
        <field name="name">visitor.badge: own company only</field>
        <field name="model_id" ref="model_visitor_badge"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_visitor_badge_issuance_company" model="ir.rule">
        <field name="name">visitor.badge.issuance: own company only</field>
        <field name="model_id" ref="model_visitor_badge_issuance"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
