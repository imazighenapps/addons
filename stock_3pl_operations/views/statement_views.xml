<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_3pl_statement_list" model="ir.ui.view">
        <field name="name">stock.3pl.statement.list</field>
        <field name="model">stock.3pl.statement</field>
        <field name="arch" type="xml">
            <list string="3PL Statements">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="total_qty_closing"/>
                <field name="total_amount"/>
                <field name="state" widget="badge" decoration-success="state=='invoiced'" decoration-info="state in ('draft','confirmed')"/>
            </list>
        </field>
    </record>

    <record id="view_stock_3pl_statement_form" model="ir.ui.view">
        <field name="name">stock.3pl.statement.form</field>
        <field name="model">stock.3pl.statement</field>
        <field name="arch" type="xml">
            <form string="3PL Stock Statement">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="state not in ('confirmed','invoiced') or invoice_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','confirmed')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="warehouse_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Totals">
                        <group>
                            <field name="total_qty_opening"/>
                            <field name="total_qty_in"/>
                        </group>
                        <group>
                            <field name="total_qty_out"/>
                            <field name="total_qty_closing"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stock Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="opening_qty"/>
                                    <field name="in_qty"/>
                                    <field name="out_qty"/>
                                    <field name="closing_qty" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Billing Lines">
                            <field name="charge_line_ids">
                                <list editable="bottom">
                                    <field name="service_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="amount" readonly="1" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="note"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_stock_3pl_statement" model="ir.actions.act_window">
        <field name="name">3PL Statements</field>
        <field name="res_model">stock.3pl.statement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
