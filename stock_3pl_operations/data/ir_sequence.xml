<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_stock_3pl_contract" model="ir.sequence">
        <field name="name">3PL Contract</field>
        <field name="code">stock.3pl.contract</field>
        <field name="prefix">3PL/C/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_stock_3pl_statement" model="ir.sequence">
        <field name="name">3PL Statement</field>
        <field name="code">stock.3pl.statement</field>
        <field name="prefix">3PL/S/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
