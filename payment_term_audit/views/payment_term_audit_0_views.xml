<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_term_audit_list" model="ir.ui.view">
        <field name="name">payment.term.audit.list</field>
        <field name="model">payment.term.audit</field>
        <field name="arch" type="xml">
            <list string="Payment Term Audits" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="checked_count"/>
                <field name="tolerance"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_payment_term_audit_form" model="ir.ui.view">
        <field name="name">payment.term.audit.form</field>
        <field name="model">payment.term.audit</field>
        <field name="arch" type="xml">
            <form string="Payment Term Audits">
                <header>
                    <button name="action_run" type="object" string="Run" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_reset" type="object" string="Reset" class="btn-secondary" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Period">
    <field name="date_from"/>
    <field name="date_to"/>
    <field name="tolerance"/>
    <field name="company_id"/>
                        </group>
                        <group string="Result">
    <field name="state"/>
    <field name="checked_count"/>
    <field name="anomaly_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Anomalies" name="lineids">
                            <field name="line_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_payment_term_audit_search" model="ir.ui.view">
        <field name="name">payment.term.audit.search</field>
        <field name="model">payment.term.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_payment_term_audit" model="ir.actions.act_window">
        <field name="name">Payment Term Audits</field>
        <field name="res_model">payment.term.audit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Compare the contract terms with the due dates invoiced over a period.</p>
        </field>
    </record>

</odoo>
