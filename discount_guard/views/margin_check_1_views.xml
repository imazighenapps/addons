<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_margin_check_list" model="ir.ui.view">
        <field name="name">margin.check.list</field>
        <field name="model">margin.check</field>
        <field name="arch" type="xml">
            <list string="Discount Checks" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="checked_on"/>
                <field name="reference"/>
                <field name="rule_id"/>
                <field name="requested_discount"/>
                <field name="requested_margin"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_margin_check_form" model="ir.ui.view">
        <field name="name">margin.check.form</field>
        <field name="model">margin.check</field>
        <field name="arch" type="xml">
            <form string="Discount Checks">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Context">
    <field name="name"/>
    <field name="reference"/>
    <field name="rule_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Requested">
    <field name="requested_discount"/>
    <field name="requested_margin"/>
    <field name="checked_on"/>
                        </group>
                        <group string="Decision">
    <field name="state"/>
    <field name="decided_by"/>
    <field name="decided_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_margin_check_search" model="ir.ui.view">
        <field name="name">margin.check.search</field>
        <field name="model">margin.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="rule_id"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_margin_check_kanban" model="ir.ui.view">
        <field name="name">margin.check.kanban</field>
        <field name="model">margin.check</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="reference"/>
                <field name="rule_id"/>
                <field name="requested_discount"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="reference"/>
                        <field name="rule_id"/>
                        <field name="requested_discount"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_margin_check" model="ir.actions.act_window">
        <field name="name">Discount Checks</field>
        <field name="res_model">margin.check</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every collision with a floor: what was requested, what the rule allows and the decision.</p>
        </field>
    </record>

</odoo>
