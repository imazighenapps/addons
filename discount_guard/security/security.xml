<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_discountguar_user" model="res.groups">
        <field name="name">Discount Guard User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_discountguar_manager" model="res.groups">
        <field name="name">Discount Guard Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('discount_guard.group_discountguar_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
