<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_stock_reserve_entry_company" model="ir.rule">
        <field name="name">stock_reserve.entry: own company only</field>
        <field name="model_id" ref="model_stock_reserve_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_stock_reserve_item_company" model="ir.rule">
        <field name="name">stock_reserve.item: own company only</field>
        <field name="model_id" ref="model_stock_reserve_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
