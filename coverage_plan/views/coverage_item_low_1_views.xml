<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_coverage_item_low_list" model="ir.ui.view">
        <field name="name">coverage.item.list</field>
        <field name="model">coverage.item</field>
        <field name="arch" type="xml">
            <list string="Below Minimum" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="on_hand_qty"/>
                <field name="daily_demand"/>
                <field name="coverage_days"/>
                <field name="min_days"/>
                <field name="planned_qty"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_coverage_item_low_form" model="ir.ui.view">
        <field name="name">coverage.item.form</field>
        <field name="model">coverage.item</field>
        <field name="arch" type="xml">
            <form string="Below Minimum">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Product">
    <field name="name"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Coverage">
    <field name="on_hand_qty"/>
    <field name="daily_demand"/>
    <field name="min_days"/>
    <field name="coverage_days"/>
    <field name="below_minimum"/>
                        </group>
                        <group string="Planning">
    <field name="planned_qty"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_coverage_item_low_search" model="ir.ui.view">
        <field name="name">coverage.item.search</field>
        <field name="model">coverage.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_coverage_item_low" model="ir.actions.act_window">
        <field name="name">Below Minimum</field>
        <field name="res_model">coverage.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Products whose stock covers fewer days than the minimum target.</p>
        </field>
    </record>

</odoo>
