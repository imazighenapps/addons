<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_volunteer_hours_list" model="ir.ui.view">
        <field name="name">volunteer.hours.list</field>
        <field name="model">volunteer.hours</field>
        <field name="arch" type="xml">
            <list string="Volunteer Hours" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="volunteer_id"/>
                <field name="activity"/>
                <field name="hours" sum="Total Hours"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_volunteer_hours_form" model="ir.ui.view">
        <field name="name">volunteer.hours.form</field>
        <field name="model">volunteer.hours</field>
        <field name="arch" type="xml">
            <form string="Volunteer Hours">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Entry">
    <field name="name"/>
    <field name="volunteer_id"/>
    <field name="date"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Work">
    <field name="activity"/>
    <field name="hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_volunteer_hours_search" model="ir.ui.view">
        <field name="name">volunteer.hours.search</field>
        <field name="model">volunteer.hours</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="volunteer_id"/>
                <field name="activity"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="validated" string="Validated" domain="[('state','=','validated')]"/>
                <separator/>
                <filter name="group_volunteer" string="Volunteer" context="{'group_by': 'volunteer_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_volunteer_hours" model="ir.actions.act_window">
        <field name="name">Volunteer Hours</field>
        <field name="res_model">volunteer.hours</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log and validate volunteer hours.</p>
        </field>
    </record>

</odoo>
