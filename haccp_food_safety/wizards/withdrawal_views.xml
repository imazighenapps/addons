<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_haccp_withdrawal_form" model="ir.ui.view">
        <field name="name">haccp.withdrawal.form</field>
        <field name="model">haccp.withdrawal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="lot_ids" widget="many2many_tags"/>
                    <field name="customers_text"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_haccp_withdrawal" model="ir.actions.act_window">
        <field name="name">Withdrawal Assistant</field>
        <field name="res_model">haccp.withdrawal</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
