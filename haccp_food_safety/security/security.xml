<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_haccp_user" model="res.groups">
        <field name="name">HACCP User</field>
        <field name="comment">Take readings and manage non-conformities.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_haccp_manager" model="res.groups">
        <field name="name">HACCP Manager</field>
        <field name="comment">Configure plans, CCPs and thresholds.</field>
        <field name="implied_ids" eval="[(4, ref('haccp_food_safety.group_haccp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
