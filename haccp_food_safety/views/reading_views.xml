<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_haccp_reading_list" model="ir.ui.view">
        <field name="name">haccp.reading.list</field>
        <field name="model">haccp.reading</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="ccp_id"/>
                <field name="value"/>
                <field name="result" widget="badge" decoration-success="result == 'ok'" decoration-danger="result == 'ko'"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="view_haccp_reading_form" model="ir.ui.view">
        <field name="name">haccp.reading.form</field>
        <field name="model">haccp.reading</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_nc" string="Create Non-Conformity" type="object"/>
                </header>
                <sheet>
                    <group>
                        <field name="ccp_id"/>
                        <field name="date"/>
                        <field name="value"/>
                        <field name="result"/>
                        <field name="user_id"/>
                        <field name="equipment_ref"/>
                        <field name="lot_id"/>
                        <field name="picking_id"/>
                        <field name="company_id"/>
                        <field name="nc_id"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_haccp_reading" model="ir.actions.act_window">
        <field name="name">Readings</field>
        <field name="res_model">haccp.reading</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
