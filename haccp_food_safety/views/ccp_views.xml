<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_haccp_ccp_list" model="ir.ui.view">
        <field name="name">haccp.ccp.list</field>
        <field name="model">haccp.ccp</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="hazard_type"/>
                <field name="reading_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_haccp_ccp_form" model="ir.ui.view">
        <field name="name">haccp.ccp.form</field>
        <field name="model">haccp.ccp</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="CCP">
                            <field name="code"/>
                            <field name="plan_id"/>
                            <field name="step"/>
                            <field name="hazard_type"/>
                            <field name="critical"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Limits">
                            <field name="limit_min"/>
                            <field name="limit_max"/>
                            <field name="target"/>
                            <field name="uom_id"/>
                            <field name="frequency"/>
                            <field name="method"/>
                            <field name="equipment_ref"/>
                        </group>
                    </group>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="location_ids" widget="many2many_tags"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_haccp_ccp" model="ir.actions.act_window">
        <field name="name">Critical Control Points</field>
        <field name="res_model">haccp.ccp</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
