<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_alert_request_list" model="ir.ui.view">
        <field name="name">stock.alert.request.list</field>
        <field name="model">stock.alert.request</field>
        <field name="arch" type="xml">
            <list string="Stock Alerts" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="product_id"/>
                <field name="email"/>
                <field name="create_date"/>
                <field name="consent_date"/>
                <field name="source"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_stock_alert_request_form" model="ir.ui.view">
        <field name="name">stock.alert.request.form</field>
        <field name="model">stock.alert.request</field>
        <field name="arch" type="xml">
            <form string="Stock Alerts">
                <header>
                    <button name="action_notify" type="object" string="Notify Now" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state != 'pending'"/>
                    <button name="action_reset" type="object" string="Reset" class="btn-link" invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,notified,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Request">
    <field name="product_id"/>
    <field name="email"/>
    <field name="partner_id"/>
    <field name="source"/>
    <field name="consent_date"/>
    <field name="notified_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_stock_alert_request_search" model="ir.ui.view">
        <field name="name">stock.alert.request.search</field>
        <field name="model">stock.alert.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="email"/>
                <field name="product_id"/>
                <filter name="pending" string="Waiting" domain="[('state','=','pending')]"/>
                <filter name="notified" string="Notified" domain="[('state','=','notified')]"/>
                <separator/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_stock_alert_request" model="ir.actions.act_window">
        <field name="name">Stock Alerts</field>
        <field name="res_model">stock.alert.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Customers waiting for a product to come back.</p>
        </field>
    </record>

</odoo>
