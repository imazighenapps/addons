#. module: back_in_stock_pro
#: model:mail.template,body_html:back_in_stock_pro.mail_template_stock_alert
msgid "<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;\">\n                <p>Hello,</p>\n                <p>Good news: <strong>${object.product_id.name}</strong>\n                   is back in stock.</p>\n                <p>Order it before it runs out again.</p>\n                <p style=\"color:#888;font-size:12px;\">\n                   You received this email because you asked to be notified.\n                   Reply STOP to unsubscribe.</p>\n            </div>\n        "
msgstr "<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;\"> \n<p>Honjour, </p> \n<p>Bonne nouvelle : <strong>${object.product_id.name}</strong> \nest de nouveau en stock.</p> \n<p>Commandez-le avant qu'il ne soit à nouveau épuisé.</p> \n<p style=\"color:#888;font-size:12px;\"> \nVous avez reçu cet e-mail car vous avez demandé à être averti. \nRépondez STOP pour vous désinscrire.</p> \n</div>"

