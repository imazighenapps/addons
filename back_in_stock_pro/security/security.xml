<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_backinstockp_user" model="res.groups">
        <field name="name">Back In Stock Pro User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_backinstockp_manager" model="res.groups">
        <field name="name">Back In Stock Pro Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('back_in_stock_pro.group_backinstockp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
