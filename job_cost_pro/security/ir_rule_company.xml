<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_job_cost_company" model="ir.rule">
        <field name="name">job.cost: own company only</field>
        <field name="model_id" ref="model_job_cost"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_job_cost_line_company" model="ir.rule">
        <field name="name">job.cost.line: own company only</field>
        <field name="model_id" ref="model_job_cost_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
