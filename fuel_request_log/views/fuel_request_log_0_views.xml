<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fuel_request_log_list" model="ir.ui.view">
        <field name="name">fuel.request.log.list</field>
        <field name="model">fuel.request.log</field>
        <field name="arch" type="xml">
            <list string="Fuel Requests" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="requester_id"/>
                <field name="request_date"/>
                <field name="amount"/>
                <field name="approver_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fuel_request_log_form" model="ir.ui.view">
        <field name="name">fuel.request.log.form</field>
        <field name="model">fuel.request.log</field>
        <field name="arch" type="xml">
            <form string="Fuel Requests">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state != 'submitted'"/>
                    <button name="action_fulfill" type="object" string="Mark Fulfilled" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state not in ('rejected', 'fulfilled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,fulfilled,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Request">
    <field name="name"/>
    <field name="vehicle_id"/>
    <field name="requester_id"/>
    <field name="request_date"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amount">
    <field name="amount"/>
    <field name="currency_id"/>
    <field name="approver_id"/>
    <field name="user_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Purpose / Notes" name="purpose">
                            <field name="purpose"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fuel_request_log_search" model="ir.ui.view">
        <field name="name">fuel.request.log.search</field>
        <field name="model">fuel.request.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="requester_id"/>
                <field name="approver_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="fulfilled" string="Fulfilled" domain="[('state','=','fulfilled')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                <filter name="group_requester" string="Requester" context="{'group_by': 'requester_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_fuel_request_log_graph" model="ir.ui.view">
        <field name="name">fuel.request.log.graph</field>
        <field name="model">fuel.request.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_fuel_request_log" model="ir.actions.act_window">
        <field name="name">Fuel Requests</field>
        <field name="res_model">fuel.request.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record and track fuel requests.</p>
        </field>
    </record>

</odoo>
