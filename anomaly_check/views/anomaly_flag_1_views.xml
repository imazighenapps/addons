<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_anomaly_flag_list" model="ir.ui.view">
        <field name="name">anomaly.flag.list</field>
        <field name="model">anomaly.flag</field>
        <field name="arch" type="xml">
            <list string="Flagged Checks" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="flag_date"/>
                <field name="document_ref"/>
                <field name="partner_name"/>
                <field name="rule_id"/>
                <field name="quantity"/>
                <field name="tax_amount"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_anomaly_flag_form" model="ir.ui.view">
        <field name="name">anomaly.flag.form</field>
        <field name="model">anomaly.flag</field>
        <field name="arch" type="xml">
            <form string="Flagged Checks">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="document_ref" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Check">
    <field name="name"/>
    <field name="document_ref"/>
    <field name="partner_name"/>
    <field name="rule_id"/>
    <field name="flag_date"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amounts">
    <field name="quantity"/>
    <field name="tax_amount"/>
    <field name="total_amount"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason" name="reason">
                            <field name="reason"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_anomaly_flag_search" model="ir.ui.view">
        <field name="name">anomaly.flag.search</field>
        <field name="model">anomaly.flag</field>
        <field name="arch" type="xml">
            <search>
                <field name="document_ref"/>
                <field name="partner_name"/>
                <field name="name"/>
                <filter name="open" string="Open" domain="[('state','in',('new','confirmed'))]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="resolved" string="Resolved" domain="[('state','=','resolved')]"/>
                <separator/>
                <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_anomaly_flag_kanban" model="ir.ui.view">
        <field name="name">anomaly.flag.kanban</field>
        <field name="model">anomaly.flag</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="document_ref"/>
                <field name="partner_name"/>
                <field name="rule_id"/>
                <field name="flag_date"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="document_ref"/>
                        <field name="partner_name"/>
                        <field name="rule_id"/>
                        <field name="flag_date"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_anomaly_flag" model="ir.actions.act_window">
        <field name="name">Flagged Checks</field>
        <field name="res_model">anomaly.flag</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Review the bills that triggered an anomaly rule.</p>
        </field>
    </record>

</odoo>
