<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_anomaly_rule_list" model="ir.ui.view">
        <field name="name">anomaly.rule.list</field>
        <field name="model">anomaly.rule</field>
        <field name="arch" type="xml">
            <list string="Anomaly Rules">
                <field name="name"/>
                <field name="rule_type"/>
                <field name="severity"/>
                <field name="tolerance"/>
                <field name="flag_count"/>
                <field name="open_flag_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_anomaly_rule_form" model="ir.ui.view">
        <field name="name">anomaly.rule.form</field>
        <field name="model">anomaly.rule</field>
        <field name="arch" type="xml">
            <form string="Anomaly Rules">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Rule">
    <field name="name"/>
    <field name="rule_type"/>
    <field name="severity"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Control">
    <field name="tolerance"/>
                        </group>
                        <group string="Counters">
    <field name="flag_count"/>
    <field name="open_flag_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_anomaly_rule_search" model="ir.ui.view">
        <field name="name">anomaly.rule.search</field>
        <field name="model">anomaly.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="rule_type"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_type" string="Type" context="{'group_by': 'rule_type'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
            </search>
        </field>
    </record>

    <record id="view_anomaly_rule_kanban" model="ir.ui.view">
        <field name="name">anomaly.rule.kanban</field>
        <field name="model">anomaly.rule</field>
        <field name="arch" type="xml">
            <kanban default_group_by="severity" sample="1">
                <field name="severity"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="open_flag_count"/>
                <templates>
                    <t t-name="card">
                        <field name="severity" class="fw-bold"/>
                        <field name="name"/>
                        <field name="rule_type"/>
                        <field name="open_flag_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_anomaly_rule" model="ir.actions.act_window">
        <field name="name">Anomaly Rules</field>
        <field name="res_model">anomaly.rule</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the controls that catch impossible bills before posting.</p>
        </field>
    </record>

</odoo>
