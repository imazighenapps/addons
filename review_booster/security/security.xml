<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_review_user" model="res.groups">
        <field name="name">Review Booster User</field>
        <field name="comment">Follow review requests.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_review_manager" model="res.groups">
        <field name="name">Review Booster Manager</field>
        <field name="comment">Configure campaigns and send requests.</field>
        <field name="implied_ids" eval="[(4, ref('review_booster.group_review_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
