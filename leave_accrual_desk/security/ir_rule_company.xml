<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_leave_accrual_entry_company" model="ir.rule">
        <field name="name">leave_accrual.entry: own company only</field>
        <field name="model_id" ref="model_leave_accrual_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_leave_accrual_item_company" model="ir.rule">
        <field name="name">leave_accrual.item: own company only</field>
        <field name="model_id" ref="model_leave_accrual_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
