<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_lot_recall_company" model="ir.rule">
        <field name="name">lot.recall: own company only</field>
        <field name="model_id" ref="model_lot_recall"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_lot_recall_line_company" model="ir.rule">
        <field name="name">lot.recall.line: own company only</field>
        <field name="model_id" ref="model_lot_recall_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
