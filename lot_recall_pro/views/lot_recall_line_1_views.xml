<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lot_recall_line_list" model="ir.ui.view">
        <field name="name">lot.recall.line.list</field>
        <field name="model">lot.recall.line</field>
        <field name="arch" type="xml">
            <list string="Recall Impacts">
                <field name="recall_id"/>
                <field name="partner_id"/>
                <field name="lot_name"/>
                <field name="quantity"/>
                <field name="reference"/>
                <field name="notified"/>
                <field name="notified_on"/>
            </list>
        </field>
    </record>

    <record id="view_lot_recall_line_form" model="ir.ui.view">
        <field name="name">lot.recall.line.form</field>
        <field name="model">lot.recall.line</field>
        <field name="arch" type="xml">
            <form string="Recall Impacts">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="lot_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Impact">
    <field name="recall_id"/>
    <field name="partner_id"/>
    <field name="lot_name"/>
    <field name="quantity"/>
    <field name="reference"/>
    <field name="company_id"/>
                        </group>
                        <group string="Notification">
    <field name="notified"/>
    <field name="notified_on"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lot_recall_line_search" model="ir.ui.view">
        <field name="name">lot.recall.line.search</field>
        <field name="model">lot.recall.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="recall_id"/>
                <field name="partner_id"/>
                <field name="lot_name"/>
                <field name="reference"/>
                <filter name="notified" string="Notified" domain="[('notified', '=', True)]"/>
                <filter name="pending" string="Pending" domain="[('notified', '=', False)]"/>
                <separator/>
                <filter name="group_recall" string="Recall" context="{'group_by': 'recall_id'}"/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_lot_recall_line" model="ir.actions.act_window">
        <field name="name">Recall Impacts</field>
        <field name="res_model">lot.recall.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every impacted customer and lot, with notification status.</p>
        </field>
    </record>

</odoo>
