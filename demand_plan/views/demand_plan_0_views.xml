<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_demand_plan_list" model="ir.ui.view">
        <field name="name">demand.plan.list</field>
        <field name="model">demand.plan</field>
        <field name="arch" type="xml">
            <list string="Forecast Plans" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="salesperson_id"/>
                <field name="line_count"/>
                <field name="forecast_qty"/>
                <field name="actual_qty"/>
                <field name="variance_qty"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_demand_plan_form" model="ir.ui.view">
        <field name="name">demand.plan.form</field>
        <field name="model">demand.plan</field>
        <field name="arch" type="xml">
            <form string="Forecast Plans">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Plan">
    <field name="name"/>
    <field name="salesperson_id"/>
    <field name="period_start"/>
    <field name="period_end"/>
    <field name="company_id"/>
                        </group>
                        <group string="Totals">
    <field name="line_count"/>
    <field name="forecast_qty"/>
    <field name="actual_qty"/>
    <field name="variance_qty"/>
    <field name="forecast_amount"/>
    <field name="actual_amount"/>
    <field name="variance_amount"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Forecast Lines" name="lineids">
                            <field name="line_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_demand_plan_search" model="ir.ui.view">
        <field name="name">demand.plan.search</field>
        <field name="model">demand.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="salesperson_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="committed" string="Committed" domain="[('state','=','committed')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'salesperson_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_demand_plan_kanban" model="ir.ui.view">
        <field name="name">demand.plan.kanban</field>
        <field name="model">demand.plan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="salesperson_id"/>
                <field name="period_start"/>
                <field name="variance_qty"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="salesperson_id"/>
                        <field name="period_start"/>
                        <field name="variance_qty"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_demand_plan" model="ir.actions.act_window">
        <field name="name">Forecast Plans</field>
        <field name="res_model">demand.plan</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Monthly commitments per salesperson, compared with what was really sold.</p>
        </field>
    </record>

</odoo>
