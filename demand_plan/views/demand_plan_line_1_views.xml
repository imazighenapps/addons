<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_demand_plan_line_list" model="ir.ui.view">
        <field name="name">demand.plan.line.list</field>
        <field name="model">demand.plan.line</field>
        <field name="arch" type="xml">
            <list string="Forecast Lines">
                <field name="plan_id"/>
                <field name="product_name"/>
                <field name="forecast_qty"/>
                <field name="actual_qty"/>
                <field name="variance_qty"/>
                <field name="forecast_amount"/>
                <field name="actual_amount"/>
                <field name="variance_amount"/>
            </list>
        </field>
    </record>

    <record id="view_demand_plan_line_form" model="ir.ui.view">
        <field name="name">demand.plan.line.form</field>
        <field name="model">demand.plan.line</field>
        <field name="arch" type="xml">
            <form string="Forecast Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="plan_id"/>
    <field name="product_name"/>
    <field name="company_id"/>
                        </group>
                        <group string="Quantities">
    <field name="forecast_qty"/>
    <field name="actual_qty"/>
    <field name="variance_qty"/>
                        </group>
                        <group string="Amounts">
    <field name="forecast_amount"/>
    <field name="actual_amount"/>
    <field name="variance_amount"/>
    <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_demand_plan_line_search" model="ir.ui.view">
        <field name="name">demand.plan.line.search</field>
        <field name="model">demand.plan.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="plan_id"/>
                <field name="product_name"/>
                <separator/>
                <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_demand_plan_line" model="ir.actions.act_window">
        <field name="name">Forecast Lines</field>
        <field name="res_model">demand.plan.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every committed line with the actuals and the variance next to it.</p>
        </field>
    </record>

</odoo>
