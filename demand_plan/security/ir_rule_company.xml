<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_demand_plan_company" model="ir.rule">
        <field name="name">demand.plan: own company only</field>
        <field name="model_id" ref="model_demand_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_demand_plan_line_company" model="ir.rule">
        <field name="name">demand.plan.line: own company only</field>
        <field name="model_id" ref="model_demand_plan_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
