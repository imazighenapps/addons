<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_audit_binder_company" model="ir.rule">
        <field name="name">audit.binder: own company only</field>
        <field name="model_id" ref="model_audit_binder"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_audit_binder_item_company" model="ir.rule">
        <field name="name">audit.binder.item: own company only</field>
        <field name="model_id" ref="model_audit_binder_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
