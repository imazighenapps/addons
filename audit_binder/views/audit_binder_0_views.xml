<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_audit_binder_list" model="ir.ui.view">
        <field name="name">audit.binder.list</field>
        <field name="model">audit.binder</field>
        <field name="arch" type="xml">
            <list string="Audit Binders" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="item_count"/>
                <field name="missing_item_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_audit_binder_form" model="ir.ui.view">
        <field name="name">audit.binder.form</field>
        <field name="model">audit.binder</field>
        <field name="arch" type="xml">
            <form string="Audit Binders">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Binder">
    <field name="name"/>
    <field name="period_start"/>
    <field name="period_end"/>
    <field name="company_id"/>
                        </group>
                        <group string="Status">
    <field name="state"/>
    <field name="closed_on"/>
                        </group>
                        <group string="Counters">
    <field name="item_count"/>
    <field name="missing_item_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_audit_binder_search" model="ir.ui.view">
        <field name="name">audit.binder.search</field>
        <field name="model">audit.binder</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="collecting" string="Collecting" domain="[('state','=','collecting')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_audit_binder_kanban" model="ir.ui.view">
        <field name="name">audit.binder.kanban</field>
        <field name="model">audit.binder</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="missing_item_count"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="period_start"/>
                        <field name="period_end"/>
                        <field name="missing_item_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_audit_binder" model="ir.actions.act_window">
        <field name="name">Audit Binders</field>
        <field name="res_model">audit.binder</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Assemble the evidence pack for each audit period.</p>
        </field>
    </record>

</odoo>
