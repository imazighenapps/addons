<odoo>
    <record id="view_qms_document_list" model="ir.ui.view">
        <field name="name">qms.document.list</field>
        <field name="model">qms.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="document_type"/>
                <field name="state"/>
                <field name="current_version_id"/>
                <field name="owner_id"/>
                <field name="review_date"/>
            </list>
        </field>
    </record>
    <record id="view_qms_document_form" model="ir.ui.view">
        <field name="name">qms.document.form</field>
        <field name="model">qms.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_version" type="object" string="New Revision" invisible="state == 'obsolete'"/>
                    <button name="action_submit_review" type="object" string="Submit Review" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_request_approval" type="object" string="Request Approval" invisible="state != 'review'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'approval'"/>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state != 'approval'"/>
                    <button name="action_obsolete" type="object" string="Obsolete" invisible="state != 'published'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,approval,published,obsolete"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="document_type"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="current_version_id"/>
                            <field name="review_date"/>
                            <field name="publication_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Coverage">
                            <group>
                                <field name="requirement_ids" widget="many2many_tags"/>
                                <field name="process_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Revisions">
                            <field name="version_ids">
                                <list editable="bottom">
                                    <field name="revision"/>
                                    <field name="state"/>
                                    <field name="prepared_by_id"/>
                                    <field name="reviewer_id"/>
                                    <field name="approved_by_id"/>
                                    <field name="approval_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Acknowledgements">
                            <field name="ack_ids">
                                <list editable="bottom">
                                    <field name="version_id"/>
                                    <field name="employee_user_id"/>
                                    <field name="status"/>
                                    <field name="acknowledged_on"/>
                                    <button name="action_acknowledge" type="object" icon="fa-check" string="Acknowledge" invisible="status != 'pending'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_qms_document_search" model="ir.ui.view">
        <field name="name">qms.document.search</field>
        <field name="model">qms.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="state"/>
                <field name="document_type"/>
                <filter name="published" string="Published" domain="[('state','=','published')]"/>
                <filter name="review" string="Needs Review" domain="[('review_date','!=',False)]"/>
            </search>
        </field>
    </record>
    <record id="action_qms_document" model="ir.actions.act_window">
        <field name="name">Controlled Documents</field>
        <field name="res_model">qms.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qms_document_search"/>
    </record>
</odoo>
