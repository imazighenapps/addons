<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_tool_item_company" model="ir.rule">
        <field name="name">tool.item: own company only</field>
        <field name="model_id" ref="model_tool_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_tool_issue_company" model="ir.rule">
        <field name="name">tool.issue: own company only</field>
        <field name="model_id" ref="model_tool_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
