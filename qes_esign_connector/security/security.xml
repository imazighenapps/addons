<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_qes_user" model="res.groups">
        <field name="name">QES User</field>
        <field name="comment">Prepare and follow signature envelopes.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_qes_manager" model="res.groups">
        <field name="name">QES Manager</field>
        <field name="comment">Full administration of providers, accounts and envelopes.</field>
        <field name="implied_ids" eval="[(4, ref('qes_esign_connector.group_qes_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
