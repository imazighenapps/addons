<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qes_provider_list" model="ir.ui.view">
        <field name="name">qes.provider.list</field>
        <field name="model">qes.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="auth_type"/>
                <field name="qcert_esig" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_qes_provider_form" model="ir.ui.view">
        <field name="name">qes.provider.form</field>
        <field name="model">qes.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <field name="code"/>
                        <field name="api_base"/>
                        <field name="auth_type"/>
                        <field name="qcert_esig"/>
                        <field name="active"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_qes_account_list" model="ir.ui.view">
        <field name="name">qes.account.list</field>
        <field name="model">qes.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider_id"/>
                <field name="environment"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_qes_account_form" model="ir.ui.view">
        <field name="name">qes.account.form</field>
        <field name="model">qes.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <field name="provider_id"/>
                        <field name="company_id"/>
                        <field name="environment"/>
                        <field name="api_key"/>
                        <field name="workspace_id"/>
                        <field name="webhook_secret"/>
                        <field name="dashboard_url"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_qes_provider" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="res_model">qes.provider</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_qes_account" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">qes.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
