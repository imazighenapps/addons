<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_margin_book_line_list" model="ir.ui.view">
        <field name="name">margin.book.line.list</field>
        <field name="model">margin.book.line</field>
        <field name="arch" type="xml">
            <list string="Margin Lines">
                <field name="book_id"/>
                <field name="description"/>
                <field name="quantity"/>
                <field name="sell_price"/>
                <field name="unit_cost"/>
                <field name="amount_revenue" sum="Total Amount Revenue"/>
                <field name="amount_cost" sum="Total Amount Cost"/>
                <field name="line_margin" sum="Total Line Margin"/>
                <field name="line_rate"/>
            </list>
        </field>
    </record>

    <record id="view_margin_book_line_form" model="ir.ui.view">
        <field name="name">margin.book.line.form</field>
        <field name="model">margin.book.line</field>
        <field name="arch" type="xml">
            <form string="Margin Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="description" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="book_id"/>
    <field name="sequence"/>
    <field name="description"/>
    <field name="quantity"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amount">
    <field name="sell_price"/>
    <field name="unit_cost"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Computed">
    <field name="amount_revenue"/>
    <field name="amount_cost"/>
    <field name="line_margin"/>
    <field name="line_rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_margin_book_line_search" model="ir.ui.view">
        <field name="name">margin.book.line.search</field>
        <field name="model">margin.book.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="description"/>
                <field name="book_id"/>
                <separator/>
                <filter name="group_book" string="Margin Sheet" context="{'group_by': 'book_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_margin_book_line_kanban" model="ir.ui.view">
        <field name="name">margin.book.line.kanban</field>
        <field name="model">margin.book.line</field>
        <field name="arch" type="xml">
            <kanban default_group_by="book_id" sample="1">
                <field name="book_id"/>
                <field name="description"/>
                <field name="quantity"/>
                <field name="line_margin"/>
                <field name="line_rate"/>
                <templates>
                    <t t-name="card">
                        <field name="book_id" class="fw-bold"/>
                        <field name="description"/>
                        <field name="quantity"/>
                        <field name="line_margin"/>
                        <field name="line_rate"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_margin_book_line" model="ir.actions.act_window">
        <field name="name">Margin Lines</field>
        <field name="res_model">margin.book.line</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every margin line of every sheet, with its quantity, price, cost and computed margin.</p>
        </field>
    </record>

</odoo>
