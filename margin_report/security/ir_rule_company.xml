    <record id="rule_margin_book_line_company" model="ir.rule">
        <field name="name">margin.book.line: own company only</field>
        <field name="model_id" ref="model_margin_book_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
