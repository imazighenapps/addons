<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_margin_book_company" model="ir.rule">
        <field name="name">margin.book: own company only</field>
        <field name="model_id" ref="model_margin_book"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
