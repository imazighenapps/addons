<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="view_legal_recovery_case_form" model="ir.ui.view">
  <field name="name">legal.recovery.case.form</field><field name="model">legal.recovery.case</field>
  <field name="arch" type="xml"><form string="Contentieux">
    <header>
      <button name="action_start" type="object" string="Démarrer" class="btn-primary" invisible="state!='draft'"/>
      <button name="action_win" type="object" string="Gagné" invisible="state!='ongoing'"/>
      <button name="action_lose" type="object" string="Perdu" invisible="state!='ongoing'"/>
      <button name="action_close" type="object" string="Clôturer" invisible="state not in ('won','lost','ongoing')"/>
      <field name="state" widget="statusbar" statusbar_visible="draft,ongoing,won,closed"/>
    </header>
    <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group>
        <field name="company_id" groups="base.group_multi_company"/><field name="invoice_id"/><field name="partner_id"/>
        <field name="procedure_step"/><field name="bailiff_name"/>
      </group><group>
        <field name="amount_claimed"/><field name="fees_amount"/><field name="recovered_amount"/>
        <field name="opened_date"/><field name="hearing_date"/><field name="currency_id" invisible="1"/>
      </group></group>
      <group string="Notes"><field name="notes" nolabel="1"/></group>
    </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
  </form></field>
</record>
<record id="view_legal_recovery_case_list" model="ir.ui.view">
  <field name="name">legal.recovery.case.list</field><field name="model">legal.recovery.case</field>
  <field name="arch" type="xml"><list decoration-success="state=='won'" decoration-danger="state=='lost'">
    <field name="name"/><field name="invoice_id"/><field name="partner_id"/><field name="procedure_step"/>
    <field name="amount_claimed"/><field name="recovered_amount"/><field name="state"/>
  </list></field>
</record>
</data></odoo>
