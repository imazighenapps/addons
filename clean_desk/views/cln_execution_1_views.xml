<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cln_execution_list" model="ir.ui.view">
        <field name="name">cln.execution.list</field>
        <field name="model">cln.execution</field>
        <field name="arch" type="xml">
            <list string="Execution Log" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="scheduled_on"/>
                <field name="plan_id"/>
                <field name="area"/>
                <field name="performer_id"/>
                <field name="performed_on"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cln_execution_form" model="ir.ui.view">
        <field name="name">cln.execution.form</field>
        <field name="model">cln.execution</field>
        <field name="arch" type="xml">
            <form string="Execution Log">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Execution">
    <field name="name"/>
    <field name="plan_id"/>
    <field name="area"/>
    <field name="scheduled_on"/>
    <field name="performer_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Completion">
    <field name="performed_on"/>
    <field name="method_used"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cln_execution_search" model="ir.ui.view">
        <field name="name">cln.execution.search</field>
        <field name="model">cln.execution</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="area"/>
                <field name="performer_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'planned')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_cln_execution_kanban" model="ir.ui.view">
        <field name="name">cln.execution.kanban</field>
        <field name="model">cln.execution</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="scheduled_on"/>
                <field name="performer_id"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="plan_id"/>
                        <field name="scheduled_on"/>
                        <field name="performer_id"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_cln_execution" model="ir.actions.act_window">
        <field name="name">Execution Log</field>
        <field name="res_model">cln.execution</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Dated proof of every cleaning execution.</p>
        </field>
    </record>

</odoo>
