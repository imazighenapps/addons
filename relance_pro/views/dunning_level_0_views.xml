<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dunning_level_list" model="ir.ui.view">
        <field name="name">dunning.level.list</field>
        <field name="model">dunning.level</field>
        <field name="arch" type="xml">
            <list string="Levels">
                <field name="sequence"/>
                <field name="name"/>
                <field name="day_offset"/>
                <field name="fee_amount" sum="Total Fee Amount"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dunning_level_form" model="ir.ui.view">
        <field name="name">dunning.level.form</field>
        <field name="model">dunning.level</field>
        <field name="arch" type="xml">
            <form string="Levels">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Level">
    <field name="name"/>
    <field name="sequence"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Rule">
    <field name="day_offset"/>
    <field name="template_id"/>
    <field name="fee_amount"/>
    <field name="fee_product_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dunning_level_search" model="ir.ui.view">
        <field name="name">dunning.level.search</field>
        <field name="model">dunning.level</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_dunning_level" model="ir.actions.act_window">
        <field name="name">Levels</field>
        <field name="res_model">dunning.level</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the ladder once: a day offset, a template and an optional fee.</p>
        </field>
    </record>

</odoo>
