<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dunning_run_form" model="ir.ui.view">
        <field name="name">dunning.run.wizard.form</field>
        <field name="model">dunning.run.wizard</field>
        <field name="arch" type="xml">
            <form string="Run Dunning">
                <sheet>
                    <group>
                        <group string="Run">
    <field name="date_ref"/>
    <field name="company_id"/>
    <field name="partner_ids"/>
    <field name="dry_run"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dunning_run" model="ir.actions.act_window">
        <field name="name">Run Dunning</field>
        <field name="res_model">dunning.run.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
