        <field name="name">dunning.level: own company only</field>
        <field name="model_id" ref="model_dunning_level"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_dunning_line_company" model="ir.rule">
        <field name="name">dunning.line: own company only</field>
        <field name="model_id" ref="model_dunning_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
