<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_vendor_onboard_entry_company" model="ir.rule">
        <field name="name">vendor_onboard.entry: own company only</field>
        <field name="model_id" ref="model_vendor_onboard_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_vendor_onboard_item_company" model="ir.rule">
        <field name="name">vendor_onboard.item: own company only</field>
        <field name="model_id" ref="model_vendor_onboard_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
