<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_sdd_mandate" model="ir.sequence">
        <field name="name">SEPA Mandate</field>
        <field name="code">sdd.mandate</field>
        <field name="prefix">SDM/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_sdd_batch" model="ir.sequence">
        <field name="name">SEPA Direct Debit Batch</field>
        <field name="code">sdd.batch</field>
        <field name="prefix">SDD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
