<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sdd_mandate_list" model="ir.ui.view">
        <field name="name">sdd.mandate.list</field>
        <field name="model">sdd.mandate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="scheme"/>
                <field name="sequence_type"/>
                <field name="signature_date"/>
                <field name="last_debit_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_sdd_mandate_form" model="ir.ui.view">
        <field name="name">sdd.mandate.form</field>
        <field name="model">sdd.mandate</field>
        <field name="arch" type="xml">
            <form string="Mandat SEPA">
                <header>
                    <button name="action_activate" type="object" string="Activer" class="btn-primary"/>
                    <button name="action_suspend" type="object" string="Suspendre"/>
                    <button name="action_revoke" type="object" string="Révoquer"/>
                    <button name="action_close" type="object" string="Clôturer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended,revoked,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="partner_id"/>
                            <field name="partner_bank_id"/>
                            <field name="scheme"/>
                        </group>
                        <group>
                            <field name="sequence_type"/>
                            <field name="signature_date"/>
                            <field name="last_debit_date"/>
                            <field name="signature_attachment_id"/>
                        </group>
                    </group>
                    <group><field name="note"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_sdd_mandate" model="ir.actions.act_window">
        <field name="name">Mandats SEPA</field>
        <field name="res_model">sdd.mandate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
