<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sdd_reject_import" model="ir.actions.act_window">
        <field name="name">Importer rejets pain.002</field>
        <field name="res_model">sdd.reject.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_batch_id': active_id}</field>
    </record>
    <record id="view_sdd_batch_list" model="ir.ui.view">
        <field name="name">sdd.batch.list</field>
        <field name="model">sdd.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="collection_date"/>
                <field name="journal_id"/>
                <field name="scheme"/>
                <field name="sequence_type"/>
                <field name="nb_txs"/>
                <field name="ctrl_sum"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_sdd_batch_form" model="ir.ui.view">
        <field name="name">sdd.batch.form</field>
        <field name="model">sdd.batch</field>
        <field name="arch" type="xml">
            <form string="Lot SDD">
                <header>
                    <button name="action_generate" type="object" string="Générer pain.008" class="btn-primary"/>
                    <button name="action_download" type="object" string="Télécharger"/>
                    <button name="action_mark_sent" type="object" string="Marquer transmis"/>
                    <button name="%(action_sdd_reject_import)d" type="action" string="Importer rejets (pain.002)"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,sent,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_id"/>
                            <field name="collection_date"/>
                            <field name="scheme"/>
                            <field name="sequence_type"/>
                        </group>
                        <group>
                            <field name="creditor_identifier"/>
                            <field name="msg_id"/>
                            <field name="pmt_inf_id"/>
                            <field name="nb_txs"/>
                            <field name="ctrl_sum"/>
                            <field name="file_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="mandate_id"/>
                                    <field name="partner_id"/>
                                    <field name="amount"/>
                                    <field name="communication"/>
                                    <field name="invoice_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rejets">
                            <field name="reject_info"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_sdd_reject_import_form" model="ir.ui.view">
        <field name="name">sdd.reject.import.form</field>
        <field name="model">sdd.reject.import</field>
        <field name="arch" type="xml">
            <form string="Importer rejets pain.002">
                <group>
                    <field name="batch_id"/>
                    <field name="file_name"/>
                    <field name="file_data" filename="file_name"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importer" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sdd_batch" model="ir.actions.act_window">
        <field name="name">Prélèvements SEPA (SDD)</field>
        <field name="res_model">sdd.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
