            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="sdd_batch_company_rule" model="ir.access">
            <field name="name">Lot SDD : société</field>
            <field name="model_id" ref="model_sdd_batch"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
