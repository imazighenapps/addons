<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_appointment_log_list" model="ir.ui.view">
        <field name="name">appointment.log.list</field>
        <field name="model">appointment.log</field>
        <field name="arch" type="xml">
            <list string="Appointments" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="location"/>
                <field name="followup_date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_appointment_log_form" model="ir.ui.view">
        <field name="name">appointment.log.form</field>
        <field name="model">appointment.log</field>
        <field name="arch" type="xml">
            <form string="Appointments">
                <header>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state != 'planned'"/>
                    <button name="action_reset" type="object" string="Reset to Planned" class="btn-link" invisible="state == 'planned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Appointment">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="user_id"/>
    <field name="date"/>
    <field name="location"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Follow-up">
    <field name="followup_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Outcome" name="outcome">
                            <field name="outcome"/>
                        </page>
                        <page string="Next Action" name="nextaction">
                            <field name="next_action"/>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_appointment_log_search" model="ir.ui.view">
        <field name="name">appointment.log.search</field>
        <field name="model">appointment.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="location"/>
                <filter name="planned" string="Planned" domain="[('state','=','planned')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_partner" string="Contact" context="{'group_by': 'partner_id'}"/>
                <filter name="group_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_appointment_log" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">appointment.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log external appointments with outcomes and follow-ups.</p>
        </field>
    </record>

</odoo>
