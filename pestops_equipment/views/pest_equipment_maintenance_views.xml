<odoo>
    <record id="view_pest_equipment_maintenance_list" model="ir.ui.view">
        <field name="name">pest.equipment.maintenance.list</field>
        <field name="model">pest.equipment.maintenance</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-warning="state in ('planned','in_progress')">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="maintenance_type"/>
                <field name="planned_date"/>
                <field name="completed_date"/>
                <field name="performed_by"/>
                <field name="state"/>
                <field name="next_due_date"/>
                <field name="cost"/>
            </list>
        </field>
    </record>
    <record id="view_pest_equipment_maintenance_form" model="ir.ui.view">
        <field name="name">pest.equipment.maintenance.form</field>
        <field name="model">pest.equipment.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="oe_highlight" invisible="state != 'planned'"/>
                    <button name="action_done" type="object" string="Done" class="oe_highlight" invisible="state not in ('planned','in_progress')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="equipment_id"/>
                        <field name="maintenance_type"/>
                        <field name="planned_date"/>
                        <field name="completed_date"/>
                        <field name="performed_by"/>
                        <field name="vendor"/>
                        <field name="frequency_days"/>
                        <field name="next_due_date" readonly="1"/>
                        <field name="cost"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="findings"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pest_equipment_maintenance" model="ir.actions.act_window">
        <field name="name">Equipment Maintenance</field>
        <field name="res_model">pest.equipment.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
