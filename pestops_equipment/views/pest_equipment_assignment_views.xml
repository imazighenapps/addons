<odoo>
    <record id="view_pest_equipment_assignment_list" model="ir.ui.view">
        <field name="name">pest.equipment.assignment.list</field>
        <field name="model">pest.equipment.assignment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-muted="state != 'active'">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="user_id"/>
                <field name="site_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_pest_equipment_assignment_form" model="ir.ui.view">
        <field name="name">pest.equipment.assignment.form</field>
        <field name="model">pest.equipment.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_close" type="object" string="Close" invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('closed','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,closed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="equipment_id"/>
                        <field name="user_id"/>
                        <field name="site_id"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pest_equipment_assignments" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">pest.equipment.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>
</odoo>
