        <field name="domain_force">[('equipment_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pest_equipment_maintenance_company" model="ir.rule">
        <field name="name">PestOps Equipment Maintenance Company Rule</field>
        <field name="model_id" ref="model_pest_equipment_maintenance"/>
        <field name="domain_force">[('equipment_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pest_equipment_usage_company" model="ir.rule">
        <field name="name">PestOps Equipment Usage Company Rule</field>
        <field name="model_id" ref="model_pest_equipment_usage"/>
        <field name="domain_force">[('equipment_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
