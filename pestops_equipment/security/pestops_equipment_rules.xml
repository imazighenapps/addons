<odoo>
    <record id="rule_pest_equipment_company" model="ir.rule">
        <field name="name">PestOps Equipment Company Rule</field>
        <field name="model_id" ref="model_pest_equipment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
