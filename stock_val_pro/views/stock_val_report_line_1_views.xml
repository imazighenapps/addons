<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_val_report_line_list" model="ir.ui.view">
        <field name="name">stock.val.report.line.list</field>
        <field name="model">stock.val.report.line</field>
        <field name="arch" type="xml">
            <list string="Valuation Lines">
                <field name="report_id"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="qty_in" sum="Total Qty In"/>
                <field name="qty_out" sum="Total Qty Out"/>
                <field name="unit_cost"/>
                <field name="balance_qty" sum="Total Balance Qty"/>
                <field name="balance_value" sum="Total Balance Value"/>
                <field name="slow_mover" string="Slow Mover" widget="boolean"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_stock_val_report_line_form" model="ir.ui.view">
        <field name="name">stock.val.report.line.form</field>
        <field name="model">stock.val.report.line</field>
        <field name="arch" type="xml">
            <form string="Valuation Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="report_id"/>
    <field name="product_id"/>
    <field name="categ_id"/>
                        </group>
                        <group string="Quantities">
    <field name="qty_in"/>
    <field name="qty_out"/>
    <field name="balance_qty"/>
                        </group>
                        <group string="Valuation">
    <field name="unit_cost"/>
    <field name="value_in"/>
    <field name="value_out"/>
    <field name="balance_value"/>
    <field name="slow_mover"/>
    <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_val_report_line_search" model="ir.ui.view">
        <field name="name">stock.val.report.line.search</field>
        <field name="model">stock.val.report.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="report_id"/>
                <field name="categ_id"/>
                <filter name="slow" string="Slow Movers" domain="[('slow_mover','=',True)]"/>
                <filter name="negative" string="Negative Balance" domain="[('balance_qty','&lt;',0)]"/>
                <separator/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="group_category" string="Category" context="{'group_by': 'categ_id'}"/>
                <filter name="group_report" string="Report" context="{'group_by': 'report_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_stock_val_report_line" model="ir.actions.act_window">
        <field name="name">Valuation Lines</field>
        <field name="res_model">stock.val.report.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every valuation line of every report, with its cost and its net balance.</p>
        </field>
    </record>

</odoo>
