<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_appointment_deposit_entry_company" model="ir.rule">
        <field name="name">appointment_deposit.entry: own company only</field>
        <field name="model_id" ref="model_appointment_deposit_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_appointment_deposit_item_company" model="ir.rule">
        <field name="name">appointment_deposit.item: own company only</field>
        <field name="model_id" ref="model_appointment_deposit_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
