<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_refer_code_company" model="ir.rule">
        <field name="name">refer.code: own company only</field>
        <field name="model_id" ref="model_refer_code"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_refer_referral_company" model="ir.rule">
        <field name="name">refer.referral: own company only</field>
        <field name="model_id" ref="model_refer_referral"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
