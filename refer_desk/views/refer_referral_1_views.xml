<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_refer_referral_list" model="ir.ui.view">
        <field name="name">refer.referral.list</field>
        <field name="model">refer.referral</field>
        <field name="arch" type="xml">
            <list string="Referrals" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="referred_on"/>
                <field name="code_id"/>
                <field name="referred_name"/>
                <field name="order_amount"/>
                <field name="reward_amount"/>
                <field name="credited_on"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_refer_referral_form" model="ir.ui.view">
        <field name="name">refer.referral.form</field>
        <field name="model">refer.referral</field>
        <field name="arch" type="xml">
            <form string="Referrals">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="referred_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Referral">
    <field name="name"/>
    <field name="code_id"/>
    <field name="referred_name"/>
    <field name="referred_on"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amounts">
    <field name="order_amount"/>
    <field name="reward_amount"/>
    <field name="currency_id"/>
    <field name="state"/>
    <field name="credited_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_refer_referral_search" model="ir.ui.view">
        <field name="name">refer.referral.search</field>
        <field name="model">refer.referral</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code_id"/>
                <field name="referred_name"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="credited" string="Credited" domain="[('state','=','credited')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_code" string="Code" context="{'group_by': 'code_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_refer_referral_kanban" model="ir.ui.view">
        <field name="name">refer.referral.kanban</field>
        <field name="model">refer.referral</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="referred_name"/>
                <field name="code_id"/>
                <field name="reward_amount"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="referred_name"/>
                        <field name="code_id"/>
                        <field name="reward_amount"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_refer_referral" model="ir.actions.act_window">
        <field name="name">Referrals</field>
        <field name="res_model">refer.referral</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every referred friend and the reward credited on the advocate's code.</p>
        </field>
    </record>

</odoo>
