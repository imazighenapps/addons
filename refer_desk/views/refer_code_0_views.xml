<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_refer_code_list" model="ir.ui.view">
        <field name="name">refer.code.list</field>
        <field name="model">refer.code</field>
        <field name="arch" type="xml">
            <list string="Referral Codes" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="advocate_name"/>
                <field name="referral_count"/>
                <field name="credited_count"/>
                <field name="total_reward"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_refer_code_form" model="ir.ui.view">
        <field name="name">refer.code.form</field>
        <field name="model">refer.code</field>
        <field name="arch" type="xml">
            <form string="Referral Codes">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="advocate_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Code">
    <field name="name"/>
    <field name="advocate_name"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Totals">
    <field name="referral_count"/>
    <field name="credited_count"/>
    <field name="total_reward"/>
    <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Referrals" name="referralids">
                            <field name="referral_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_refer_code_search" model="ir.ui.view">
        <field name="name">refer.code.search</field>
        <field name="model">refer.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="advocate_name"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_refer_code_kanban" model="ir.ui.view">
        <field name="name">refer.code.kanban</field>
        <field name="model">refer.code</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="advocate_name"/>
                <field name="total_reward"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="advocate_name"/>
                        <field name="total_reward"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_refer_code" model="ir.actions.act_window">
        <field name="name">Referral Codes</field>
        <field name="res_model">refer.code</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">One code per advocate with the credited rewards computed from referrals.</p>
        </field>
    </record>

</odoo>
