<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_patrol_round_company" model="ir.rule">
        <field name="name">patrol.round: own company only</field>
        <field name="model_id" ref="model_patrol_round"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_patrol_stop_company" model="ir.rule">
        <field name="name">patrol.stop: own company only</field>
        <field name="model_id" ref="model_patrol_stop"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
