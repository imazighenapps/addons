<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_patrol_stop_list" model="ir.ui.view">
        <field name="name">patrol.stop.list</field>
        <field name="model">patrol.stop</field>
        <field name="arch" type="xml">
            <list string="Patrol Stops">
                <field name="checked_at"/>
                <field name="round_id"/>
                <field name="name"/>
                <field name="status" widget="badge"/>
                <field name="finding"/>
            </list>
        </field>
    </record>

    <record id="view_patrol_stop_form" model="ir.ui.view">
        <field name="name">patrol.stop.form</field>
        <field name="model">patrol.stop</field>
        <field name="arch" type="xml">
            <form string="Patrol Stops">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Stop">
    <field name="name"/>
    <field name="round_id"/>
    <field name="status"/>
    <field name="checked_at"/>
    <field name="finding"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observation" name="observation">
                            <field name="observation"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_patrol_stop_search" model="ir.ui.view">
        <field name="name">patrol.stop.search</field>
        <field name="model">patrol.stop</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="round_id"/>
                <field name="observation"/>
                <filter name="visited" string="Visited" domain="[('status','=','visited')]"/>
                <filter name="skipped" string="Skipped" domain="[('status','=','skipped')]"/>
                <filter name="finding" string="Findings" domain="[('finding','=',True)]"/>
                <separator/>
                <filter name="group_round" string="Round" context="{'group_by': 'round_id'}"/>
                <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="view_patrol_stop_kanban" model="ir.ui.view">
        <field name="name">patrol.stop.kanban</field>
        <field name="model">patrol.stop</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" sample="1">
                <field name="status"/>
                <field name="name"/>
                <field name="round_id"/>
                <field name="checked_at"/>
                <field name="finding"/>
                <templates>
                    <t t-name="card">
                        <field name="status" class="fw-bold"/>
                        <field name="name"/>
                        <field name="round_id"/>
                        <field name="checked_at"/>
                        <field name="finding"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_patrol_stop" model="ir.actions.act_window">
        <field name="name">Patrol Stops</field>
        <field name="res_model">patrol.stop</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Each checkpoint checked during a round, with its finding.</p>
        </field>
    </record>

</odoo>
