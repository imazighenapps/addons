<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_patrol_round_list" model="ir.ui.view">
        <field name="name">patrol.round.list</field>
        <field name="model">patrol.round</field>
        <field name="arch" type="xml">
            <list string="Patrol Rounds" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="start_at"/>
                <field name="name"/>
                <field name="guard_name"/>
                <field name="route"/>
                <field name="stop_count"/>
                <field name="skipped_count"/>
                <field name="finding_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_patrol_round_form" model="ir.ui.view">
        <field name="name">patrol.round.form</field>
        <field name="model">patrol.round</field>
        <field name="arch" type="xml">
            <form string="Patrol Rounds">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Round">
    <field name="name"/>
    <field name="guard_name"/>
    <field name="route"/>
    <field name="company_id"/>
                        </group>
                        <group string="Schedule">
    <field name="start_at"/>
    <field name="end_at"/>
    <field name="state"/>
                        </group>
                        <group string="Summary">
    <field name="stop_count"/>
    <field name="skipped_count"/>
    <field name="finding_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stops" name="stopids">
                            <field name="stop_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_patrol_round_search" model="ir.ui.view">
        <field name="name">patrol.round.search</field>
        <field name="model">patrol.round</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="guard_name"/>
                <field name="route"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="done" string="Completed" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_route" string="Route" context="{'group_by': 'route'}"/>
            </search>
        </field>
    </record>

    <record id="view_patrol_round_kanban" model="ir.ui.view">
        <field name="name">patrol.round.kanban</field>
        <field name="model">patrol.round</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="guard_name"/>
                <field name="route"/>
                <field name="start_at"/>
                <field name="skipped_count"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="guard_name"/>
                        <field name="route"/>
                        <field name="start_at"/>
                        <field name="skipped_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_patrol_round" model="ir.actions.act_window">
        <field name="name">Patrol Rounds</field>
        <field name="res_model">patrol.round</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every patrol round with its route, its stops and what was missed.</p>
        </field>
    </record>

</odoo>
