<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="view_realized_fx_settlement_form" model="ir.ui.view">
  <field name="name">realized.fx.settlement.form</field><field name="model">realized.fx.settlement</field>
  <field name="arch" type="xml"><form string="Écart de change réalisé">
    <header>
      <button name="action_compute" type="object" string="Calculer" class="btn-primary" invisible="state!='draft'"/>
      <button name="action_post" type="object" string="Comptabiliser" invisible="state!='computed'"/>
      <field name="state" widget="statusbar" statusbar_visible="draft,computed,posted"/>
    </header>
    <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group>
        <field name="company_id" groups="base.group_multi_company"/><field name="invoice_id"/><field name="partner_id"/>
        <field name="currency_id"/><field name="amount_currency"/><field name="settlement_date"/>
      </group><group>
        <field name="invoice_rate"/><field name="settlement_rate"/><field name="skip_threshold"/>
        <field name="fx_gain_loss"/><field name="skipped"/><field name="company_currency_id" invisible="1"/>
      </group></group>
      <group string="Notes / audit"><field name="notes" nolabel="1"/></group>
    </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
  </form></field>
</record>
<record id="view_realized_fx_settlement_list" model="ir.ui.view">
  <field name="name">realized.fx.settlement.list</field><field name="model">realized.fx.settlement</field>
  <field name="arch" type="xml"><list>
    <field name="name"/><field name="invoice_id"/><field name="currency_id"/><field name="amount_currency"/>
    <field name="fx_gain_loss"/><field name="settlement_date"/><field name="state"/>
  </list></field>
</record>
</data></odoo>
