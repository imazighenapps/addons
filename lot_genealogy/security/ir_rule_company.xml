<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_lot_genealogy_company" model="ir.rule">
        <field name="name">lot.genealogy: own company only</field>
        <field name="model_id" ref="model_lot_genealogy"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_lot_genealogy_link_company" model="ir.rule">
        <field name="name">lot.genealogy.link: own company only</field>
        <field name="model_id" ref="model_lot_genealogy_link"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
