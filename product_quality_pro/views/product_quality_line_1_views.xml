<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_quality_line_list" model="ir.ui.view">
        <field name="name">product.quality.line.list</field>
        <field name="model">product.quality.line</field>
        <field name="arch" type="xml">
            <list string="Anomalies" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="scan_id"/>
                <field name="product_id"/>
                <field name="field_key" widget="badge"/>
                <field name="severity" widget="badge"/>
                <field name="message"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_product_quality_line_form" model="ir.ui.view">
        <field name="name">product.quality.line.form</field>
        <field name="model">product.quality.line</field>
        <field name="arch" type="xml">
            <form string="Anomalies">
                <header>
                    <button name="action_mark_fixed" type="object" string="Mark Fixed" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_ignore" type="object" string="Ignore" class="btn-secondary" invisible="state != 'new'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,fixed,ignored"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Anomaly">
    <field name="scan_id"/>
    <field name="product_id"/>
    <field name="rule_id"/>
    <field name="field_key"/>
    <field name="severity"/>
    <field name="message"/>
                        </group>
                        <group string="Follow-up">
    <field name="state"/>
    <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_quality_line_search" model="ir.ui.view">
        <field name="name">product.quality.line.search</field>
        <field name="model">product.quality.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="message"/>
                <field name="scan_id"/>
                <filter name="new" string="To Fix" domain="[('state','=','new')]"/>
                <filter name="fixed" string="Fixed" domain="[('state','=','fixed')]"/>
                <filter name="ignored" string="Ignored" domain="[('state','=','ignored')]"/>
                <filter name="errors" string="Errors" domain="[('severity','=','error')]"/>
                <filter name="warnings" string="Warnings" domain="[('severity','=','warning')]"/>
                <separator/>
                <filter name="group_field" string="Field" context="{'group_by': 'field_key'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_product_quality_line" model="ir.actions.act_window">
        <field name="name">Anomalies</field>
        <field name="res_model">product.quality.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">One line per missing field, with the rule that caught it and the field to fix on the product sheet.</p>
        </field>
    </record>

</odoo>
