<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_quality_rule_list" model="ir.ui.view">
        <field name="name">product.quality.rule.list</field>
        <field name="model">product.quality.rule</field>
        <field name="arch" type="xml">
            <list string="Rules">
                <field name="name"/>
                <field name="field_key" widget="badge"/>
                <field name="severity" widget="badge"/>
                <field name="points"/>
                <field name="company_id"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_product_quality_rule_form" model="ir.ui.view">
        <field name="name">product.quality.rule.form</field>
        <field name="model">product.quality.rule</field>
        <field name="arch" type="xml">
            <form string="Rules">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Rule">
    <field name="name"/>
    <field name="field_key"/>
    <field name="severity"/>
    <field name="points"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Notes">
    <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_quality_rule_search" model="ir.ui.view">
        <field name="name">product.quality.rule.search</field>
        <field name="model">product.quality.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="warning" string="Warnings" domain="[('severity','=','warning')]"/>
                <filter name="error" string="Errors" domain="[('severity','=','error')]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_field" string="Field" context="{'group_by': 'field_key'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
            </search>
        </field>
    </record>

    <record id="action_product_quality_rule" model="ir.actions.act_window">
        <field name="name">Rules</field>
        <field name="res_model">product.quality.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">One rule per field of the product sheet, with the points it weighs in the score.</p>
        </field>
    </record>

</odoo>
