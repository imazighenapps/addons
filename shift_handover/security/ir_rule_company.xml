<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_shift_handover_company" model="ir.rule">
        <field name="name">shift.handover: own company only</field>
        <field name="model_id" ref="model_shift_handover"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_shift_handover_line_company" model="ir.rule">
        <field name="name">shift.handover.line: own company only</field>
        <field name="model_id" ref="model_shift_handover_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
