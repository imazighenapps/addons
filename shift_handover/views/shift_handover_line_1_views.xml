<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shift_handover_line_list" model="ir.ui.view">
        <field name="name">shift.handover.line.list</field>
        <field name="model">shift.handover.line</field>
        <field name="arch" type="xml">
            <list string="Items">
                <field name="handover_id"/>
                <field name="category" widget="badge"/>
                <field name="description"/>
                <field name="severity" widget="badge"/>
                <field name="assigned_id"/>
                <field name="follow_up"/>
                <field name="resolved"/>
                <field name="resolved_date"/>
            </list>
        </field>
    </record>

    <record id="view_shift_handover_line_form" model="ir.ui.view">
        <field name="name">shift.handover.line.form</field>
        <field name="model">shift.handover.line</field>
        <field name="arch" type="xml">
            <form string="Items">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="description" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Item">
    <field name="handover_id"/>
    <field name="sequence"/>
    <field name="category"/>
    <field name="description"/>
                        </group>
                        <group string="Follow-up">
    <field name="severity"/>
    <field name="assigned_id"/>
    <field name="follow_up"/>
    <field name="company_id"/>
                        </group>
                        <group string="Resolution">
    <field name="resolved"/>
    <field name="resolved_date"/>
                        </group>
                    </group>
                    <div class="oe_button_box" name="button_box"><button name="action_resolve" type="object" class="oe_stat_button" icon="fa-check-circle" invisible="resolved"><div class="o_stat_info"><span class="o_stat_text">Resolve</span></div></button><button name="action_reopen" type="object" class="oe_stat_button" icon="fa-undo" invisible="not resolved"><div class="o_stat_info"><span class="o_stat_text">Reopen</span></div></button></div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shift_handover_line_search" model="ir.ui.view">
        <field name="name">shift.handover.line.search</field>
        <field name="model">shift.handover.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="description"/>
                <field name="handover_id"/>
                <field name="assigned_id"/>
                <filter name="open" string="Open" domain="[('resolved','=',False)]"/>
                <filter name="resolved" string="Resolved" domain="[('resolved','=',True)]"/>
                <filter name="follow_up" string="Follow-up" domain="[('follow_up','=',True)]"/>
                <filter name="high" string="High Severity" domain="[('severity','=','high')]"/>
                <separator/>
                <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                <filter name="group_handover" string="Handover" context="{'group_by': 'handover_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_shift_handover_line" model="ir.actions.act_window">
        <field name="name">Items</field>
        <field name="res_model">shift.handover.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every point written for a shift, in one place.</p>
        </field>
    </record>

</odoo>
