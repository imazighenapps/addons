<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_consol_line_list" model="ir.ui.view">
        <field name="name">consol.line.list</field>
        <field name="model">consol.line</field>
        <field name="arch" type="xml">
            <list string="Consolidation Lines">
                <field name="run_id"/>
                <field name="company_id"/>
                <field name="account_code"/>
                <field name="account_name"/>
                <field name="mapping"/>
                <field name="debit" sum="Total Debit"/>
                <field name="credit" sum="Total Credit"/>
                <field name="balance" sum="Total Balance"/>
                <field name="eliminated" widget="boolean"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_consol_line_form" model="ir.ui.view">
        <field name="name">consol.line.form</field>
        <field name="model">consol.line</field>
        <field name="arch" type="xml">
            <form string="Consolidation Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="account_code" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="run_id"/>
    <field name="company_id"/>
    <field name="account_code"/>
    <field name="account_name"/>
    <field name="mapping"/>
                        </group>
                        <group string="Amounts">
    <field name="currency_id"/>
    <field name="debit"/>
    <field name="credit"/>
    <field name="balance"/>
    <field name="eliminated"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_consol_line_search" model="ir.ui.view">
        <field name="name">consol.line.search</field>
        <field name="model">consol.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="account_code"/>
                <field name="account_name"/>
                <field name="mapping"/>
                <field name="run_id"/>
                <field name="company_id"/>
                <filter name="eliminated" string="Eliminated" domain="[('eliminated','=',True)]"/>
                <filter name="open" string="Not Eliminated" domain="[('eliminated','=',False)]"/>
                <filter name="mapped" string="Mapped" domain="[('mapping','!=','')]"/>
                <separator/>
                <filter name="group_run" string="Run" context="{'group_by': 'run_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_account" string="Account Code" context="{'group_by': 'account_code'}"/>
                <filter name="group_mapping" string="Mapping" context="{'group_by': 'mapping'}"/>
            </search>
        </field>
    </record>

    <record id="action_consol_line" model="ir.actions.act_window">
        <field name="name">Consolidation Lines</field>
        <field name="res_model">consol.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every consolidation line of every run, account by account and company by company.</p>
        </field>
    </record>

</odoo>
