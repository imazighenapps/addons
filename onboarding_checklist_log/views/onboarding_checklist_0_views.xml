<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_onboarding_checklist_list" model="ir.ui.view">
        <field name="name">onboarding.checklist.list</field>
        <field name="model">onboarding.checklist</field>
        <field name="arch" type="xml">
            <list string="Onboarding Checklists" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="responsible_id"/>
                <field name="date_start"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_onboarding_checklist_form" model="ir.ui.view">
        <field name="name">onboarding.checklist.form</field>
        <field name="model">onboarding.checklist</field>
        <field name="arch" type="xml">
            <form string="Onboarding Checklists">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state in ('done','cancelled')"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Onboarding">
    <field name="name"/>
    <field name="employee_id"/>
    <field name="department_id"/>
    <field name="responsible_id"/>
    <field name="date_start"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks" name="lineids">
                            <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="date_due"/>
                            <field name="done"/>
                            <field name="note"/>
                            <field name="company_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_onboarding_checklist_search" model="ir.ui.view">
        <field name="name">onboarding.checklist.search</field>
        <field name="model">onboarding.checklist</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="responsible_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_onboarding_checklist" model="ir.actions.act_window">
        <field name="name">Onboarding Checklists</field>
        <field name="res_model">onboarding.checklist</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track onboarding checklists for new employees.</p>
        </field>
    </record>

</odoo>
