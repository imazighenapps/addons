<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_onboarding_checklist_company" model="ir.rule">
        <field name="name">onboarding.checklist: own company only</field>
        <field name="model_id" ref="model_onboarding_checklist"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_onboarding_checklist_line_company" model="ir.rule">
        <field name="name">onboarding.checklist.line: own company only</field>
        <field name="model_id" ref="model_onboarding_checklist_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
