<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tool_crib_open_list" model="ir.ui.view">
        <field name="name">tool.crib.loan.list</field>
        <field name="model">tool.crib.loan</field>
        <field name="arch" type="xml">
            <list string="Open Loans">
                <field name="due_on"/>
                <field name="borrower_name"/>
                <field name="tool_id"/>
                <field name="issued_on"/>
                <field name="is_late"/>
            </list>
        </field>
    </record>

    <record id="view_tool_crib_open_form" model="ir.ui.view">
        <field name="name">tool.crib.loan.form</field>
        <field name="model">tool.crib.loan</field>
        <field name="arch" type="xml">
            <form string="Open Loans">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="borrower_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Loan">
    <field name="name"/>
    <field name="tool_id"/>
    <field name="borrower_name"/>
    <field name="company_id"/>
                        </group>
                        <group string="Dates">
    <field name="issued_on"/>
    <field name="due_on"/>
    <field name="state"/>
    <field name="returned_on"/>
    <field name="is_late"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tool_crib_open_search" model="ir.ui.view">
        <field name="name">tool.crib.loan.search</field>
        <field name="model">tool.crib.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="borrower_name"/>
                <field name="tool_id"/>
                <separator/>
                <filter name="group_borrower" string="Borrower" context="{'group_by': 'borrower_name'}"/>
            </search>
        </field>
    </record>

    <record id="action_tool_crib_open" model="ir.actions.act_window">
        <field name="name">Open Loans</field>
        <field name="res_model">tool.crib.loan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tools still out of the crib and the people who hold them.</p>
        </field>
    </record>

</odoo>
