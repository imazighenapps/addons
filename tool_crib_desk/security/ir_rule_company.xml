        <field name="name">tool.crib.tool: own company only</field>
        <field name="model_id" ref="model_tool_crib_tool"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_tool_crib_loan_company" model="ir.rule">
        <field name="name">tool.crib.loan: own company only</field>
        <field name="model_id" ref="model_tool_crib_loan"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
