<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_privacy_scan_form" model="ir.ui.view">
        <field name="name">privacy.scan.form</field>
        <field name="model">privacy.scan</field>
        <field name="arch" type="xml">
            <form string="Scan Expired Data">
                <sheet>
                    <group>
                        <group string="Scan">
    <field name="rule_ids"/>
    <field name="dry_run"/>
                        </group>
                    </group>
                    <div class="text-muted">A dry run only counts the expired records. Uncheck it to apply the anonymize, archive or delete action of each rule.</div>
                </sheet>
                <footer><button name="action_scan" type="object" string="Run Scan" class="btn-primary"/><button special="cancel" string="Close" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>

    <record id="action_privacy_scan" model="ir.actions.act_window">
        <field name="name">Scan Expired Data</field>
        <field name="res_model">privacy.scan</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
