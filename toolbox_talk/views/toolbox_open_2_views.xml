<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_toolbox_open_list" model="ir.ui.view">
        <field name="name">toolbox.talk.list</field>
        <field name="model">toolbox.talk</field>
        <field name="arch" type="xml">
            <list string="Open Talks">
                <field name="talk_on"/>
                <field name="name"/>
                <field name="location"/>
                <field name="leader_id"/>
                <field name="attendance_count"/>
            </list>
        </field>
    </record>

    <record id="view_toolbox_open_form" model="ir.ui.view">
        <field name="name">toolbox.talk.form</field>
        <field name="model">toolbox.talk</field>
        <field name="arch" type="xml">
            <form string="Open Talks">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Briefing">
    <field name="name"/>
    <field name="talk_on"/>
    <field name="location"/>
    <field name="leader_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Status">
    <field name="state"/>
    <field name="attendance_count"/>
    <field name="signed_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_toolbox_open_search" model="ir.ui.view">
        <field name="name">toolbox.talk.search</field>
        <field name="model">toolbox.talk</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location"/>
                <field name="leader_id"/>
                <separator/>
                <filter name="group_leader" string="Leader" context="{'group_by': 'leader_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_toolbox_open" model="ir.actions.act_window">
        <field name="name">Open Talks</field>
        <field name="res_model">toolbox.talk</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Briefings planned but not yet completed and recorded.</p>
        </field>
    </record>

</odoo>
