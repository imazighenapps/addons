<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_toolbox_talk_list" model="ir.ui.view">
        <field name="name">toolbox.talk.list</field>
        <field name="model">toolbox.talk</field>
        <field name="arch" type="xml">
            <list string="Toolbox Talks" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="talk_on"/>
                <field name="name"/>
                <field name="location"/>
                <field name="leader_id"/>
                <field name="attendance_count"/>
                <field name="signed_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_toolbox_talk_form" model="ir.ui.view">
        <field name="name">toolbox.talk.form</field>
        <field name="model">toolbox.talk</field>
        <field name="arch" type="xml">
            <form string="Toolbox Talks">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Briefing">
    <field name="name"/>
    <field name="talk_on"/>
    <field name="location"/>
    <field name="leader_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Status">
    <field name="state"/>
    <field name="attendance_count"/>
    <field name="signed_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_toolbox_talk_search" model="ir.ui.view">
        <field name="name">toolbox.talk.search</field>
        <field name="model">toolbox.talk</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location"/>
                <field name="leader_id"/>
                <filter name="planned" string="Planned" domain="[('state','=','planned')]"/>
                <filter name="done" string="Completed" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_leader" string="Leader" context="{'group_by': 'leader_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_toolbox_talk_kanban" model="ir.ui.view">
        <field name="name">toolbox.talk.kanban</field>
        <field name="model">toolbox.talk</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="talk_on"/>
                <field name="leader_id"/>
                <field name="attendance_count"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="talk_on"/>
                        <field name="leader_id"/>
                        <field name="attendance_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_toolbox_talk" model="ir.actions.act_window">
        <field name="name">Toolbox Talks</field>
        <field name="res_model">toolbox.talk</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every safety briefing, its topic, date and who attended.</p>
        </field>
    </record>

</odoo>
