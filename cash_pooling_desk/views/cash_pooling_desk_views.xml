<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="view_cash_pooling_transfer_form" model="ir.ui.view">
  <field name="name">cash.pooling.transfer.form</field><field name="model">cash.pooling.transfer</field>
  <field name="arch" type="xml"><form string="Cash pooling">
    <header>
      <button name="action_compute" type="object" string="Calculer" class="btn-primary" invisible="state!='draft'"/>
      <button name="action_post" type="object" string="Comptabiliser" invisible="state!='computed'"/>
      <button name="action_cancel" type="object" string="Annuler" invisible="state in ('posted','cancelled')"/>
      <field name="state" widget="statusbar" statusbar_visible="draft,computed,posted"/>
    </header>
    <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group>
        <field name="company_id"/><field name="target_company_id"/><field name="direction"/><field name="transfer_date"/>
      </group><group>
        <field name="amount"/><field name="interest_rate"/><field name="interest_amount"/><field name="net_amount"/>
        <field name="currency_id" invisible="1"/>
      </group></group>
      <group string="Notes / justificatif"><field name="notes" nolabel="1"/></group>
    </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
  </form></field>
</record>
<record id="view_cash_pooling_transfer_list" model="ir.ui.view">
  <field name="name">cash.pooling.transfer.list</field><field name="model">cash.pooling.transfer</field>
  <field name="arch" type="xml"><list decoration-success="state=='posted'" decoration-muted="state=='cancelled'">
    <field name="name"/><field name="transfer_date"/><field name="company_id"/><field name="target_company_id"/>
    <field name="direction"/><field name="amount"/><field name="interest_amount"/><field name="state"/>
  </list></field>
</record>
</data></odoo>
