<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_meeting_minute_company" model="ir.rule">
        <field name="name">meeting.minute: own company only</field>
        <field name="model_id" ref="model_meeting_minute"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_meeting_action_company" model="ir.rule">
        <field name="name">meeting.action: own company only</field>
        <field name="model_id" ref="model_meeting_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
