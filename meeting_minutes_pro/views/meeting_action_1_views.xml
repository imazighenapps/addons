<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_meeting_action_list" model="ir.ui.view">
        <field name="name">meeting.action.list</field>
        <field name="model">meeting.action</field>
        <field name="arch" type="xml">
            <list string="Action Items" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="minute_id"/>
                <field name="user_id"/>
                <field name="due_date"/>
                <field name="is_overdue" string="Overdue" widget="boolean"/>
                <field name="state" widget="badge"/>
                <field name="done_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_meeting_action_form" model="ir.ui.view">
        <field name="name">meeting.action.form</field>
        <field name="model">meeting.action</field>
        <field name="arch" type="xml">
            <form string="Action Items">
                <header>
                    <button name="action_done" type="object" string="Done" class="btn-primary" invisible="state != 'todo'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" invisible="state != 'done'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Action">
    <field name="minute_id"/>
    <field name="sequence"/>
    <field name="name"/>
                        </group>
                        <group string="Assignment">
    <field name="user_id"/>
    <field name="due_date"/>
    <field name="done_date"/>
    <field name="state"/>
                        </group>
                        <group string="Follow-up">
    <field name="is_overdue"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_meeting_action_search" model="ir.ui.view">
        <field name="name">meeting.action.search</field>
        <field name="model">meeting.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="minute_id"/>
                <field name="user_id"/>
                <filter name="todo" string="To Do" domain="[('state','=','todo')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/>
                <filter name="mine" string="Assigned to Me" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_user" string="Assigned To" context="{'group_by': 'user_id'}"/>
                <filter name="group_minute" string="Meeting" context="{'group_by': 'minute_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_meeting_action" model="ir.actions.act_window">
        <field name="name">Action Items</field>
        <field name="res_model">meeting.action</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every action of every meeting, with its owner, its due date and its status.</p>
        </field>
    </record>

</odoo>
