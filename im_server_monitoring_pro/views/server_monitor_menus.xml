              name="🖥️ Server Monitor"
              sequence="90"
              groups="im_server_monitoring_pro.group_server_monitor_user"/>

    <!-- Dashboard -->
    <menuitem id="menu_server_monitor_dashboard"
              name="📊 Dashboard"
              parent="menu_server_monitor_root"
              action="action_server_monitor_dashboard"
              sequence="1"
              groups="im_server_monitoring_pro.group_server_monitor_user"/>

    <!-- History -->
    <menuitem id="menu_server_monitor_history_root"
