<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Metrics collection cron (every minute) -->
        <record id="cron_server_monitor_collect" model="ir.cron">
            <field name="name">Server Monitor - Metrics Collection</field>
            <field name="model_id" ref="model_server_monitor_config"/>
            <field name="state">code</field>
            <field name="code">model._collect_metrics()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>

        <!-- Processes refresh cron (every minute) -->
        <record id="cron_server_monitor_refresh_processes" model="ir.cron">
            <field name="name">Server Monitor - Refresh Processes</field>
            <field name="model_id" ref="model_server_monitor_process"/>
            <field name="state">code</field>
            <field name="code">model.refresh_processes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>

        <!-- Weekly cleanup cron -->
        <record id="cron_server_monitor_cleanup" model="ir.cron">
            <field name="name">Server Monitor - History Cleanup</field>
            <field name="model_id" ref="model_server_monitor_config"/>
            <field name="state">code</field>
            <field name="code">
config = model.search([], limit=1)
if config:
    config.action_cleanup_history()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
