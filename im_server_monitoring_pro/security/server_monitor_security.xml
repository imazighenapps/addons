<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Catégorie -->
        <record id="module_server_monitor_category" model="ir.module.category">
            <field name="name">Server Monitor</field>
            <field name="description">Monitoring du serveur Odoo</field>
            <field name="sequence">50</field>
        </record>

        <record id="module_server_monitor_privilege" model="res.groups.privilege">
            <field name="name">Server Monitor</field>
            <field name="category_id" ref="module_server_monitor_category"/>
            <field name="sequence">50</field>
        </record>

        <!-- Groupe utilisateur (lecture seule) -->
        <record id="group_server_monitor_user" model="res.groups">
            <field name="name">Utilisateur Monitoring</field>
            <field name="privilege_id" ref="module_server_monitor_privilege"/>
            <field name="comment">Peut visualiser le dashboard et les métriques</field>
        </record>

        <!-- Groupe manager (peut acquitter les alertes) -->
        <record id="group_server_monitor_manager" model="res.groups">
            <field name="name">Manager Monitoring</field>
            <field name="privilege_id" ref="module_server_monitor_privilege"/>
            <field name="implied_ids" eval="[(4, ref('group_server_monitor_user'))]"/>
            <field name="comment">Peut configurer les seuils et acquitter les alertes</field>
        </record>

        <!-- Groupe administrateur (peut tuer les processus) -->
        <record id="group_server_monitor_admin" model="res.groups">
            <field name="name">Administrateur Monitoring</field>
            <field name="privilege_id" ref="module_server_monitor_privilege"/>
            <field name="implied_ids" eval="[(4, ref('group_server_monitor_manager'))]"/>
            <!-- <field name="users" eval="[(4, ref('base.user_admin'))]"/> -->
            <field name="comment">Accès complet, y compris la gestion des processus</field>
        </record>

    </data>
</odoo>
