<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_interco_transfer_line_list" model="ir.ui.view">
        <field name="name">interco.transfer.line.list</field>
        <field name="model">interco.transfer.line</field>
        <field name="arch" type="xml">
            <list string="Transfer Lines">
                <field name="name"/>
                <field name="transfer_id"/>
                <field name="source_product_id"/>
                <field name="target_product_id"/>
                <field name="product_qty" sum="Total Product Qty"/>
                <field name="price_unit"/>
                <field name="subtotal" sum="Total Subtotal"/>
                <field name="subtotal_sale" sum="Total Subtotal Sale"/>
                <field name="margin" sum="Total Margin"/>
            </list>
        </field>
    </record>

    <record id="view_interco_transfer_line_form" model="ir.ui.view">
        <field name="name">interco.transfer.line.form</field>
        <field name="model">interco.transfer.line</field>
        <field name="arch" type="xml">
            <form string="Transfer Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Products">
    <field name="transfer_id"/>
    <field name="source_product_id"/>
    <field name="target_product_id"/>
                        </group>
                        <group string="Value">
    <field name="product_qty"/>
    <field name="price_unit"/>
    <field name="subtotal"/>
    <field name="subtotal_sale"/>
    <field name="margin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_interco_transfer_line_search" model="ir.ui.view">
        <field name="name">interco.transfer.line.search</field>
        <field name="model">interco.transfer.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="transfer_id"/>
                <separator/>
                <filter name="group_transfer" string="Transfer" context="{'group_by': 'transfer_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_interco_transfer_line" model="ir.actions.act_window">
        <field name="name">Transfer Lines</field>
        <field name="res_model">interco.transfer.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">One line per sold product, with the target product and the transfer price.</p>
        </field>
    </record>

</odoo>
