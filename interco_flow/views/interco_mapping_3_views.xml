<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_interco_mapping_list" model="ir.ui.view">
        <field name="name">interco.mapping.list</field>
        <field name="model">interco.mapping</field>
        <field name="arch" type="xml">
            <list string="Product Mappings">
                <field name="name"/>
                <field name="rule_id"/>
                <field name="source_product_id"/>
                <field name="target_product_id"/>
                <field name="price_unit"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_interco_mapping_form" model="ir.ui.view">
        <field name="name">interco.mapping.form</field>
        <field name="model">interco.mapping</field>
        <field name="arch" type="xml">
            <form string="Product Mappings">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Mapping">
    <field name="rule_id"/>
    <field name="source_product_id"/>
    <field name="target_product_id"/>
    <field name="active"/>
                        </group>
                        <group string="Price">
    <field name="price_unit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_interco_mapping_search" model="ir.ui.view">
        <field name="name">interco.mapping.search</field>
        <field name="model">interco.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="source_product_id"/>
                <field name="target_product_id"/>
                <separator/>
                <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_interco_mapping" model="ir.actions.act_window">
        <field name="name">Product Mappings</field>
        <field name="res_model">interco.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Translate a product of the selling company into a product of the buying company.</p>
        </field>
    </record>

</odoo>
