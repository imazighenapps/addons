<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_interco_rule_list" model="ir.ui.view">
        <field name="name">interco.rule.list</field>
        <field name="model">interco.rule</field>
        <field name="arch" type="xml">
            <list string="Rules">
                <field name="name"/>
                <field name="company_id"/>
                <field name="target_company_id"/>
                <field name="price_mode"/>
                <field name="margin_percent"/>
                <field name="auto_create_po"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_interco_rule_form" model="ir.ui.view">
        <field name="name">interco.rule.form</field>
        <field name="model">interco.rule</field>
        <field name="arch" type="xml">
            <form string="Rules">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Companies">
    <field name="name"/>
    <field name="company_id"/>
    <field name="target_company_id"/>
    <field name="vendor_partner_id"/>
    <field name="active"/>
                        </group>
                        <group string="Price">
    <field name="price_mode"/>
    <field name="margin_percent"/>
    <field name="auto_create_po"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mappings" name="mappingids">
                            <field name="mapping_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_interco_rule_search" model="ir.ui.view">
        <field name="name">interco.rule.search</field>
        <field name="model">interco.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter name="group_company" string="Selling Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_target" string="Buying Company" context="{'group_by': 'target_company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_interco_rule" model="ir.actions.act_window">
        <field name="name">Rules</field>
        <field name="res_model">interco.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set the pair of companies, the transfer price policy and the product mappings.</p>
        </field>
    </record>

</odoo>
