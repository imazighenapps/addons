<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cash_forecast_recurrence_list" model="ir.ui.view">
        <field name="name">cash.forecast.recurrence.list</field>
        <field name="model">cash.forecast.recurrence</field>
        <field name="arch" type="xml">
            <list string="Recurrences">
                <field name="name"/>
                <field name="category"/>
                <field name="amount"/>
                <field name="frequency"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_cash_forecast_recurrence_form" model="ir.ui.view">
        <field name="name">cash.forecast.recurrence.form</field>
        <field name="model">cash.forecast.recurrence</field>
        <field name="arch" type="xml">
            <form string="Recurrences">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Entry">
    <field name="name"/>
    <field name="company_id"/>
    <field name="category"/>
    <field name="partner_id"/>
    <field name="active"/>
                        </group>
                        <group string="Schedule">
    <field name="amount"/>
    <field name="frequency"/>
    <field name="date_start"/>
    <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cash_forecast_recurrence_search" model="ir.ui.view">
        <field name="name">cash.forecast.recurrence.search</field>
        <field name="model">cash.forecast.recurrence</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="group_frequency" string="Frequency" context="{'group_by': 'frequency'}"/>
                <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
            </search>
        </field>
    </record>

    <record id="action_cash_forecast_recurrence" model="ir.actions.act_window">
        <field name="name">Recurrences</field>
        <field name="res_model">cash.forecast.recurrence</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Rent, payroll, tax: the flows that no invoice carries.</p>
        </field>
    </record>

</odoo>
