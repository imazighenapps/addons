<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_sla_case" model="ir.sequence">
        <field name="name">Discuss SLA Case</field>
        <field name="code">discuss.sla</field>
        <field name="prefix">SLA-</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_handover" model="ir.sequence">
        <field name="name">Discuss Handover</field>
        <field name="code">discuss.handover</field>
        <field name="prefix">HO-</field>
        <field name="padding">4</field>
    </record>
    <record id="policy_standard" model="discuss.sla.policy">
        <field name="name">Standard Internal SLA</field>
        <field name="priority">normal</field>
        <field name="first_response_hours">4.0</field>
        <field name="resolution_hours">24.0</field>
        <field name="warn_ratio">0.8</field>
    </record>
    <record id="policy_urgent" model="discuss.sla.policy">
        <field name="name">Urgent Internal SLA</field>
        <field name="priority">high</field>
        <field name="first_response_hours">1.0</field>
        <field name="resolution_hours">4.0</field>
        <field name="warn_ratio">0.7</field>
    </record>
    <record id="cron_sla_check" model="ir.cron">
        <field name="name">Discuss SLA: check breaches</field>
        <field name="model_id" ref="model_discuss_sla_case"/>
        <field name="state">code</field>
        <field name="code">model._cron_check()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="cron_channel_archive" model="ir.cron">
        <field name="name">Discuss: archive idle channels</field>
        <field name="model_id" ref="model_discuss_channel"/>
        <field name="state">code</field>
        <field name="code">model._cron_archive_idle()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>