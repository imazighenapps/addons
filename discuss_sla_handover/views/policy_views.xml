<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sla_policy_list" model="ir.ui.view">
        <field name="name">discuss.sla.policy.list</field>
        <field name="model">discuss.sla.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="priority" widget="badge" decoration-danger="priority == 'high'" decoration-info="priority == 'normal'" decoration-muted="priority == 'low'"/>
                <field name="first_response_hours"/>
                <field name="resolution_hours"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_sla_policy_form" model="ir.ui.view">
        <field name="name">discuss.sla.policy.form</field>
        <field name="model">discuss.sla.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Targets">
                            <field name="company_id"/>
                            <field name="priority"/>
                            <field name="first_response_hours"/>
                            <field name="resolution_hours"/>
                            <field name="warn_ratio"/>
                            <field name="active"/>
                        </group>
                        <group string="Scope">
                            <field name="channel_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sla_policy" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">discuss.sla.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>