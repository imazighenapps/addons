<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_event_rsvp_entry_company" model="ir.rule">
        <field name="name">event_rsvp.entry: own company only</field>
        <field name="model_id" ref="model_event_rsvp_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_event_rsvp_item_company" model="ir.rule">
        <field name="name">event_rsvp.item: own company only</field>
        <field name="model_id" ref="model_event_rsvp_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
