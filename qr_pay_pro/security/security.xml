<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_qrpay_user" model="res.groups">
        <field name="name">QR Pay User</field>
        <field name="comment">Use QR references and the compliance cockpit.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_qrpay_manager" model="res.groups">
        <field name="name">QR Pay Manager</field>
        <field name="comment">Configure sequences, purposes and imports.</field>
        <field name="implied_ids" eval="[(4, ref('qr_pay_pro.group_qrpay_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
