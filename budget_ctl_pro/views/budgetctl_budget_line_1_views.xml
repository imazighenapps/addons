<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_budgetctl_budget_line_list" model="ir.ui.view">
        <field name="name">budget.ctl.line.list</field>
        <field name="model">budget.ctl.line</field>
        <field name="arch" type="xml">
            <list string="Budget Lines">
                <field name="budget_id"/>
                <field name="sequence"/>
                <field name="name"/>
                <field name="planned" sum="Total Planned"/>
                <field name="actual" sum="Total Actual"/>
                <field name="committed" sum="Total Committed"/>
                <field name="available" sum="Total Available"/>
                <field name="note" optional="hide"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_budgetctl_budget_line_form" model="ir.ui.view">
        <field name="name">budget.ctl.line.form</field>
        <field name="model">budget.ctl.line</field>
        <field name="arch" type="xml">
            <form string="Budget Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="budget_id"/>
    <field name="sequence"/>
    <field name="name"/>
                        </group>
                        <group string="Amounts">
    <field name="currency_id"/>
    <field name="planned"/>
    <field name="actual"/>
    <field name="committed"/>
    <field name="available"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budgetctl_budget_line_search" model="ir.ui.view">
        <field name="name">budget.ctl.line.search</field>
        <field name="model">budget.ctl.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="budget_id"/>
                <filter name="overspent" string="Overspent Lines" domain="[('available','&lt;',0)]"/>
                <filter name="with_actual" string="With Actuals" domain="[('actual','&gt;',0)]"/>
                <filter name="with_commitment" string="With Commitments" domain="[('committed','&gt;',0)]"/>
                <separator/>
                <filter name="group_budget" string="Budget" context="{'group_by': 'budget_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_budgetctl_budget_line" model="ir.actions.act_window">
        <field name="name">Budget Lines</field>
        <field name="res_model">budget.ctl.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every budget line of every budget, with its planned, actual, committed and available amounts.</p>
        </field>
    </record>

</odoo>
