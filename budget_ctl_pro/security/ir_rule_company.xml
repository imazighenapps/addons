<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_budget_ctl_company" model="ir.rule">
        <field name="name">budget.ctl: own company only</field>
        <field name="model_id" ref="model_budget_ctl"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_budget_ctl_line_company" model="ir.rule">
        <field name="name">budget.ctl.line: own company only</field>
        <field name="model_id" ref="model_budget_ctl_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
