<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_credit_profile_company" model="ir.rule">
        <field name="name">credit.profile: own company only</field>
        <field name="model_id" ref="model_credit_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_credit_override_company" model="ir.rule">
        <field name="name">credit.override: own company only</field>
        <field name="model_id" ref="model_credit_override"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
