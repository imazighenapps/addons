<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_credit_override_list" model="ir.ui.view">
        <field name="name">credit.override.list</field>
        <field name="model">credit.override</field>
        <field name="arch" type="xml">
            <list string="Override Requests" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="requested_by"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_credit_override_form" model="ir.ui.view">
        <field name="name">credit.override.form</field>
        <field name="model">credit.override</field>
        <field name="arch" type="xml">
            <form string="Override Requests">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_reset" type="object" string="Reset" class="btn-link" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,refused"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Request">
    <field name="partner_id"/>
    <field name="sale_order_id"/>
    <field name="amount"/>
    <field name="date"/>
                        </group>
                        <group string="Decision">
    <field name="requested_by"/>
    <field name="approved_by"/>
    <field name="approved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason" name="reason">
                            <field name="reason"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_credit_override_search" model="ir.ui.view">
        <field name="name">credit.override.search</field>
        <field name="model">credit.override</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="draft" string="To Decide" domain="[('state','=','draft')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_credit_override" model="ir.actions.act_window">
        <field name="name">Override Requests</field>
        <field name="res_model">credit.override</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track every exception to a customer credit limit.</p>
        </field>
    </record>

</odoo>
