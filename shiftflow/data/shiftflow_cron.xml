<odoo noupdate="1">
  <record id="ir_cron_shiftflow_overdue_tasks" model="ir.cron">
    <field name="name">ShiftFlow: Overdue Task Reminder</field>
    <field name="model_id" ref="model_shiftflow_task"/>
    <field name="state">code</field>
    <field name="code">model._cron_overdue_task_reminders()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
  </record>
  <record id="ir_cron_shiftflow_critical_incidents" model="ir.cron">
    <field name="name">ShiftFlow: Critical Incident Alert</field>
    <field name="model_id" ref="model_shiftflow_incident"/>
    <field name="state">code</field>
    <field name="code">model._cron_critical_incident_alerts()</field>
    <field name="interval_number">15</field>
    <field name="interval_type">minutes</field>
    <field name="active">True</field>
  </record>
</odoo>
