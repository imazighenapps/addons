<odoo>
  <record id="mail_template_overdue_task" model="mail.template">
    <field name="name">ShiftFlow - Overdue Task Reminder</field>
    <field name="model_id" ref="model_shiftflow_task"/>
    <field name="subject">ShiftFlow: Overdue task ${object.reference}</field>
    <field name="email_from">${(user.email_formatted or '')}</field>
    <field name="email_to">${(object.responsible_id.email or '')}</field>
    <field name="body_html" type="html">
      <div>
        <p>Hello ${object.responsible_id.name},</p>
        <p>The following ShiftFlow follow-up task is overdue:</p>
        <p><strong>${object.reference} - ${object.name}</strong></p>
        <p>Deadline: ${object.deadline}</p>
        <p>Please update the task status in Odoo.</p>
      </div>
    </field>
  </record>
  <record id="mail_template_critical_incident" model="mail.template">
    <field name="name">ShiftFlow - Critical Incident Alert</field>
    <field name="model_id" ref="model_shiftflow_incident"/>
    <field name="subject">ShiftFlow: Critical incident ${object.reference}</field>
    <field name="email_from">${(user.email_formatted or '')}</field>
    <field name="email_to">${(object.owner_id.email or '')}</field>
    <field name="body_html" type="html">
      <div>
        <p>Hello ${object.owner_id.name},</p>
        <p>A critical operational incident requires attention:</p>
        <p><strong>${object.reference} - ${object.name}</strong></p>
        <p>${object.description}</p>
        <p>Please review it in ShiftFlow.</p>
      </div>
    </field>
  </record>
</odoo>
