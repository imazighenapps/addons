<odoo>
    <record id="group_shiftflow_user" model="res.groups">
        <field name="name">ShiftFlow User</field>
    </record>
    <record id="group_shiftflow_manager" model="res.groups">
        <field name="name">ShiftFlow Manager</field>
        <field name="implied_ids" eval="[(4, ref('shiftflow.group_shiftflow_user'))]"/>
    </record>

    <record id="rule_shiftflow_team_user_company" model="ir.rule">
        <field name="name">ShiftFlow teams: company access</field>
        <field name="model_id" ref="model_shiftflow_team"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('shiftflow.group_shiftflow_user'))]"/>
    </record>
    <record id="rule_shiftflow_shift_user_company" model="ir.rule">
        <field name="name">ShiftFlow shifts: company access</field>
        <field name="model_id" ref="model_shiftflow_shift"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('shiftflow.group_shiftflow_user'))]"/>
    </record>
    <record id="rule_shiftflow_incident_user_company" model="ir.rule">
        <field name="name">ShiftFlow incidents: company access</field>
        <field name="model_id" ref="model_shiftflow_incident"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('shiftflow.group_shiftflow_user'))]"/>
    </record>
    <record id="rule_shiftflow_task_user_company" model="ir.rule">
        <field name="name">ShiftFlow tasks: company access</field>
        <field name="model_id" ref="model_shiftflow_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('shiftflow.group_shiftflow_user'))]"/>
    </record>
    <record id="rule_shiftflow_log_user_company" model="ir.rule">
        <field name="name">ShiftFlow logs: company access</field>
        <field name="model_id" ref="model_shiftflow_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('shiftflow.group_shiftflow_user'))]"/>
    </record>
    <record id="rule_shiftflow_handover_user_company" model="ir.rule">
        <field name="name">ShiftFlow handovers: company access</field>
        <field name="model_id" ref="model_shiftflow_handover"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('shiftflow.group_shiftflow_user'))]"/>
    </record>
    <record id="rule_shiftflow_handover_item_user_company" model="ir.rule">
        <field name="name">ShiftFlow handover items: company access</field>
        <field name="model_id" ref="model_shiftflow_handover_item"/>
        <field name="domain_force">[('handover_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('shiftflow.group_shiftflow_user'))]"/>
    </record>
</odoo>
