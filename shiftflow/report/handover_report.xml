<odoo>
 <record id="action_shiftflow_handover_report" model="ir.actions.report"><field name="name">Shift Handover Report</field><field name="model">shiftflow.handover</field><field name="report_type">qweb-pdf</field><field name="report_name">shiftflow.handover_report_document</field><field name="report_file">shiftflow.handover_report_document</field><field name="binding_model_id" ref="model_shiftflow_handover"/><field name="binding_type">report</field></record>
 <template id="handover_report_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Shift Handover</h2><p><strong>Reference:</strong> <span t-field="o.name"/></p><p><strong>Outgoing Shift:</strong> <span t-field="o.outgoing_shift_id"/></p><p><strong>Incoming Shift:</strong> <span t-field="o.incoming_shift_id"/></p><p><strong>Prepared By:</strong> <span t-field="o.prepared_by_id"/></p><table class="table table-sm"><thead><tr><th>Type</th><th>Description</th><th>Priority</th><th>Carry Over</th></tr></thead><tbody><tr t-foreach="o.item_ids" t-as="line"><td><span t-field="line.item_type"/></td><td><span t-field="line.description"/></td><td><span t-field="line.priority"/></td><td><span t-field="line.carry_over"/></td></tr></tbody></table><h3>Summary</h3><p t-field="o.summary"/></div></t></t></t></template>
</odoo>
