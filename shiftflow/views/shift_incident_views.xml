<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================ -->
  <!-- Incidents                                                    -->
  <!-- ============================================================ -->

  <record id="view_shiftflow_incident_search" model="ir.ui.view">
    <field name="name">shiftflow.incident.search</field>
    <field name="model">shiftflow.incident</field>
    <field name="arch" type="xml">
      <search>
        <field name="reference"/>
        <field name="name"/>
        <field name="shift_id"/>
        <field name="severity"/>
        <field name="state"/>
        <field name="owner_id"/>
        <filter name="open" string="Open" domain="[('state','not in',('resolved','cancelled'))]"/>
        <filter name="critical" string="Critical" domain="[('severity','=','critical'),('state','not in',('resolved','cancelled'))]"/>
        <filter name="carry" string="Carry-over" domain="[('carry_over','=',True)]"/>
        <separator/>
        <filter name="group_severity" string="Severity" context="{'group_by':'severity'}"/>
        <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
        <filter name="group_owner_id" string="Responsible" context="{'group_by':'owner_id'}"/>
        <filter name="group_shift_id" string="Shift" context="{'group_by':'shift_id'}"/>
      </search>
    </field>
  </record>

  <record id="view_shiftflow_incident_list" model="ir.ui.view">
    <field name="name">shiftflow.incident.list</field>
    <field name="model">shiftflow.incident</field>
    <field name="arch" type="xml">
      <list decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'">
        <field name="reference"/>
        <field name="name"/>
        <field name="shift_id"/>
        <field name="severity"/>
        <field name="state"/>
        <field name="owner_id"/>
        <field name="started_at"/>
        <field name="carry_over"/>
      </list>
    </field>
  </record>

  <record id="view_shiftflow_incident_graph" model="ir.ui.view">
    <field name="name">shiftflow.incident.graph</field>
    <field name="model">shiftflow.incident</field>
    <field name="arch" type="xml">
      <graph string="Incidents by Severity" type="bar">
        <field name="severity" type="row"/>
      </graph>
    </field>
  </record>

  <record id="view_shiftflow_incident_pivot" model="ir.ui.view">
    <field name="name">shiftflow.incident.pivot</field>
    <field name="model">shiftflow.incident</field>
    <field name="arch" type="xml">
      <pivot string="Incident Analysis">
        <field name="severity" type="row"/>
        <field name="state" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="view_shiftflow_incident_form" model="ir.ui.view">
    <field name="name">shiftflow.incident.form</field>
    <field name="model">shiftflow.incident</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state == 'resolved'"/>
          <button name="action_reopen" type="object" string="Reopen" invisible="state not in ('resolved','cancelled')"/>
          <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
          <field name="state" widget="statusbar" statusbar_visible="open,investigating,monitoring,resolved"/>
        </header>
        <sheet>
          <h1><field name="name"/></h1>
          <group>
            <field name="reference"/>
            <field name="shift_id"/>
            <field name="started_at"/>
            <field name="resolved_at"/>
            <field name="severity"/>
            <field name="owner_id"/>
            <field name="carry_over"/>
          </group>
          <notebook>
            <page string="Description">
              <field name="description"/>
            </page>
            <page string="Resolution">
              <field name="resolution"/>
            </page>
            <page string="Attachments">
              <field name="attachment_ids" widget="many2many_binary"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_shiftflow_incidents" model="ir.actions.act_window">
    <field name="name">Incidents</field>
    <field name="res_model">shiftflow.incident</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="view_shiftflow_incident_search"/>
  </record>

  <record id="action_shiftflow_incident_analysis" model="ir.actions.act_window">
    <field name="name">Incident Analysis</field>
    <field name="res_model">shiftflow.incident</field>
    <field name="view_mode">graph,pivot,list</field>
    <field name="search_view_id" ref="view_shiftflow_incident_search"/>
  </record>

  <record id="view_shiftflow_incident_kanban" model="ir.ui.view">
    <field name="name">shiftflow.incident.kanban</field>
    <field name="model">shiftflow.incident</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state">
        <field name="reference"/>
        <field name="name"/>
        <field name="severity"/>
        <field name="owner_id"/>
        <field name="shift_id"/>
        <field name="carry_over"/>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <div class="d-flex justify-content-between">
                <strong><field name="reference"/></strong>
                <span class="badge text-bg-danger" invisible="severity != 'critical'">Critical</span>
              </div>
              <div class="mt-1"><field name="name"/></div>
              <div class="text-muted mt-2"><field name="owner_id"/> · <field name="shift_id"/></div>
              <div class="mt-2" invisible="not carry_over">
                <span class="badge text-bg-warning">Carry-over</span>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

</odoo>
