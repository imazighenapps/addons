<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_petty_cash_box_list" model="ir.ui.view">
        <field name="name">petty.cash.box.list</field>
        <field name="model">petty.cash.box</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Boxes">
                <field name="name"/>
                <field name="responsible_id"/>
                <field name="opening_balance"/>
                <field name="balance" sum="Total Balance"/>
                <field name="currency_id"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_box_form" model="ir.ui.view">
        <field name="name">petty.cash.box.form</field>
        <field name="model">petty.cash.box</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Boxes">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Box">
    <field name="name"/>
    <field name="responsible_id"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Balance">
    <field name="currency_id"/>
    <field name="opening_balance"/>
    <field name="balance"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movements" name="movementids">
                            <field name="movement_ids">
                        <list>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="movement_type"/>
                            <field name="category_id"/>
                            <field name="amount" sum="Amount"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="state" widget="badge"/>
                            <field name="company_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Counts" name="countids">
                            <field name="count_ids">
                        <list>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="expected_amount"/>
                            <field name="counted_amount"/>
                            <field name="difference" sum="Difference"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_petty_cash_box_search" model="ir.ui.view">
        <field name="name">petty.cash.box.search</field>
        <field name="model">petty.cash.box</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="responsible_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_petty_cash_box" model="ir.actions.act_window">
        <field name="name">Petty Cash Boxes</field>
        <field name="res_model">petty.cash.box</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create petty cash boxes and track their movements and balance.</p>
        </field>
    </record>

</odoo>
