<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_petty_cash_category_list" model="ir.ui.view">
        <field name="name">petty.cash.category.list</field>
        <field name="model">petty.cash.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_category_form" model="ir.ui.view">
        <field name="name">petty.cash.category.form</field>
        <field name="model">petty.cash.category</field>
        <field name="arch" type="xml">
            <form string="Categories">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Category">
    <field name="name"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_petty_cash_category_search" model="ir.ui.view">
        <field name="name">petty.cash.category.search</field>
        <field name="model">petty.cash.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_petty_cash_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">petty.cash.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Categories to classify petty cash movements.</p>
        </field>
    </record>

</odoo>
