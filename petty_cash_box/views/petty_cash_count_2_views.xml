<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_petty_cash_count_list" model="ir.ui.view">
        <field name="name">petty.cash.count.list</field>
        <field name="model">petty.cash.count</field>
        <field name="arch" type="xml">
            <list string="Cash Counts" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="box_id"/>
                <field name="date"/>
                <field name="expected_amount"/>
                <field name="counted_amount"/>
                <field name="difference" sum="Total Difference"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_count_form" model="ir.ui.view">
        <field name="name">petty.cash.count.form</field>
        <field name="model">petty.cash.count</field>
        <field name="arch" type="xml">
            <form string="Cash Counts">
                <header>
                    <button name="action_done" type="object" string="Confirm Count" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Count">
    <field name="name"/>
    <field name="box_id"/>
    <field name="date"/>
    <field name="state"/>
                        </group>
                        <group string="Amounts">
    <field name="currency_id"/>
    <field name="expected_amount"/>
    <field name="counted_amount"/>
    <field name="difference"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_petty_cash_count_search" model="ir.ui.view">
        <field name="name">petty.cash.count.search</field>
        <field name="model">petty.cash.count</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="box_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_box" string="Box" context="{'group_by': 'box_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_petty_cash_count" model="ir.actions.act_window">
        <field name="name">Cash Counts</field>
        <field name="res_model">petty.cash.count</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Reconcile the counted cash against the expected balance.</p>
        </field>
    </record>

</odoo>
