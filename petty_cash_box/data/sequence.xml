<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_petty_cash_movement" model="ir.sequence">
        <field name="name">Petty Cash Movement</field>
        <field name="code">petty.cash.movement</field>
        <field name="prefix">PCM/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_petty_cash_count" model="ir.sequence">
        <field name="name">Petty Cash Count</field>
        <field name="code">petty.cash.count</field>
        <field name="prefix">PCC/%(year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>
