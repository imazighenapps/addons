<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_meeting_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        
                        <h2 class="mt-4">
                            <span>Meeting Summary</span>
                        </h2>

                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Meeting Title:</strong>
                                <p t-field="o.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Status:</strong>
                                <p>
                                    <span t-if="o.state == 'draft'" class="badge badge-info">Draft</span>
                                    <span t-if="o.state == 'planned'" class="badge badge-warning">Planned</span>
                                    <span t-if="o.state == 'done'" class="badge badge-danger">Done</span>
                                    <span t-if="o.state == 'validated'" class="badge badge-success">Validated</span>
                                </p>
                            </div>
                        </div>

                        <div class="row mt-2 mb-2">
                            <div class="col-6">
                                <strong>Start Date:</strong>
                                <p t-field="o.date_start" t-options='{"widget": "datetime"}'/>
                            </div>
                            <div class="col-6">
                                <strong>End Date:</strong>
                                <p t-field="o.date_end" t-options='{"widget": "datetime"}'/>
                            </div>
                        </div>

                        <div class="row mt-2 mb-2">
                            <div class="col-6">
                                <strong>Planned Duration:</strong>
                                <p>
                                    <span t-field="o.duration_planned" t-options='{"widget": "float_time"}'/> hours
                                </p>
                            </div>
                            <div class="col-6">
                                <strong>Actual Duration:</strong>
                                <p>
                                    <span t-field="o.duration_actual" t-options='{"widget": "float_time"}'/> hours
                                </p>
                            </div>
                        </div>

                        <div class="row mt-2 mb-4" t-if="o.project_id or o.client_id">
                            <div class="col-6" t-if="o.project_id">
                                <strong>Project:</strong>
                                <p t-field="o.project_id.name"/>
                            </div>
                            <div class="col-6" t-if="o.client_id">
                                <strong>Client:</strong>
                                <p t-field="o.client_id.name"/>
                            </div>
                        </div>

                        <h4 class="mt-4 mb-3">Participants</h4>
                        
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr class="bg-light">
                                    <th>User</th>
                                    <th>Role</th>
                                    <th class="text-end">Duration (hours)</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.participant_ids" t-as="participant">
                                    <td>
                                        <span t-field="participant.user_id.name"/>
                                    </td>
                                    <td>
                                        <span t-if="participant.role == 'organizer'" class="badge badge-primary">Organizer</span>
                                        <span t-if="participant.role == 'participant'" class="badge badge-secondary">Participant</span>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="participant.duration_actual" t-options='{"widget": "float_time"}'/>
                                    </td>
                                    <td>
                                        <span t-field="participant.notes"/>
                                    </td>
                                </tr>
                                <tr t-if="not o.participant_ids">
                                    <td colspan="4" class="text-center text-muted">
                                        No participants
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt-4" t-if="o.notes">
                            <div class="col-12">
                                <h4>Notes</h4>
                                <p t-field="o.notes"/>
                            </div>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
