<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meeting_management_tree" model="ir.ui.view">
        <field name="name">meeting.management.tree</field>
        <field name="model">meeting.management</field>
        <field name="arch" type="xml">
            <list string="Meetings" decoration-info="state=='draft'" decoration-success="state=='validated'" decoration-warning="state=='planned'">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration_planned" widget="float_time"/>
                <field name="duration_actual" widget="float_time"/>
                <field name="project_id"/>
                <field name="client_id"/>
                <field name="participant_count"/>
                <field name="state" widget="badge" decoration-info="state=='draft'" decoration-success="state=='validated'" decoration-warning="state=='planned'" decoration-danger="state=='done'"/>
            </list>
        </field>
    </record>

    <record id="view_meeting_management_form" model="ir.ui.view">
        <field name="name">meeting.management.form</field>
        <field name="model">meeting.management</field>
        <field name="arch" type="xml">
            <form string="Meeting">
                <header>
                    <button name="action_set_planned" string="Mark as Planned" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_set_done" string="Mark as Done" type="object" class="oe_highlight" invisible="state != 'planned'"/>
                    <button name="action_validate" string="Validate" type="object" class="oe_highlight" invisible="state != 'done'" groups="im_meeting_management.group_meeting_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,done,validated"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_participants" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="participant_count" widget="statinfo" string="Participants"/>
                        </button>
                        <button name="action_view_project" type="object" class="oe_stat_button" icon="fa-folder" invisible="not project_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Project</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Meeting Title..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration_planned" widget="float_time"/>
                            <field name="duration_actual" widget="float_time"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="client_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General" name="general">
                            <field name="notes" placeholder="Meeting notes..."/>
                        </page>
                        <page string="Participants" name="participants">
                            <field name="participant_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="role"/>
                                    <field name="duration_actual" widget="float_time"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
               
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_meeting_management_search" model="ir.ui.view">
        <field name="name">meeting.management.search</field>
        <field name="model">meeting.management</field>
        <field name="arch" type="xml">
            <search string="Meetings">
                <field name="name" string="Meeting"/>
                <field name="project_id"/>
                <field name="client_id"/>
                <separator/>
                <filter string="My Meetings" name="my_meetings" domain="['|', ('create_uid', '=', uid), ('participant_ids.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Planned" name="planned" domain="[('state', '=', 'planned')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Validated" name="validated" domain="[('state', '=', 'validated')]"/>
                <separator/>
                <filter string="This Month" name="this_month" domain="[('date_start', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')), ('date_start', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <!-- <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Start Date" name="group_date" context="{'group_by': 'date_start'}"/>
                </group> -->
            </search>
        </field>
    </record>

    <record id="view_meeting_management_kanban" model="ir.ui.view">
        <field name="name">meeting.management.kanban</field>
        <field name="model">meeting.management</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration_planned"/>
                <field name="duration_actual"/>
                <field name="project_id"/>
                <field name="client_id"/>
                <field name="participant_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <span class="badge rounded-pill" t-attf-class="badge-{{state == 'draft' ? 'info' : state == 'planned' ? 'warning' : state == 'done' ? 'danger' : 'success'}}">
                                        <field name="state"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <i class="fa fa-calendar"/> <field name="date_start"/>
                                    </div>
                                    <div class="col-6">
                                        <i class="fa fa-clock-o"/> <field name="duration_planned" widget="float_time"/>h
                                    </div>
                                </div>
                                <div class="row" t-if="record.project_id.raw_value">
                                    <div class="col-12">
                                        <i class="fa fa-folder"/> <field name="project_id"/>
                                    </div>
                                </div>
                                <div class="row" t-if="record.client_id.raw_value">
                                    <div class="col-12">
                                        <i class="fa fa-building"/> <field name="client_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <i class="fa fa-users"/> <field name="participant_count"/> participants
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_meeting_management_calendar" model="ir.ui.view">
        <field name="name">meeting.management.calendar</field>
        <field name="model">meeting.management</field>
        <field name="arch" type="xml">
            <calendar string="Meetings" date_start="date_start" date_stop="date_end" color="state" mode="month">
                <field name="name"/>
                <field name="project_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_meeting_management" model="ir.actions.act_window">
        <field name="name">Meetings</field>
        <field name="res_model">meeting.management</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="context">{'search_default_my_meetings': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first meeting
            </p>
            <p>
                Track meetings with projects, clients, and participants.
            </p>
        </field>
    </record>
</odoo>
