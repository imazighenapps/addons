<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meeting_participant_tree" model="ir.ui.view">
        <field name="name">meeting.participant.tree</field>
        <field name="model">meeting.participant</field>
        <field name="arch" type="xml">
            <list string="Participants" editable="bottom">
                <field name="meeting_id"/>
                <field name="user_id"/>
                <field name="role"/>
                <field name="duration_actual" widget="float_time"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_meeting_participant_form" model="ir.ui.view">
        <field name="name">meeting.participant.form</field>
        <field name="model">meeting.participant</field>
        <field name="arch" type="xml">
            <form string="Participant">
                <sheet>
                    <group>
                        <group>
                            <field name="meeting_id"/>
                            <field name="user_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="duration_actual" widget="float_time"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Participant notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_meeting_participant" model="ir.actions.act_window">
        <field name="name">Participants</field>
        <field name="res_model">meeting.participant</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
