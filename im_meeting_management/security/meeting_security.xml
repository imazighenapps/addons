<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_meeting" model="res.groups.privilege">
        <field name="name">Meeting Management</field>
        <field name="category_id" ref="base.module_category_services"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_meeting_user" model="res.groups">
        <field name="name">Meeting User</field>
        <field name="privilege_id" ref="module_category_meeting"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_meeting_manager" model="res.groups">
        <field name="name">Meeting Manager</field>
        <field name="privilege_id" ref="module_category_meeting"/>
        <field name="implied_ids" eval="[(4, ref('group_meeting_user'))]"/>
    </record>

    <record id="meeting_user_rule" model="ir.rule">
        <field name="name">Meeting User Rule</field>
        <field name="model_id" ref="model_meeting_management"/>
        <field name="domain_force">[
            '|',
            ('create_uid', '=', user.id),
            ('participant_ids.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="meeting_manager_rule" model="ir.rule">
        <field name="name">Meeting Manager Rule</field>
        <field name="model_id" ref="model_meeting_management"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
