<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_deferral_line_list" model="ir.ui.view">
        <field name="name">deferral.line.list</field>
        <field name="model">deferral.line</field>
        <field name="arch" type="xml">
            <list string="Deferral Lines" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="schedule_id"/>
                <field name="sequence"/>
                <field name="date"/>
                <field name="amount" sum="Total Amount"/>
                <field name="state" widget="badge"/>
                <field name="move_id"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_deferral_line_form" model="ir.ui.view">
        <field name="name">deferral.line.form</field>
        <field name="model">deferral.line</field>
        <field name="arch" type="xml">
            <form string="Deferral Lines">
                <header>
                    <button name="action_post" type="object" string="Post Line" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group string="Period">
    <field name="schedule_id"/>
    <field name="sequence"/>
    <field name="date"/>
    <field name="state"/>
                        </group>
                        <group string="Amount">
    <field name="amount"/>
    <field name="currency_id"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Journal Entry" name="moveid">
                            <field name="move_id"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deferral_line_search" model="ir.ui.view">
        <field name="name">deferral.line.search</field>
        <field name="model">deferral.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="schedule_id"/>
                <field name="move_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="with_move" string="With Journal Entry" domain="[('move_id','!=',False)]"/>
                <separator/>
                <filter name="group_schedule" string="Schedule" context="{'group_by': 'schedule_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_deferral_line" model="ir.actions.act_window">
        <field name="name">Deferral Lines</field>
        <field name="res_model">deferral.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every period of every schedule, ready to be posted.</p>
        </field>
    </record>

</odoo>
