<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_container_charge_list" model="ir.ui.view">
        <field name="name">container.charge.list</field>
        <field name="model">container.charge</field>
        <field name="arch" type="xml">
            <list string="Container Charges">
                <field name="shipment_id"/>
                <field name="name"/>
                <field name="charge_type"/>
                <field name="payer"/>
                <field name="amount" sum="Total Amount"/>
                <field name="settled"/>
            </list>
        </field>
    </record>

    <record id="view_container_charge_form" model="ir.ui.view">
        <field name="name">container.charge.form</field>
        <field name="model">container.charge</field>
        <field name="arch" type="xml">
            <form string="Container Charges">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Charge">
    <field name="shipment_id"/>
    <field name="name"/>
    <field name="charge_type"/>
    <field name="payer"/>
                        </group>
                        <group string="Amount">
    <field name="amount"/>
    <field name="currency_id"/>
    <field name="settled"/>
    <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_container_charge_search" model="ir.ui.view">
        <field name="name">container.charge.search</field>
        <field name="model">container.charge</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="shipment_id"/>
                <filter name="unsettled" string="Unsettled" domain="[('settled','=',False)]"/>
                <separator/>
                <filter name="group_shipment" string="Container" context="{'group_by': 'shipment_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'charge_type'}"/>
                <filter name="group_payer" string="Payer" context="{'group_by': 'payer'}"/>
            </search>
        </field>
    </record>

    <record id="action_container_charge" model="ir.actions.act_window">
        <field name="name">Container Charges</field>
        <field name="res_model">container.charge</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">All container charges and who owes them.</p>
        </field>
    </record>

</odoo>
