<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_container_shipment_company" model="ir.rule">
        <field name="name">container.shipment: own company only</field>
        <field name="model_id" ref="model_container_shipment"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_container_charge_company" model="ir.rule">
        <field name="name">container.charge: own company only</field>
        <field name="model_id" ref="model_container_charge"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
