<odoo>
  <record id="rule_duplicate_match_sales_company" model="ir.rule">
    <field name="name">Duplicate matches: company scope</field>
    <field name="model_id" ref="model_fs_sale_order_duplicate_match"/>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_duplicate_match_manager_company" model="ir.rule">
    <field name="name">Duplicate matches manager: company scope</field>
    <field name="model_id" ref="model_fs_sale_order_duplicate_match"/>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_duplicate_config_company" model="ir.rule">
    <field name="name">Duplicate configuration: company scope</field>
    <field name="model_id" ref="model_fs_sale_order_duplicate_config"/>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
