<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rebate_contract_list" model="ir.ui.view">
        <field name="name">rebate.contract.list</field>
        <field name="model">rebate.contract</field>
        <field name="arch" type="xml">
            <list string="Rebate Contracts" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="rate"/>
                <field name="accrued_amount"/>
                <field name="settled_amount"/>
                <field name="remaining_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_rebate_contract_form" model="ir.ui.view">
        <field name="name">rebate.contract.form</field>
        <field name="model">rebate.contract</field>
        <field name="arch" type="xml">
            <form string="Rebate Contracts">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Contract">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Period">
    <field name="date_start"/>
    <field name="date_end"/>
    <field name="rate"/>
    <field name="target_amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Amounts">
    <field name="accrued_amount"/>
    <field name="settled_amount"/>
    <field name="remaining_amount"/>
    <field name="state"/>
    <field name="settled_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accruals" name="accrualids">
                            <field name="accrual_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rebate_contract_search" model="ir.ui.view">
        <field name="name">rebate.contract.search</field>
        <field name="model">rebate.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="open" string="Open" domain="[('state','=','open')]"/>
                <filter name="settled" string="Settled" domain="[('state','=','settled')]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_rebate_contract_kanban" model="ir.ui.view">
        <field name="name">rebate.contract.kanban</field>
        <field name="model">rebate.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="accrued_amount"/>
                <field name="remaining_amount"/>
                <field name="date_end"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="accrued_amount"/>
                        <field name="remaining_amount"/>
                        <field name="date_end"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_rebate_contract" model="ir.actions.act_window">
        <field name="name">Rebate Contracts</field>
        <field name="res_model">rebate.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every promised rebate in one place: who earns it, how fast it grows and what is left to settle.</p>
        </field>
    </record>

</odoo>
