<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_oee_desk_entry_company" model="ir.rule">
        <field name="name">oee_desk.entry: own company only</field>
        <field name="model_id" ref="model_oee_desk_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_oee_desk_item_company" model="ir.rule">
        <field name="name">oee_desk.item: own company only</field>
        <field name="model_id" ref="model_oee_desk_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
