<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_cycle_count" model="ir.cron">
        <field name="name">CycleCountPro: create due sessions</field>
        <field name="model_id" ref="model_cycle_count_plan"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_sessions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
