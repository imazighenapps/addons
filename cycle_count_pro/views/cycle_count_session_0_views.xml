<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cycle_count_session_list" model="ir.ui.view">
        <field name="name">cycle.count.session.list</field>
        <field name="model">cycle.count.session</field>
        <field name="arch" type="xml">
            <list string="Count Sessions" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="warehouse_id"/>
                <field name="responsible_id"/>
                <field name="line_count" string="Lines"/>
                <field name="counted_count" string="Counted"/>
                <field name="total_difference" string="Variance" sum="Total Variance"/>
                <field name="variance_value" string="Value Variance" sum="Total Value Variance"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cycle_count_session_form" model="ir.ui.view">
        <field name="name">cycle.count.session.form</field>
        <field name="model">cycle.count.session</field>
        <field name="arch" type="xml">
            <form string="Count Sessions">
                <header>
                    <button name="action_start" type="object" string="Start Counting" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_finish" type="object" string="Send to Review" class="btn-primary" invisible="state != 'counting'"/>
                    <button name="action_validate" type="object" string="Validate and Adjust" class="btn-success" invisible="state != 'review'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state not in ('counting', 'review')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,counting,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Session">
    <field name="plan_id"/>
    <field name="warehouse_id"/>
    <field name="date"/>
    <field name="responsible_id"/>
    <field name="state"/>
                        </group>
                        <group string="Variance">
    <field name="line_count"/>
    <field name="counted_count"/>
    <field name="total_difference"/>
    <field name="variance_value"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Count Lines" name="lineids">
                            <field name="line_ids"><list editable="bottom"><field name="product_id"/><field name="location_id"/><field name="theoretical_qty"/><field name="counted_qty"/><field name="is_counted"/><field name="difference"/><field name="value_difference"/><field name="state"/><field name="note" optional="hide"/></list></field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cycle_count_session_search" model="ir.ui.view">
        <field name="name">cycle.count.session.search</field>
        <field name="model">cycle.count.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="responsible_id"/>
                <filter name="counting" string="Counting" domain="[('state','=','counting')]"/>
                <filter name="review" string="To Review" domain="[('state','=','review')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_cycle_count_session" model="ir.actions.act_window">
        <field name="name">Count Sessions</field>
        <field name="res_model">cycle.count.session</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Start a session from a plan, count, review and post.</p>
        </field>
    </record>

</odoo>
