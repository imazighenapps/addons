<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cycle_count_line_list" model="ir.ui.view">
        <field name="name">cycle.count.line.list</field>
        <field name="model">cycle.count.line</field>
        <field name="arch" type="xml">
            <list string="Variance Lines" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="session_id"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="theoretical_qty" sum="Total Theoretical Qty"/>
                <field name="counted_qty" sum="Total Counted Qty"/>
                <field name="difference" sum="Total Difference"/>
                <field name="value_difference" sum="Total Value Difference"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cycle_count_line_form" model="ir.ui.view">
        <field name="name">cycle.count.line.form</field>
        <field name="model">cycle.count.line</field>
        <field name="arch" type="xml">
            <form string="Variance Lines">
                <sheet>
                    <group>
                        <group string="Line">
    <field name="session_id"/>
    <field name="product_id"/>
    <field name="location_id"/>
                        </group>
                        <group string="Quantities">
    <field name="theoretical_qty"/>
    <field name="counted_qty"/>
    <field name="is_counted"/>
    <field name="difference"/>
    <field name="value_difference"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cycle_count_line_search" model="ir.ui.view">
        <field name="name">cycle.count.line.search</field>
        <field name="model">cycle.count.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="session_id"/>
                <field name="location_id"/>
                <filter name="variance" string="With Variance" domain="[('difference','!=',0)]"/>
                <filter name="adjusted" string="Adjusted" domain="[('state','=','adjusted')]"/>
                <separator/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="group_session" string="Session" context="{'group_by': 'session_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_cycle_count_line" model="ir.actions.act_window">
        <field name="name">Variance Lines</field>
        <field name="res_model">cycle.count.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every counted line, with its variance and value.</p>
        </field>
    </record>

</odoo>
