<odoo>
    <record id="action_qms_training_course" model="ir.actions.act_window">
        <field name="name">Training Courses</field>
        <field name="res_model">qms.training.course</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_qms_training_assignment" model="ir.actions.act_window">
        <field name="name">Training Assignments</field>
        <field name="res_model">qms.training.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_qms_competency_requirement" model="ir.actions.act_window">
        <field name="name">Competency Requirements</field>
        <field name="res_model">qms.competency.requirement</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_qms_employee_competency" model="ir.actions.act_window">
        <field name="name">Employee Competencies</field>
        <field name="res_model">qms.employee.competency</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_qms_training_course_tree" model="ir.ui.view">
        <field name="name">qms.training.course.tree</field>
        <field name="model">qms.training.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="course_type"/>
                <field name="owner_id"/>
                <field name="assignment_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_qms_training_course_form" model="ir.ui.view">
        <field name="name">qms.training.course.form</field>
        <field name="model">qms.training.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box">
                        <button name="%(action_qms_training_assignment)d" type="action" class="oe_stat_button" icon="fa-users">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="course_type"/>
                            <field name="owner_id"/>
                            <field name="validity_days"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Linked Records">
                        <field name="requirement_ids" widget="many2many_tags"/>
                        <field name="document_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Assignments">
                            <field name="assignment_ids">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="assigned_date"/>
                                    <field name="due_date"/>
                                    <field name="expiry_date"/>
                                    <field name="state"/>
                                    <field name="score"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_qms_training_assignment_tree" model="ir.ui.view">
        <field name="name">qms.training.assignment.tree</field>
        <field name="model">qms.training.assignment</field>
        <field name="arch" type="xml">
            <list>
                <field name="course_id"/>
                <field name="employee_id"/>
                <field name="assigned_date"/>
                <field name="due_date"/>
                <field name="completed_date"/>
                <field name="expiry_date"/>
                <field name="score"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_qms_training_assignment_form" model="ir.ui.view">
        <field name="name">qms.training.assignment.form</field>
        <field name="model">qms.training.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_completed" string="Mark Completed" type="object" class="btn-primary" invisible="state != 'assigned'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('completed','expired','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="assigned,completed,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="course_id"/>
                            <field name="employee_id"/>
                            <field name="assigned_date"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="completed_date"/>
                            <field name="expiry_date"/>
                            <field name="score"/>
                            <field name="minimum_score"/>
                        </group>
                    </group>
                    <group string="Linked Evidence">
                        <field name="evidence_ids" widget="many2many_tags"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_qms_competency_requirement_tree" model="ir.ui.view">
        <field name="name">qms.competency.requirement.tree</field>
        <field name="model">qms.competency.requirement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="role_name"/>
                <field name="level"/>
                <field name="mandatory"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_qms_competency_requirement_form" model="ir.ui.view">
        <field name="name">qms.competency.requirement.form</field>
        <field name="model">qms.competency.requirement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="role_name"/>
                            <field name="level"/>
                        </group>
                        <group>
                            <field name="mandatory"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Linked Records">
                        <field name="process_ids" widget="many2many_tags"/>
                        <field name="course_ids" widget="many2many_tags"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_qms_employee_competency_tree" model="ir.ui.view">
        <field name="name">qms.employee.competency.tree</field>
        <field name="model">qms.employee.competency</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="requirement_id"/>
                <field name="achieved_level"/>
                <field name="assessment_date"/>
                <field name="expiry_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="view_qms_employee_competency_form" model="ir.ui.view">
        <field name="name">qms.employee.competency.form</field>
        <field name="model">qms.employee.competency</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="requirement_id"/>
                            <field name="achieved_level"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="assessment_date"/>
                            <field name="expiry_date"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <field name="evidence_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
