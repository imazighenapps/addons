<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_inventory_line_list" model="ir.ui.view">
        <field name="name">asset.inventory.line.list</field>
        <field name="model">asset.inventory.line</field>
        <field name="arch" type="xml">
            <list string="Count Lines">
                <field name="inventory_id"/>
                <field name="asset_tag"/>
                <field name="asset_name"/>
                <field name="expected_location"/>
                <field name="result" widget="badge"/>
                <field name="observed_location"/>
                <field name="checked_on"/>
            </list>
        </field>
    </record>

    <record id="view_asset_inventory_line_form" model="ir.ui.view">
        <field name="name">asset.inventory.line.form</field>
        <field name="model">asset.inventory.line</field>
        <field name="arch" type="xml">
            <form string="Count Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="asset_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Asset">
    <field name="inventory_id"/>
    <field name="asset_tag"/>
    <field name="asset_name"/>
    <field name="company_id"/>
                        </group>
                        <group string="Check">
    <field name="expected_location"/>
    <field name="result"/>
    <field name="observed_location"/>
    <field name="checked_on"/>
    <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_inventory_line_search" model="ir.ui.view">
        <field name="name">asset.inventory.line.search</field>
        <field name="model">asset.inventory.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_tag"/>
                <field name="asset_name"/>
                <field name="inventory_id"/>
                <filter name="found" string="Found" domain="[('result','=','found')]"/>
                <filter name="missing" string="Missing" domain="[('result','=','missing')]"/>
                <filter name="moved" string="Moved" domain="[('result','=','moved')]"/>
                <separator/>
                <filter name="group_campaign" string="Campaign" context="{'group_by': 'inventory_id'}"/>
                <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
            </search>
        </field>
    </record>

    <record id="action_asset_inventory_line" model="ir.actions.act_window">
        <field name="name">Count Lines</field>
        <field name="res_model">asset.inventory.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every asset checked on the floor with its result.</p>
        </field>
    </record>

</odoo>
