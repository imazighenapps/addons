<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_inventory_list" model="ir.ui.view">
        <field name="name">asset.inventory.list</field>
        <field name="model">asset.inventory</field>
        <field name="arch" type="xml">
            <list string="Asset Counts" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="responsible_id"/>
                <field name="planned_date"/>
                <field name="line_count"/>
                <field name="found_count"/>
                <field name="missing_count"/>
                <field name="moved_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_asset_inventory_form" model="ir.ui.view">
        <field name="name">asset.inventory.form</field>
        <field name="model">asset.inventory</field>
        <field name="arch" type="xml">
            <form string="Asset Counts">
                <header>
                    <button name="action_start" type="object" string="Start Count" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Campaign">
    <field name="name"/>
    <field name="responsible_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Schedule">
    <field name="planned_date"/>
    <field name="closed_on"/>
                        </group>
                        <group string="Results">
    <field name="line_count"/>
    <field name="found_count"/>
    <field name="missing_count"/>
    <field name="moved_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assets" name="lineids">
                            <field name="line_ids" readonly="state == 'closed'">
                        <list editable="bottom">
                            <field name="asset_tag"/>
                            <field name="asset_name"/>
                            <field name="expected_location"/>
                            <field name="result"/>
                            <field name="observed_location"/>
                            <field name="checked_on"/>
                            <field name="note"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_inventory_search" model="ir.ui.view">
        <field name="name">asset.inventory.search</field>
        <field name="model">asset.inventory</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="responsible_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <filter name="open" string="Open Campaigns" domain="[('state','in',('draft','in_progress'))]"/>
                <separator/>
                <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_asset_inventory_kanban" model="ir.ui.view">
        <field name="name">asset.inventory.kanban</field>
        <field name="model">asset.inventory</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="planned_date"/>
                <field name="line_count"/>
                <field name="missing_count"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="planned_date"/>
                        <field name="line_count"/>
                        <field name="missing_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_asset_inventory" model="ir.actions.act_window">
        <field name="name">Asset Counts</field>
        <field name="res_model">asset.inventory</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan a floor count and reconcile the register with what really exists.</p>
        </field>
    </record>

</odoo>
