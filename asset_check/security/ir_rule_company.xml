<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_asset_inventory_company" model="ir.rule">
        <field name="name">asset.inventory: own company only</field>
        <field name="model_id" ref="model_asset_inventory"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_asset_inventory_line_company" model="ir.rule">
        <field name="name">asset.inventory.line: own company only</field>
        <field name="model_id" ref="model_asset_inventory_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
