<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_gdpr_request_connection_company" model="ir.rule">
        <field name="name">gdpr_request.connection: own company only</field>
        <field name="model_id" ref="model_gdpr_request_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_gdpr_request_record_company" model="ir.rule">
        <field name="name">gdpr_request.record: own company only</field>
        <field name="model_id" ref="model_gdpr_request_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
