<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_locker_locker_company" model="ir.rule">
        <field name="name">locker.locker: own company only</field>
        <field name="model_id" ref="model_locker_locker"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_locker_assignment_company" model="ir.rule">
        <field name="name">locker.assignment: own company only</field>
        <field name="model_id" ref="model_locker_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
