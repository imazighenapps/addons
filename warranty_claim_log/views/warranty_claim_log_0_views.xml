<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_warranty_claim_log_list" model="ir.ui.view">
        <field name="name">warranty.claim.log.list</field>
        <field name="model">warranty.claim.log</field>
        <field name="arch" type="xml">
            <list string="Warranty Claims" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <field name="claim_date"/>
                <field name="planned_date"/>
                <field name="state" widget="badge"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_warranty_claim_log_form" model="ir.ui.view">
        <field name="name">warranty.claim.log.form</field>
        <field name="model">warranty.claim.log</field>
        <field name="arch" type="xml">
            <form string="Warranty Claims">
                <header>
                    <button name="action_review" type="object" string="Send to Review" class="btn-primary" invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'review'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state != 'review'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state not in ('rejected', 'resolved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,approved,resolved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Claim">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="product_id"/>
    <field name="sale_order_id"/>
    <field name="serial_ref"/>
    <field name="company_id"/>
                        </group>
                        <group string="Schedule">
    <field name="claim_date"/>
    <field name="received_date"/>
    <field name="planned_date"/>
    <field name="user_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issue Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Resolution" name="resolution">
                            <field name="resolution"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_warranty_claim_log_search" model="ir.ui.view">
        <field name="name">warranty.claim.log.search</field>
        <field name="model">warranty.claim.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="review" string="In Review" domain="[('state','=','review')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="resolved" string="Resolved" domain="[('state','=','resolved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="group_responsible" string="Responsible" context="{'group_by': 'user_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_warranty_claim_log_graph" model="ir.ui.view">
        <field name="name">warranty.claim.log.graph</field>
        <field name="model">warranty.claim.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_warranty_claim_log" model="ir.actions.act_window">
        <field name="name">Warranty Claims</field>
        <field name="res_model">warranty.claim.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register and track warranty claims.</p>
        </field>
    </record>

</odoo>
