<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_brevo_event_log_list" model="ir.ui.view">
        <field name="name">brevo.event.log.list</field>
        <field name="model">brevo.event.log</field>
        <field name="arch" type="xml">
            <list string="Event Logs">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="contact_sync_id"/>
                <field name="event_type"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_brevo_event_log_form" model="ir.ui.view">
        <field name="name">brevo.event.log.form</field>
        <field name="model">brevo.event.log</field>
        <field name="arch" type="xml">
            <form string="Event Logs">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="event_type" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Event">
    <field name="connection_id"/>
    <field name="contact_sync_id"/>
    <field name="event_type"/>
    <field name="message"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_brevo_event_log_search" model="ir.ui.view">
        <field name="name">brevo.event.log.search</field>
        <field name="model">brevo.event.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="connection_id"/>
                <separator/>
                <filter name="group_event" string="Event" context="{'group_by': 'event_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_brevo_event_log" model="ir.actions.act_window">
        <field name="name">Event Logs</field>
        <field name="res_model">brevo.event.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Brevo engagement and sync events.</p>
        </field>
    </record>

</odoo>
