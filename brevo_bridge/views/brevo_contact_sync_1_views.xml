<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_brevo_contact_sync_list" model="ir.ui.view">
        <field name="name">brevo.contact.sync.list</field>
        <field name="model">brevo.contact.sync</field>
        <field name="arch" type="xml">
            <list string="Contacts" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="partner_id"/>
                <field name="email"/>
                <field name="list_id"/>
                <field name="opt_in"/>
                <field name="state" widget="badge"/>
                <field name="brevo_contact_id"/>
                <field name="last_sync_at"/>
            </list>
        </field>
    </record>

    <record id="view_brevo_contact_sync_form" model="ir.ui.view">
        <field name="name">brevo.contact.sync.form</field>
        <field name="model">brevo.contact.sync</field>
        <field name="arch" type="xml">
            <form string="Contacts">
                <header>
                    <button name="action_prepare" type="object" string="Prepare" class="btn-primary" invisible="state not in ('draft','error')"/>
                    <button name="action_sync" type="object" string="Sync" class="btn-primary" invisible="state != 'ready'"/>
                    <button name="action_reset" type="object" string="Reset" class="btn-secondary" invisible="False"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,synced,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Contact">
    <field name="connection_id"/>
    <field name="partner_id"/>
    <field name="email"/>
    <field name="list_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Sync">
    <field name="opt_in"/>
    <field name="state"/>
    <field name="brevo_contact_id"/>
    <field name="last_sync_at"/>
    <field name="error_message"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_brevo_contact_sync_search" model="ir.ui.view">
        <field name="name">brevo.contact.sync.search</field>
        <field name="model">brevo.contact.sync</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="email"/>
                <field name="brevo_contact_id"/>
                <filter name="synced" string="Synced" domain="[('state','=','synced')]"/>
                <filter name="ready" string="Ready" domain="[('state','=','ready')]"/>
                <filter name="optin" string="Opt-in" domain="[('opt_in','=',True)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_list" string="List" context="{'group_by': 'list_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_brevo_contact_sync" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">brevo.contact.sync</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sync contacts with Brevo.</p>
        </field>
    </record>

</odoo>
