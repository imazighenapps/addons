<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_brevo_connection_list" model="ir.ui.view">
        <field name="name">brevo.connection.list</field>
        <field name="model">brevo.connection</field>
        <field name="arch" type="xml">
            <list string="Connections" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="company_id"/>
                <field name="sender_email"/>
                <field name="state" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_brevo_connection_form" model="ir.ui.view">
        <field name="name">brevo.connection.form</field>
        <field name="model">brevo.connection</field>
        <field name="arch" type="xml">
            <form string="Connections">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary" invisible="False"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Connection">
    <field name="name"/>
    <field name="company_id"/>
    <field name="state"/>
    <field name="active"/>
                        </group>
                        <group string="Brevo">
    <field name="api_key"/>
    <field name="sender_name"/>
    <field name="sender_email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contacts" name="contactids">
                            <field name="contact_ids" readonly="1">
                        <list><field name="partner_id"/><field name="email"/><field name="list_id"/>
                        <field name="opt_in"/><field name="state" widget="badge"/><field name="last_sync_at"/></list>
                     </field>
                        </page>
                        <page string="Lists" name="listids">
                            <field name="list_ids"><list editable="bottom">
                        <field name="name"/><field name="brevo_list_id"/><field name="contact_count"/>
                     </list></field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_brevo_connection_search" model="ir.ui.view">
        <field name="name">brevo.connection.search</field>
        <field name="model">brevo.connection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sender_email"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_brevo_connection" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">brevo.connection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure Brevo and manage synced contacts.</p>
        </field>
    </record>

</odoo>
