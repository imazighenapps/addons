<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_shift_swap_entry_company" model="ir.rule">
        <field name="name">shift_swap.entry: own company only</field>
        <field name="model_id" ref="model_shift_swap_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_shift_swap_item_company" model="ir.rule">
        <field name="name">shift_swap.item: own company only</field>
        <field name="model_id" ref="model_shift_swap_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
