    <record id="rule_gsheets_job_company" model="ir.rule">
        <field name="name">gsheets.job: own company only</field>
        <field name="model_id" ref="model_gsheets_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
