<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gsheets_connection_list" model="ir.ui.view">
        <field name="name">gsheets.connection.list</field>
        <field name="model">gsheets.connection</field>
        <field name="arch" type="xml">
            <list string="Connections" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="company_id"/>
                <field name="spreadsheet_id"/>
                <field name="sheet_name"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_gsheets_connection_form" model="ir.ui.view">
        <field name="name">gsheets.connection.form</field>
        <field name="model">gsheets.connection</field>
        <field name="arch" type="xml">
            <form string="Connections">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state == 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Connection">
    <field name="name"/>
    <field name="company_id"/>
    <field name="spreadsheet_id"/>
    <field name="sheet_name"/>
    <field name="state"/>
    <field name="active"/>
                        </group>
                        <group string="Credentials">
    <field name="credential_ref"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Jobs" name="jobids">
                            <field name="job_ids"><list><field name="sequence" widget="handle"/><field name="name"/>
                    <field name="model_name"/><field name="last_status" widget="badge"/><field name="last_run_at"/></list></field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gsheets_connection_search" model="ir.ui.view">
        <field name="name">gsheets.connection.search</field>
        <field name="model">gsheets.connection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="spreadsheet_id"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_gsheets_connection" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">gsheets.connection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure Google Sheets connections.</p>
        </field>
    </record>

</odoo>
