<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gsheets_job_list" model="ir.ui.view">
        <field name="name">gsheets.job.list</field>
        <field name="model">gsheets.job</field>
        <field name="arch" type="xml">
            <list string="Export Jobs">
                <field name="sequence"/>
                <field name="name"/>
                <field name="connection_id"/>
                <field name="model_name"/>
                <field name="last_status" widget="badge"/>
                <field name="last_run_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_gsheets_job_form" model="ir.ui.view">
        <field name="name">gsheets.job.form</field>
        <field name="model">gsheets.job</field>
        <field name="arch" type="xml">
            <form string="Export Jobs">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Job">
    <field name="name"/>
    <field name="sequence"/>
    <field name="connection_id"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Export">
    <field name="model_name"/>
    <field name="field_names"/>
    <field name="domain_filter"/>
    <field name="last_run_at"/>
    <field name="last_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Runs" name="runids">
                            <field name="run_ids" readonly="1"><list><field name="create_date"/><field name="status" widget="badge"/>
                    <field name="row_count"/><field name="message"/></list></field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gsheets_job_search" model="ir.ui.view">
        <field name="name">gsheets.job.search</field>
        <field name="model">gsheets.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_name"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_connection" string="Connection" context="{'group_by': 'connection_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_gsheets_job" model="ir.actions.act_window">
        <field name="name">Export Jobs</field>
        <field name="res_model">gsheets.job</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define and run Google Sheets exports.</p>
        </field>
    </record>

</odoo>
