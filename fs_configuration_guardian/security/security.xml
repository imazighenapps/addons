<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: security groups are organized through res.groups.privilege. -->
    <record id="privilege_configuration_guardian" model="res.groups.privilege">
        <field name="name">Configuration Guardian</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_administration"/>
        <field name="description">Access levels for Configuration Guardian.</field>
    </record>

    <record id="group_guardian_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_configuration_guardian"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can review baselines, snapshots and detected configuration changes.</field>
    </record>

    <record id="group_guardian_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_configuration_guardian"/>
        <field name="implied_ids" eval="[(4, ref('group_guardian_user'))]"/>
        <field name="comment">Can manage baselines, risk rules and configuration governance.</field>
    </record>
</odoo>
