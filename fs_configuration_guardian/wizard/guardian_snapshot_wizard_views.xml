<odoo>
    <record id="guardian_snapshot_wizard_form" model="ir.ui.view">
        <field name="name">fs.guardian.snapshot.wizard.form</field>
        <field name="model">fs.guardian.snapshot.wizard</field>
        <field name="arch" type="xml">
            <form string="Scan Configuration">
                <group>
                    <field name="baseline_id"/>
                </group>
                <footer>
                    <button name="action_create_and_compare" type="object" string="Scan &amp; Compare" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
