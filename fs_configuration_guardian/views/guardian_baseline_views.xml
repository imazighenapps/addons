<odoo>
    <record id="guardian_baseline_kanban" model="ir.ui.view">
        <field name="name">fs.guardian.baseline.kanban</field>
        <field name="model">fs.guardian.baseline</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/><field name="company_id"/><field name="state"/><field name="change_count"/>
                <templates><t t-name="card">
                    <div class="oe_kanban_global_click">
                        <strong><field name="name"/></strong>
                        <div><field name="company_id"/></div>
                        <div class="mt8">Status: <field name="state"/></div>
                        <div>Changes: <field name="change_count"/></div>
                    </div>
                </t></templates>
            </kanban>
        </field>
    </record>
    <record id="guardian_baseline_list" model="ir.ui.view">
        <field name="name">fs.guardian.baseline.list</field>
        <field name="model">fs.guardian.baseline</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'archived'">
                <field name="name"/><field name="company_id"/><field name="state"/><field name="snapshot_id"/><field name="change_count"/><field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="guardian_baseline_form" model="ir.ui.view">
        <field name="name">fs.guardian.baseline.form</field>
        <field name="model">fs.guardian.baseline</field>
        <field name="arch" type="xml">
            <form string="Configuration Baseline">
                <header>
                    <button name="action_create_snapshot" type="object" string="Create Production Baseline" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_scan_now" type="object" string="Scan &amp; Compare" class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_archive_baseline" type="object" string="Archive" invisible="state == 'archived'"/>
                    <button name="action_reactivate" type="object" string="Reactivate" invisible="state != 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_changes" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="change_count" widget="statinfo" string="Changes"/>
                        </button>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'active'">
                        <strong>Configuration Health:</strong> <field name="health_score"/> / 100
                        &amp;nbsp; | &amp;nbsp; Critical: <field name="critical_count"/>
                        &amp;nbsp; | &amp;nbsp; High: <field name="high_count"/>
                        &amp;nbsp; | &amp;nbsp; Medium: <field name="medium_count"/>
                    </div>
                    <group>
                        <group><field name="name"/><field name="company_id"/><field name="snapshot_id" readonly="1"/></group>
                        <group><field name="description"/><field name="snapshot_count" readonly="1"/><field name="last_scan_at" readonly="1"/></group>
                    </group>
                    <notebook>
                        <page string="Governance">
                            <p class="text-muted">A baseline is a trusted reference point. Future scans compare the current configuration against this state and create reviewable changes.</p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
