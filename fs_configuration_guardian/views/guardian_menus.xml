<odoo>
    <record id="action_guardian_baselines" model="ir.actions.act_window">
        <field name="name">Baselines</field>
        <field name="res_model">fs.guardian.baseline</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="action_guardian_changes" model="ir.actions.act_window">
        <field name="name">Configuration Changes</field>
        <field name="res_model">fs.guardian.change</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="guardian_change_search"/>
    </record>
    <record id="action_guardian_snapshots" model="ir.actions.act_window">
        <field name="name">Snapshots</field>
        <field name="res_model">fs.guardian.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_guardian_rules" model="ir.actions.act_window">
        <field name="name">Rules</field>
        <field name="res_model">fs.guardian.rule</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="guardian_root_menu" name="Configuration Guardian" sequence="50" groups="group_guardian_user" web_icon="fs_configuration_guardian,static/description/icon.png"/>
        <menuitem id="guardian_menu_dashboard" name="Dashboard" parent="guardian_root_menu" action="action_guardian_dashboard" sequence="10"/>
        <menuitem id="guardian_menu_baselines" name="Baselines" parent="guardian_root_menu" action="action_guardian_baselines" sequence="20"/>
        <menuitem id="guardian_menu_changes" name="Changes" parent="guardian_root_menu" action="action_guardian_changes" sequence="30"/>
        <menuitem id="guardian_menu_snapshots" name="Snapshots" parent="guardian_root_menu" action="action_guardian_snapshots" sequence="40"/>
        <menuitem id="guardian_menu_rules" name="Risk Rules" parent="guardian_root_menu" action="action_guardian_rules" sequence="50" groups="group_guardian_manager"/>
</odoo>
