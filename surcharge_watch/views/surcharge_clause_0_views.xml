<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_surcharge_clause_list" model="ir.ui.view">
        <field name="name">surcharge.clause.list</field>
        <field name="model">surcharge.clause</field>
        <field name="arch" type="xml">
            <list string="Index Clauses">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="material"/>
                <field name="base_index"/>
                <field name="factor"/>
                <field name="line_count"/>
            </list>
        </field>
    </record>

    <record id="view_surcharge_clause_form" model="ir.ui.view">
        <field name="name">surcharge.clause.form</field>
        <field name="model">surcharge.clause</field>
        <field name="arch" type="xml">
            <form string="Index Clauses">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Clause">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="material"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Formula">
    <field name="base_index"/>
    <field name="factor"/>
    <field name="currency_id"/>
                        </group>
                        <group string="History">
    <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_surcharge_clause_search" model="ir.ui.view">
        <field name="name">surcharge.clause.search</field>
        <field name="model">surcharge.clause</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="material"/>
                <separator/>
                <filter name="group_supplier" string="Supplier" context="{'group_by': 'partner_id'}"/>
                <filter name="group_material" string="Material" context="{'group_by': 'material'}"/>
            </search>
        </field>
    </record>

    <record id="view_surcharge_clause_kanban" model="ir.ui.view">
        <field name="name">surcharge.clause.kanban</field>
        <field name="model">surcharge.clause</field>
        <field name="arch" type="xml">
            <kanban default_group_by="partner_id" sample="1">
                <field name="partner_id"/>
                <field name="name"/>
                <field name="material"/>
                <field name="base_index"/>
                <field name="factor"/>
                <templates>
                    <t t-name="card">
                        <field name="partner_id" class="fw-bold"/>
                        <field name="name"/>
                        <field name="material"/>
                        <field name="base_index"/>
                        <field name="factor"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_surcharge_clause" model="ir.actions.act_window">
        <field name="name">Index Clauses</field>
        <field name="res_model">surcharge.clause</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The agreed surcharge formulas, one clause per supplier and material.</p>
        </field>
    </record>

</odoo>
