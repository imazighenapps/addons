<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_fedex_connection_company" model="ir.rule">
        <field name="name">fedex.connection: own company only</field>
        <field name="model_id" ref="model_fedex_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_fedex_record_company" model="ir.rule">
        <field name="name">fedex.record: own company only</field>
        <field name="model_id" ref="model_fedex_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
