<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_spare_part_entry_company" model="ir.rule">
        <field name="name">spare_part.entry: own company only</field>
        <field name="model_id" ref="model_spare_part_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_spare_part_item_company" model="ir.rule">
        <field name="name">spare_part.item: own company only</field>
        <field name="model_id" ref="model_spare_part_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
