<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_expense_audit_list" model="ir.ui.view">
        <field name="name">expense.audit.list</field>
        <field name="model">expense.audit</field>
        <field name="arch" type="xml">
            <list string="Policy Violations" create="0">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="policy_id"/>
                <field name="level"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_expense_audit_form" model="ir.ui.view">
        <field name="name">expense.audit.form</field>
        <field name="model">expense.audit</field>
        <field name="arch" type="xml">
            <form string="Policy Violations">
                <sheet>
                    <group>
                        <group string="Violation">
    <field name="name"/>
    <field name="date"/>
    <field name="employee_id"/>
    <field name="policy_id"/>
    <field name="level"/>
    <field name="company_id"/>
                        </group>
                        <group string="Expense">
    <field name="expense_id"/>
                        </group>
                        <group string="Message">
    <field name="message"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_expense_audit_search" model="ir.ui.view">
        <field name="name">expense.audit.search</field>
        <field name="model">expense.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="employee_id"/>
                <filter name="block" string="Blocked" domain="[('level','=','block')]"/>
                <filter name="warning" string="Warnings" domain="[('level','=','warning')]"/>
                <separator/>
                <filter name="group_policy" string="Policy" context="{'group_by': 'policy_id'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_expense_audit" model="ir.actions.act_window">
        <field name="name">Policy Violations</field>
        <field name="res_model">expense.audit</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
