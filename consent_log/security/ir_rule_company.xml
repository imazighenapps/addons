        <field name="name">consent.subject: own company only</field>
        <field name="model_id" ref="model_consent_subject"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_consent_record_company" model="ir.rule">
        <field name="name">consent.record: own company only</field>
        <field name="model_id" ref="model_consent_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
