<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_attendance_anomaly_entry_company" model="ir.rule">
        <field name="name">attendance_anomaly.entry: own company only</field>
        <field name="model_id" ref="model_attendance_anomaly_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_attendance_anomaly_item_company" model="ir.rule">
        <field name="name">attendance_anomaly.item: own company only</field>
        <field name="model_id" ref="model_attendance_anomaly_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
