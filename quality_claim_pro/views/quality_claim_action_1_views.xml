<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quality_claim_action_list" model="ir.ui.view">
        <field name="name">quality.claim.action.list</field>
        <field name="model">quality.claim.action</field>
        <field name="arch" type="xml">
            <list string="Corrective Actions" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="claim_id"/>
                <field name="sequence"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="due_date"/>
                <field name="state" widget="badge"/>
                <field name="done_date"/>
            </list>
        </field>
    </record>

    <record id="view_quality_claim_action_form" model="ir.ui.view">
        <field name="name">quality.claim.action.form</field>
        <field name="model">quality.claim.action</field>
        <field name="arch" type="xml">
            <form string="Corrective Actions">
                <header>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Action">
    <field name="claim_id"/>
    <field name="sequence"/>
    <field name="name"/>
    <field name="user_id"/>
    <field name="due_date"/>
                        </group>
                        <group string="Follow-up">
    <field name="state"/>
    <field name="done_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_quality_claim_action_search" model="ir.ui.view">
        <field name="name">quality.claim.action.search</field>
        <field name="model">quality.claim.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="claim_id"/>
                <field name="user_id"/>
                <filter name="todo" string="To Do" domain="[('state','=','todo')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_claim" string="Claim" context="{'group_by': 'claim_id'}"/>
                <filter name="group_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_quality_claim_action" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field>
        <field name="res_model">quality.claim.action</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every corrective action of every claim, with its owner and its due date.</p>
        </field>
    </record>

</odoo>
