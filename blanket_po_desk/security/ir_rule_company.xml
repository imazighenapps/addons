<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_blanket_po_entry_company" model="ir.rule">
        <field name="name">blanket_po.entry: own company only</field>
        <field name="model_id" ref="model_blanket_po_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_blanket_po_item_company" model="ir.rule">
        <field name="name">blanket_po.item: own company only</field>
        <field name="model_id" ref="model_blanket_po_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
