<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_provision_book_company" model="ir.rule">
        <field name="name">provision.book: own company only</field>
        <field name="model_id" ref="model_provision_book"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_provision_movement_company" model="ir.rule">
        <field name="name">provision.movement: own company only</field>
        <field name="model_id" ref="model_provision_movement"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
