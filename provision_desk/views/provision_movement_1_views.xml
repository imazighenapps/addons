<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_provision_movement_list" model="ir.ui.view">
        <field name="name">provision.movement.list</field>
        <field name="model">provision.movement</field>
        <field name="arch" type="xml">
            <list string="Provision Movements">
                <field name="date"/>
                <field name="provision_id"/>
                <field name="movement_type"/>
                <field name="amount" sum="Total Amount"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_provision_movement_form" model="ir.ui.view">
        <field name="name">provision.movement.form</field>
        <field name="model">provision.movement</field>
        <field name="arch" type="xml">
            <form string="Provision Movements">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reason" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Movement">
    <field name="provision_id"/>
    <field name="date"/>
    <field name="movement_type"/>
                        </group>
                        <group string="Amount">
    <field name="amount"/>
    <field name="currency_id"/>
    <field name="reason"/>
    <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_provision_movement_search" model="ir.ui.view">
        <field name="name">provision.movement.search</field>
        <field name="model">provision.movement</field>
        <field name="arch" type="xml">
            <search>
                <field name="provision_id"/>
                <field name="reason"/>
                <filter name="increase" string="Increases" domain="[('movement_type','=','increase')]"/>
                <filter name="decrease" string="Decreases" domain="[('movement_type','=','decrease')]"/>
                <separator/>
                <filter name="group_provision" string="Provision" context="{'group_by': 'provision_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'movement_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_provision_movement" model="ir.actions.act_window">
        <field name="name">Provision Movements</field>
        <field name="res_model">provision.movement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every increase and decrease recorded on every provision.</p>
        </field>
    </record>

</odoo>
