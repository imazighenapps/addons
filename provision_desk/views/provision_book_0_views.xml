<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_provision_book_list" model="ir.ui.view">
        <field name="name">provision.book.list</field>
        <field name="model">provision.book</field>
        <field name="arch" type="xml">
            <list string="Provisions" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="provision_type"/>
                <field name="owner_id"/>
                <field name="opening_balance"/>
                <field name="current_balance" sum="Total Current Balance"/>
                <field name="movement_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_provision_book_form" model="ir.ui.view">
        <field name="name">provision.book.form</field>
        <field name="model">provision.book</field>
        <field name="arch" type="xml">
            <form string="Provisions">
                <header>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Provision">
    <field name="name"/>
    <field name="provision_type"/>
    <field name="owner_id"/>
    <field name="company_id"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Balance">
    <field name="opening_balance"/>
    <field name="current_balance"/>
    <field name="movement_count"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movements" name="movementids">
                            <field name="movement_ids" readonly="state == 'closed'">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="movement_type"/>
                            <field name="amount" sum="Total"/>
                            <field name="reason"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_provision_book_search" model="ir.ui.view">
        <field name="name">provision.book.search</field>
        <field name="model">provision.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="owner_id"/>
                <filter name="open" string="Open" domain="[('state','=','open')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <filter name="bad_debt" string="Bad Debt" domain="[('provision_type','=','bad_debt')]"/>
                <filter name="warranty" string="Warranty" domain="[('provision_type','=','warranty')]"/>
                <separator/>
                <filter name="group_type" string="Type" context="{'group_by': 'provision_type'}"/>
                <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_provision_book_kanban" model="ir.ui.view">
        <field name="name">provision.book.kanban</field>
        <field name="model">provision.book</field>
        <field name="arch" type="xml">
            <kanban default_group_by="provision_type" sample="1">
                <field name="provision_type"/>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="current_balance"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="provision_type" class="fw-bold"/>
                        <field name="name"/>
                        <field name="owner_id"/>
                        <field name="current_balance"/>
                        <field name="state"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_provision_book" model="ir.actions.act_window">
        <field name="name">Provisions</field>
        <field name="res_model">provision.book</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track each provision and the movements that explain its balance.</p>
        </field>
    </record>

</odoo>
