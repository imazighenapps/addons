<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_inbound_quality_entry_company" model="ir.rule">
        <field name="name">inbound_quality.entry: own company only</field>
        <field name="model_id" ref="model_inbound_quality_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_inbound_quality_item_company" model="ir.rule">
        <field name="name">inbound_quality.item: own company only</field>
        <field name="model_id" ref="model_inbound_quality_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
