<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_meeting_booking_list" model="ir.ui.view">
        <field name="name">meeting.booking.list</field>
        <field name="model">meeting.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="room_id"/>
                <field name="organizer_id"/>
                <field name="start_datetime"/>
                <field name="stop_datetime"/>
                <field name="attendee_count"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_meeting_booking_form" model="ir.ui.view">
        <field name="name">meeting.booking.form</field>
        <field name="model">meeting.booking</field>
        <field name="arch" type="xml">
            <form string="Bookings">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state == 'cancelled'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Booking">
    <field name="name"/>
    <field name="room_id"/>
    <field name="organizer_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Schedule">
    <field name="start_datetime"/>
    <field name="stop_datetime"/>
    <field name="attendee_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_meeting_booking_search" model="ir.ui.view">
        <field name="name">meeting.booking.search</field>
        <field name="model">meeting.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="room_id"/>
                <field name="organizer_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_room" string="Room" context="{'group_by': 'room_id'}"/>
                <filter name="group_organizer" string="Organizer" context="{'group_by': 'organizer_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_meeting_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">meeting.booking</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book meeting rooms and track reservations.</p>
        </field>
    </record>

</odoo>
