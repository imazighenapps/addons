<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dual_product_single_list" model="ir.ui.view">
        <field name="name">dual.product.list</field>
        <field name="model">dual.product</field>
        <field name="arch" type="xml">
            <list string="Single Points">
                <field name="name"/>
                <field name="qualified_source_count"/>
                <field name="critical"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_dual_product_single_form" model="ir.ui.view">
        <field name="name">dual.product.form</field>
        <field name="model">dual.product</field>
        <field name="arch" type="xml">
            <form string="Single Points">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Product">
    <field name="name"/>
    <field name="critical"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Sourcing">
    <field name="qualified_source_count"/>
    <field name="single_source"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Suppliers" name="supplierids">
                            <field name="supplier_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dual_product_single_search" model="ir.ui.view">
        <field name="name">dual.product.search</field>
        <field name="model">dual.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter name="group_critical" string="Critical" context="{'group_by': 'critical'}"/>
            </search>
        </field>
    </record>

    <record id="action_dual_product_single" model="ir.actions.act_window">
        <field name="name">Single Points</field>
        <field name="res_model">dual.product</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Critical products with only one qualified supplier.</p>
        </field>
    </record>

</odoo>
