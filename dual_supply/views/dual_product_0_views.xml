<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dual_product_list" model="ir.ui.view">
        <field name="name">dual.product.list</field>
        <field name="model">dual.product</field>
        <field name="arch" type="xml">
            <list string="Critical Products">
                <field name="name"/>
                <field name="critical"/>
                <field name="qualified_source_count"/>
                <field name="single_source"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_dual_product_form" model="ir.ui.view">
        <field name="name">dual.product.form</field>
        <field name="model">dual.product</field>
        <field name="arch" type="xml">
            <form string="Critical Products">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Product">
    <field name="name"/>
    <field name="critical"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Sourcing">
    <field name="qualified_source_count"/>
    <field name="single_source"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Suppliers" name="supplierids">
                            <field name="supplier_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dual_product_search" model="ir.ui.view">
        <field name="name">dual.product.search</field>
        <field name="model">dual.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="critical" string="Critical" domain="[('critical', '=', True)]"/>
                <filter name="single_source" string="Single Source" domain="[('single_source', '=', True)]"/>
                <separator/>
                <filter name="group_single_source" string="Single Source" context="{'group_by': 'single_source'}"/>
                <filter name="group_critical" string="Critical" context="{'group_by': 'critical'}"/>
            </search>
        </field>
    </record>

    <record id="view_dual_product_kanban" model="ir.ui.view">
        <field name="name">dual.product.kanban</field>
        <field name="model">dual.product</field>
        <field name="arch" type="xml">
            <kanban default_group_by="single_source" sample="1">
                <field name="single_source"/>
                <field name="name"/>
                <field name="critical"/>
                <field name="qualified_source_count"/>
                <templates>
                    <t t-name="card">
                        <field name="single_source" class="fw-bold"/>
                        <field name="name"/>
                        <field name="critical"/>
                        <field name="qualified_source_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_dual_product" model="ir.actions.act_window">
        <field name="name">Critical Products</field>
        <field name="res_model">dual.product</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Critical products with their primary and alternate suppliers.</p>
        </field>
    </record>

</odoo>
