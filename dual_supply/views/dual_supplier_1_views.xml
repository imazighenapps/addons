<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dual_supplier_list" model="ir.ui.view">
        <field name="name">dual.supplier.list</field>
        <field name="model">dual.supplier</field>
        <field name="arch" type="xml">
            <list string="Supplier Sources">
                <field name="product_id"/>
                <field name="supplier_name"/>
                <field name="role"/>
                <field name="qualified"/>
                <field name="lead_time_days"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_dual_supplier_form" model="ir.ui.view">
        <field name="name">dual.supplier.form</field>
        <field name="model">dual.supplier</field>
        <field name="arch" type="xml">
            <form string="Supplier Sources">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="supplier_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Source">
    <field name="product_id"/>
    <field name="supplier_name"/>
    <field name="role"/>
    <field name="qualified"/>
    <field name="lead_time_days"/>
    <field name="company_id"/>
                        </group>
                        <group string="Details">
    <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dual_supplier_search" model="ir.ui.view">
        <field name="name">dual.supplier.search</field>
        <field name="model">dual.supplier</field>
        <field name="arch" type="xml">
            <search>
                <field name="supplier_name"/>
                <field name="product_id"/>
                <filter name="qualified" string="Qualified" domain="[('qualified', '=', True)]"/>
                <filter name="primary" string="Primary" domain="[('role', '=', 'primary')]"/>
                <separator/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="group_role" string="Role" context="{'group_by': 'role'}"/>
            </search>
        </field>
    </record>

    <record id="action_dual_supplier" model="ir.actions.act_window">
        <field name="name">Supplier Sources</field>
        <field name="res_model">dual.supplier</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Primary and alternate suppliers mapped to critical products.</p>
        </field>
    </record>

</odoo>
