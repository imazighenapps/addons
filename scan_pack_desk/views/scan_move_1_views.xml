<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_scan_move_list" model="ir.ui.view">
        <field name="name">scan_pack.move.list</field>
        <field name="model">scan_pack.move</field>
        <field name="arch" type="xml">
            <list string="Pick Lines">
                <field name="session_id"/>
                <field name="product_id"/>
                <field name="demand_qty"/>
                <field name="scanned_qty"/>
                <field name="difference_qty"/>
                <field name="is_complete" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_scan_move_form" model="ir.ui.view">
        <field name="name">scan_pack.move.form</field>
        <field name="model">scan_pack.move</field>
        <field name="arch" type="xml">
            <form string="Pick Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="session_id"/>
    <field name="move_id"/>
    <field name="product_id"/>
                        </group>
                        <group string="Quantities">
    <field name="demand_qty"/>
    <field name="scanned_qty"/>
    <field name="difference_qty"/>
    <field name="is_complete"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_scan_move_search" model="ir.ui.view">
        <field name="name">scan_pack.move.search</field>
        <field name="model">scan_pack.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="session_id"/>
                <filter name="complete" string="Complete" domain="[('is_complete','=',True)]"/>
                <filter name="incomplete" string="Incomplete" domain="[('is_complete','=',False)]"/>
                <separator/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="group_session" string="Scan Session" context="{'group_by': 'session_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_scan_move" model="ir.actions.act_window">
        <field name="name">Pick Lines</field>
        <field name="res_model">scan_pack.move</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every pick line of every scan session, in one place.</p>
        </field>
    </record>

</odoo>
