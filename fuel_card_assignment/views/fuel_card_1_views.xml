<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fuel_card_list" model="ir.ui.view">
        <field name="name">fuel.card.list</field>
        <field name="model">fuel.card</field>
        <field name="arch" type="xml">
            <list string="Fuel Cards">
                <field name="name"/>
                <field name="provider"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fuel_card_form" model="ir.ui.view">
        <field name="name">fuel.card.form</field>
        <field name="model">fuel.card</field>
        <field name="arch" type="xml">
            <form string="Fuel Cards">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Card">
    <field name="name"/>
    <field name="provider"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fuel_card_search" model="ir.ui.view">
        <field name="name">fuel.card.search</field>
        <field name="model">fuel.card</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="provider"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_fuel_card" model="ir.actions.act_window">
        <field name="name">Fuel Cards</field>
        <field name="res_model">fuel.card</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register fuel cards.</p>
        </field>
    </record>

</odoo>
