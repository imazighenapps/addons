<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_fuelcardassi_user" model="res.groups">
        <field name="name">Fuel Card Assignment User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_fuelcardassi_manager" model="res.groups">
        <field name="name">Fuel Card Assignment Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('fuel_card_assignment.group_fuelcardassi_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
