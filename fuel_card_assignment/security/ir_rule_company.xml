<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_fuel_card_company" model="ir.rule">
        <field name="name">fuel.card: own company only</field>
        <field name="model_id" ref="model_fuel_card"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_fuel_card_assignment_company" model="ir.rule">
        <field name="name">fuel.card.assignment: own company only</field>
        <field name="model_id" ref="model_fuel_card_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
