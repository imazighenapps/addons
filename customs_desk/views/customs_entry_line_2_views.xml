<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customs_entry_line_list" model="ir.ui.view">
        <field name="name">customs.entry.line.list</field>
        <field name="model">customs.entry.line</field>
        <field name="arch" type="xml">
            <list string="Entry Lines">
                <field name="entry_id"/>
                <field name="duty_code_id"/>
                <field name="description"/>
                <field name="quantity"/>
                <field name="customs_value" sum="Total Customs Value"/>
                <field name="duty_rate"/>
                <field name="duty_amount" sum="Total Duty Amount"/>
            </list>
        </field>
    </record>

    <record id="view_customs_entry_line_form" model="ir.ui.view">
        <field name="name">customs.entry.line.form</field>
        <field name="model">customs.entry.line</field>
        <field name="arch" type="xml">
            <form string="Entry Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="description" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="entry_id"/>
    <field name="duty_code_id"/>
    <field name="description"/>
    <field name="quantity"/>
    <field name="company_id"/>
                        </group>
                        <group string="Duty">
    <field name="customs_value"/>
    <field name="duty_rate"/>
    <field name="duty_amount"/>
    <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_customs_entry_line_search" model="ir.ui.view">
        <field name="name">customs.entry.line.search</field>
        <field name="model">customs.entry.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="description"/>
                <field name="entry_id"/>
                <field name="duty_code_id"/>
                <separator/>
                <filter name="group_entry" string="Entry" context="{'group_by': 'entry_id'}"/>
                <filter name="group_code" string="HS Code" context="{'group_by': 'duty_code_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_customs_entry_line" model="ir.actions.act_window">
        <field name="name">Entry Lines</field>
        <field name="res_model">customs.entry.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">All customs entry lines with their computed duty amount.</p>
        </field>
    </record>

</odoo>
