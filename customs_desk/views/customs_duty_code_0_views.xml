<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customs_duty_code_list" model="ir.ui.view">
        <field name="name">customs.duty.code.list</field>
        <field name="model">customs.duty.code</field>
        <field name="arch" type="xml">
            <list string="HS Codes">
                <field name="code"/>
                <field name="name"/>
                <field name="duty_rate"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_customs_duty_code_form" model="ir.ui.view">
        <field name="name">customs.duty.code.form</field>
        <field name="model">customs.duty.code</field>
        <field name="arch" type="xml">
            <form string="HS Codes">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Code">
    <field name="code"/>
    <field name="name"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Duty">
    <field name="duty_rate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_customs_duty_code_search" model="ir.ui.view">
        <field name="name">customs.duty.code.search</field>
        <field name="model">customs.duty.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_customs_duty_code" model="ir.actions.act_window">
        <field name="name">HS Codes</field>
        <field name="res_model">customs.duty.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Maintain the HS codes and duty rates used to check each customs entry.</p>
        </field>
    </record>

</odoo>
