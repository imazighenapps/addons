<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="view_rate_provider_sync_form" model="ir.ui.view">
  <field name="name">rate.provider.sync.form</field><field name="model">rate.provider.sync</field>
  <field name="arch" type="xml"><form string="Taux de change">
    <header>
      <button name="action_sync" type="object" string="Synchroniser / Valider" class="btn-primary" invisible="state!='draft'"/>
      <field name="state" widget="statusbar" statusbar_visible="draft,synced"/>
    </header>
    <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group>
        <field name="company_id" groups="base.group_multi_company"/><field name="currency_id"/><field name="provider"/>
        <field name="sync_date"/>
      </group><group>
        <field name="previous_rate"/><field name="rate"/><field name="variation_pct"/><field name="alert_threshold"/><field name="alert"/>
      </group></group>
      <group string="Justification (si manuel)"><field name="justification" nolabel="1"/></group>
      <group string="Journal"><field name="notes" nolabel="1"/></group>
    </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
  </form></field>
</record>
<record id="view_rate_provider_sync_list" model="ir.ui.view">
  <field name="name">rate.provider.sync.list</field><field name="model">rate.provider.sync</field>
  <field name="arch" type="xml"><list decoration-danger="alert==True" decoration-success="state in ('synced','manual')">
    <field name="name"/><field name="sync_date"/><field name="currency_id"/><field name="provider"/>
    <field name="rate"/><field name="variation_pct"/><field name="alert"/><field name="state"/>
  </list></field>
</record>
</data></odoo>
