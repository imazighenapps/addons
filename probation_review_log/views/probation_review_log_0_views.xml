<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_probation_review_log_list" model="ir.ui.view">
        <field name="name">probation.review.log.list</field>
        <field name="model">probation.review.log</field>
        <field name="arch" type="xml">
            <list string="Probation Reviews" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="reviewer_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="review_date"/>
                <field name="score"/>
                <field name="state" widget="badge"/>
                <field name="outcome"/>
            </list>
        </field>
    </record>

    <record id="view_probation_review_log_form" model="ir.ui.view">
        <field name="name">probation.review.log.form</field>
        <field name="model">probation.review.log</field>
        <field name="arch" type="xml">
            <form string="Probation Reviews">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close Review" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,closed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Employee">
    <field name="name"/>
    <field name="employee_id"/>
    <field name="reviewer_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Probation">
    <field name="date_start"/>
    <field name="date_end"/>
    <field name="review_date"/>
    <field name="score"/>
    <field name="outcome"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_probation_review_log_search" model="ir.ui.view">
        <field name="name">probation.review.log.search</field>
        <field name="model">probation.review.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="reviewer_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_outcome" string="Decision" context="{'group_by': 'outcome'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_probation_review_log_graph" model="ir.ui.view">
        <field name="name">probation.review.log.graph</field>
        <field name="model">probation.review.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_probation_review_log" model="ir.actions.act_window">
        <field name="name">Probation Reviews</field>
        <field name="res_model">probation.review.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Document probation reviews and confirmation decisions.</p>
        </field>
    </record>

</odoo>
