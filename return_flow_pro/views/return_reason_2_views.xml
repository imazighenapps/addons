<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_return_reason_list" model="ir.ui.view">
        <field name="name">return.flow.reason.list</field>
        <field name="model">return.flow.reason</field>
        <field name="arch" type="xml">
            <list string="Return Motives">
                <field name="sequence"/>
                <field name="name"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_return_reason_form" model="ir.ui.view">
        <field name="name">return.flow.reason.form</field>
        <field name="model">return.flow.reason</field>
        <field name="arch" type="xml">
            <form string="Return Motives">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Motive">
    <field name="name"/>
    <field name="sequence"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_return_reason_search" model="ir.ui.view">
        <field name="name">return.flow.reason.search</field>
        <field name="model">return.flow.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_return_reason" model="ir.actions.act_window">
        <field name="name">Return Motives</field>
        <field name="res_model">return.flow.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configurable motives to classify customer returns.</p>
        </field>
    </record>

</odoo>
