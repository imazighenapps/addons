<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_return_line_list" model="ir.ui.view">
        <field name="name">return.flow.line.list</field>
        <field name="model">return.flow.line</field>
        <field name="arch" type="xml">
            <list string="Return Lines">
                <field name="request_id"/>
                <field name="product_id"/>
                <field name="qty_delivered"/>
                <field name="qty" sum="Total Qty"/>
                <field name="uom_id"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_return_line_form" model="ir.ui.view">
        <field name="name">return.flow.line.form</field>
        <field name="model">return.flow.line</field>
        <field name="arch" type="xml">
            <form string="Return Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="request_id"/>
    <field name="move_id"/>
    <field name="product_id"/>
    <field name="uom_id"/>
                        </group>
                        <group string="Quantities">
    <field name="qty_delivered"/>
    <field name="qty"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_return_line_search" model="ir.ui.view">
        <field name="name">return.flow.line.search</field>
        <field name="model">return.flow.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_id"/>
                <field name="product_id"/>
                <separator/>
                <filter name="group_return" string="Return" context="{'group_by': 'request_id'}"/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_return_line" model="ir.actions.act_window">
        <field name="name">Return Lines</field>
        <field name="res_model">return.flow.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">All returned lines across customer returns.</p>
        </field>
    </record>

</odoo>
