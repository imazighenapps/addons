<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_plan_list" model="ir.ui.view">
        <field name="name">payment.plan.list</field>
        <field name="model">payment.plan</field>
        <field name="arch" type="xml">
            <list string="Payment Plans" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="total_amount" sum="Total Total Amount"/>
                <field name="installment_count"/>
                <field name="first_due_date"/>
                <field name="paid_amount" sum="Total Paid Amount"/>
                <field name="remaining_amount" sum="Total Remaining Amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_payment_plan_form" model="ir.ui.view">
        <field name="name">payment.plan.form</field>
        <field name="model">payment.plan</field>
        <field name="arch" type="xml">
            <form string="Payment Plans">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_recompute" type="object" string="Recompute" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Invoice">
    <field name="move_id"/>
    <field name="partner_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Plan">
    <field name="total_amount"/>
    <field name="installment_count"/>
    <field name="first_due_date"/>
    <field name="interval_days"/>
                        </group>
                        <group string="Balance">
    <field name="paid_amount"/>
    <field name="remaining_amount"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Installments" name="lineids">
                            <field name="line_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_payment_plan_search" model="ir.ui.view">
        <field name="name">payment.plan.search</field>
        <field name="model">payment.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="due" string="Nothing Paid" domain="[('paid_amount','=',0)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_payment_plan_kanban" model="ir.ui.view">
        <field name="name">payment.plan.kanban</field>
        <field name="model">payment.plan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="remaining_amount"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="remaining_amount"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_payment_plan_graph" model="ir.ui.view">
        <field name="name">payment.plan.graph</field>
        <field name="model">payment.plan</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="total_amount" type="measure"/>
                <field name="paid_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_payment_plan_pivot" model="ir.ui.view">
        <field name="name">payment.plan.pivot</field>
        <field name="model">payment.plan</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="partner_id" type="row"/>
                <field name="state" type="col"/>
                <field name="total_amount" type="measure"/>
                <field name="remaining_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_payment_plan" model="ir.actions.act_window">
        <field name="name">Payment Plans</field>
        <field name="res_model">payment.plan</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Split an invoice into dated installments and follow what is really paid.</p>
        </field>
    </record>

</odoo>
