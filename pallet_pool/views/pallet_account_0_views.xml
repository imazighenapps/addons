<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pallet_account_list" model="ir.ui.view">
        <field name="name">pallet.account.list</field>
        <field name="model">pallet.account</field>
        <field name="arch" type="xml">
            <list string="Pallet Accounts">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="lent_qty"/>
                <field name="returned_qty"/>
                <field name="balance_qty"/>
                <field name="movement_count"/>
            </list>
        </field>
    </record>

    <record id="view_pallet_account_form" model="ir.ui.view">
        <field name="name">pallet.account.form</field>
        <field name="model">pallet.account</field>
        <field name="arch" type="xml">
            <form string="Pallet Accounts">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Account">
    <field name="name"/>
    <field name="partner_name"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Totals">
    <field name="lent_qty"/>
    <field name="returned_qty"/>
    <field name="balance_qty"/>
    <field name="movement_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movements" name="movementids">
                            <field name="movement_ids"/>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pallet_account_search" model="ir.ui.view">
        <field name="name">pallet.account.search</field>
        <field name="model">pallet.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_name"/>
                <filter name="open_balance" string="Open Balance" domain="[('balance_qty','&gt;',0)]"/>
                <separator/>
                <filter name="group_partner" string="Partner" context="{'group_by': 'partner_name'}"/>
            </search>
        </field>
    </record>

    <record id="view_pallet_account_kanban" model="ir.ui.view">
        <field name="name">pallet.account.kanban</field>
        <field name="model">pallet.account</field>
        <field name="arch" type="xml">
            <kanban default_group_by="partner_name" sample="1">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="balance_qty"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="balance_qty"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_pallet_account" model="ir.actions.act_window">
        <field name="name">Pallet Accounts</field>
        <field name="res_model">pallet.account</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track how many pallets each partner owes you.</p>
        </field>
    </record>

</odoo>
