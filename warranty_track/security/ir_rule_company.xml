<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_warranty_registration_company" model="ir.rule">
        <field name="name">warranty.registration: own company only</field>
        <field name="model_id" ref="model_warranty_registration"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_warranty_claim_company" model="ir.rule">
        <field name="name">warranty.claim: own company only</field>
        <field name="model_id" ref="model_warranty_claim"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
