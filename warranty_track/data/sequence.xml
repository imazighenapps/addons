<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_warranty_registration" model="ir.sequence">
        <field name="name">Warranty</field>
        <field name="code">warranty.registration</field>
        <field name="prefix">WAR/%(year)s/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_warranty_claim" model="ir.sequence">
        <field name="name">Warranty Claim</field>
        <field name="code">warranty.claim</field>
        <field name="prefix">WCL/%(year)s/</field>
        <field name="padding">5</field>
    </record>
</odoo>
