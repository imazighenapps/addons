<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_warranty" model="ir.ui.view">
        <field name="name">sale.order.form.warranty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_warranties" type="object"
                        class="oe_stat_button" icon="fa-shield">
                    <field name="warranty_count" widget="statinfo"
                           string="Warranties"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
