<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_warranty_claim_list" model="ir.ui.view">
        <field name="name">warranty.claim.list</field>
        <field name="model">warranty.claim</field>
        <field name="arch" type="xml">
            <list string="Claims" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="resolution"/>
                <field name="cost" sum="Total Cost"/>
                <field name="vendor_recovery" sum="Total Vendor Recovery"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_warranty_claim_form" model="ir.ui.view">
        <field name="name">warranty.claim.form</field>
        <field name="model">warranty.claim</field>
        <field name="arch" type="xml">
            <form string="Claims">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Close" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-link" invisible="state in ('done', 'refused')"/>
                    <button name="action_reset" type="object" string="Reset" class="btn-link" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,done,refused"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Warranty">
    <field name="registration_id"/>
    <field name="partner_id"/>
    <field name="product_id"/>
    <field name="date"/>
    <field name="covered"/>
    <field name="goodwill"/>
                        </group>
                        <group string="Resolution">
    <field name="resolution"/>
    <field name="state"/>
                        </group>
                        <group string="Costs">
    <field name="cost"/>
    <field name="vendor_recovery"/>
    <field name="supplier_id"/>
    <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issue" name="issue">
                            <field name="issue"/>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_warranty_claim_search" model="ir.ui.view">
        <field name="name">warranty.claim.search</field>
        <field name="model">warranty.claim</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="goodwill" string="Goodwill" domain="[('goodwill','=',True)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_resolution" string="Resolution" context="{'group_by': 'resolution'}"/>
            </search>
        </field>
    </record>

    <record id="action_warranty_claim" model="ir.actions.act_window">
        <field name="name">Claims</field>
        <field name="res_model">warranty.claim</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a warranty claim and its real cost.</p>
        </field>
    </record>

</odoo>
