<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_supplier_rebate_entry_company" model="ir.rule">
        <field name="name">supplier_rebate.entry: own company only</field>
        <field name="model_id" ref="model_supplier_rebate_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_supplier_rebate_item_company" model="ir.rule">
        <field name="name">supplier_rebate.item: own company only</field>
        <field name="model_id" ref="model_supplier_rebate_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
