<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_multi_barcode_entry_company" model="ir.rule">
        <field name="name">multi_barcode.entry: own company only</field>
        <field name="model_id" ref="model_multi_barcode_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_multi_barcode_item_company" model="ir.rule">
        <field name="name">multi_barcode.item: own company only</field>
        <field name="model_id" ref="model_multi_barcode_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
