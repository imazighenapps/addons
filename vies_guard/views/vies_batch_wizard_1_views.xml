<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vies_batch_wizard_form" model="ir.ui.view">
        <field name="name">vies.batch.wizard.form</field>
        <field name="model">vies.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch VAT Check">
                <sheet>
                    <group>
                        <group string="Scope">
    <field name="partner_ids"/>
    <field name="only_unchecked"/>
    <field name="only_contacts"/>
                        </group>
                    </group>
                    <div class="text-muted">The check calls the official VIES service for each partner. Large batches can take a few minutes.</div>
                </sheet>
                <footer><button name="action_run" type="object" string="Run Check" class="btn-primary"/><button special="cancel" string="Close" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>

    <record id="action_vies_batch_wizard" model="ir.actions.act_window">
        <field name="name">Batch VAT Check</field>
        <field name="res_model">vies.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
