<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_viesguard_user" model="res.groups">
        <field name="name">Vies Guard User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_viesguard_manager" model="res.groups">
        <field name="name">Vies Guard Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('vies_guard.group_viesguard_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
