<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_vies_recheck" model="ir.cron">
        <field name="name">VIESGuard: re-check old VAT numbers</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_recheck()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
