<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_monday_connection_company" model="ir.rule">
        <field name="name">monday.connection: own company only</field>
        <field name="model_id" ref="model_monday_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_monday_record_company" model="ir.rule">
        <field name="name">monday.record: own company only</field>
        <field name="model_id" ref="model_monday_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
