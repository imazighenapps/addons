<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_margin" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.margin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Sales Margin"
                     string="Sales Margin" data-key="sale_margin_block_pro">
                    <h2>Sales Margin Control</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="min_margin_percent"/>
                                <div class="text-muted">
                                    Used when no product, category or
                                    customer margin rule matches the order.
                                </div>
                                <div class="content-group">
                                    <field name="min_margin_percent"/> %
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
