<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="module_category_sale_margin" model="ir.module.category">
        <field name="name">Sales Margin Control</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_margin_manager" model="res.groups">
        <field name="name">Override Margin Block</field>
        <field name="category_id" ref="module_category_sale_margin"/>
        <field name="comment">Users in this group can confirm sale orders
            even when the margin is below the required minimum. Every
            override is logged and posted to the order's chatter.</field>
    </record>

    <!-- Sales Managers automatically get override rights -->
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_margin_manager'))]"/>
    </record>

</odoo>
