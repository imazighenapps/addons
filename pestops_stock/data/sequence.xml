<odoo>
    <record id="seq_pest_stock_trace" model="ir.sequence">
        <field name="name">PestOps Stock Trace</field>
        <field name="code">pest.stock.trace</field>
        <field name="prefix">ST/</field>
        <field name="padding">7</field>
    </record>
    <record id="seq_pest_stock_threshold" model="ir.sequence">
        <field name="name">PestOps Stock Threshold</field>
        <field name="code">pest.stock.threshold</field>
        <field name="prefix">THR/</field>
        <field name="padding">5</field>
    </record>
</odoo>
