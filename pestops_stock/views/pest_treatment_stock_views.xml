<odoo>
    <record id="view_pest_treatment_form_stock_extension" model="ir.ui.view">
        <field name="name">pest.treatment.form.stock.extension</field>
        <field name="model">pest.treatment</field>
        <field name="inherit_id" ref="pestops_core.view_pest_treatment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_consume_products']" position="after">
                <button name="action_view_stock_traces"
                        type="object"
                        string="Traceability"
                        icon="fa-list"
                        invisible="stock_trace_count == 0"/>
                <field name="stock_trace_count" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='product_consumption']/field/list/field[@name='stock_move_id']" position="after">
                <field name="available_qty" readonly="1"/>
                <field name="stock_status" readonly="1"/>
                <field name="lot_required" readonly="1"/>
                <field name="lot_expiration_date" readonly="1"/>
                <field name="trace_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
