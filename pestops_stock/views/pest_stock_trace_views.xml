<odoo>
    <record id="view_pest_stock_trace_list" model="ir.ui.view">
        <field name="name">pest.stock.trace.list</field>
        <field name="model">pest.stock.trace</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="consumed_at"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="site_id"/>
                <field name="technician_id"/>
                <field name="source_location_id"/>
                <field name="treatment_id"/>
                <field name="stock_move_id"/>
            </list>
        </field>
    </record>

    <record id="view_pest_stock_trace_pivot" model="ir.ui.view">
        <field name="name">pest.stock.trace.pivot</field>
        <field name="model">pest.stock.trace</field>
        <field name="arch" type="xml">
            <pivot string="Consumption Analysis">
                <field name="product_id" type="row"/>
                <field name="lot_id" type="row"/>
                <field name="site_id" type="row"/>
                <field name="technician_id" type="col"/>
                <field name="consumed_at" type="col" interval="month"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pest_stock_trace_form" model="ir.ui.view">
        <field name="name">pest.stock.trace.form</field>
        <field name="model">pest.stock.trace</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_view_stock_move" type="object" string="Stock Move"/>
                    <button name="action_view_treatment" type="object" string="Treatment" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="consumed_at"/>
                            <field name="company_id"/>
                            <field name="technician_id"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="lot_expiration_date"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="source_location_id"/>
                            <field name="destination_location_id"/>
                            <field name="stock_move_id"/>
                            <field name="site_id"/>
                            <field name="zone_id"/>
                            <field name="visit_id"/>
                            <field name="treatment_id"/>
                            <field name="treatment_line_id"/>
                        </group>
                    </group>
                    <field name="notes"/>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pest_stock_traces" model="ir.actions.act_window">
        <field name="name">Consumption Traceability</field>
        <field name="res_model">pest.stock.trace</field>
        <field name="view_mode">list,pivot,form</field>
    </record>
</odoo>
