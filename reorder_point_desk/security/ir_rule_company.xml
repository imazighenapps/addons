<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_reorder_point_entry_company" model="ir.rule">
        <field name="name">reorder_point.entry: own company only</field>
        <field name="model_id" ref="model_reorder_point_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_reorder_point_item_company" model="ir.rule">
        <field name="name">reorder_point.item: own company only</field>
        <field name="model_id" ref="model_reorder_point_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
