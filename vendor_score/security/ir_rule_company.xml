<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_vendor_review_company" model="ir.rule">
        <field name="name">vendor.review: own company only</field>
        <field name="model_id" ref="model_vendor_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_vendor_action_company" model="ir.rule">
        <field name="name">vendor.action: own company only</field>
        <field name="model_id" ref="model_vendor_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
