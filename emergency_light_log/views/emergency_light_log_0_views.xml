<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_emergency_light_log_list" model="ir.ui.view">
        <field name="name">emergency.light.log.list</field>
        <field name="model">emergency.light.log</field>
        <field name="arch" type="xml">
            <list string="Lighting Tests" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="light_ref"/>
                <field name="location"/>
                <field name="light_type"/>
                <field name="test_date"/>
                <field name="next_test_date"/>
                <field name="state" widget="badge"/>
                <field name="tester_id"/>
            </list>
        </field>
    </record>

    <record id="view_emergency_light_log_form" model="ir.ui.view">
        <field name="name">emergency.light.log.form</field>
        <field name="model">emergency.light.log</field>
        <field name="arch" type="xml">
            <form string="Lighting Tests">
                <header>
                    <button name="action_test" type="object" string="Validate Test" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_fail" type="object" string="Mark Failed" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,tested,failed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Light">
    <field name="name"/>
    <field name="light_ref"/>
    <field name="location"/>
    <field name="light_type"/>
    <field name="company_id"/>
                        </group>
                        <group string="Test">
    <field name="test_date"/>
    <field name="next_test_date"/>
    <field name="duration_minutes"/>
    <field name="tester_id"/>
    <field name="battery_ok"/>
    <field name="lamp_ok"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_emergency_light_log_search" model="ir.ui.view">
        <field name="name">emergency.light.log.search</field>
        <field name="model">emergency.light.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="light_ref"/>
                <field name="location"/>
                <field name="tester_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="tested" string="Tested" domain="[('state','=','tested')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_location" string="Location" context="{'group_by': 'location'}"/>
                <filter name="group_light_type" string="Light Type" context="{'group_by': 'light_type'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_emergency_light_log_graph" model="ir.ui.view">
        <field name="name">emergency.light.log.graph</field>
        <field name="model">emergency.light.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_emergency_light_log" model="ir.actions.act_window">
        <field name="name">Lighting Tests</field>
        <field name="res_model">emergency.light.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track emergency lighting tests and due dates.</p>
        </field>
    </record>

</odoo>
