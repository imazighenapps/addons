<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fire_door_log_list" model="ir.ui.view">
        <field name="name">fire.door.log.list</field>
        <field name="model">fire.door.log</field>
        <field name="arch" type="xml">
            <list string="Fire Doors" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="door_ref"/>
                <field name="location"/>
                <field name="door_type"/>
                <field name="inspection_date"/>
                <field name="next_inspection_date"/>
                <field name="state" widget="badge"/>
                <field name="inspector_id"/>
            </list>
        </field>
    </record>

    <record id="view_fire_door_log_form" model="ir.ui.view">
        <field name="name">fire.door.log.form</field>
        <field name="model">fire.door.log</field>
        <field name="arch" type="xml">
            <form string="Fire Doors">
                <header>
                    <button name="action_pass" type="object" string="Pass Inspection" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_flag_defect" type="object" string="Flag Defect" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,passed,defect,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Door">
    <field name="name"/>
    <field name="door_ref"/>
    <field name="location"/>
    <field name="door_type"/>
    <field name="company_id"/>
                        </group>
                        <group string="Inspection">
    <field name="inspection_date"/>
    <field name="next_inspection_date"/>
    <field name="inspector_id"/>
    <field name="hinge_ok"/>
    <field name="seal_ok"/>
    <field name="closer_ok"/>
    <field name="gap_ok"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fire_door_log_search" model="ir.ui.view">
        <field name="name">fire.door.log.search</field>
        <field name="model">fire.door.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="door_ref"/>
                <field name="location"/>
                <field name="inspector_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="passed" string="Passed" domain="[('state','=','passed')]"/>
                <filter name="defect" string="Defect" domain="[('state','=','defect')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_location" string="Location" context="{'group_by': 'location'}"/>
                <filter name="group_door_type" string="Door Type" context="{'group_by': 'door_type'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_fire_door_log_graph" model="ir.ui.view">
        <field name="name">fire.door.log.graph</field>
        <field name="model">fire.door.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_fire_door_log" model="ir.actions.act_window">
        <field name="name">Fire Doors</field>
        <field name="res_model">fire.door.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track fire door inspections and open defects.</p>
        </field>
    </record>

</odoo>
