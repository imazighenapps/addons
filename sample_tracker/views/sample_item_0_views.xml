<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sample_item_list" model="ir.ui.view">
        <field name="name">sample.item.list</field>
        <field name="model">sample.item</field>
        <field name="arch" type="xml">
            <list string="Samples Issued">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="followup_days"/>
                <field name="issue_count"/>
                <field name="open_issue_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sample_item_form" model="ir.ui.view">
        <field name="name">sample.item.form</field>
        <field name="model">sample.item</field>
        <field name="arch" type="xml">
            <form string="Samples Issued">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Sample">
    <field name="code"/>
    <field name="name"/>
    <field name="category"/>
    <field name="active"/>
                        </group>
                        <group string="Rules">
    <field name="followup_days"/>
    <field name="company_id"/>
                        </group>
                        <group string="Counters">
    <field name="issue_count"/>
    <field name="open_issue_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sample_item_search" model="ir.ui.view">
        <field name="name">sample.item.search</field>
        <field name="model">sample.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <separator/>
                <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                <filter name="group_active" string="Active" context="{'group_by': 'active'}"/>
            </search>
        </field>
    </record>

    <record id="view_sample_item_kanban" model="ir.ui.view">
        <field name="name">sample.item.kanban</field>
        <field name="model">sample.item</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category" sample="1">
                <field name="category"/>
                <field name="name"/>
                <field name="code"/>
                <field name="open_issue_count"/>
                <templates>
                    <t t-name="card">
                        <field name="category" class="fw-bold"/>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="open_issue_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_sample_item" model="ir.actions.act_window">
        <field name="name">Samples Issued</field>
        <field name="res_model">sample.item</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every sample you hand to prospects, its category and the delay before the call.</p>
        </field>
    </record>

</odoo>
