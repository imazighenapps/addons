<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sample_issue_list" model="ir.ui.view">
        <field name="name">sample.issue.list</field>
        <field name="model">sample.issue</field>
        <field name="arch" type="xml">
            <list string="Sample Detail" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="handed_on"/>
                <field name="recipient_id"/>
                <field name="item_id"/>
                <field name="quantity"/>
                <field name="follow_up_on"/>
                <field name="converted"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_sample_issue_form" model="ir.ui.view">
        <field name="name">sample.issue.form</field>
        <field name="model">sample.issue</field>
        <field name="arch" type="xml">
            <form string="Sample Detail">
                <header>
                    <button name="action_convert" type="object" string="Order Placed" class="btn-primary" invisible="converted"/>
                    <button name="action_return" type="object" string="Returned" class="btn-primary" invisible="state != 'out'"/>
                    <button name="action_consume" type="object" string="Consumed" class="btn-secondary" invisible="state != 'out'"/>
                    <field name="state" widget="statusbar" statusbar_visible="out,consumed,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="recipient_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Hand-Out">
    <field name="name"/>
    <field name="item_id"/>
    <field name="recipient_id"/>
    <field name="quantity"/>
    <field name="handed_on"/>
    <field name="company_id"/>
                        </group>
                        <group string="Follow Up">
    <field name="follow_up_on"/>
    <field name="state"/>
    <field name="returned_on"/>
    <field name="converted"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sample_issue_search" model="ir.ui.view">
        <field name="name">sample.issue.search</field>
        <field name="model">sample.issue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="recipient_id"/>
                <field name="item_id"/>
                <filter name="outside" string="With Prospects" domain="[('state','=','out')]"/>
                <filter name="unsold" string="No Order Yet" domain="[('state','=','out'),('converted','=',False)]"/>
                <separator/>
                <filter name="group_recipient" string="Recipient" context="{'group_by': 'recipient_id'}"/>
                <filter name="group_sample" string="Sample" context="{'group_by': 'item_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_sample_issue_kanban" model="ir.ui.view">
        <field name="name">sample.issue.kanban</field>
        <field name="model">sample.issue</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="recipient_id"/>
                <field name="item_id"/>
                <field name="handed_on"/>
                <field name="follow_up_on"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="recipient_id"/>
                        <field name="item_id"/>
                        <field name="handed_on"/>
                        <field name="follow_up_on"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_sample_issue" model="ir.actions.act_window">
        <field name="name">Sample Detail</field>
        <field name="res_model">sample.issue</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Who received what, when, and whether the sample sold or came back.</p>
        </field>
    </record>

</odoo>
