<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_close_template_list" model="ir.ui.view">
        <field name="name">close.template.list</field>
        <field name="model">close.template</field>
        <field name="arch" type="xml">
            <list string="Close Templates">
                <field name="name"/>
                <field name="line_count"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_close_template_form" model="ir.ui.view">
        <field name="name">close.template.form</field>
        <field name="model">close.template</field>
        <field name="arch" type="xml">
            <form string="Close Templates">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Template">
    <field name="name"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks" name="lineids">
                            <field name="line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="user_id"/><field name="due_day"/><field name="evidence_required"/><field name="dependency_ids" widget="many2many_tags"/></list></field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_close_template_search" model="ir.ui.view">
        <field name="name">close.template.search</field>
        <field name="model">close.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_close_template" model="ir.actions.act_window">
        <field name="name">Close Templates</field>
        <field name="res_model">close.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build your checklist once and reuse it every month.</p>
        </field>
    </record>

</odoo>
