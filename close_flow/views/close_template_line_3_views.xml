<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_close_template_line_list" model="ir.ui.view">
        <field name="name">close.template.line.list</field>
        <field name="model">close.template.line</field>
        <field name="arch" type="xml">
            <list string="Template Tasks">
                <field name="template_id"/>
                <field name="sequence"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="due_day"/>
                <field name="evidence_required"/>
                <field name="dependency_ids"/>
            </list>
        </field>
    </record>

    <record id="view_close_template_line_form" model="ir.ui.view">
        <field name="name">close.template.line.form</field>
        <field name="model">close.template.line</field>
        <field name="arch" type="xml">
            <form string="Template Tasks">
                <sheet>
                    <group>
                        <group string="Task">
    <field name="template_id"/>
    <field name="sequence"/>
    <field name="name"/>
    <field name="user_id"/>
                        </group>
                        <group string="Control">
    <field name="due_day"/>
    <field name="evidence_required"/>
    <field name="dependency_ids"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instruction" name="instruction">
                            <field name="instruction"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_close_template_line_search" model="ir.ui.view">
        <field name="name">close.template.line.search</field>
        <field name="model">close.template.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="template_id"/>
                <separator/>
                <filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/>
                <filter name="group_user" string="Owner" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_close_template_line" model="ir.actions.act_window">
        <field name="name">Template Tasks</field>
        <field name="res_model">close.template.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Each line becomes a task when the period is generated.</p>
        </field>
    </record>

</odoo>
