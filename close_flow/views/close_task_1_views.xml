<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_close_task_list" model="ir.ui.view">
        <field name="name">close.task.list</field>
        <field name="model">close.task</field>
        <field name="arch" type="xml">
            <list string="Close Tasks" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="period_id"/>
                <field name="sequence"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="due_date"/>
                <field name="evidence_required"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_close_task_form" model="ir.ui.view">
        <field name="name">close.task.form</field>
        <field name="model">close.task</field>
        <field name="arch" type="xml">
            <form string="Close Tasks">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state not in ('todo', 'blocked')"/>
                    <button name="action_done" type="object" string="Complete" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_block" type="object" string="Block" class="btn-secondary" invisible="state == 'blocked'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-link" invisible="state == 'todo'"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,in_progress,done,blocked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Task">
    <field name="period_id"/>
    <field name="sequence"/>
    <field name="name"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Owner">
    <field name="user_id"/>
    <field name="due_date"/>
    <field name="completed_on"/>
    <field name="completed_by"/>
                        </group>
                        <group string="Control">
    <field name="evidence_required"/>
    <field name="dependency_ids"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instruction" name="instruction">
                            <field name="instruction"/>
                        </page>
                        <page string="Evidence" name="attachmentids">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_close_task_search" model="ir.ui.view">
        <field name="name">close.task.search</field>
        <field name="model">close.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="period_id"/>
                <field name="user_id"/>
                <filter name="todo" string="To Do" domain="[('state','=','todo')]"/>
                <filter name="progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                <filter name="blocked" string="Blocked" domain="[('state','=','blocked')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="mine" string="My Tasks" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_user" string="Owner" context="{'group_by': 'user_id'}"/>
                <filter name="group_period" string="Period" context="{'group_by': 'period_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_close_task" model="ir.actions.act_window">
        <field name="name">Close Tasks</field>
        <field name="res_model">close.task</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every task of the close, with its owner, deadline and proof.</p>
        </field>
    </record>

</odoo>
