<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tax_rule_list" model="ir.ui.view">
        <field name="name">tax.rule.list</field>
        <field name="model">tax.rule</field>
        <field name="arch" type="xml">
            <list string="Rules">
                <field name="name"/>
                <field name="tax_type" widget="badge"/>
                <field name="frequency"/>
                <field name="due_day"/>
                <field name="lead_days"/>
                <field name="company_id"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_tax_rule_form" model="ir.ui.view">
        <field name="name">tax.rule.form</field>
        <field name="model">tax.rule</field>
        <field name="arch" type="xml">
            <form string="Rules">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Rule">
    <field name="name"/>
    <field name="tax_type"/>
    <field name="frequency"/>
    <field name="due_day"/>
    <field name="lead_days"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tax_rule_search" model="ir.ui.view">
        <field name="name">tax.rule.search</field>
        <field name="model">tax.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tax_type"/>
                <filter name="monthly" string="Monthly" domain="[('frequency','=','monthly')]"/>
                <filter name="quarterly" string="Quarterly" domain="[('frequency','=','quarterly')]"/>
                <filter name="yearly" string="Yearly" domain="[('frequency','=','yearly')]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_tax_type" string="Tax Type" context="{'group_by': 'tax_type'}"/>
                <filter name="group_frequency" string="Frequency" context="{'group_by': 'frequency'}"/>
            </search>
        </field>
    </record>

    <record id="action_tax_rule" model="ir.actions.act_window">
        <field name="name">Rules</field>
        <field name="res_model">tax.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">One rule per tax and per rhythm: the rule generates the dated deadlines, year after year.</p>
        </field>
    </record>

</odoo>
