<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_document_expiry_alerts" model="ir.cron">
            <field name="name">Smart Document Expiry: Send Expiry Alerts</field>
            <field name="model_id" ref="model_document_expiry"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_expiry_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=7, minute=0, second=0)"/>
        </record>

        <record id="ir_cron_document_expiry_state_refresh" model="ir.cron">
            <field name="name">Smart Document Expiry: Refresh Expiry States</field>
            <field name="model_id" ref="model_document_expiry"/>
            <field name="state">code</field>
            <field name="code">
docs = model.search([('state', 'not in', ['renewed', 'archived'])])
docs._compute_days_until_expiry()
docs._compute_state()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=0, minute=5, second=0)"/>
        </record>

    </data>
</odoo>
