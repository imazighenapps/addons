<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── 90-day Alert ───────────────────────────────────── -->
        <record id="email_template_alert_90" model="mail.template">
            <field name="name">Document Expiry — 90-Day Alert</field>
            <field name="model_id" ref="model_document_expiry"/>
            <field name="subject">⚠️ Document Expiring in ~90 Days: {{ object.name }}</field>
            <field name="email_to">{{ object.responsible_id.email }}</field>
            <field name="email_cc">{{ ','.join(object.notify_ids.mapped('email')) }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #f9f9f9; padding: 20px; border-radius: 8px;">
    <div style="background: #ff9800; color: white; padding: 16px 24px; border-radius: 6px 6px 0 0;">
        <h2 style="margin: 0;">⚠️ Document Expiry — Early Warning</h2>
    </div>
    <div style="background: white; padding: 24px; border-radius: 0 0 6px 6px; border: 1px solid #e0e0e0;">
        <p>Hello <strong>{{ object.responsible_id.name }}</strong>,</p>
        <p>The following document will expire in approximately <strong>90 days</strong> and requires your attention:</p>
        <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
            <tr style="background: #f5f5f5;">
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Document</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd;">{{ object.name }}</td>
            </tr>
            <tr>
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Type</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd;">{{ object.document_type_id.name }}</td>
            </tr>
            <tr style="background: #f5f5f5;">
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Reference</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd;">{{ object.reference or '—' }}</td>
            </tr>
            <tr>
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Expiry Date</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd; color: #e65100;"><strong>{{ object.expiry_date }}</strong></td>
            </tr>
            <tr style="background: #f5f5f5;">
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Entity</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd;">
                    {% if object.person_id %}{{ object.person_id.name }}{% endif %}
                    {% if object.partner_id %}{{ object.partner_id.name }}{% endif %}
                    {% if object.vehicle_id %}{{ object.vehicle_id.name }}{% endif %}
                    {% if object.equipment_id %}{{ object.equipment_id.name }}{% endif %}
                </td>
            </tr>
        </table>
        <p>Please initiate the renewal process at your earliest convenience.</p>
        <div style="text-align: center; margin-top: 24px;">
            <a href="{{ ctx.get('base_url','') }}/web#id={{ object.id }}&amp;model=document.expiry&amp;view_type=form"
               style="background: #1976d2; color: white; padding: 12px 24px; border-radius: 4px; text-decoration: none; font-weight: bold;">
               View Document
            </a>
        </div>
        <p style="color: #888; font-size: 12px; margin-top: 24px;">This is an automated alert from Smart Document Expiry Tracker.</p>
    </div>
</div>
            ]]></field>
        </record>

        <!-- ── 30-day Alert ───────────────────────────────────── -->
        <record id="email_template_alert_30" model="mail.template">
            <field name="name">Document Expiry — 30-Day Alert</field>
            <field name="model_id" ref="model_document_expiry"/>
            <field name="subject">🟠 Action Required — Document Expires in 30 Days: {{ object.name }}</field>
            <field name="email_to">{{ object.responsible_id.email }}</field>
            <field name="email_cc">{{ ','.join(object.notify_ids.mapped('email')) }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #f9f9f9; padding: 20px; border-radius: 8px;">
    <div style="background: #e65100; color: white; padding: 16px 24px; border-radius: 6px 6px 0 0;">
        <h2 style="margin: 0;">🟠 Urgent: Document Expiring in 30 Days</h2>
    </div>
    <div style="background: white; padding: 24px; border-radius: 0 0 6px 6px; border: 1px solid #e0e0e0;">
        <p>Hello <strong>{{ object.responsible_id.name }}</strong>,</p>
        <p>This is an urgent reminder. The document below will expire in <strong>30 days</strong>. Immediate action is required:</p>
        <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
            <tr style="background: #fff3e0;">
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Document</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd;">{{ object.name }}</td>
            </tr>
            <tr>
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Type</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd;">{{ object.document_type_id.name }}</td>
            </tr>
            <tr style="background: #fff3e0;">
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Expiry Date</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd; color: #bf360c;"><strong>{{ object.expiry_date }}</strong></td>
            </tr>
        </table>
        <div style="text-align: center; margin-top: 24px;">
            <a href="{{ ctx.get('base_url','') }}/web#id={{ object.id }}&amp;model=document.expiry&amp;view_type=form"
               style="background: #e65100; color: white; padding: 12px 24px; border-radius: 4px; text-decoration: none; font-weight: bold;">
               Renew Now
            </a>
        </div>
        <p style="color: #888; font-size: 12px; margin-top: 24px;">Smart Document Expiry Tracker — automated alert.</p>
    </div>
</div>
            ]]></field>
        </record>

        <!-- ── 7-day Final Alert ──────────────────────────────── -->
        <record id="email_template_alert_7" model="mail.template">
            <field name="name">Document Expiry — 7-Day Final Alert</field>
            <field name="model_id" ref="model_document_expiry"/>
            <field name="subject">🔴 FINAL WARNING — Document Expires in 7 Days: {{ object.name }}</field>
            <field name="email_to">{{ object.responsible_id.email }}</field>
            <field name="email_cc">{{ ','.join(object.notify_ids.mapped('email')) }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #f9f9f9; padding: 20px; border-radius: 8px;">
    <div style="background: #c62828; color: white; padding: 16px 24px; border-radius: 6px 6px 0 0;">
        <h2 style="margin: 0;">🔴 FINAL WARNING — 7 Days Left</h2>
    </div>
    <div style="background: white; padding: 24px; border-radius: 0 0 6px 6px; border: 2px solid #c62828;">
        <p>Hello <strong>{{ object.responsible_id.name }}</strong>,</p>
        <p style="color: #c62828; font-weight: bold;">⚠️ The document below expires in 7 days. Failure to renew may result in compliance issues.</p>
        <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
            <tr style="background: #ffebee;">
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Document</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd; color: #c62828; font-weight: bold;">{{ object.name }}</td>
            </tr>
            <tr>
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Expiry Date</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd; color: #c62828;"><strong>{{ object.expiry_date }}</strong></td>
            </tr>
        </table>
        <div style="text-align: center; margin-top: 24px;">
            <a href="{{ ctx.get('base_url','') }}/web#id={{ object.id }}&amp;model=document.expiry&amp;view_type=form"
               style="background: #c62828; color: white; padding: 14px 28px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 16px;">
               🚨 Renew Immediately
            </a>
        </div>
    </div>
</div>
            ]]></field>
        </record>

        <!-- ── Escalation Alert ───────────────────────────────── -->
        <record id="email_template_escalation" model="mail.template">
            <field name="name">Document Expiry — Escalation Alert</field>
            <field name="model_id" ref="model_document_expiry"/>
            <field name="subject">🚨 ESCALATION — Document EXPIRED and NOT Renewed: {{ object.name }}</field>
            <field name="email_to">{{ object.responsible_id.partner_id.parent_id.user_ids[:1].email or object.responsible_id.email }}</field>
            <field name="email_cc">{{ object.responsible_id.email }},{{ ','.join(object.notify_ids.mapped('email')) }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #f9f9f9; padding: 20px; border-radius: 8px;">
    <div style="background: #4a148c; color: white; padding: 16px 24px; border-radius: 6px 6px 0 0;">
        <h2 style="margin: 0;">🚨 ESCALATION — Expired Document Not Renewed</h2>
    </div>
    <div style="background: white; padding: 24px; border-radius: 0 0 6px 6px; border: 2px solid #4a148c;">
        <p>This is an escalation notification. The following document has <strong style="color:#c62828">EXPIRED</strong> and has not been renewed:</p>
        <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
            <tr style="background: #f3e5f5;">
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Document</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold; color: #4a148c;">{{ object.name }}</td>
            </tr>
            <tr>
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Expired On</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd; color: #c62828;"><strong>{{ object.expiry_date }}</strong></td>
            </tr>
            <tr style="background: #f3e5f5;">
                <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold;">Responsible</td>
                <td style="padding: 8px 12px; border: 1px solid #ddd;">{{ object.responsible_id.name }}</td>
            </tr>
        </table>
        <p>Please intervene immediately to ensure compliance.</p>
        <div style="text-align: center; margin-top: 24px;">
            <a href="{{ ctx.get('base_url','') }}/web#id={{ object.id }}&amp;model=document.expiry&amp;view_type=form"
               style="background: #4a148c; color: white; padding: 14px 28px; border-radius: 4px; text-decoration: none; font-weight: bold;">
               View &amp; Take Action
            </a>
        </div>
    </div>
</div>
            ]]></field>
        </record>

    </data>
</odoo>
