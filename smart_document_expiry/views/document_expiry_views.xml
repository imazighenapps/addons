<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════
         FORM VIEW
    ════════════════════════════════════════════════════ -->
    <record id="view_document_expiry_form" model="ir.ui.view">
        <field name="name">document.expiry.form</field>
        <field name="model">document.expiry</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_renew"
                            string="🔄 Renew Document"
                            type="object"
                            class="btn-primary"
                            invisible="state in ('renewed','archived')"/>
                    <button name="action_archive_document"
                            string="Archive"
                            type="object"
                            class="btn-secondary"
                            invisible="state in ('renewed','archived')"
                            confirm="Archive this document? It will be hidden from active views."/>
                    <button name="action_view_history"
                            string="📋 View History"
                            type="object"
                            class="btn-secondary"
                            invisible="renewal_count == 0"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="valid,expiring_soon,expired,renewed"/>
                </header>
                <sheet>
                    <!-- Alert banners -->
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'expired'">
                        <strong>🔴 This document has EXPIRED.</strong>
                        Please renew it immediately to maintain compliance.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'expiring_soon'">
                        <strong>🟠 This document expires in <field name="days_until_expiry" readonly="1"/> days.</strong>
                        Please schedule renewal soon.
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="state != 'renewed'">
                        <strong>✅ This document has been renewed.</strong>
                        It is now archived for historical reference.
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_history" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="renewal_count == 0">
                            <field name="renewal_count" widget="statinfo" string="Renewals"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-paperclip"
                                type="object" name="action_get_attachment_view">
                            <field name="attachment_count" widget="statinfo" string="Files"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Document name..."/></h1>
                    </div>

                    <group>
                        <group string="Document Info">
                            <field name="document_type_id"/>
                            <field name="reference"/>
                            <field name="entity_type" widget="radio"/>
                        </group>
                        <group string="Dates &amp; Status">
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_until_expiry" readonly="1"
                                   decoration-danger="days_until_expiry &lt; 0"
                                   decoration-warning="days_until_expiry &gt;= 0 and days_until_expiry &lt;= 30"
                                   decoration-success="days_until_expiry &gt; 30"/>
                        </group>
                    </group>

                    <group string="Entity">
                        <field name="person_id"  invisible="entity_type != 'person'"
                               required="entity_type == 'person'"/>
                        <field name="partner_id"   invisible="entity_type != 'vendor'"
                               required="entity_type == 'vendor'"/>
                        <field name="vehicle_id"   invisible="entity_type != 'vehicle'"
                               required="entity_type == 'vehicle'"/>
                        <field name="equipment_id" invisible="entity_type != 'equipment'"
                               required="entity_type == 'equipment'"/>
                        <field name="other_entity_name" invisible="entity_type != 'other'"
                               required="entity_type == 'other'"
                               placeholder="Describe the entity..."/>
                    </group>

                    <group string="Responsibility">
                        <field name="responsible_id"/>
                        <field name="notify_ids" widget="many2many_tags"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>

                    <group string="Alert Status" groups="smart_document_expiry.group_document_manager">
                        <field name="alert_90_sent" readonly="1"/>
                        <field name="alert_30_sent" readonly="1"/>
                        <field name="alert_7_sent"  readonly="1"/>
                        <field name="escalation_sent" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes, instructions..."/>
                        </page>
                        <page string="History" name="history" invisible="previous_document_id == False">
                            <group>
                                <field name="previous_document_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════
         LIST VIEW
    ════════════════════════════════════════════════════ -->
    <record id="view_document_expiry_list" model="ir.ui.view">
        <field name="name">document.expiry.list</field>
        <field name="model">document.expiry</field>
        <field name="arch" type="xml">
            <list string="Documents"
                  decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring_soon'"
                  decoration-success="state == 'valid'"
                  decoration-muted="state in ('renewed','archived')">
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="entity_type"/>
                <field name="person_id"  optional="show" invisible="entity_type != 'person'"/>
                <field name="partner_id"   optional="show" invisible="entity_type != 'vendor'"/>
                <field name="vehicle_id"   optional="show" invisible="entity_type != 'vehicle'"/>
                <field name="equipment_id" optional="show" invisible="entity_type != 'equipment'"/>
                <field name="reference"    optional="hide"/>
                <field name="issue_date"   optional="hide"/>
                <field name="expiry_date"/>
                <field name="days_until_expiry"
                       decoration-danger="days_until_expiry &lt; 0"
                       decoration-warning="days_until_expiry &gt;= 0 and days_until_expiry &lt;= 30"
                       decoration-success="days_until_expiry &gt; 30"
                       string="Days Left"/>
                <field name="responsible_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'expired'"
                       decoration-warning="state == 'expiring_soon'"
                       decoration-success="state == 'valid'"
                       decoration-info="state == 'renewed'"/>
                <button name="action_renew" type="object"
                        icon="fa-refresh" title="Renew"
                        invisible="state in ('renewed','archived')"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════
         KANBAN VIEW
    ════════════════════════════════════════════════════ -->
    <record id="view_document_expiry_kanban" model="ir.ui.view">
        <field name="name">document.expiry.kanban</field>
        <field name="model">document.expiry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    group_create="false">
                <field name="name"/>
                <field name="state"/>
                <field name="days_until_expiry"/>
                <field name="expiry_date"/>
                <field name="entity_type"/>
                <field name="person_id"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="equipment_id"/>
                <field name="document_type_id"/>
                <field name="responsible_id"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click
                             #{ record.state.raw_value == 'expired' ? 'border-danger' :
                                record.state.raw_value == 'expiring_soon' ? 'border-warning' :
                                'border-success' }">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div>
                                        <field name="state" widget="badge"
                                               options="{'classes': {'valid': 'success', 'expiring_soon': 'warning', 'expired': 'danger', 'renewed': 'info'}}"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="text-muted small">
                                        <i class="fa fa-tag me-1"/><field name="document_type_id"/>
                                    </div>
                                    <div class="mt-1">
                                        <span t-if="record.entity_type.raw_value == 'employee'">
                                            <i class="fa fa-user me-1 text-primary"/>
                                            <field name="person_id"/>
                                        </span>
                                        <span t-if="record.entity_type.raw_value == 'vendor'">
                                            <i class="fa fa-building me-1 text-info"/>
                                            <field name="partner_id"/>
                                        </span>
                                        <span t-if="record.entity_type.raw_value == 'vehicle'">
                                            <i class="fa fa-car me-1 text-success"/>
                                            <field name="vehicle_id"/>
                                        </span>
                                        <span t-if="record.entity_type.raw_value == 'equipment'">
                                            <i class="fa fa-cogs me-1 text-warning"/>
                                            <field name="equipment_id"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <i class="fa fa-calendar me-1"/>
                                        <field name="expiry_date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <t t-if="record.days_until_expiry.raw_value &lt; 0">
                                            <span class="badge bg-danger">
                                                <t t-esc="Math.abs(record.days_until_expiry.raw_value)"/> days ago
                                            </span>
                                        </t>
                                        <t t-elif="record.days_until_expiry.raw_value &lt;= 30">
                                            <span class="badge bg-warning text-dark">
                                                <t t-esc="record.days_until_expiry.raw_value"/> days left
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge bg-success">
                                                <t t-esc="record.days_until_expiry.raw_value"/> days left
                                            </span>
                                        </t>
                                        <field name="responsible_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════
         SEARCH VIEW
    ════════════════════════════════════════════════════ -->
    <record id="view_document_expiry_search" model="ir.ui.view">
        <field name="name">document.expiry.search</field>
        <field name="model">document.expiry</field>
        <field name="arch" type="xml">
            <search string="Search Documents">
                <field name="name" string="Document" filter_domain="[('name','ilike',self)]"/>
                <field name="reference"/>
                <field name="document_type_id"/>
                <field name="person_id"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="responsible_id"/>

                <separator/>

                <!-- Status filters -->
                <filter name="filter_expired"
                        string="🔴 Expired"
                        domain="[('state','=','expired')]"/>
                <filter name="filter_expiring_soon"
                        string="🟠 Expiring Soon"
                        domain="[('state','=','expiring_soon')]"/>
                <filter name="filter_valid"
                        string="🟢 Valid"
                        domain="[('state','=','valid')]"/>
                <filter name="filter_renewed"
                        string="🔵 Renewed"
                        domain="[('state','=','renewed')]"/>

                <separator/>

                <!-- Time-based filters -->
                <filter name="filter_expiry_7"
                        string="Expiring within 7 days"
                        domain="[('days_until_expiry','&lt;=',7),('days_until_expiry','&gt;=',0)]"/>
                <filter name="filter_expiry_30"
                        string="Expiring within 30 days"
                        domain="[('days_until_expiry','&lt;=',30),('days_until_expiry','&gt;=',0)]"/>
                <filter name="filter_expiry_90"
                        string="Expiring within 90 days"
                        domain="[('days_until_expiry','&lt;=',90),('days_until_expiry','&gt;=',0)]"/>

                <separator/>

                <!-- Entity filters -->
                <filter name="filter_employee"  string="Employees"  domain="[('entity_type','=','employee')]"/>
                <filter name="filter_vendor"    string="Vendors"    domain="[('entity_type','=','vendor')]"/>
                <filter name="filter_vehicle"   string="Vehicles"   domain="[('entity_type','=','vehicle')]"/>
                <filter name="filter_equipment" string="Equipment"  domain="[('entity_type','=','equipment')]"/>

                <separator/>

                <filter name="filter_my_documents"
                        string="My Documents"
                        domain="[('responsible_id','=',uid)]"/>

                <!-- Group by -->
                <group>
                    <filter name="group_by_state"         string="Status"        context="{'group_by': 'state'}"/>
                    <filter name="group_by_entity_type"   string="Entity Type"   context="{'group_by': 'entity_type'}"/>
                    <filter name="group_by_document_type" string="Document Type" context="{'group_by': 'document_type_id'}"/>
                    <filter name="group_by_responsible"   string="Responsible"   context="{'group_by': 'responsible_id'}"/>
                    <filter name="group_by_expiry_month"  string="Expiry Month"  context="{'group_by': 'expiry_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════
         ACTION
    ════════════════════════════════════════════════════ -->
    <record id="action_document_expiry" model="ir.actions.act_window">
        <field name="name">All Documents</field>
        <field name="res_model">document.expiry</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_document_expiry_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents tracked yet!
            </p>
            <p>
                Start by adding your first document — a work permit, vehicle insurance,
                vendor contract, or any document with an expiry date.
            </p>
        </field>
    </record>

    <record id="action_document_expiry_expired" model="ir.actions.act_window">
        <field name="name">Expired Documents</field>
        <field name="res_model">document.expiry</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state','=','expired')]</field>
        <field name="search_view_id" ref="view_document_expiry_search"/>
        <field name="context">{'search_default_filter_expired': 1}</field>
    </record>

    <record id="action_document_expiry_soon" model="ir.actions.act_window">
        <field name="name">Expiring Soon</field>
        <field name="res_model">document.expiry</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state','=','expiring_soon')]</field>
        <field name="search_view_id" ref="view_document_expiry_search"/>
    </record>

</odoo>
