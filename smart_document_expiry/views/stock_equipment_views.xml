<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════
         document.equipment — FORM VIEW
    ════════════════════════════════════════════════════ -->
    <record id="view_document_equipment_form" model="ir.ui.view">
        <field name="name">document.equipment.form</field>
        <field name="model">document.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="document_expiry_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="document_expiry_count"/>
                                </span>
                                <span class="o_stat_text">Documents</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Equipment name..."/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="category"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Compliance">
                            <field name="compliance_score" readonly="1"/>
                            <field name="document_expired_count" readonly="1"/>
                        </group>
                    </group>

                    <field name="notes" placeholder="Notes..."/>

                    <notebook>
                        <page string="Documents" name="equipment_documents" icon="fa-file-text-o">
                            <field name="document_expiry_ids" mode="list">
                                <list decoration-danger="state == 'expired'"
                                      decoration-warning="state == 'expiring_soon'"
                                      decoration-success="state == 'valid'">
                                    <field name="name"/>
                                    <field name="document_type_id"/>
                                    <field name="reference"/>
                                    <field name="expiry_date"/>
                                    <field name="days_until_expiry" string="Days Left"/>
                                    <field name="state" widget="badge"
                                           decoration-danger="state == 'expired'"
                                           decoration-warning="state == 'expiring_soon'"
                                           decoration-success="state == 'valid'"/>
                                    <button name="action_renew" type="object"
                                            icon="fa-refresh" title="Renew"
                                            invisible="state in ('renewed','archived')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_document_equipment_list" model="ir.ui.view">
        <field name="name">document.equipment.list</field>
        <field name="model">document.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="name"/>
                <field name="reference"/>
                <field name="category"/>
                <field name="document_expiry_count" string="Docs"/>
                <field name="document_expired_count" string="Expired"/>
                <field name="compliance_score" string="Compliance (%)"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_document_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">document.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
