<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_document_type_list" model="ir.ui.view">
        <field name="name">document.expiry.type.list</field>
        <field name="model">document.expiry.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="entity_type"/>
                <field name="alert_days_1" string="Alert 1 (days)"/>
                <field name="alert_days_2" string="Alert 2 (days)"/>
                <field name="alert_days_3" string="Alert 3 (days)"/>
                <field name="escalation_days"/>
                <field name="require_renewal_attachment"/>
                <field name="document_count" string="Documents"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_document_type_form" model="ir.ui.view">
        <field name="name">document.expiry.type.form</field>
        <field name="model">document.expiry.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Document type name..."/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="code"/>
                            <field name="entity_type"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                        <group string="Alert Schedule">
                            <field name="alert_days_1" string="First alert (days before expiry)"/>
                            <field name="alert_days_2" string="Second alert (days before expiry)"/>
                            <field name="alert_days_3" string="Final alert (days before expiry)"/>
                            <field name="escalation_days" string="Escalate after expiry (days)"/>
                        </group>
                    </group>
                    <group>
                        <field name="require_renewal_attachment"/>
                        <field name="description" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">document.expiry.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
