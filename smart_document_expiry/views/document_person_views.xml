<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_document_person_form" model="ir.ui.view">
        <field name="name">document.person.form</field>
        <field name="model">document.person</field>
        <field name="arch" type="xml">
            <form string="Person">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="document_expiry_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="document_expiry_count"/></span>
                                <span class="o_stat_text">Documents</span>
                            </div>
                        </button>
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="document_expired_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value text-danger"><field name="document_expired_count"/></span>
                                <span class="o_stat_text">Expired</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Full name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_title"/>
                            <field name="department"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group string="Compliance">
                            <field name="compliance_score" string="Compliance (%)" readonly="1"/>
                            <field name="document_expiring_count" string="Expiring Soon" readonly="1"/>
                            <field name="document_expired_count"  string="Expired"       readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                    <notebook>
                        <page string="Documents" icon="fa-file-text-o">
                            <field name="document_expiry_ids" mode="list">
                                <list decoration-danger="state == 'expired'"
                                      decoration-warning="state == 'expiring_soon'"
                                      decoration-success="state == 'valid'">
                                    <field name="name"/>
                                    <field name="document_type_id"/>
                                    <field name="reference"/>
                                    <field name="expiry_date"/>
                                    <field name="days_until_expiry" string="Days Left"/>
                                    <field name="state" widget="badge"
                                           decoration-danger="state == 'expired'"
                                           decoration-warning="state == 'expiring_soon'"
                                           decoration-success="state == 'valid'"/>
                                    <button name="action_renew" type="object"
                                            icon="fa-refresh" title="Renew"
                                            invisible="state in ('renewed','archived')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_document_person_list" model="ir.ui.view">
        <field name="name">document.person.list</field>
        <field name="model">document.person</field>
        <field name="arch" type="xml">
            <list string="Persons">
                <field name="name"/>
                <field name="job_title"/>
                <field name="department"/>
                <field name="email"/>
                <field name="document_expiry_count"  string="Docs"/>
                <field name="document_expired_count" string="Expired"
                       decoration-danger="document_expired_count > 0"/>
                <field name="compliance_score"       string="Compliance (%)"/>
            </list>
        </field>
    </record>

    <record id="view_document_person_search" model="ir.ui.view">
        <field name="name">document.person.search</field>
        <field name="model">document.person</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department"/>
                <field name="job_title"/>
                <!-- <filter string="With Expired Docs" name="has_expired"
                        domain="[('document_expired_count','>',0)]"/> -->
                <group>
                    <!-- <filter string="Department" name="by_dept" context="{'group_by':'department'}"/> -->
                </group>
            </search>
        </field>
    </record>

    <record id="action_document_person" model="ir.actions.act_window">
        <field name="name">Persons</field>
        <field name="res_model">document.person</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_document_person_search"/>
    </record>

</odoo>
