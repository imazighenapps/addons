<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mileage_log_list" model="ir.ui.view">
        <field name="name">mileage.log.list</field>
        <field name="model">mileage.log</field>
        <field name="arch" type="xml">
            <list string="Mileage Logs" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="purpose"/>
                <field name="distance" sum="Total Distance"/>
                <field name="amount" sum="Total Amount"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mileage_log_form" model="ir.ui.view">
        <field name="name">mileage.log.form</field>
        <field name="model">mileage.log</field>
        <field name="arch" type="xml">
            <form string="Mileage Logs">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-secondary" invisible="state != 'submitted'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Trip">
    <field name="name"/>
    <field name="employee_id"/>
    <field name="department_id"/>
    <field name="date"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Route">
    <field name="origin"/>
    <field name="destination"/>
    <field name="purpose"/>
                        </group>
                        <group string="Amount">
    <field name="distance"/>
    <field name="currency_id"/>
    <field name="rate"/>
    <field name="amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mileage_log_search" model="ir.ui.view">
        <field name="name">mileage.log.search</field>
        <field name="model">mileage.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="purpose"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="validated" string="Validated" domain="[('state','=','validated')]"/>
                <filter name="refused" string="Refused" domain="[('state','=','refused')]"/>
                <separator/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_mileage_log" model="ir.actions.act_window">
        <field name="name">Mileage Logs</field>
        <field name="res_model">mileage.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log and validate business mileage trips.</p>
        </field>
    </record>

</odoo>
