<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_purchaserequ_user" model="res.groups">
        <field name="name">Purchase Request User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_purchaserequ_manager" model="res.groups">
        <field name="name">Purchase Request Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('purchase_request.group_purchaserequ_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
