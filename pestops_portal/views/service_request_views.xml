<odoo>
    <record id="action_pest_service_requests" model="ir.actions.act_window">
        <field name="name">Service Requests</field>
        <field name="res_model">pest.service.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="view_pest_service_request_list" model="ir.ui.view">
        <field name="name">pest.service.request.list</field>
        <field name="model">pest.service.request</field>
        <field name="arch" type="xml">
            <list string="Service Requests" decoration-danger="priority == '2'" decoration-warning="priority == '1'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <field name="visit_id"/>
                <field name="request_type"/>
                <field name="priority" widget="priority"/>
                <field name="state"/>
                <field name="create_date"/>
                <field name="resservice_id"/>
            </list>
        </field>
    </record>

    <record id="view_pest_service_request_form" model="ir.ui.view">
        <field name="name">pest.service.request.form</field>
        <field name="model">pest.service.request</field>
        <field name="arch" type="xml">
            <form string="Service Request">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_done" type="object" string="Close" class="btn-primary" invisible="state not in ('in_progress', 'submitted')"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state in ('done', 'rejected')"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state not in ('done', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,in_progress,done,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="action" class="oe_stat_button" name="%(action_pest_service_requests)d" icon="fa-list" context="{'search_default_partner_id': partner_id}">
                            <div class="o_stat_info"><span class="o_stat_text">Requests</span></div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="site_id"/>
                            <field name="visit_id" domain="[('site_id', '=', site_id)]"/>
                            <field name="resservice_id"/>
                        </group>
                        <group>
                            <field name="request_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="submitted_by_id"/>
                            <field name="company_id"/>
                            <field name="create_date"/>
                            <field name="closed_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="description" placeholder="Describe the issue or request..."/>
                        </page>
                        <page string="Internal Response">
                            <field name="response_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
