<odoo>
    <record id="view_pest_contract_form_accounting" model="ir.ui.view">
        <field name="name">pest.contract.form.accounting</field>
        <field name="model">pest.contract</field>
        <field name="inherit_id" ref="pestops_core.view_pest_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_prepare_billing" type="object" string="Prepare Billing" invisible="state not in ('confirmed', 'to_renew')"/>
                <button name="action_generate_invoices" type="object" string="Generate Invoices" class="oe_highlight" invisible="state not in ('confirmed', 'to_renew')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_billing_items" class="oe_stat_button" icon="fa-list-alt">
                    <field name="billing_item_count" widget="statinfo" string="Billing Items"/>
                </button>
                <button type="object" name="action_view_billing_invoices" class="oe_stat_button" icon="fa-file-text-o">
                    <field name="billing_invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='billing_notes']" position="before">
                <page string="Billing">
                    <group>
                        <group>
                            <field name="billing_product_id"/>
                            <field name="billing_payment_term_id"/>
                            <field name="billing_frequency"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="billing_to_invoice_amount" readonly="1"/>
                            <field name="billing_invoiced_amount" readonly="1"/>
                        </group>
                    </group>
                    <field name="billing_item_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="source_type"/>
                            <field name="invoice_date"/>
                            <field name="amount"/>
                            <field name="state"/>
                            <field name="invoice_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
