<odoo>
    <record id="view_pest_billing_item_list" model="ir.ui.view">
        <field name="name">pest.billing.item.list</field>
        <field name="model">pest.billing.item</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'invoiced'">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="source_type"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="invoice_date"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="amount" sum="Total"/>
                <field name="state"/>
                <field name="invoice_id"/>
            </list>
        </field>
    </record>

    <record id="view_pest_billing_item_form" model="ir.ui.view">
        <field name="name">pest.billing.item.form</field>
        <field name="model">pest.billing.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'to_invoice'"/>
                    <button name="action_reset_to_invoice" type="object" string="Reset to Invoice" class="oe_highlight" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="to_invoice,invoiced,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="source_type"/>
                            <field name="visit_id" invisible="source_type != 'visit'"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="currency_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="unit_price"/>
                        <field name="amount" readonly="1"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pest_billing_items" model="ir.actions.act_window">
        <field name="name">Billing Items</field>
        <field name="res_model">pest.billing.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
