<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_late_fee_rule_list" model="ir.ui.view">
        <field name="name">late.fee.rule.list</field>
        <field name="model">late.fee.rule</field>
        <field name="arch" type="xml">
            <list string="Interest Rules">
                <field name="name"/>
                <field name="annual_rate"/>
                <field name="fixed_fee"/>
                <field name="issued_amount" sum="Total Issued Amount"/>
                <field name="line_count"/>
            </list>
        </field>
    </record>

    <record id="view_late_fee_rule_form" model="ir.ui.view">
        <field name="name">late.fee.rule.form</field>
        <field name="model">late.fee.rule</field>
        <field name="arch" type="xml">
            <form string="Interest Rules">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Rule">
    <field name="name"/>
    <field name="annual_rate"/>
    <field name="fixed_fee"/>
    <field name="active"/>
    <field name="currency_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Totals">
    <field name="issued_amount"/>
    <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_late_fee_rule_search" model="ir.ui.view">
        <field name="name">late.fee.rule.search</field>
        <field name="model">late.fee.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_late_fee_rule" model="ir.actions.act_window">
        <field name="name">Interest Rules</field>
        <field name="res_model">late.fee.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the statutory interest rates you apply to late payments.</p>
        </field>
    </record>

</odoo>
