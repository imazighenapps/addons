<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sct_batch_list" model="ir.ui.view">
        <field name="name">sct.batch.list</field>
        <field name="model">sct.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="nb_txs"/>
                <field name="ctrl_sum"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_sct_reject_import" model="ir.actions.act_window">
        <field name="name">Importer rejets pain.002</field>
        <field name="res_model">sct.reject.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_batch_id': active_id}</field>
    </record>

    <record id="view_sct_batch_form" model="ir.ui.view">
        <field name="name">sct.batch.form</field>
        <field name="model">sct.batch</field>
        <field name="arch" type="xml">
            <form string="Lot SEPA SCT">
                <header>
                    <button name="action_generate" type="object" string="Générer pain.001" class="btn-primary"/>
                    <button name="action_download" type="object" string="Télécharger" class="btn-secondary"/>
                    <button name="action_mark_sent" type="object" string="Marquer transmis" class="btn-secondary"/>
                    <button name="%(action_sct_reject_import)d" type="action" string="Importer rejets (pain.002)" class="btn-secondary"/>
                    <button name="action_reset_draft" type="object" string="Remettre en brouillon" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,sent,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="msg_id"/>
                            <field name="pmt_inf_id"/>
                            <field name="nb_txs"/>
                            <field name="ctrl_sum"/>
                            <field name="file_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Paiements">
                            <field name="payment_ids"/>
                        </page>
                        <page string="Rejets">
                            <field name="reject_info"/>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sct_reject_import_form" model="ir.ui.view">
        <field name="name">sct.reject.import.form</field>
        <field name="model">sct.reject.import</field>
        <field name="arch" type="xml">
            <form string="Importer rejets pain.002">
                <group>
                    <field name="batch_id"/>
                    <field name="file_name"/>
                    <field name="file_data" filename="file_name"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importer" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
