<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_parcel_late_list" model="ir.ui.view">
        <field name="name">parcel.parcel.list</field>
        <field name="model">parcel.parcel</field>
        <field name="arch" type="xml">
            <list string="Late Parcels" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="tracking_number"/>
                <field name="carrier"/>
                <field name="partner_id"/>
                <field name="expected_on"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_parcel_late_form" model="ir.ui.view">
        <field name="name">parcel.parcel.form</field>
        <field name="model">parcel.parcel</field>
        <field name="arch" type="xml">
            <form string="Late Parcels">
                <header>
                    <button name="action_mark_received" type="object" string="Receive" class="btn-primary" invisible="state in ('received','lost')"/>
                    <button name="action_mark_lost" type="object" string="Mark Lost" class="btn-secondary" invisible="state in ('received','lost')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_transit,received,lost"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Parcel">
    <field name="name"/>
    <field name="tracking_number"/>
    <field name="carrier"/>
    <field name="partner_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Dates">
    <field name="expected_on"/>
    <field name="received_on"/>
    <field name="is_late"/>
    <field name="state"/>
                        </group>
                        <group string="Tracking">
    <field name="tracking_url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lost Reason" name="lostreason">
                            <field name="lost_reason"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_parcel_late_search" model="ir.ui.view">
        <field name="name">parcel.parcel.search</field>
        <field name="model">parcel.parcel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tracking_number"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="group_carrier" string="Carrier" context="{'group_by': 'carrier'}"/>
            </search>
        </field>
    </record>

    <record id="action_parcel_late" model="ir.actions.act_window">
        <field name="name">Late Parcels</field>
        <field name="res_model">parcel.parcel</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Parcels still on the road after their expected date.</p>
        </field>
    </record>

</odoo>
