<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_parcelwatch_user" model="res.groups">
        <field name="name">Parcel Watch User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_parcelwatch_manager" model="res.groups">
        <field name="name">Parcel Watch Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('parcel_watch.group_parcelwatch_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
