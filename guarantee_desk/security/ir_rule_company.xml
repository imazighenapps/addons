<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bank_guarantee_company" model="ir.rule">
        <field name="name">bank.guarantee: own company only</field>
        <field name="model_id" ref="model_bank_guarantee"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_bank_guarantee_renewal_company" model="ir.rule">
        <field name="name">bank.guarantee.renewal: own company only</field>
        <field name="model_id" ref="model_bank_guarantee_renewal"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
