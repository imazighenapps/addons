<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_guarantee_list" model="ir.ui.view">
        <field name="name">bank.guarantee.list</field>
        <field name="model">bank.guarantee</field>
        <field name="arch" type="xml">
            <list string="Bank Guarantees" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="guarantee_type"/>
                <field name="beneficiary_id"/>
                <field name="issuing_bank_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="renewal_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_bank_guarantee_form" model="ir.ui.view">
        <field name="name">bank.guarantee.form</field>
        <field name="model">bank.guarantee</field>
        <field name="arch" type="xml">
            <form string="Bank Guarantees">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_release" type="object" string="Release" class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state not in ('draft', 'active')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,released,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Guarantee">
    <field name="name"/>
    <field name="guarantee_type"/>
    <field name="beneficiary_id"/>
    <field name="issuing_bank_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amount">
    <field name="amount"/>
    <field name="currency_id"/>
    <field name="state"/>
                        </group>
                        <group string="Dates">
    <field name="issue_date"/>
    <field name="expiry_date"/>
    <field name="release_date"/>
    <field name="renewal_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Renewals" name="renewalids">
                            <field name="renewal_ids" readonly="state == 'released'">
                        <list editable="bottom">
                            <field name="renewed_on"/>
                            <field name="previous_expiry"/>
                            <field name="new_expiry"/>
                            <field name="fee" sum="Total"/>
                            <field name="note"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Release Note" name="releasenote">
                            <field name="release_note"/>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bank_guarantee_search" model="ir.ui.view">
        <field name="name">bank.guarantee.search</field>
        <field name="model">bank.guarantee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="beneficiary_id"/>
                <field name="issuing_bank_id"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="released" string="Released" domain="[('state','=','released')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_type" string="Type" context="{'group_by': 'guarantee_type'}"/>
                <filter name="group_beneficiary" string="Beneficiary" context="{'group_by': 'beneficiary_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_bank_guarantee_kanban" model="ir.ui.view">
        <field name="name">bank.guarantee.kanban</field>
        <field name="model">bank.guarantee</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="beneficiary_id"/>
                <field name="amount"/>
                <field name="expiry_date"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="beneficiary_id"/>
                        <field name="amount"/>
                        <field name="expiry_date"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_bank_guarantee" model="ir.actions.act_window">
        <field name="name">Bank Guarantees</field>
        <field name="res_model">bank.guarantee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Keep every guarantee, its expiry and its release in one register.</p>
        </field>
    </record>

</odoo>
