<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_feedback_topic_list" model="ir.ui.view">
        <field name="name">customer.feedback.topic.list</field>
        <field name="model">customer.feedback.topic</field>
        <field name="arch" type="xml">
            <list string="Feedback Topics">
                <field name="name"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_customer_feedback_topic_form" model="ir.ui.view">
        <field name="name">customer.feedback.topic.form</field>
        <field name="model">customer.feedback.topic</field>
        <field name="arch" type="xml">
            <form string="Feedback Topics">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Topic">
    <field name="name"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_customer_feedback_topic_search" model="ir.ui.view">
        <field name="name">customer.feedback.topic.search</field>
        <field name="model">customer.feedback.topic</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_customer_feedback_topic" model="ir.actions.act_window">
        <field name="name">Feedback Topics</field>
        <field name="res_model">customer.feedback.topic</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Topics to classify customer feedback.</p>
        </field>
    </record>

</odoo>
