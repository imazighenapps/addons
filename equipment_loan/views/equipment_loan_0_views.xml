<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_equipment_loan_list" model="ir.ui.view">
        <field name="name">equipment.loan.list</field>
        <field name="model">equipment.loan</field>
        <field name="arch" type="xml">
            <list string="Equipment Loans" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="item_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="state" widget="badge"/>
                <field name="date_out"/>
                <field name="date_due"/>
                <field name="date_return"/>
                <field name="is_overdue" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_loan_form" model="ir.ui.view">
        <field name="name">equipment.loan.form</field>
        <field name="model">equipment.loan</field>
        <field name="arch" type="xml">
            <form string="Equipment Loans">
                <header>
                    <button name="action_start" type="object" string="Start Loan" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_return" type="object" string="Mark Returned" class="btn-primary" invisible="state != 'ongoing'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state in ('ongoing','returned','cancelled')"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ongoing,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Loan">
    <field name="name"/>
    <field name="item_id"/>
    <field name="employee_id"/>
    <field name="department_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Dates">
    <field name="date_out"/>
    <field name="date_due"/>
    <field name="date_return"/>
    <field name="is_overdue"/>
                        </group>
                        <group string="Return">
    <field name="return_condition"/>
    <field name="return_note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_loan_search" model="ir.ui.view">
        <field name="name">equipment.loan.search</field>
        <field name="model">equipment.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="item_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="ongoing" string="Ongoing" domain="[('state','=','ongoing')]"/>
                <filter name="returned" string="Returned" domain="[('state','=','returned')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_item" string="Equipment" context="{'group_by': 'item_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_equipment_loan" model="ir.actions.act_window">
        <field name="name">Equipment Loans</field>
        <field name="res_model">equipment.loan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register equipment loans to employees and track their return.</p>
        </field>
    </record>

</odoo>
