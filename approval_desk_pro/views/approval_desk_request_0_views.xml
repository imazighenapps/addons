<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_approval_desk_request_list" model="ir.ui.view">
        <field name="name">approval.desk.request.list</field>
        <field name="model">approval.desk.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="res_name"/>
                <field name="model_name" optional="hide"/>
                <field name="requester_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="current_step"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_approval_desk_request_form" model="ir.ui.view">
        <field name="name">approval.desk.request.form</field>
        <field name="model">approval.desk.request</field>
        <field name="arch" type="xml">
            <form string="Approval Requests">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'waiting'"/>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-secondary" invisible="state not in ('draft', 'waiting')"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting,approved,refused"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Request">
    <field name="name"/>
    <field name="requester_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Document">
    <field name="model_name"/>
    <field name="res_id"/>
    <field name="res_name"/>
                        </group>
                        <group string="Amount">
    <field name="amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Approval">
    <field name="current_step"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Steps" name="stepids">
                            <field name="step_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="approver_id"/>
                            <field name="min_amount" sum="Total Threshold"/>
                            <field name="state" widget="badge"/>
                            <field name="decision_date"/>
                            <field name="comment" optional="hide"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_approval_desk_request_search" model="ir.ui.view">
        <field name="name">approval.desk.request.search</field>
        <field name="model">approval.desk.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="res_name"/>
                <field name="model_name"/>
                <field name="requester_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="waiting" string="Waiting Approval" domain="[('state','=','waiting')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="refused" string="Refused" domain="[('state','=','refused')]"/>
                <filter name="mine" string="My Requests" domain="[('requester_id','=',uid)]"/>
                <filter name="toapprove" string="Waiting for Me" domain="[('step_ids.approver_id','=',uid),('state','=','waiting')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_requester" string="Requester" context="{'group_by': 'requester_id'}"/>
                <filter name="group_model" string="Document Model" context="{'group_by': 'model_name'}"/>
            </search>
        </field>
    </record>

    <record id="action_approval_desk_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">approval.desk.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Describe what must be approved, add one approver per amount threshold, then submit the request.</p>
        </field>
    </record>

</odoo>
