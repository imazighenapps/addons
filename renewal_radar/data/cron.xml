<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_renewal_radar" model="ir.cron">
        <field name="name">RenewalRadar: flag contracts to renew</field>
        <field name="model_id" ref="model_renewal_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_mark_to_renew()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
