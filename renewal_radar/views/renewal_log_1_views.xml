<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_renewal_log_list" model="ir.ui.view">
        <field name="name">renewal.log.list</field>
        <field name="model">renewal.log</field>
        <field name="arch" type="xml">
            <list string="Renewal History">
                <field name="date"/>
                <field name="contract_id"/>
                <field name="action"/>
                <field name="user_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_renewal_log_form" model="ir.ui.view">
        <field name="name">renewal.log.form</field>
        <field name="model">renewal.log</field>
        <field name="arch" type="xml">
            <form string="Renewal History">
                <sheet>
                    <group>
                        <group string="History">
    <field name="contract_id"/>
    <field name="date"/>
    <field name="action"/>
    <field name="user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_renewal_log_search" model="ir.ui.view">
        <field name="name">renewal.log.search</field>
        <field name="model">renewal.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="contract_id"/>
                <field name="user_id"/>
                <field name="note"/>
                <filter name="renewed" string="Renewed" domain="[('action','=','renewed')]"/>
                <filter name="churned" string="Churned" domain="[('action','=','churned')]"/>
                <filter name="reminder" string="Reminder" domain="[('action','=','reminder')]"/>
                <separator/>
                <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_renewal_log" model="ir.actions.act_window">
        <field name="name">Renewal History</field>
        <field name="res_model">renewal.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every activation, reminder, renewal and churn is recorded here.</p>
        </field>
    </record>

</odoo>
