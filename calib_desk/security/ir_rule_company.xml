<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_calib_instrument_company" model="ir.rule">
        <field name="name">calib.instrument: own company only</field>
        <field name="model_id" ref="model_calib_instrument"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_calib_event_company" model="ir.rule">
        <field name="name">calib.event: own company only</field>
        <field name="model_id" ref="model_calib_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
