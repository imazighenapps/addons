<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_calib_instrument_list" model="ir.ui.view">
        <field name="name">calib.instrument.list</field>
        <field name="model">calib.instrument</field>
        <field name="arch" type="xml">
            <list string="Instruments" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="serial"/>
                <field name="location"/>
                <field name="interval_months"/>
                <field name="last_calibration"/>
                <field name="next_due"/>
                <field name="is_overdue" widget="boolean"/>
                <field name="calibration_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_calib_instrument_form" model="ir.ui.view">
        <field name="name">calib.instrument.form</field>
        <field name="model">calib.instrument</field>
        <field name="arch" type="xml">
            <form string="Instruments">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Instrument">
    <field name="name"/>
    <field name="serial"/>
    <field name="location"/>
    <field name="responsible_id"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Calibration">
    <field name="interval_months"/>
    <field name="last_calibration"/>
    <field name="next_due"/>
    <field name="is_overdue"/>
    <field name="state"/>
                        </group>
                        <group string="History">
    <field name="calibration_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Calibrations" name="calibrationids">
                            <field name="calibration_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="calibration_date"/>
                            <field name="result"/>
                            <field name="certificate_ref" optional="show"/>
                            <field name="technician" optional="hide"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_calib_instrument_search" model="ir.ui.view">
        <field name="name">calib.instrument.search</field>
        <field name="model">calib.instrument</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="serial"/>
                <field name="location"/>
                <filter name="in_service" string="In Service" domain="[('state','=','in_service')]"/>
                <filter name="blocked" string="Blocked" domain="[('state','=','blocked')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_calib_instrument" model="ir.actions.act_window">
        <field name="name">Instruments</field>
        <field name="res_model">calib.instrument</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register every gauge, its interval and its next calibration due date.</p>
        </field>
    </record>

</odoo>
