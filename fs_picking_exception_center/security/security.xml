<odoo>
  <record id="rule_picking_exception_company_user" model="ir.rule">
    <field name="name">Picking exceptions: company scope</field>
    <field name="model_id" ref="model_fs_picking_exception"/>
    <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_picking_exception_company_manager" model="ir.rule">
    <field name="name">Picking exceptions manager: company scope</field>
    <field name="model_id" ref="model_fs_picking_exception"/>
    <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_picking_exception_config_company" model="ir.rule">
    <field name="name">Picking exception configuration: company scope</field>
    <field name="model_id" ref="model_fs_picking_exception_config"/>
    <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
