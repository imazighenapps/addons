<odoo>
  <record id="view_fs_picking_exception_list" model="ir.ui.view">
    <field name="name">fs.picking.exception.list</field>
    <field name="model">fs.picking.exception</field>
    <field name="arch" type="xml">
      <list decoration-danger="severity == 'critical' and state == 'open'" decoration-warning="severity == 'warning' and state == 'open'">
        <field name="picking_id"/>
        <field name="exception_type"/>
        <field name="severity"/>
        <field name="state"/>
        <field name="details"/>
        <field name="age_days"/>
          <field name="assigned_user_id"/>
        <field name="age_days"/>
        <field name="warehouse_id"/>
      </list>
    </field>
  </record>
  <record id="view_fs_picking_exception_form" model="ir.ui.view">
    <field name="name">fs.picking.exception.form</field>
    <field name="model">fs.picking.exception</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_open_picking" type="object" string="Open Transfer" class="btn-primary"/>
          <button name="action_assign_to_me" type="object" string="Assign to Me" class="btn-secondary" invisible="state != 'open'"/>
          <button name="action_resolve" type="object" string="Resolve" class="btn-secondary" invisible="state != 'open'"/>
          <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" invisible="state != 'resolved'"/>
          <field name="state" widget="statusbar" statusbar_visible="open,resolved"/>
        </header>
        <sheet>
          <group>
            <field name="picking_id"/>
            <field name="partner_id"/>
            <field name="picking_type_id"/>
            <field name="warehouse_id"/>
            <field name="exception_type"/>
            <field name="severity"/>
            <field name="first_seen"/>
            <field name="last_seen"/>
            <field name="resolved_at"/>
            <field name="age_days"/>
            <field name="assigned_user_id"/>
          </group>
          <field name="details"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_fs_picking_exception_search" model="ir.ui.view">
    <field name="name">fs.picking.exception.search</field>
    <field name="model">fs.picking.exception</field>
    <field name="arch" type="xml">
      <search>
        <field name="picking_id"/>
        <field name="exception_type"/>
        <field name="severity"/>
        <field name="warehouse_id"/>
        <filter name="filter_open" string="Open" domain="[('state','=','open')]"/>
        <filter name="filter_critical" string="Critical" domain="[('severity','=','critical'),('state','=','open')]"/>
        <group>
          <filter name="group_type" string="Type" context="{'group_by':'exception_type'}"/>
          <filter name="group_warehouse" string="Warehouse" context="{'group_by':'warehouse_id'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_fs_picking_exception_config_search" model="ir.ui.view"><field name="name">fs.picking.exception.config.search</field><field name="model">fs.picking.exception.config</field><field name="arch" type="xml"><search><field name="company_id"/></search></field></record>
  <record id="action_fs_picking_exception" model="ir.actions.act_window">
    <field name="name">Picking Exceptions</field>
    <field name="res_model">fs.picking.exception</field>
    <field name="view_mode">list,kanban,form</field>
  </record>
  <record id="view_fs_picking_exception_kanban" model="ir.ui.view">
    <field name="name">fs.picking.exception.kanban</field>
    <field name="model">fs.picking.exception</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <strong>
                <field name="picking_id"/>
              </strong>
              <div>
                <field name="exception_type"/> · <field name="severity"/>
              </div>
              <div>
                <field name="details"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <menuitem id="menu_fs_picking_exception_root" name="Picking Exceptions" parent="stock.menu_stock_root" sequence="92" groups="stock.group_stock_user"/>
  <menuitem id="menu_fs_picking_exception" name="Control Center" parent="menu_fs_picking_exception_root" action="action_fs_picking_exception"/>
  <menuitem id="menu_fs_picking_exception_config_root" name="Configuration" parent="menu_fs_picking_exception_root" groups="stock.group_stock_manager" sequence="90"/>
  <record id="action_fs_picking_exception_config" model="ir.actions.act_window">
    <field name="name">Configuration</field>
    <field name="res_model">fs.picking.exception.config</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_fs_picking_exception_config" name="Rules" parent="menu_fs_picking_exception_config_root" action="action_fs_picking_exception_config"/>
  <record id="view_fs_picking_exception_config_form" model="ir.ui.view">
    <field name="name">fs.picking.exception.config.form</field>
    <field name="model">fs.picking.exception.config</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="company_id"/>
            <field name="overdue_minutes"/>
            <field name="critical_after_days"/>
            <field name="notification_mode"/>
            <field name="notification_user_id" invisible="notification_mode != 'activity'"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="stock_picking_view_form_fs_picking_exception_center" model="ir.ui.view">
    <field name="name">stock.picking.form.fs.picking.exception.center</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet//div[@name='button_box']" position="inside">
        <button name="action_fs_picking_exceptions" type="object" class="oe_stat_button" icon="fa-exclamation-triangle" invisible="fs_picking_exception_count == 0">
          <field name="fs_picking_exception_count" widget="statinfo" string="Exceptions"/>
        </button>
      </xpath>
    </field>
  </record>
</odoo>
