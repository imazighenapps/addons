<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_po_ack_followup_list" model="ir.ui.view">
        <field name="name">po.ack.followup.list</field>
        <field name="model">po.ack.followup</field>
        <field name="arch" type="xml">
            <list string="Acknowledgement Follow-ups">
                <field name="followup_date"/>
                <field name="ack_id"/>
                <field name="partner_id"/>
                <field name="channel"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_po_ack_followup_form" model="ir.ui.view">
        <field name="name">po.ack.followup.form</field>
        <field name="model">po.ack.followup</field>
        <field name="arch" type="xml">
            <form string="Acknowledgement Follow-ups">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Follow-up">
    <field name="name"/>
    <field name="ack_id"/>
    <field name="partner_id"/>
    <field name="followup_date"/>
    <field name="channel"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Response" name="response">
                            <field name="response"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_po_ack_followup_search" model="ir.ui.view">
        <field name="name">po.ack.followup.search</field>
        <field name="model">po.ack.followup</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ack_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
                <filter name="group_supplier" string="Supplier" context="{'group_by': 'partner_id'}"/>
                <filter name="group_po" string="Purchase Order" context="{'group_by': 'ack_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_po_ack_followup_kanban" model="ir.ui.view">
        <field name="name">po.ack.followup.kanban</field>
        <field name="model">po.ack.followup</field>
        <field name="arch" type="xml">
            <kanban default_group_by="channel" sample="1">
                <field name="channel"/>
                <field name="ack_id"/>
                <field name="partner_id"/>
                <field name="followup_date"/>
                <templates>
                    <t t-name="card">
                        <field name="channel" class="fw-bold"/>
                        <field name="ack_id"/>
                        <field name="partner_id"/>
                        <field name="followup_date"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_po_ack_followup" model="ir.actions.act_window">
        <field name="name">Acknowledgement Follow-ups</field>
        <field name="res_model">po.ack.followup</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Each chase sent to a supplier, with the channel, date and response.</p>
        </field>
    </record>

</odoo>
