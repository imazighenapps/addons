<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_po_ack_order_company" model="ir.rule">
        <field name="name">po.ack.order: own company only</field>
        <field name="model_id" ref="model_po_ack_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_po_ack_followup_company" model="ir.rule">
        <field name="name">po.ack.followup: own company only</field>
        <field name="model_id" ref="model_po_ack_followup"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
