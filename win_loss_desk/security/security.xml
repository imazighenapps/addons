<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_winlossdesk_user" model="res.groups">
        <field name="name">Win Loss Desk User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_winlossdesk_manager" model="res.groups">
        <field name="name">Win Loss Desk Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('win_loss_desk.group_winlossdesk_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
