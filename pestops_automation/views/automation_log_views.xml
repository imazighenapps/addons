<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pest_automation_log_list" model="ir.ui.view">
        <field name="name">pest.automation.log.list</field>
        <field name="model">pest.automation.log</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="event_at"/>
                <field name="event_type"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="activity_created"/>
                <field name="email_sent"/>
            </list>
        </field>
    </record>

    <record id="view_pest_automation_log_form" model="ir.ui.view">
        <field name="name">pest.automation.log.form</field>
        <field name="model">pest.automation.log</field>
        <field name="arch" type="xml">
            <form string="Automation Event">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                            <field name="event_at" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="activity_created" readonly="1"/>
                            <field name="email_sent" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="key" readonly="1"/>
                        <field name="res_model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                        <field name="record_display_name" readonly="1"/>
                        <field name="note" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_open_record" type="object" string="Open Record" class="btn-primary"/>
                        <button special="cancel" string="Close" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pest_automation_log_search" model="ir.ui.view">
        <field name="name">pest.automation.log.search</field>
        <field name="model">pest.automation.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_type"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="email_sent" string="Email Sent" domain="[('email_sent', '=', True)]"/>
                <filter name="activity_created" string="Activity Created" domain="[('activity_created', '=', True)]"/>
                <group>
                    <filter name="group_event_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pest_automation_log" model="ir.actions.act_window">
        <field name="name">Automation Log</field>
        <field name="res_model">pest.automation.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_event_type': 1}</field>
    </record>
</odoo>
