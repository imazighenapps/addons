<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recode_request_list" model="ir.ui.view">
        <field name="name">recode.request.list</field>
        <field name="model">recode.request</field>
        <field name="arch" type="xml">
            <list string="Code Changes" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="old_code"/>
                <field name="new_code"/>
                <field name="reason"/>
                <field name="planned_on"/>
                <field name="applied_on"/>
                <field name="line_count"/>
                <field name="updated_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_recode_request_form" model="ir.ui.view">
        <field name="name">recode.request.form</field>
        <field name="model">recode.request</field>
        <field name="arch" type="xml">
            <form string="Code Changes">
                <header>
                    <button name="action_apply" type="object" string="Apply Recode" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-secondary" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Request">
    <field name="name"/>
    <field name="old_code"/>
    <field name="new_code"/>
    <field name="reason"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Schedule">
    <field name="planned_on"/>
    <field name="applied_on"/>
    <field name="state"/>
                        </group>
                        <group string="Trace">
    <field name="line_count"/>
    <field name="updated_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="References" name="lineids">
                            <field name="line_ids" readonly="state == 'done'">
                        <list editable="bottom">
                            <field name="source"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="updated"/>
                            <field name="company_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_recode_request_search" model="ir.ui.view">
        <field name="name">recode.request.search</field>
        <field name="model">recode.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="old_code"/>
                <field name="new_code"/>
                <field name="reason"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="done" string="Applied" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_recode_request_kanban" model="ir.ui.view">
        <field name="name">recode.request.kanban</field>
        <field name="model">recode.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="old_code"/>
                <field name="new_code"/>
                <field name="planned_on"/>
                <field name="line_count"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="old_code"/>
                        <field name="new_code"/>
                        <field name="planned_on"/>
                        <field name="line_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_recode_request" model="ir.actions.act_window">
        <field name="name">Code Changes</field>
        <field name="res_model">recode.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every product renumbering with the full trace of references moved.</p>
        </field>
    </record>

</odoo>
