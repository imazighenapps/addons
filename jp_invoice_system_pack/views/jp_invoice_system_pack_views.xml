<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="view_jp_qualifying_invoice_form" model="ir.ui.view">
  <field name="name">jp.qualifying.invoice.form</field><field name="model">jp.qualifying.invoice</field>
  <field name="arch" type="xml"><form string="Facture qualifiante JP">
    <header>
      <button name="action_register" type="object" string="Enregistrer" class="btn-primary" invisible="state!='draft'"/>
      <button name="action_mark_compliant" type="object" string="Marquer conforme" invisible="state!='registered'"/>
      <field name="state" widget="statusbar" statusbar_visible="draft,registered,compliant"/>
    </header>
    <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="invoice_id"/><field name="partner_id"/><field name="invoice_date"/>
        <field name="registration_number"/>
      </group><group>
        <field name="consumption_tax_rate"/><field name="taxable_amount"/><field name="tax_amount"/><field name="currency_id" invisible="1"/>
        <field name="compliance_ok" readonly="1"/>
      </group></group>
      <group string="Journal / notes"><field name="notes" nolabel="1"/></group>
    </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
  </form></field>
</record>
<record id="view_jp_qualifying_invoice_list" model="ir.ui.view">
  <field name="name">jp.qualifying.invoice.list</field><field name="model">jp.qualifying.invoice</field>
  <field name="arch" type="xml"><list decoration-success="state=='compliant'">
    <field name="name"/><field name="invoice_id"/><field name="partner_id"/><field name="registration_number"/>
    <field name="taxable_amount"/><field name="tax_amount"/><field name="compliance_ok"/><field name="state"/>
  </list></field>
</record>
</data></odoo>
