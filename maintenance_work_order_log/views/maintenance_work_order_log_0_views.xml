<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maintenance_work_order_log_list" model="ir.ui.view">
        <field name="name">maintenance.work.order.log.list</field>
        <field name="model">maintenance.work.order.log</field>
        <field name="arch" type="xml">
            <list string="Work Orders" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="request_id"/>
                <field name="technician_id"/>
                <field name="date_planned"/>
                <field name="duration"/>
                <field name="state" widget="badge"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_work_order_log_form" model="ir.ui.view">
        <field name="name">maintenance.work.order.log.form</field>
        <field name="model">maintenance.work.order.log</field>
        <field name="arch" type="xml">
            <form string="Work Orders">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'progress'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Work Order">
    <field name="name"/>
    <field name="equipment_id"/>
    <field name="request_id"/>
    <field name="technician_id"/>
    <field name="user_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Schedule">
    <field name="date_planned"/>
    <field name="date_start"/>
    <field name="date_end"/>
    <field name="duration"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Parts / Consumables" name="partsnote">
                            <field name="parts_note"/>
                        </page>
                        <page string="Outcome" name="outcome">
                            <field name="outcome"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_maintenance_work_order_log_search" model="ir.ui.view">
        <field name="name">maintenance.work.order.log.search</field>
        <field name="model">maintenance.work.order.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="technician_id"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="progress" string="In Progress" domain="[('state','=','progress')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                <filter name="group_technician" string="Technician" context="{'group_by': 'technician_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_maintenance_work_order_log_graph" model="ir.ui.view">
        <field name="name">maintenance.work.order.log.graph</field>
        <field name="model">maintenance.work.order.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_maintenance_work_order_log" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">maintenance.work.order.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log maintenance interventions and track their outcome.</p>
        </field>
    </record>

</odoo>
