<?xml version="1.0" encoding="utf-8"?>
<!-- sentinelle_health_monitor/views/sentinelle_config_views.xml -->
<odoo>
    <data>

        <!-- CONFIG FORM VIEW -->
        <record id="view_sentinelle_config_form" model="ir.ui.view">
            <field name="name">sentinelle.config.form</field>
            <field name="model">sentinelle.config</field>
            <field name="arch" type="xml">
                <form string="Sentinelle Configuration">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>

                        <!-- Quick stats banner -->
                        <div class="alert alert-info o_sentinelle_stats" role="status">
                            <span>
                                📊 <strong><field name="total_open_alerts" readonly="1"/></strong> open alerts
                                &amp;nbsp;|&amp;nbsp;
                                📅 <strong><field name="total_alerts_today" readonly="1"/></strong> alerts today
                            </span>
                        </div>

                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="monitoring_enabled" widget="boolean_toggle"/>
                        </group>

                        <notebook>

                            <!-- ── ORM ──────────────────────────────── -->
                            <page string="ORM Monitoring">
                                <group string="ORM Slow Call Thresholds (milliseconds)">
                                    <field name="orm_create_threshold_ms"/>
                                    <field name="orm_write_threshold_ms"/>
                                    <field name="orm_search_threshold_ms"/>
                                </group>
                            </page>

                            <!-- ── SQL ──────────────────────────────── -->
                            <page string="SQL Monitoring">
                                <group string="SQL Performance Thresholds">
                                    <field name="sql_slow_query_threshold_ms"/>
                                    <field name="sql_max_queries_per_request"/>
                                </group>
                                <p class="text-muted">
                                    Tip: enable the PostgreSQL <code>pg_stat_statements</code> extension
                                    for historical slow query analysis:
                                    <code>CREATE EXTENSION pg_stat_statements;</code>
                                </p>
                            </page>

                            <!-- ── API ──────────────────────────────── -->
                            <page string="API Monitoring">
                                <group string="External API Thresholds">
                                    <field name="api_response_threshold_ms"/>
                                    <field name="api_failure_threshold"/>
                                </group>
                            </page>

                            <!-- ── Log Analysis ─────────────────────── -->
                            <page string="Log Analysis">
                                <group>
                                    <field name="log_error_count_threshold"/>
                                    <field name="log_analysis_window_hours"/>
                                </group>
                            </page>

                            <!-- ── Cron ─────────────────────────────── -->
                            <page string="Cron Monitoring">
                                <group>
                                    <field name="cron_delay_threshold_minutes"/>
                                    <field name="cron_failure_threshold"/>
                                </group>
                            </page>

                            <!-- ── System ───────────────────────────── -->
                            <page string="System Resources">
                                <group>
                                    <field name="cpu_usage_threshold_pct"/>
                                    <field name="ram_usage_threshold_pct"/>
                                    <field name="disk_usage_threshold_pct"/>
                                </group>
                            </page>

                            <!-- ── Notifications ────────────────────── -->
                            <page string="Notifications">
                                <group string="Email">
                                    <field name="notify_email" widget="boolean_toggle"/>
                                    <field name="notify_email_addresses"
                                           required ="notify_email == True"
                                           invisible = "notify_email == False"/>
                                </group>
                                <group string="Slack">
                                    <field name="notify_slack" widget="boolean_toggle"/>
                                    <field name="slack_webhook_url"
                                        required ="notify_slack == True"
                                        invisible = "notify_slack == False"/>
                                </group>
                                <group string="Odoo Discuss">
                                    <field name="notify_odoo_channel" widget="boolean_toggle"/>
                                    <field name="odoo_channel_id"
                                        invisible ="notify_odoo_channel == False"/>
                                </group>
                                <group string="Cooldown">
                                    <field name="alert_cooldown_minutes"/>
                                </group>
                            </page>

                            <!-- ── Retention ─────────────────────────── -->
                            <page string="Data Retention">
                                <group>
                                    <field name="metric_retention_days"/>
                                    <field name="alert_retention_days"/>
                                </group>
                            </page>

                            <!-- ── Extension ─────────────────────────── -->
                            <page string="Extensions">
                                <group string="Custom Thresholds (JSON)">
                                    <field name="custom_thresholds" widget="code" nolabel="1"/>
                                </group>
                                <p class="text-muted">
                                    JSON key/value pairs for custom metrics added by extensions.
                                    Example: <code>{"my_custom_metric_max": 200}</code>
                                </p>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- CONFIG LIST VIEW -->
        <record id="view_sentinelle_config_list" model="ir.ui.view">
            <field name="name">sentinelle.config.list</field>
            <field name="model">sentinelle.config</field>
            <field name="arch" type="xml">
                <list string="Configurations">
                    <field name="name"/>
                    <field name="monitoring_enabled" widget="boolean"/>
                    <field name="total_open_alerts" string="Open Alerts"/>
                    <field name="total_alerts_today" string="Alerts Today"/>
                </list>
            </field>
        </record>

        <!-- API ENDPOINT VIEWS -->
        <record id="view_sentinelle_api_endpoint_list" model="ir.ui.view">
            <field name="name">sentinelle.api.endpoint.list</field>
            <field name="model">sentinelle.api.endpoint</field>
            <field name="arch" type="xml">
                <list string="API Endpoints" editable="bottom">
                    <field name="name"/>
                    <field name="url"/>
                    <field name="method"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="timeout_seconds"/>
                    <field name="expected_status_code"/>
                    <field name="last_probe_date" readonly="1"/>
                    <field name="last_response_ms" readonly="1" string="Last (ms)"/>
                    <field name="consecutive_failures" readonly="1"/>
                    <button name="action_probe_now" type="object" string="Probe Now"
                            icon="fa-bolt" groups="sentinelle_health_monitor.group_sentinelle_admin"/>
                </list>
            </field>
        </record>

        <record id="view_sentinelle_api_endpoint_form" model="ir.ui.view">
            <field name="name">sentinelle.api.endpoint.form</field>
            <field name="model">sentinelle.api.endpoint</field>
            <field name="arch" type="xml">
                <form string="API Endpoint">
                    <header>
                        <button name="action_probe_now" type="object"
                                string="Probe Now" class="oe_highlight"
                                groups="sentinelle_health_monitor.group_sentinelle_admin"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="url"/>
                                <field name="method"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="timeout_seconds"/>
                                <field name="expected_status_code"/>
                                <field name="last_probe_date" readonly="1"/>
                                <field name="last_response_ms" readonly="1"/>
                                <field name="consecutive_failures" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_sentinelle_config" model="ir.actions.act_window">
            <field name="name">Configuration</field>
            <field name="res_model">sentinelle.config</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_sentinelle_api_endpoint" model="ir.actions.act_window">
            <field name="name">API Endpoints</field>
            <field name="res_model">sentinelle.api.endpoint</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
