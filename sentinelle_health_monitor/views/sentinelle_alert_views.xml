<?xml version="1.0" encoding="utf-8"?>
<!-- sentinelle_health_monitor/views/sentinelle_alert_views.xml -->
<odoo>
    <data>

        <!-- ══════════════════════════════════════════════════════════
             LIST VIEW
        ════════════════════════════════════════════════════════════ -->
        <record id="view_sentinelle_alert_list" model="ir.ui.view">
            <field name="name">sentinelle.alert.list</field>
            <field name="model">sentinelle.alert</field>
            <field name="arch" type="xml">
                <list string="Alerts"
                      decoration-danger="severity == 'critical'"
                      decoration-warning="severity == 'warning'"
                      decoration-muted="state in ('resolved', 'muted')"
                      default_order="create_date desc">

                    <field name="create_date" string="Date" widget="datetime" optional="show"/>
                    <field name="name" string="Alert"/>
                    <field name="alert_type" string="Type" optional="show"/>
                    <field name="severity" widget="badge"
                           decoration-danger="severity == 'critical'"
                           decoration-warning="severity == 'warning'"
                           decoration-info="severity == 'info'"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'resolved'"
                           decoration-warning="state == 'acknowledged'"
                           decoration-danger="state == 'open'"
                           decoration-muted="state == 'muted'"/>
                    <field name="metric_value" string="Value" optional="show"/>
                    <field name="unit" optional="show"/>
                    <field name="threshold_value" string="Threshold" optional="show"/>
                    <field name="model_name" optional="hide"/>
                    <field name="age_hours" string="Age (h)" optional="show"/>
                    <field name="notification_sent" optional="show" widget="boolean"/>

                    <!-- Inline action buttons -->
                    <button name="action_acknowledge" type="object" string="Ack"
                            icon="fa-check" invisible = "state != 'open'"
                            groups="sentinelle_health_monitor.group_sentinelle_user"/>
                    <button name="action_resolve" type="object" string="Resolve"
                            icon="fa-check-circle"
                            invisible ="state in ('resolved', 'muted')"
                            groups="sentinelle_health_monitor.group_sentinelle_admin"/>
                </list>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════════
             KANBAN VIEW
        ════════════════════════════════════════════════════════════ -->
        <record id="view_sentinelle_alert_kanban" model="ir.ui.view">
            <field name="name">sentinelle.alert.kanban</field>
            <field name="model">sentinelle.alert</field>
            <field name="arch" type="xml">
                <kanban default_group_by="severity"
                        class="o_kanban_small_column"
                        group_create="false">
                    <field name="severity"/>
                    <field name="state"/>
                    <field name="alert_type"/>
                    <field name="create_date"/>
                    <field name="metric_value"/>
                    <field name="unit"/>
                    <field name="age_hours"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click sentinelle-card sentinelle-card-#{record.severity.raw_value}">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="sentinelle-badge">
                                        <field name="state" widget="badge"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <span class="text-muted">
                                        <field name="alert_type"/>
                                    </span>
                                    <br/>
                                    <span>
                                        Value: <field name="metric_value"/> <field name="unit"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left text-muted">
                                        <field name="create_date" widget="datetime"/>
                                        (<field name="age_hours"/> h ago)
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════════
             FORM VIEW
        ════════════════════════════════════════════════════════════ -->
        <record id="view_sentinelle_alert_form" model="ir.ui.view">
            <field name="name">sentinelle.alert.form</field>
            <field name="model">sentinelle.alert</field>
            <field name="arch" type="xml">
                <form string="Alert">
                    <!-- Status bar -->
                    <header>
                        <button name="action_acknowledge" type="object" string="Acknowledge"
                                class="oe_highlight"
                                invisible="state != 'open'"
                                groups="sentinelle_health_monitor.group_sentinelle_user"/>
                        <button name="action_resolve" type="object" string="Mark as Resolved"
                                class="oe_highlight"
                                invisible="state in ('resolved', 'muted')"
                                groups="sentinelle_health_monitor.group_sentinelle_admin"/>
                        <button name="action_mute" type="object" string="Mute"
                                invisible="state in ('resolved', 'muted')"
                                groups="sentinelle_health_monitor.group_sentinelle_admin"/>
                        <button name="action_reopen" type="object" string="Reopen"
                                invisible="state in ('open', 'acknowledged')"
                                groups="sentinelle_health_monitor.group_sentinelle_admin"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="open,acknowledged,resolved"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>

                        <group>
                            <group string="Alert Details">
                                <field name="alert_type"/>
                                <field name="severity" widget="badge"
                                       decoration-danger="severity == 'critical'"
                                       decoration-warning="severity == 'warning'"
                                       decoration-info="severity == 'info'"/>
                                <field name="create_date" string="Detected At" readonly="1"/>
                                <field name="age_hours" readonly="1"/>
                            </group>
                            <group string="Metric Values">
                                <field name="metric_value"/>
                                <field name="threshold_value"/>
                                <field name="unit"/>
                                <field name="model_name"/>
                                <field name="endpoint"/>
                                <field name="cron_id"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Description">
                                <field name="description" widget="html" readonly="1"/>
                            </page>
                            <page string="Resolution">
                                <group>
                                    <field name="resolved_by" readonly="1"/>
                                    <field name="resolved_date" readonly="1"/>
                                    <field name="resolution_note"/>
                                </group>
                            </page>
                            <page string="Notifications">
                                <group>
                                    <field name="notification_sent" readonly="1"/>
                                    <field name="notification_log" readonly="1" widget="code"/>
                                </group>
                            </page>
                            <page string="Source Metric">
                                <field name="metric_id" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>

                    <!-- Chatter (tracking + activity) -->
                    <chatter/>
                    
                </form>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════════
             SEARCH VIEW
        ════════════════════════════════════════════════════════════ -->
        <record id="view_sentinelle_alert_search" model="ir.ui.view">
            <field name="name">sentinelle.alert.search</field>
            <field name="model">sentinelle.alert</field>
            <field name="arch" type="xml">
                <search string="Search Alerts">
                    <field name="name" string="Alert Title"/>
                    <field name="alert_type"/>
                    <field name="model_name"/>

                    <!-- Filters -->
                    <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                    <filter name="acknowledged" string="Acknowledged"
                            domain="[('state', '=', 'acknowledged')]"/>
                    <filter name="resolved" string="Resolved" domain="[('state', '=', 'resolved')]"/>
                    <separator/>
                    <filter name="critical" string="🔴 Critical" domain="[('severity', '=', 'critical')]"/>
                    <filter name="warning" string="🟡 Warning" domain="[('severity', '=', 'warning')]"/>
                    <separator/>
                    <filter name="today" string="Today"
                            domain="[('create_date', '>=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter name="this_week" string="This Week"
                            domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <filter name="unsent" string="Notification Not Sent"
                            domain="[('notification_sent', '=', False), ('state', '=', 'open')]"/>

                    <!-- Group By -->
                    <group>
                        <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                        <filter name="group_type" string="Alert Type" context="{'group_by': 'alert_type'}"/>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_sentinelle_alert" model="ir.actions.act_window">
            <field name="name">Alerts</field>
            <field name="res_model">sentinelle.alert</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="context">{'search_default_open': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No alerts yet — your instance looks healthy! 🟢
                </p>
            </field>
        </record>

    </data>
</odoo>
