<odoo>
  <record id="email_template_vendor_ack" model="mail.template">
    <field name="name">Vendor Acknowledgment Invitation</field>
    <field name="model_id" ref="model_fs_purchase_vendor_ack"/>
    <field name="subject">Vendor acknowledgment required - {{ object.purchase_order_id.name }}</field>
    <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
    <field name="partner_to">{{ object.vendor_id.id }}</field>
    <field name="body_html" type="html">
      <div>
        <p>Hello {{ object.vendor_id.name }},</p>
        <p>Please confirm quantities and expected dates for purchase order <strong>{{ object.purchase_order_id.name }}</strong>.</p>
        <p>
          <a t-att-href="object.get_portal_url()">Open acknowledgment form</a>
        </p>
        <p>This secure link expires on {{ object.expiration_date }}.</p>
      </div>
    </field>
  </record>
</odoo>
