<odoo>
  <record id="rule_vendor_ack_purchase_user_company" model="ir.rule">
    <field name="name">Vendor acknowledgments: company scope</field>
    <field name="model_id" ref="model_fs_purchase_vendor_ack"/>
    <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_vendor_ack_purchase_manager_company" model="ir.rule">
    <field name="name">Vendor acknowledgments manager: company scope</field>
    <field name="model_id" ref="model_fs_purchase_vendor_ack"/>
    <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_vendor_ack_line_company" model="ir.rule">
    <field name="name">Vendor acknowledgment lines: company scope</field>
    <field name="model_id" ref="model_fs_purchase_vendor_ack_line"/>
    <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
