<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_badge_access_entry_company" model="ir.rule">
        <field name="name">badge_access.entry: own company only</field>
        <field name="model_id" ref="model_badge_access_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_badge_access_item_company" model="ir.rule">
        <field name="name">badge_access.item: own company only</field>
        <field name="model_id" ref="model_badge_access_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
