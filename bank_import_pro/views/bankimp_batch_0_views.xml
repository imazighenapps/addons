<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bankimp_batch_list" model="ir.ui.view">
        <field name="name">bank.import.batch.list</field>
        <field name="model">bank.import.batch</field>
        <field name="arch" type="xml">
            <list string="Import Batches" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="file_name"/>
                <field name="file_type" widget="badge"/>
                <field name="journal_id"/>
                <field name="date"/>
                <field name="total_amount" sum="Total Total Amount"/>
                <field name="error_message" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bankimp_batch_form" model="ir.ui.view">
        <field name="name">bank.import.batch.form</field>
        <field name="model">bank.import.batch</field>
        <field name="arch" type="xml">
            <form string="Import Batches">
                <header>
                    <button name="action_parse" type="object" string="Parse File" class="btn-primary" invisible="state != 'draft' and state != 'error'"/>
                    <button name="action_apply_rules" type="object" string="Apply Rules" class="btn-primary" invisible="state != 'imported'"/>
                    <button name="action_flag_duplicates" type="object" string="Flag Duplicates" class="btn-secondary" invisible="state != 'imported'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,imported,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="File">
    <field name="file_name"/>
    <field name="file_type"/>
    <field name="journal_id"/>
    <field name="date"/>
    <field name="currency_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Result">
    <field name="total_amount"/>
    <field name="error_message" invisible="state != 'error'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions" name="lineids">
                            <field name="line_ids">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="label"/>
                            <field name="reference" optional="show"/>
                            <field name="partner_id"/>
                            <field name="account_id" optional="show"/>
                            <field name="amount" sum="Total"/>
                            <field name="matched" widget="boolean_toggle"/>
                            <field name="duplicate" readonly="1"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bankimp_batch_search" model="ir.ui.view">
        <field name="name">bank.import.batch.search</field>
        <field name="model">bank.import.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="file_name"/>
                <field name="journal_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="imported" string="Imported" domain="[('state','=','imported')]"/>
                <filter name="error" string="In Error" domain="[('state','=','error')]"/>
                <filter name="duplicated" string="With Duplicates" domain="[('line_ids.duplicate','=',True)]"/>
                <separator/>
                <filter name="group_journal" string="Bank Journal" context="{'group_by': 'journal_id'}"/>
                <filter name="group_type" string="File Type" context="{'group_by': 'file_type'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_bankimp_batch" model="ir.actions.act_window">
        <field name="name">Import Batches</field>
        <field name="res_model">bank.import.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Store a bank file, parse it into transactions, apply the matching rules and keep duplicates out.</p>
        </field>
    </record>

</odoo>
