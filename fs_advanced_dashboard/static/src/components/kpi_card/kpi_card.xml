<?xml version="1.0" encoding="UTF-8" ?>
<templates>
 
   <t t-name="KpiCardView" t-inherit="fs_dashboard.KpiCard" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[1]" position="attributes">
            <attribute name="t-on-click">(ev) => this.show_view(ev, props.domain,props.model,props.name)</attribute>
        </xpath>
    </t>

    <t t-name="KpiCardFilter" t-inherit="fs_dashboard.KpiCard" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('tile')]" position="inside">
            <h4 t-attf-class="text-success rounded-2 p-2 +'mb-0'" style="background: #FFF;">
                <t t-set="color" t-value="'success'"/>
                    <t t-if="props.percentage > 0">
                        <t t-if="props.objective == 'increase'">
                            <t t-set="color" t-value="'success'"/>
                        </t>
                        <t t-if="props.objective == 'decrease'">
                            <t t-set="color" t-value="'danger'"/>
                        </t>
                    </t>
                    <t t-if="props.percentage &lt; 0">
                        <t t-if="props.objective= 'increase'">
                            <t t-set="color" t-value="'danger'"/>
                        </t>
                        <t t-if="props.objective == 'decrease'">
                            <t t-set="color" t-value="'success'"/>
                        </t>
                    </t>

                    <t t-if="props.percentage == 0">
                        <t t-set="color" t-value="'success'"/>
                    </t>

                    <strong t-attf-class="text-#{color}">
                        <span t-attf-class="me-1 fa fa-arrow-#{ props.percentage &lt;  0 ? 'down':'up' }"/>
                        <t t-if="props.percentage">
                            <span t-esc="props.percentage+'%'" t-attf-class="text-#{color}" />
                        </t>
                        <t t-else="">
                            <span class="text-success" >0.00%</span>
                        </t>
                    </strong>
                <div class="progress">
                    <div t-attf-class="progress-bar bg-#{color}" role="progressbar" t-attf-style="width: #{props.percentage>0 ? props.percentage:props.percentage*-1}%" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </h4>
        </xpath>
    </t>

</templates>