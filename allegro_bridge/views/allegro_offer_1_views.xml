<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_allegro_offer_list" model="ir.ui.view">
        <field name="name">allegro.offer.list</field>
        <field name="model">allegro.offer</field>
        <field name="arch" type="xml">
            <list string="Offers" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="external_id"/>
                <field name="price"/>
                <field name="stock_qty"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_allegro_offer_form" model="ir.ui.view">
        <field name="name">allegro.offer.form</field>
        <field name="model">allegro.offer</field>
        <field name="arch" type="xml">
            <form string="Offers">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Offer">
    <field name="name"/>
    <field name="connection_id"/>
    <field name="company_id"/>
    <field name="external_id"/>
    <field name="state"/>
                        </group>
                        <group string="Pricing &amp; Stock">
    <field name="price"/>
    <field name="currency_id"/>
    <field name="stock_qty"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_allegro_offer_search" model="ir.ui.view">
        <field name="name">allegro.offer.search</field>
        <field name="model">allegro.offer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="external_id"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_allegro_offer" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">allegro.offer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Allegro offers.</p>
        </field>
    </record>

</odoo>
