<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_call_sheet_entry_company" model="ir.rule">
        <field name="name">call_sheet.entry: own company only</field>
        <field name="model_id" ref="model_call_sheet_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_call_sheet_item_company" model="ir.rule">
        <field name="name">call_sheet.item: own company only</field>
        <field name="model_id" ref="model_call_sheet_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
