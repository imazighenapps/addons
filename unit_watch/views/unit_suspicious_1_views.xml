<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_unit_suspicious_list" model="ir.ui.view">
        <field name="name">unit.check.list</field>
        <field name="model">unit.check</field>
        <field name="arch" type="xml">
            <list string="Suspicious Lines">
                <field name="name"/>
                <field name="checked_on"/>
                <field name="document_ref"/>
                <field name="product_name"/>
                <field name="expected_unit"/>
                <field name="entered_unit"/>
                <field name="quantity"/>
                <field name="severity"/>
            </list>
        </field>
    </record>

    <record id="view_unit_suspicious_form" model="ir.ui.view">
        <field name="name">unit.check.form</field>
        <field name="model">unit.check</field>
        <field name="arch" type="xml">
            <form string="Suspicious Lines">
                <header>
                    <button name="action_correct" type="object" string="Mark Corrected" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_dismiss" type="object" string="Dismiss" class="btn-secondary" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,corrected,dismissed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Check">
    <field name="name"/>
    <field name="checked_on"/>
    <field name="document_ref"/>
    <field name="product_name"/>
    <field name="source"/>
    <field name="severity"/>
    <field name="company_id"/>
                        </group>
                        <group string="Units">
    <field name="expected_unit"/>
    <field name="entered_unit"/>
    <field name="quantity"/>
    <field name="corrected_qty"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Correction Note" name="correctionnote">
                            <field name="correction_note"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_unit_suspicious_search" model="ir.ui.view">
        <field name="name">unit.check.search</field>
        <field name="model">unit.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_ref"/>
                <field name="product_name"/>
                <separator/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
            </search>
        </field>
    </record>

    <record id="action_unit_suspicious" model="ir.actions.act_window">
        <field name="name">Suspicious Lines</field>
        <field name="res_model">unit.check</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Open unit slips that still need correction or dismissal.</p>
        </field>
    </record>

</odoo>
