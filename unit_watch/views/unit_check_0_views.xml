<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_unit_check_list" model="ir.ui.view">
        <field name="name">unit.check.list</field>
        <field name="model">unit.check</field>
        <field name="arch" type="xml">
            <list string="Unit Checks" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="checked_on"/>
                <field name="document_ref"/>
                <field name="product_name"/>
                <field name="source"/>
                <field name="expected_unit"/>
                <field name="entered_unit"/>
                <field name="quantity"/>
                <field name="severity"/>
                <field name="is_suspicious"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_unit_check_form" model="ir.ui.view">
        <field name="name">unit.check.form</field>
        <field name="model">unit.check</field>
        <field name="arch" type="xml">
            <form string="Unit Checks">
                <header>
                    <button name="action_correct" type="object" string="Mark Corrected" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_dismiss" type="object" string="Dismiss" class="btn-secondary" invisible="state != 'open'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" invisible="state == 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,corrected,dismissed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Check">
    <field name="name"/>
    <field name="checked_on"/>
    <field name="document_ref"/>
    <field name="product_name"/>
    <field name="source"/>
    <field name="severity"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Units">
    <field name="expected_unit"/>
    <field name="entered_unit"/>
    <field name="quantity"/>
    <field name="corrected_qty"/>
    <field name="is_suspicious"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Correction Note" name="correctionnote">
                            <field name="correction_note"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_unit_check_search" model="ir.ui.view">
        <field name="name">unit.check.search</field>
        <field name="model">unit.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_ref"/>
                <field name="product_name"/>
                <filter name="suspicious" string="Suspicious" domain="[('is_suspicious','=',True)]"/>
                <filter name="high" string="High Severity" domain="[('severity','=','high')]"/>
                <filter name="open" string="Open" domain="[('state','=','open')]"/>
                <separator/>
                <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_unit_check_kanban" model="ir.ui.view">
        <field name="name">unit.check.kanban</field>
        <field name="model">unit.check</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="document_ref"/>
                <field name="product_name"/>
                <field name="expected_unit"/>
                <field name="entered_unit"/>
                <field name="severity"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="document_ref"/>
                        <field name="product_name"/>
                        <field name="expected_unit"/>
                        <field name="entered_unit"/>
                        <field name="severity"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_unit_check" model="ir.actions.act_window">
        <field name="name">Unit Checks</field>
        <field name="res_model">unit.check</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every suspicious unit slip found in orders, receipts or bills.</p>
        </field>
    </record>

</odoo>
