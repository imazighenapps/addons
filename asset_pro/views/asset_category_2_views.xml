<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_category_list" model="ir.ui.view">
        <field name="name">asset.category.list</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <list string="Asset Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="method"/>
                <field name="duration_months"/>
                <field name="declining_rate"/>
                <field name="asset_count"/>
            </list>
        </field>
    </record>

    <record id="view_asset_category_form" model="ir.ui.view">
        <field name="name">asset.category.form</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <form string="Asset Categories">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Category">
    <field name="name"/>
    <field name="code"/>
    <field name="company_id"/>
    <field name="asset_count"/>
                        </group>
                        <group string="Depreciation">
    <field name="method"/>
    <field name="duration_months"/>
    <field name="declining_rate"/>
                        </group>
                        <group string="Accounts">
    <field name="account_asset_id"/>
    <field name="account_depreciation_id"/>
    <field name="account_expense_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_category_search" model="ir.ui.view">
        <field name="name">asset.category.search</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">asset.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the depreciation method and duration for each family of assets.</p>
        </field>
    </record>

</odoo>
