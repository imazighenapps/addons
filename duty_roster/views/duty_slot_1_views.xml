<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_duty_slot_list" model="ir.ui.view">
        <field name="name">duty.slot.list</field>
        <field name="model">duty.slot</field>
        <field name="arch" type="xml">
            <list string="Duty Slots">
                <field name="slot_start"/>
                <field name="slot_end"/>
                <field name="roster_id"/>
                <field name="employee_id"/>
                <field name="compensation"/>
            </list>
        </field>
    </record>

    <record id="view_duty_slot_form" model="ir.ui.view">
        <field name="name">duty.slot.form</field>
        <field name="model">duty.slot</field>
        <field name="arch" type="xml">
            <form string="Duty Slots">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Slot">
    <field name="name"/>
    <field name="roster_id"/>
    <field name="employee_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Period">
    <field name="slot_start"/>
    <field name="slot_end"/>
    <field name="compensation"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_duty_slot_search" model="ir.ui.view">
        <field name="name">duty.slot.search</field>
        <field name="model">duty.slot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="roster_id"/>
                <separator/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_roster" string="Roster" context="{'group_by': 'roster_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_duty_slot_kanban" model="ir.ui.view">
        <field name="name">duty.slot.kanban</field>
        <field name="model">duty.slot</field>
        <field name="arch" type="xml">
            <kanban default_group_by="roster_id" sample="1">
                <field name="roster_id"/>
                <field name="employee_id"/>
                <field name="slot_start"/>
                <field name="slot_end"/>
                <field name="compensation"/>
                <templates>
                    <t t-name="card">
                        <field name="roster_id" class="fw-bold"/>
                        <field name="employee_id"/>
                        <field name="slot_start"/>
                        <field name="slot_end"/>
                        <field name="compensation"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_duty_slot" model="ir.actions.act_window">
        <field name="name">Duty Slots</field>
        <field name="res_model">duty.slot</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Assign employees to duty slots and track compensation.</p>
        </field>
    </record>

</odoo>
