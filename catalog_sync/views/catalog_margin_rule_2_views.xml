<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_catalog_margin_rule_list" model="ir.ui.view">
        <field name="name">catalog.margin.rule.list</field>
        <field name="model">catalog.margin.rule</field>
        <field name="arch" type="xml">
            <list string="Margin Rules">
                <field name="name"/>
                <field name="company_id"/>
                <field name="category_id"/>
                <field name="margin_rate"/>
                <field name="round_to"/>
                <field name="apply_sale_price"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_catalog_margin_rule_form" model="ir.ui.view">
        <field name="name">catalog.margin.rule.form</field>
        <field name="model">catalog.margin.rule</field>
        <field name="arch" type="xml">
            <form string="Margin Rules">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Scope">
    <field name="name"/>
    <field name="company_id"/>
    <field name="category_id"/>
    <field name="active"/>
                        </group>
                        <group string="Margin">
    <field name="margin_rate"/>
    <field name="round_to"/>
    <field name="apply_sale_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_catalog_margin_rule_search" model="ir.ui.view">
        <field name="name">catalog.margin.rule.search</field>
        <field name="model">catalog.margin.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_catalog_margin_rule" model="ir.actions.act_window">
        <field name="name">Margin Rules</field>
        <field name="res_model">catalog.margin.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">One rule per category, plus a generic rule for everything else.</p>
        </field>
    </record>

</odoo>
