<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sdi_document_form" model="ir.ui.view">
            <field name="name">sdi.document.form</field>
            <field name="model">sdi.document</field>
            <field name="arch" type="xml">
                <form string="Document SdI">
                    <header>
                        <button name="action_prepare" type="object" string="Générer FatturaPA" class="btn-primary" invisible="state not in ('draft','rejected')"/>
                        <button name="action_mark_sent" type="object" string="Marquer envoyée" invisible="state not in ('ready','rejected')"/>
                        <button name="action_mark_delivered" type="object" string="Délivrée" invisible="state != 'sent'"/>
                        <button name="action_mark_accepted" type="object" string="Acceptée" invisible="state not in ('sent','delivered')"/>
                        <button name="action_mark_rejected" type="object" string="Refusée" invisible="state in ('accepted','draft')"/>
                        <button name="action_reset" type="object" string="Réinitialiser" invisible="state == 'accepted'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,ready,sent,accepted"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name"/></h1></div>
                        <group>
                            <group string="Facture">
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="invoice_id"/>
                                <field name="partner_id"/>
                            </group>
                            <group string="Transmission">
                                <field name="destinatario_code"/>
                                <field name="pec_address"/>
                                <field name="transmission_format"/>
                                <field name="sdi_identifier"/>
                            </group>
                        </group>
                        <group string="Fichier">
                            <field name="file_name" readonly="1"/>
                            <field name="file_data" readonly="1" filename="file_name"/>
                            <field name="generated_at" readonly="1"/>
                        </group>
                        <group string="Journal des statuts">
                            <field name="status_note" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Dernière erreur">
                            <field name="last_error" nolabel="1"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="view_sdi_document_list" model="ir.ui.view">
            <field name="name">sdi.document.list</field>
            <field name="model">sdi.document</field>
            <field name="arch" type="xml">
                <list decoration-success="state == 'accepted'" decoration-danger="state == 'rejected'" decoration-info="state == 'sent'">
                    <field name="name"/>
                    <field name="invoice_id"/>
                    <field name="partner_id"/>
                    <field name="destinatario_code"/>
                    <field name="generated_at"/>
                    <field name="state"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
