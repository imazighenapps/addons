<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_slack_log_list" model="ir.ui.view">
        <field name="name">slack.log.list</field>
        <field name="model">slack.log</field>
        <field name="arch" type="xml">
            <list string="Logs">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="record_id"/>
                <field name="level"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_slack_log_form" model="ir.ui.view">
        <field name="name">slack.log.form</field>
        <field name="model">slack.log</field>
        <field name="arch" type="xml">
            <form string="Logs">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="message" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Log">
    <field name="connection_id"/>
    <field name="record_id"/>
    <field name="level"/>
    <field name="message"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_slack_log_search" model="ir.ui.view">
        <field name="name">slack.log.search</field>
        <field name="model">slack.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="connection_id"/>
                <filter name="info" string="Info" domain="[('level','=','info')]"/>
                <filter name="error" string="Error" domain="[('level','=','error')]"/>
                <separator/>
                <filter name="group_level" string="Level" context="{'group_by': 'level'}"/>
            </search>
        </field>
    </record>

    <record id="action_slack_log" model="ir.actions.act_window">
        <field name="name">Logs</field>
        <field name="res_model">slack.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">View logs.</p>
        </field>
    </record>

</odoo>
