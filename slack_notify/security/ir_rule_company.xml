<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_slack_connection_company" model="ir.rule">
        <field name="name">slack.connection: own company only</field>
        <field name="model_id" ref="model_slack_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_slack_record_company" model="ir.rule">
        <field name="name">slack.record: own company only</field>
        <field name="model_id" ref="model_slack_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
