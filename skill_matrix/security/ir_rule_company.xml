<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_skill_skill_company" model="ir.rule">
        <field name="name">skill.skill: own company only</field>
        <field name="model_id" ref="model_skill_skill"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_skill_assignment_company" model="ir.rule">
        <field name="name">skill.assignment: own company only</field>
        <field name="model_id" ref="model_skill_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
