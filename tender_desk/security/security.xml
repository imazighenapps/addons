<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_tenderdesk_user" model="res.groups">
        <field name="name">Tender Desk User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_tenderdesk_manager" model="res.groups">
        <field name="name">Tender Desk Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('tender_desk.group_tenderdesk_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
