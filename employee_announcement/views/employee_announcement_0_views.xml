<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_announcement_list" model="ir.ui.view">
        <field name="name">employee.announcement.list</field>
        <field name="model">employee.announcement</field>
        <field name="arch" type="xml">
            <list string="Announcements" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="author_id"/>
                <field name="department_id"/>
                <field name="date_publish"/>
                <field name="date_expiry"/>
                <field name="priority"/>
                <field name="is_expired" widget="boolean"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_employee_announcement_form" model="ir.ui.view">
        <field name="name">employee.announcement.form</field>
        <field name="model">employee.announcement</field>
        <field name="arch" type="xml">
            <form string="Announcements">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_archive_announcement" type="object" string="Archive" class="btn-secondary" invisible="state != 'published'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Announcement">
    <field name="name"/>
    <field name="author_id"/>
    <field name="department_id"/>
    <field name="priority"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Validity">
    <field name="date_publish"/>
    <field name="date_expiry"/>
    <field name="is_expired"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="body">
                            <field name="body"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_announcement_search" model="ir.ui.view">
        <field name="name">employee.announcement.search</field>
        <field name="model">employee.announcement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author_id"/>
                <field name="department_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="published" string="Published" domain="[('state','=','published')]"/>
                <filter name="archived" string="Archived" domain="[('state','=','archived')]"/>
                <filter name="important" string="Important" domain="[('priority','=','1')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_employee_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">employee.announcement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create and publish internal announcements for employees.</p>
        </field>
    </record>

</odoo>
