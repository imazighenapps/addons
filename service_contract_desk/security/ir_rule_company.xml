<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_service_contract_entry_company" model="ir.rule">
        <field name="name">service_contract.entry: own company only</field>
        <field name="model_id" ref="model_service_contract_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_service_contract_item_company" model="ir.rule">
        <field name="name">service_contract.item: own company only</field>
        <field name="model_id" ref="model_service_contract_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
