<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_assignment_list" model="ir.ui.view">
        <field name="name">it.assignment.list</field>
        <field name="model">it.assignment</field>
        <field name="arch" type="xml">
            <list string="Assignments" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="assigned_on"/>
                <field name="asset_id"/>
                <field name="holder"/>
                <field name="due_back_on"/>
                <field name="returned_on"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_it_assignment_form" model="ir.ui.view">
        <field name="name">it.assignment.form</field>
        <field name="model">it.assignment</field>
        <field name="arch" type="xml">
            <form string="Assignments">
                <header>
                    <button name="action_return" type="object" string="Mark Returned" class="btn-primary" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Assignment">
    <field name="name"/>
    <field name="asset_id"/>
    <field name="holder"/>
    <field name="company_id"/>
                        </group>
                        <group string="Dates">
    <field name="assigned_on"/>
    <field name="due_back_on"/>
    <field name="returned_on"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_it_assignment_search" model="ir.ui.view">
        <field name="name">it.assignment.search</field>
        <field name="model">it.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="holder"/>
                <filter name="open" string="Open" domain="[('state','=','open')]"/>
                <filter name="returned" string="Returned" domain="[('state','=','returned')]"/>
                <separator/>
                <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_it_assignment_kanban" model="ir.ui.view">
        <field name="name">it.assignment.kanban</field>
        <field name="model">it.assignment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="asset_id"/>
                <field name="holder"/>
                <field name="assigned_on"/>
                <field name="due_back_on"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="asset_id"/>
                        <field name="holder"/>
                        <field name="assigned_on"/>
                        <field name="due_back_on"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_it_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">it.assignment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track who holds each device and when it comes back.</p>
        </field>
    </record>

</odoo>
