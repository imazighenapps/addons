<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_asset_list" model="ir.ui.view">
        <field name="name">it.asset.list</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <list string="Assets" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="asset_type"/>
                <field name="serial"/>
                <field name="model_name"/>
                <field name="purchase_on"/>
                <field name="current_holder"/>
                <field name="open_assignment_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_it_asset_form" model="ir.ui.view">
        <field name="name">it.asset.form</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <form string="Assets">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Asset">
    <field name="name"/>
    <field name="asset_type"/>
    <field name="serial"/>
    <field name="model_name"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Lifecycle">
    <field name="purchase_on"/>
    <field name="state"/>
    <field name="current_holder"/>
                        </group>
                        <group string="Counters">
    <field name="assignment_count"/>
    <field name="open_assignment_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_it_asset_search" model="ir.ui.view">
        <field name="name">it.asset.search</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="serial"/>
                <field name="model_name"/>
                <field name="current_holder"/>
                <filter name="stock" string="In Stock" domain="[('state','=','stock')]"/>
                <filter name="in_use" string="In Use" domain="[('state','=','in_use')]"/>
                <filter name="repair" string="In Repair" domain="[('state','=','repair')]"/>
                <filter name="retired" string="Retired" domain="[('state','=','retired')]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_type" string="Type" context="{'group_by': 'asset_type'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_it_asset_kanban" model="ir.ui.view">
        <field name="name">it.asset.kanban</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="serial"/>
                <field name="current_holder"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="asset_type"/>
                        <field name="serial"/>
                        <field name="current_holder"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_it_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">it.asset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register every device and follow its lifecycle and holder.</p>
        </field>
    </record>

</odoo>
