<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_it_asset_company" model="ir.rule">
        <field name="name">it.asset: own company only</field>
        <field name="model_id" ref="model_it_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_it_assignment_company" model="ir.rule">
        <field name="name">it.assignment: own company only</field>
        <field name="model_id" ref="model_it_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
