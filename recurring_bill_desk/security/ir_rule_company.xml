<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_recurring_bill_entry_company" model="ir.rule">
        <field name="name">recurring_bill.entry: own company only</field>
        <field name="model_id" ref="model_recurring_bill_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_recurring_bill_item_company" model="ir.rule">
        <field name="name">recurring_bill.item: own company only</field>
        <field name="model_id" ref="model_recurring_bill_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
