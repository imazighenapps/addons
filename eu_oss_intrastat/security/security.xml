<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_oss_user" model="res.groups">
        <field name="name">OSS / Intrastat User</field>
        <field name="comment">Follow thresholds and prepare declarations.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_oss_manager" model="res.groups">
        <field name="name">OSS / Intrastat Manager</field>
        <field name="comment">Configure thresholds and mark lines declared.</field>
        <field name="implied_ids" eval="[(4, ref('eu_oss_intrastat.group_oss_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>