<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_osst_list" model="ir.ui.view">
        <field name="name">oss.threshold.list</field>
        <field name="model">oss.threshold</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="scheme" widget="badge" decoration-info="scheme == 'oss'" decoration-success="scheme == 'ioss'"/>
                <field name="limit" widget="monetary"/>
                <field name="warn_ratio" widget="percentage"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_osst_form" model="ir.ui.view">
        <field name="name">oss.threshold.form</field>
        <field name="model">oss.threshold</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Scheme">
                            <field name="scheme"/>
                            <field name="limit"/>
                            <field name="warn_ratio" widget="percentage"/>
                            <field name="active"/>
                        </group>
                        <group string="Scope">
                            <field name="country_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_osst" model="ir.actions.act_window">
        <field name="name">Thresholds</field>
        <field name="res_model">oss.threshold</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>