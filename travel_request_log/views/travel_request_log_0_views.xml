<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_travel_request_log_list" model="ir.ui.view">
        <field name="name">travel.request.log.list</field>
        <field name="model">travel.request.log</field>
        <field name="arch" type="xml">
            <list string="Travel Requests" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="destination"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="estimated_cost"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_travel_request_log_form" model="ir.ui.view">
        <field name="name">travel.request.log.form</field>
        <field name="model">travel.request.log</field>
        <field name="arch" type="xml">
            <form string="Travel Requests">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state != 'submitted'"/>
                    <button name="action_complete" type="object" string="Mark Completed" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state not in ('rejected', 'completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,completed,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Trip">
    <field name="name"/>
    <field name="employee_id"/>
    <field name="destination"/>
    <field name="date_start"/>
    <field name="date_end"/>
    <field name="company_id"/>
                        </group>
                        <group string="Approval">
    <field name="currency_id"/>
    <field name="estimated_cost"/>
    <field name="approver_id"/>
    <field name="user_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Purpose" name="purpose">
                            <field name="purpose"/>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_travel_request_log_search" model="ir.ui.view">
        <field name="name">travel.request.log.search</field>
        <field name="model">travel.request.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="destination"/>
                <field name="approver_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="completed" string="Completed" domain="[('state','=','completed')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_travel_request_log_graph" model="ir.ui.view">
        <field name="name">travel.request.log.graph</field>
        <field name="model">travel.request.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="estimated_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_travel_request_log" model="ir.actions.act_window">
        <field name="name">Travel Requests</field>
        <field name="res_model">travel.request.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record and track travel requests.</p>
        </field>
    </record>

</odoo>
