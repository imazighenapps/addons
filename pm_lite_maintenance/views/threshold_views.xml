<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_threshold_list" model="ir.ui.view">
        <field name="name">pm.threshold.list</field>
        <field name="model">pm.threshold</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="counter_id"/>
                <field name="warn_level"/>
                <field name="crit_level"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_pm_threshold_form" model="ir.ui.view">
        <field name="name">pm.threshold.form</field>
        <field name="model">pm.threshold</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <field name="counter_id"/>
                        <field name="equipment_id"/>
                        <field name="metric"/>
                        <field name="operator"/>
                        <field name="warn_level"/>
                        <field name="crit_level"/>
                        <field name="hysteresis"/>
                        <field name="cooldown_hours"/>
                        <field name="active"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_pm_threshold" model="ir.actions.act_window">
        <field name="name">Thresholds</field>
        <field name="res_model">pm.threshold</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
