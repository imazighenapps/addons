<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_reading_list" model="ir.ui.view">
        <field name="name">pm.reading.list</field>
        <field name="model">pm.reading</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="counter_id"/>
                <field name="value"/>
                <field name="source"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="view_pm_reading_form" model="ir.ui.view">
        <field name="name">pm.reading.form</field>
        <field name="model">pm.reading</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="counter_id"/>
                        <field name="date"/>
                        <field name="value"/>
                        <field name="source"/>
                        <field name="user_id"/>
                        <field name="external_id"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_pm_reading" model="ir.actions.act_window">
        <field name="name">Readings</field>
        <field name="res_model">pm.reading</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
