<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_alert_list" model="ir.ui.view">
        <field name="name">pm.alert.list</field>
        <field name="model">pm.alert</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="level" widget="badge" decoration-danger="level == 'crit'" decoration-warning="level == 'warn'" decoration-info="level == 'info'"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'ack'" decoration-warning="state == 'open'"/>
                <field name="request_id"/>
            </list>
        </field>
    </record>
    <record id="view_pm_alert_form" model="ir.ui.view">
        <field name="name">pm.alert.form</field>
        <field name="model">pm.alert</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ack" string="Acknowledge" type="object"/>
                    <button name="action_done" string="Done" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="name"/>
                    <group>
                        <field name="equipment_id"/>
                        <field name="company_id"/>
                        <field name="threshold_id"/>
                        <field name="counter_id"/>
                        <field name="level"/>
                        <field name="state"/>
                        <field name="reading_id"/>
                        <field name="request_id"/>
                    </group>
                    <field name="message"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pm_alert" model="ir.actions.act_window">
        <field name="name">Alerts</field>
        <field name="res_model">pm.alert</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
