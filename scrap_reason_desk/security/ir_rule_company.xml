<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_scrap_reason_entry_company" model="ir.rule">
        <field name="name">scrap_reason.entry: own company only</field>
        <field name="model_id" ref="model_scrap_reason_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_scrap_reason_item_company" model="ir.rule">
        <field name="name">scrap_reason.item: own company only</field>
        <field name="model_id" ref="model_scrap_reason_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
