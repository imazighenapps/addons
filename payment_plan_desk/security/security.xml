<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_paymentpland_user" model="res.groups">
        <field name="name">Payment Plan Desk User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_paymentpland_manager" model="res.groups">
        <field name="name">Payment Plan Desk Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('payment_plan_desk.group_paymentpland_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
