<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_statement" model="report.paperformat">
        <field name="name">Statement A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_statement" model="ir.actions.report">
        <field name="name">Partner Statement</field>
        <field name="model">statement.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">statement_pro.report_statement</field>
        <field name="paperformat_id" ref="paperformat_statement"/>
        <field name="print_report_name">'Statement - %s' % object.partner_id.name</field>
    </record>

    <template id="report_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mt-0">Account Statement</h2>
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong t-field="o.partner_id.name"/><br/>
                                <span t-field="o.partner_id.street"/><br/>
                                <span t-field="o.partner_id.zip"/>
                                <span t-field="o.partner_id.city"/>
                            </div>
                            <div class="col-6 text-end">
                                <div><strong>Statement:</strong> <span t-field="o.name"/></div>
                                <div><strong>Period:</strong>
                                    <span t-field="o.date_from"/> -
                                    <span t-field="o.date_to"/></div>
                                <div><strong>Currency:</strong>
                                    <span t-field="o.currency_id.name"/></div>
                            </div>
                        </div>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th><th>Reference</th><th>Label</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                    <th class="text-end">Balance</th>
                                    <th>Due</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="fw-bold">
                                    <td colspan="5">Opening balance</td>
                                    <td class="text-end">
                                        <span t-field="o.opening_balance"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td/>
                                </tr>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.date"/></td>
                                        <td><span t-field="line.reference"/></td>
                                        <td><span t-field="line.label"/></td>
                                        <td class="text-end"><span t-field="line.debit"/></td>
                                        <td class="text-end"><span t-field="line.credit"/></td>
                                        <td class="text-end"><span t-field="line.balance"/></td>
                                        <td><span t-field="line.date_maturity"/></td>
                                    </tr>
                                </t>
                                <tr class="fw-bold border-top">
                                    <td colspan="3">Totals</td>
                                    <td class="text-end"><span t-field="o.total_debit"/></td>
                                    <td class="text-end"><span t-field="o.total_credit"/></td>
                                    <td class="text-end"><span t-field="o.closing_balance"/></td>
                                    <td/>
                                </tr>
                            </tbody>
                        </table>
                        <p t-if="o.overdue_amount" class="text-danger">
                            Overdue amount:
                            <span t-field="o.overdue_amount"/>
                        </p>
                        <p t-if="o.note" t-field="o.note"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
