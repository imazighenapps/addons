<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_statement_batch_form" model="ir.ui.view">
        <field name="name">statement.batch.form</field>
        <field name="model">statement.batch</field>
        <field name="arch" type="xml">
            <form string="Generate Statements">
                <sheet>
                    <group>
                        <group string="Period">
    <field name="date_from"/>
    <field name="date_to"/>
                        </group>
                        <group string="Selection">
    <field name="only_customers"/>
    <field name="partner_ids"/>
    <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <footer><button name="action_generate" type="object" string="Generate" class="btn-primary"/><button special="cancel" string="Cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>

    <record id="action_statement_batch" model="ir.actions.act_window">
        <field name="name">Generate Statements</field>
        <field name="res_model">statement.batch</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
