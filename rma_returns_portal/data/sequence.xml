<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_rma_request" model="ir.sequence">
        <field name="name">RMA Request</field>
        <field name="code">rma.request</field>
        <field name="prefix">RMA-</field>
        <field name="padding">5</field>
    </record>
    <record id="reason_withdrawal" model="rma.reason">
        <field name="name">Withdrawal 14 days</field>
        <field name="code">WITHDRAWAL</field>
        <field name="rtype">withdrawal</field>
        <field name="auto_approve">True</field>
    </record>
    <record id="reason_defective" model="rma.reason">
        <field name="name">Defective Product</field>
        <field name="code">DEFECTIVE</field>
        <field name="rtype">warranty</field>
        <field name="requires_photo">True</field>
    </record>
    <record id="reason_wrong_item" model="rma.reason">
        <field name="name">Wrong Item Sent</field>
        <field name="code">WRONG_ITEM</field>
        <field name="rtype">goodwill</field>
        <field name="auto_approve">True</field>
    </record>
    <record id="grade_a" model="rma.grade">
        <field name="name">A - Like New</field>
        <field name="description">Restock directly.</field>
        <field name="disposition">restock</field>
    </record>
    <record id="grade_b" model="rma.grade">
        <field name="name">B - Refurbished</field>
        <field name="description">Light refurbishment, second-life sale.</field>
        <field name="disposition">refurb</field>
        <field name="discount_pct">30.0</field>
    </record>
    <record id="grade_c" model="rma.grade">
        <field name="name">C - Not Resalable</field>
        <field name="description">Scrap or spare parts.</field>
        <field name="disposition">scrap</field>
    </record>
    <record id="grade_d" model="rma.grade">
        <field name="name">D - Dispute</field>
        <field name="description">Needs further expertise.</field>
        <field name="disposition">repair</field>
    </record>
    <record id="param_window" model="ir.config_parameter">
        <field name="key">rma_returns_portal.window_days</field>
        <field name="value">30</field>
    </record>
    <record id="param_warranty" model="ir.config_parameter">
        <field name="key">rma_returns_portal.warranty_days</field>
        <field name="value">730</field>
    </record>
    <record id="param_auto" model="ir.config_parameter">
        <field name="key">rma_returns_portal.auto_amount</field>
        <field name="value">0</field>
    </record>
</odoo>
