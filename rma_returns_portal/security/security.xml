<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_rma_user" model="res.groups">
        <field name="name">RMA User</field>
        <field name="comment">Process return requests and QC.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rma_manager" model="res.groups">
        <field name="name">RMA Manager</field>
        <field name="comment">Full administration of returns configuration.</field>
        <field name="implied_ids" eval="[(4, ref('rma_returns_portal.group_rma_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
