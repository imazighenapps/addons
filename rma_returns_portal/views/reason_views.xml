<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rma_reason_list" model="ir.ui.view">
        <field name="name">rma.reason.list</field>
        <field name="model">rma.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="rtype"/>
                <field name="auto_approve" widget="boolean_toggle"/>
                <field name="restocking_fee_pct"/>
                <field name="website_visible" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_rma_reason_form" model="ir.ui.view">
        <field name="name">rma.reason.form</field>
        <field name="model">rma.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <field name="code"/>
                        <field name="rtype"/>
                        <field name="requires_photo"/>
                        <field name="auto_approve"/>
                        <field name="restocking_fee_pct"/>
                        <field name="charge_to_customer"/>
                        <field name="website_visible"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rma_reason" model="ir.actions.act_window">
        <field name="name">Return Reasons</field>
        <field name="res_model">rma.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
