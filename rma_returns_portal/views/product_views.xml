<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_rma" model="ir.ui.view">
        <field name="name">product.template.rma</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Returns" name="rma">
                    <field name="is_returnable"/>
                    <field name="return_window_override"/>
                    <field name="refurbished_product_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
