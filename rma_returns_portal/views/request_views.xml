<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rma_request_list" model="ir.ui.view">
        <field name="name">rma.request.list</field>
        <field name="model">rma.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="request_type"/>
                <field name="state" widget="badge" decoration-success="state in ('resolved', 'closed')" decoration-info="state in ('approved', 'label_sent', 'in_transit', 'received', 'qc_done')" decoration-warning="state in ('draft', 'submitted')" decoration-danger="state in ('rejected', 'cancelled')"/>
                <field name="amount_to_refund"/>
            </list>
        </field>
    </record>
    <record id="view_rma_request_form" model="ir.ui.view">
        <field name="name">rma.request.form</field>
        <field name="model">rma.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"/>
                    <button name="action_approve" string="Approve" type="object"/>
                    <button name="action_reject" string="Reject" type="object"/>
                    <button name="action_label_sent" string="Label Sent" type="object"/>
                    <button name="action_in_transit" string="In Transit" type="object"/>
                    <button name="action_receive" string="Receive" type="object"/>
                    <button name="action_qc_done" string="QC Done" type="object"/>
                    <button name="action_resolve_refund" string="Refund" type="object"/>
                    <button name="action_resolve_exchange" string="Exchange" type="object"/>
                    <button name="action_resolve_credit" string="Store Credit" type="object"/>
                    <button name="action_close" string="Close" type="object"/>
                    <button name="action_cancel" string="Cancel" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,received,resolved,closed"/>
                </header>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Request">
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="picking_id"/>
                            <field name="request_type"/>
                            <field name="reason_id"/>
                            <field name="resolution"/>
                        </group>
                        <group string="Follow-up">
                            <field name="company_id"/>
                            <field name="warehouse_id"/>
                            <field name="days_since_delivery"/>
                            <field name="amount_to_refund"/>
                            <field name="tracking_ref"/>
                            <field name="refund_move_id"/>
                            <field name="exchange_order_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="qty_delivered"/>
                            <field name="qty_requested"/>
                            <field name="qty_received"/>
                            <field name="qty_accepted"/>
                            <field name="grade_id"/>
                            <field name="disposition"/>
                            <field name="subtotal_refund"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_rma_request" model="ir.actions.act_window">
        <field name="name">Return Requests</field>
        <field name="res_model">rma.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
