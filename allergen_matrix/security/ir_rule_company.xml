<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_allergen_recipe_company" model="ir.rule">
        <field name="name">allergen.recipe: own company only</field>
        <field name="model_id" ref="model_allergen_recipe"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_allergen_line_company" model="ir.rule">
        <field name="name">allergen.line: own company only</field>
        <field name="model_id" ref="model_allergen_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
