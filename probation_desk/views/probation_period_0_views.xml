<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_probation_period_list" model="ir.ui.view">
        <field name="name">probation.period.list</field>
        <field name="model">probation.period</field>
        <field name="arch" type="xml">
            <list string="Probation Periods" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="review_date"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="is_overdue"/>
                <field name="decision"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_probation_period_form" model="ir.ui.view">
        <field name="name">probation.period.form</field>
        <field name="model">probation.period</field>
        <field name="arch" type="xml">
            <form string="Probation Periods">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state == 'ongoing'"/>
                    <button name="action_extend" type="object" string="Extend" class="btn-secondary" invisible="state == 'ongoing'"/>
                    <button name="action_close" type="object" string="Close" class="btn-secondary" invisible="state == 'ongoing'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" invisible="state == 'decided'"/>
                    <field name="state" widget="statusbar" statusbar_visible="s,t,a,t,e"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Period">
    <field name="name"/>
    <field name="employee_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Dates">
    <field name="start_date"/>
    <field name="end_date"/>
    <field name="review_date"/>
    <field name="decision_date"/>
    <field name="decision"/>
    <field name="is_overdue"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_probation_period_search" model="ir.ui.view">
        <field name="name">probation.period.search</field>
        <field name="model">probation.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="ongoing" string="Ongoing" domain="[('state','=','ongoing')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/>
                <filter name="decided" string="Decided" domain="[('state','=','decided')]"/>
                <separator/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_decision" string="Decision" context="{'group_by': 'decision'}"/>
            </search>
        </field>
    </record>

    <record id="view_probation_period_kanban" model="ir.ui.view">
        <field name="name">probation.period.kanban</field>
        <field name="model">probation.period</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="employee_id"/>
                <field name="review_date"/>
                <field name="end_date"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="employee_id"/>
                        <field name="review_date"/>
                        <field name="end_date"/>
                        <field name="is_overdue"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_probation_period" model="ir.actions.act_window">
        <field name="name">Probation Periods</field>
        <field name="res_model">probation.period</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Probation periods with review deadlines and decisions.</p>
        </field>
    </record>

</odoo>
