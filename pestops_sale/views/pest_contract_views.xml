<odoo>
    <record id="view_pest_contract_form_sale" model="ir.ui.view">
        <field name="name">pest.contract.form.sale.integration</field>
        <field name="model">pest.contract</field>
        <field name="inherit_id" ref="pestops_core.view_pest_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="sale_order_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
