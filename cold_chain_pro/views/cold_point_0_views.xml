<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cold_point_list" model="ir.ui.view">
        <field name="name">cold.point.list</field>
        <field name="model">cold.point</field>
        <field name="arch" type="xml">
            <list string="Cold Points">
                <field name="name"/>
                <field name="ref"/>
                <field name="location"/>
                <field name="min_temp"/>
                <field name="max_temp"/>
                <field name="frequency"/>
                <field name="responsible_id"/>
                <field name="reading_count"/>
                <field name="open_breach_count"/>
            </list>
        </field>
    </record>

    <record id="view_cold_point_form" model="ir.ui.view">
        <field name="name">cold.point.form</field>
        <field name="model">cold.point</field>
        <field name="arch" type="xml">
            <form string="Cold Points">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Point">
    <field name="name"/>
    <field name="ref"/>
    <field name="location"/>
    <field name="active"/>
                        </group>
                        <group string="Safe Range">
    <field name="min_temp"/>
    <field name="max_temp"/>
    <field name="frequency"/>
    <field name="responsible_id"/>
                        </group>
                        <group string="Counters">
    <field name="reading_count"/>
    <field name="open_breach_count"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cold_point_search" model="ir.ui.view">
        <field name="name">cold.point.search</field>
        <field name="model">cold.point</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ref"/>
                <field name="location"/>
                <filter name="breaches" string="Open Breaches" domain="[('open_breach_count','&gt;',0)]"/>
                <separator/>
                <filter name="group_frequency" string="Frequency" context="{'group_by': 'frequency'}"/>
                <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_cold_point_kanban" model="ir.ui.view">
        <field name="name">cold.point.kanban</field>
        <field name="model">cold.point</field>
        <field name="arch" type="xml">
            <kanban default_group_by="frequency" sample="1">
                <field name="frequency"/>
                <field name="name"/>
                <field name="location"/>
                <field name="min_temp"/>
                <field name="max_temp"/>
                <field name="open_breach_count"/>
                <templates>
                    <t t-name="card">
                        <field name="frequency" class="fw-bold"/>
                        <field name="name"/>
                        <field name="location"/>
                        <field name="min_temp"/>
                        <field name="max_temp"/>
                        <field name="open_breach_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_cold_point" model="ir.actions.act_window">
        <field name="name">Cold Points</field>
        <field name="res_model">cold.point</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every fridge, cold room and freezer of your HACCP plan with its safe range and its check frequency.</p>
        </field>
    </record>

</odoo>
