<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cold_breach_list" model="ir.ui.view">
        <field name="name">cold.reading.list</field>
        <field name="model">cold.reading</field>
        <field name="arch" type="xml">
            <list string="Open Breaches">
                <field name="recorded_at"/>
                <field name="point_id"/>
                <field name="temperature"/>
                <field name="point_max_temp"/>
                <field name="point_min_temp"/>
                <field name="measured_by"/>
                <field name="corrected_at"/>
            </list>
        </field>
    </record>

    <record id="view_cold_breach_form" model="ir.ui.view">
        <field name="name">cold.reading.form</field>
        <field name="model">cold.reading</field>
        <field name="arch" type="xml">
            <form string="Open Breaches">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="point_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Reading">
    <field name="point_id"/>
    <field name="temperature"/>
    <field name="recorded_at"/>
    <field name="measured_by"/>
    <field name="company_id"/>
                        </group>
                        <group string="Check">
    <field name="status"/>
    <field name="point_min_temp"/>
    <field name="point_max_temp"/>
    <field name="corrected"/>
    <field name="corrected_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Correction" name="correctionnote">
                            <field name="correction_note"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cold_breach_search" model="ir.ui.view">
        <field name="name">cold.reading.search</field>
        <field name="model">cold.reading</field>
        <field name="arch" type="xml">
            <search>
                <field name="point_id"/>
                <separator/>
                <filter name="group_point" string="Cold Point" context="{'group_by': 'point_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_cold_breach" model="ir.actions.act_window">
        <field name="name">Open Breaches</field>
        <field name="res_model">cold.reading</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every out-of-range reading not corrected yet, the list to empty before the next audit.</p>
        </field>
    </record>

</odoo>
