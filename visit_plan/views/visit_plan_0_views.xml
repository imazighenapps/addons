<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_visit_plan_list" model="ir.ui.view">
        <field name="name">visit.plan.list</field>
        <field name="model">visit.plan</field>
        <field name="arch" type="xml">
            <list string="Visit Plans" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="week_start"/>
                <field name="technician_id"/>
                <field name="stop_count"/>
                <field name="planned_stop_count"/>
                <field name="done_stop_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_visit_plan_form" model="ir.ui.view">
        <field name="name">visit.plan.form</field>
        <field name="model">visit.plan</field>
        <field name="arch" type="xml">
            <form string="Visit Plans">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Plan">
    <field name="name"/>
    <field name="week_start"/>
    <field name="technician_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Progress">
    <field name="stop_count"/>
    <field name="planned_stop_count"/>
    <field name="done_stop_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stops" name="stopids">
                            <field name="stop_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_visit_plan_search" model="ir.ui.view">
        <field name="name">visit.plan.search</field>
        <field name="model">visit.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="technician_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="planned" string="Planned" domain="[('state','=','planned')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_technician" string="Technician" context="{'group_by': 'technician_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_week" string="Week Start" context="{'group_by': 'week_start'}"/>
            </search>
        </field>
    </record>

    <record id="view_visit_plan_kanban" model="ir.ui.view">
        <field name="name">visit.plan.kanban</field>
        <field name="model">visit.plan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="week_start"/>
                <field name="technician_id"/>
                <field name="planned_stop_count"/>
                <field name="done_stop_count"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="week_start"/>
                        <field name="technician_id"/>
                        <field name="planned_stop_count"/>
                        <field name="done_stop_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_visit_plan" model="ir.actions.act_window">
        <field name="name">Visit Plans</field>
        <field name="res_model">visit.plan</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan each technician route week by week and keep the travel order clear.</p>
        </field>
    </record>

</odoo>
