<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_visit_stop_list" model="ir.ui.view">
        <field name="name">visit.stop.list</field>
        <field name="model">visit.stop</field>
        <field name="arch" type="xml">
            <list string="Visit Stops" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="sequence"/>
                <field name="planned_date"/>
                <field name="partner_id"/>
                <field name="site_name"/>
                <field name="plan_id"/>
                <field name="done_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_visit_stop_form" model="ir.ui.view">
        <field name="name">visit.stop.form</field>
        <field name="model">visit.stop</field>
        <field name="arch" type="xml">
            <form string="Visit Stops">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Stop">
    <field name="plan_id"/>
    <field name="sequence"/>
    <field name="partner_id"/>
    <field name="site_name"/>
    <field name="company_id"/>
                        </group>
                        <group string="Schedule">
    <field name="planned_date"/>
    <field name="state"/>
    <field name="done_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_visit_stop_search" model="ir.ui.view">
        <field name="name">visit.stop.search</field>
        <field name="model">visit.stop</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="site_name"/>
                <field name="plan_id"/>
                <filter name="planned" string="Planned" domain="[('state','=','planned')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_route" string="Route" context="{'group_by': 'plan_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_visit_stop_kanban" model="ir.ui.view">
        <field name="name">visit.stop.kanban</field>
        <field name="model">visit.stop</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="partner_id"/>
                <field name="planned_date"/>
                <field name="plan_id"/>
                <field name="sequence"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="partner_id"/>
                        <field name="planned_date"/>
                        <field name="plan_id"/>
                        <field name="sequence"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_visit_stop" model="ir.actions.act_window">
        <field name="name">Visit Stops</field>
        <field name="res_model">visit.stop</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Review every planned stop and complete visits in the expected order.</p>
        </field>
    </record>

</odoo>
