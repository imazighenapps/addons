<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_expedite_entry_premium_list" model="ir.ui.view">
        <field name="name">expedite.entry.list</field>
        <field name="model">expedite.entry</field>
        <field name="arch" type="xml">
            <list string="Premium Entries" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="request_date"/>
                <field name="name"/>
                <field name="requester_name"/>
                <field name="product_name"/>
                <field name="normal_cost"/>
                <field name="actual_cost"/>
                <field name="premium_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_expedite_entry_premium_form" model="ir.ui.view">
        <field name="name">expedite.entry.form</field>
        <field name="model">expedite.entry</field>
        <field name="arch" type="xml">
            <form string="Premium Entries">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Entry">
    <field name="name"/>
    <field name="product_name"/>
    <field name="requester_name"/>
    <field name="urgency_type"/>
    <field name="request_date"/>
    <field name="company_id"/>
                        </group>
                        <group string="Costs">
    <field name="normal_cost"/>
    <field name="actual_cost"/>
    <field name="premium_amount"/>
    <field name="currency_id"/>
    <field name="has_premium"/>
    <field name="state"/>
                        </group>
                        <group string="Reason">
    <field name="reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_expedite_entry_premium_search" model="ir.ui.view">
        <field name="name">expedite.entry.search</field>
        <field name="model">expedite.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_name"/>
                <field name="product_name"/>
                <separator/>
                <filter name="group_requester" string="Requester" context="{'group_by': 'requester_name'}"/>
            </search>
        </field>
    </record>

    <record id="action_expedite_entry_premium" model="ir.actions.act_window">
        <field name="name">Premium Entries</field>
        <field name="res_model">expedite.entry</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Expedited purchases that carried an extra urgency premium.</p>
        </field>
    </record>

</odoo>
