<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_time_blackout_list" model="ir.ui.view">
        <field name="name">delivery.time.blackout.list</field>
        <field name="model">delivery.time.blackout</field>
        <field name="arch" type="xml">
            <list string="Blackout Days">
                <field name="name"/>
                <field name="date"/>
                <field name="slot_id"/>
                <field name="company_id"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_time_blackout_form" model="ir.ui.view">
        <field name="name">delivery.time.blackout.form</field>
        <field name="model">delivery.time.blackout</field>
        <field name="arch" type="xml">
            <form string="Blackout Days">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Blackout">
    <field name="name"/>
    <field name="date"/>
    <field name="slot_id"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Reason">
    <field name="reason"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_delivery_time_blackout_search" model="ir.ui.view">
        <field name="name">delivery.time.blackout.search</field>
        <field name="model">delivery.time.blackout</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reason"/>
                <field name="slot_id"/>
                <filter name="upcoming" string="Upcoming" domain="[('date','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="past" string="Past" domain="[('date','&lt;',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_slot" string="Time Slot" context="{'group_by': 'slot_id'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_delivery_time_blackout" model="ir.actions.act_window">
        <field name="name">Blackout Days</field>
        <field name="res_model">delivery.time.blackout</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Close the warehouse or a single dock for a stocktake, a holiday or a maintenance.</p>
        </field>
    </record>

</odoo>
