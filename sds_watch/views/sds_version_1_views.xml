<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sds_version_list" model="ir.ui.view">
        <field name="name">sds.version.list</field>
        <field name="model">sds.version</field>
        <field name="arch" type="xml">
            <list string="Sheet Versions">
                <field name="issue_date"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="expiry_date"/>
                <field name="supplier_ref"/>
                <field name="is_current" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_sds_version_form" model="ir.ui.view">
        <field name="name">sds.version.form</field>
        <field name="model">sds.version</field>
        <field name="arch" type="xml">
            <form string="Sheet Versions">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Version">
    <field name="name"/>
    <field name="product_id"/>
    <field name="supplier_ref"/>
                        </group>
                        <group string="Dates">
    <field name="issue_date"/>
    <field name="expiry_date"/>
    <field name="is_current"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sds_version_search" model="ir.ui.view">
        <field name="name">sds.version.search</field>
        <field name="model">sds.version</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="supplier_ref"/>
                <filter name="current" string="Current" domain="[('is_current','=',True)]"/>
                <separator/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_sds_version" model="ir.actions.act_window">
        <field name="name">Sheet Versions</field>
        <field name="res_model">sds.version</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every revision of every safety data sheet.</p>
        </field>
    </record>

</odoo>
