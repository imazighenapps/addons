<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_sds_product_company" model="ir.rule">
        <field name="name">sds.product: own company only</field>
        <field name="model_id" ref="model_sds_product"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_sds_version_company" model="ir.rule">
        <field name="name">sds.version: own company only</field>
        <field name="model_id" ref="model_sds_version"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
