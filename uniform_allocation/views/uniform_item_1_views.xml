<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_uniform_item_list" model="ir.ui.view">
        <field name="name">uniform.item.list</field>
        <field name="model">uniform.item</field>
        <field name="arch" type="xml">
            <list string="Uniform Items">
                <field name="name"/>
                <field name="item_type"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_uniform_item_form" model="ir.ui.view">
        <field name="name">uniform.item.form</field>
        <field name="model">uniform.item</field>
        <field name="arch" type="xml">
            <form string="Uniform Items">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Item">
    <field name="name"/>
    <field name="item_type"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uniform_item_search" model="ir.ui.view">
        <field name="name">uniform.item.search</field>
        <field name="model">uniform.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_type" string="Type" context="{'group_by': 'item_type'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_uniform_item" model="ir.actions.act_window">
        <field name="name">Uniform Items</field>
        <field name="res_model">uniform.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define uniform and PPE items.</p>
        </field>
    </record>

</odoo>
