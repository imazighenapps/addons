<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_uniform_item_company" model="ir.rule">
        <field name="name">uniform.item: own company only</field>
        <field name="model_id" ref="model_uniform_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_uniform_allocation_company" model="ir.rule">
        <field name="name">uniform.allocation: own company only</field>
        <field name="model_id" ref="model_uniform_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
