<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_feed_channel_list" model="ir.ui.view">
        <field name="name">feed.channel.list</field>
        <field name="model">feed.channel</field>
        <field name="arch" type="xml">
            <list string="Product Feeds">
                <field name="sequence"/>
                <field name="name"/>
                <field name="backend"/>
                <field name="format"/>
                <field name="product_count"/>
                <field name="error_count"/>
                <field name="last_generation"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_feed_channel_form" model="ir.ui.view">
        <field name="name">feed.channel.form</field>
        <field name="model">feed.channel</field>
        <field name="arch" type="xml">
            <form string="Product Feeds">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Channel">
    <field name="name"/>
    <field name="backend"/>
    <field name="format"/>
    <field name="company_id"/>
    <field name="currency_id"/>
    <field name="active"/>
                        </group>
                        <group string="Publication">
    <field name="base_url"/>
    <field name="token"/>
    <field name="include_oos"/>
    <field name="min_price"/>
                        </group>
                        <group string="Last Run">
    <field name="product_count"/>
    <field name="error_count"/>
    <field name="last_generation"/>
    <field name="attachment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Validation" name="logids">
                            <field name="log_ids" readonly="1"><list><field name="level" decoration-danger="level == 'error'" decoration-warning="level == 'warning'"/><field name="product_name"/><field name="field_name"/><field name="message"/></list></field>
                        </page>
                        <page string="Preview" name="content">
                            <field name="content" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_feed_channel_search" model="ir.ui.view">
        <field name="name">feed.channel.search</field>
        <field name="model">feed.channel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <filter name="errors" string="With Errors" domain="[('error_count','&gt;',0)]"/>
                <separator/>
                <filter name="group_backend" string="Backend" context="{'group_by': 'backend'}"/>
                <filter name="group_format" string="Format" context="{'group_by': 'format'}"/>
            </search>
        </field>
    </record>

    <record id="action_feed_channel" model="ir.actions.act_window">
        <field name="name">Product Feeds</field>
        <field name="res_model">feed.channel</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a channel, then generate your first feed.</p>
        </field>
    </record>

</odoo>
