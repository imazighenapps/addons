<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bank_reconcile_rule_list" model="ir.ui.view">
            <field name="name">bank.reconcile.rule.list</field>
            <field name="model">bank.reconcile.rule</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="journal_id"/>
                    <field name="partner_id"/>
                    <field name="label_contains"/>
                    <field name="ref_contains"/>
                    <field name="amount_tolerance"/>
                    <field name="tolerance_type"/>
                    <field name="min_score"/>
                    <field name="auto_apply"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_bank_reconcile_rule_form" model="ir.ui.view">
            <field name="name">bank.reconcile.rule.form</field>
            <field name="model">bank.reconcile.rule</field>
            <field name="arch" type="xml">
                <form string="Règle de rapprochement">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="active"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="journal_id"/>
                            </group>
                            <group>
                                <field name="partner_id"/>
                                <field name="label_contains"/>
                                <field name="ref_contains"/>
                                <field name="amount_tolerance"/>
                                <field name="tolerance_type"/>
                                <field name="counterpart_account_id"/>
                                <field name="auto_apply"/>
                                <field name="min_score"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
