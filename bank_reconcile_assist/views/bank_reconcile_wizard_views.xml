<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bank_reconcile_assist_wizard_form" model="ir.ui.view">
            <field name="name">bank.reconcile.assist.wizard.form</field>
            <field name="model">bank.reconcile.assist.wizard</field>
            <field name="arch" type="xml">
                <form string="Assistant de rapprochement">
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="amount_tolerance"/>
                        </group>
                    </group>
                    <group>
                        <field name="matched_count" readonly="1"/>
                        <field name="pending_count" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Propositions">
                            <field name="line_ids" nolabel="1">
                                <list create="0" delete="0" editable="bottom">
                                    <field name="selected" widget="boolean_toggle"/>
                                    <field name="st_date"/>
                                    <field name="statement_line_id"/>
                                    <field name="st_label"/>
                                    <field name="st_amount"/>
                                    <field name="move_line_id"/>
                                    <field name="move_ref"/>
                                    <field name="ml_partner"/>
                                    <field name="ml_residual"/>
                                    <field name="score"/>
                                    <field name="reason"/>
                                    <field name="state"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_compute" type="object" string="Calculer les propositions" class="btn-primary"/>
                        <button name="action_apply_selected" type="object" string="Appliquer la sélection" class="btn-secondary"/>
                        <button name="action_progress_report" type="object" string="Rapport d'avancement" class="btn-secondary"/>
                        <button string="Fermer" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
