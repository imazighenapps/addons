<odoo>
  <record id="rule_mrp_readiness_company_user" model="ir.rule">
    <field name="name">MRP readiness checks: company scope</field>
    <field name="model_id" ref="model_fs_mrp_readiness_check"/>
    <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_mrp_readiness_company_manager" model="ir.rule">
    <field name="name">MRP readiness checks manager: company scope</field>
    <field name="model_id" ref="model_fs_mrp_readiness_check"/>
    <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_mrp_readiness_item_company" model="ir.rule">
    <field name="name">MRP readiness items: company scope</field>
    <field name="model_id" ref="model_fs_mrp_readiness_item"/>
    <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_mrp_readiness_config_company" model="ir.rule">
    <field name="name">MRP readiness configuration: company scope</field>
    <field name="model_id" ref="model_fs_mrp_readiness_config"/>
    <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
