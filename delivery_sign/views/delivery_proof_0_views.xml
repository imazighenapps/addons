<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_proof_list" model="ir.ui.view">
        <field name="name">delivery.proof.list</field>
        <field name="model">delivery.proof</field>
        <field name="arch" type="xml">
            <list string="Delivery Proofs" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="delivery_date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="recipient_name"/>
                <field name="signature_ok"/>
                <field name="photo_ok"/>
                <field name="proof_complete"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_proof_form" model="ir.ui.view">
        <field name="name">delivery.proof.form</field>
        <field name="model">delivery.proof</field>
        <field name="arch" type="xml">
            <form string="Delivery Proofs">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Delivery">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="responsible_id"/>
    <field name="delivery_date"/>
    <field name="company_id"/>
                        </group>
                        <group string="Proof">
    <field name="recipient_name"/>
    <field name="signature_ok"/>
    <field name="photo_ok"/>
    <field name="proof_complete"/>
    <field name="state"/>
    <field name="signed_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_delivery_proof_search" model="ir.ui.view">
        <field name="name">delivery.proof.search</field>
        <field name="model">delivery.proof</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="recipient_name"/>
                <field name="responsible_id"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="signed" string="Signed" domain="[('state','=','signed')]"/>
                <filter name="missing_signature" string="Missing Signature" domain="[('signature_ok','=',False),('state','=','pending')]"/>
                <filter name="missing_photo" string="Missing Photo" domain="[('photo_ok','=',False),('state','=','pending')]"/>
                <separator/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_driver" string="Driver" context="{'group_by': 'responsible_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_delivery_proof_kanban" model="ir.ui.view">
        <field name="name">delivery.proof.kanban</field>
        <field name="model">delivery.proof</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="delivery_date"/>
                <field name="proof_complete"/>
                <field name="responsible_id"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="delivery_date"/>
                        <field name="proof_complete"/>
                        <field name="responsible_id"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_delivery_proof" model="ir.actions.act_window">
        <field name="name">Delivery Proofs</field>
        <field name="res_model">delivery.proof</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Capture and review the signature and photo proof for every delivery.</p>
        </field>
    </record>

</odoo>
