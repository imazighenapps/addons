        <field name="name">pr.request: own company only</field>
        <field name="model_id" ref="model_pr_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_pr_request_line_company" model="ir.rule">
        <field name="name">pr.request.line: own company only</field>
        <field name="model_id" ref="model_pr_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
