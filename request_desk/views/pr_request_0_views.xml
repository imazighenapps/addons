<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pr_request_list" model="ir.ui.view">
        <field name="name">pr.request.list</field>
        <field name="model">pr.request</field>
        <field name="arch" type="xml">
            <list string="Purchase Requests" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="needed_on"/>
                <field name="line_count"/>
                <field name="total_qty"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_pr_request_form" model="ir.ui.view">
        <field name="name">pr.request.form</field>
        <field name="model">pr.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Requests">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Request">
    <field name="name"/>
    <field name="requester_id"/>
    <field name="needed_on"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Summary">
    <field name="line_count"/>
    <field name="total_qty"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lineids">
                            <field name="line_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pr_request_search" model="ir.ui.view">
        <field name="name">pr.request.search</field>
        <field name="model">pr.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="to_order" string="To Order" domain="[('state', 'in', ('submitted', 'approved'))]"/>
                <separator/>
                <filter name="group_requester" string="Requester" context="{'group_by': 'requester_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_needed" string="Needed On" context="{'group_by': 'needed_on'}"/>
            </search>
        </field>
    </record>

    <record id="view_pr_request_kanban" model="ir.ui.view">
        <field name="name">pr.request.kanban</field>
        <field name="model">pr.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="needed_on"/>
                <field name="line_count"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="requester_id"/>
                        <field name="needed_on"/>
                        <field name="line_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_pr_request" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">pr.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">A shared desk for every internal purchase need, from request to order.</p>
        </field>
    </record>

</odoo>
