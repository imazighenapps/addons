<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pr_request_line_list" model="ir.ui.view">
        <field name="name">pr.request.line.list</field>
        <field name="model">pr.request.line</field>
        <field name="arch" type="xml">
            <list string="Request Lines">
                <field name="request_id"/>
                <field name="product_name"/>
                <field name="description"/>
                <field name="quantity"/>
                <field name="uom_name"/>
                <field name="needed_on"/>
            </list>
        </field>
    </record>

    <record id="view_pr_request_line_form" model="ir.ui.view">
        <field name="name">pr.request.line.form</field>
        <field name="model">pr.request.line</field>
        <field name="arch" type="xml">
            <form string="Request Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="request_id"/>
    <field name="product_name"/>
    <field name="description"/>
    <field name="company_id"/>
                        </group>
                        <group string="Quantity">
    <field name="quantity"/>
    <field name="uom_name"/>
    <field name="needed_on"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pr_request_line_search" model="ir.ui.view">
        <field name="name">pr.request.line.search</field>
        <field name="model">pr.request.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_id"/>
                <field name="product_name"/>
                <field name="description"/>
                <separator/>
                <filter name="group_request" string="Request" context="{'group_by': 'request_id'}"/>
                <filter name="group_needed" string="Needed On" context="{'group_by': 'needed_on'}"/>
            </search>
        </field>
    </record>

    <record id="action_pr_request_line" model="ir.actions.act_window">
        <field name="name">Request Lines</field>
        <field name="res_model">pr.request.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every line requested by departments, ready for the buyer queue.</p>
        </field>
    </record>

</odoo>
