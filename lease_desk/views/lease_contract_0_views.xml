<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lease_contract_list" model="ir.ui.view">
        <field name="name">lease.contract.list</field>
        <field name="model">lease.contract</field>
        <field name="arch" type="xml">
            <list string="Leases" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="monthly_amount"/>
                <field name="posted_amount" sum="Total Posted Amount"/>
                <field name="remaining_amount" sum="Total Remaining Amount"/>
                <field name="schedule_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_lease_contract_form" model="ir.ui.view">
        <field name="name">lease.contract.form</field>
        <field name="model">lease.contract</field>
        <field name="arch" type="xml">
            <form string="Leases">
                <header>
                    <button name="action_generate_schedule" type="object" string="Generate Schedule" class="btn-secondary" invisible="state == 'closed'"/>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'running'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Lease">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Term">
    <field name="date_start"/>
    <field name="date_end"/>
    <field name="monthly_amount"/>
    <field name="currency_id"/>
    <field name="state"/>
                        </group>
                        <group string="Totals">
    <field name="posted_amount"/>
    <field name="remaining_amount"/>
    <field name="schedule_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Schedule" name="lineids">
                            <field name="line_ids" readonly="state == 'closed'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="due_date"/>
                            <field name="amount" sum="Total"/>
                            <field name="state" widget="badge"/>
                            <field name="posted_on"/>
                            <button name="action_post" type="object"
                                    string="Post" class="btn-link"
                                    invisible="state == 'posted'"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_lease_contract_search" model="ir.ui.view">
        <field name="name">lease.contract.search</field>
        <field name="model">lease.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="running" string="Running" domain="[('state','=','running')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="group_partner" string="Lessor" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_lease_contract_kanban" model="ir.ui.view">
        <field name="name">lease.contract.kanban</field>
        <field name="model">lease.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="monthly_amount"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="monthly_amount"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_lease_contract" model="ir.actions.act_window">
        <field name="name">Leases</field>
        <field name="res_model">lease.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register leases and generate their monthly payment schedule.</p>
        </field>
    </record>

</odoo>
