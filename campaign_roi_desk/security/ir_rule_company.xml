<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_campaign_roi_entry_company" model="ir.rule">
        <field name="name">campaign_roi.entry: own company only</field>
        <field name="model_id" ref="model_campaign_roi_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_campaign_roi_item_company" model="ir.rule">
        <field name="name">campaign_roi.item: own company only</field>
        <field name="model_id" ref="model_campaign_roi_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
