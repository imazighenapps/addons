<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hold_request_list" model="ir.ui.view">
        <field name="name">hold.desk.request.list</field>
        <field name="model">hold.desk.request</field>
        <field name="arch" type="xml">
            <list string="Order Holds" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="document"/>
                <field name="partner_id"/>
                <field name="reason_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="hold_on"/>
                <field name="release_on"/>
                <field name="hold_days"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hold_request_form" model="ir.ui.view">
        <field name="name">hold.desk.request.form</field>
        <field name="model">hold.desk.request</field>
        <field name="arch" type="xml">
            <form string="Order Holds">
                <header>
                    <button name="action_hold" type="object" string="Place On Hold" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_release" type="object" string="Release" class="btn-primary" invisible="state != 'hold'"/>
                    <button name="action_abandon" type="object" string="Abandon" class="btn-secondary" invisible="state not in ('draft', 'hold')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,hold,released,abandoned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Order">
    <field name="name"/>
    <field name="document"/>
    <field name="partner_id"/>
    <field name="amount"/>
    <field name="currency_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Hold">
    <field name="reason_id"/>
    <field name="state"/>
    <field name="hold_on"/>
    <field name="release_on"/>
                        </group>
                        <group string="Release">
    <field name="released_by"/>
    <field name="hold_days"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hold_request_search" model="ir.ui.view">
        <field name="name">hold.desk.request.search</field>
        <field name="model">hold.desk.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document"/>
                <field name="partner_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="hold" string="On Hold" domain="[('state','=','hold')]"/>
                <filter name="released" string="Released" domain="[('state','=','released')]"/>
                <filter name="abandoned" string="Cancelled" domain="[('state','=','abandoned')]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_reason" string="Reason" context="{'group_by': 'reason_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_hold_request_kanban" model="ir.ui.view">
        <field name="name">hold.desk.request.kanban</field>
        <field name="model">hold.desk.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="document"/>
                <field name="partner_id"/>
                <field name="reason_id"/>
                <field name="amount"/>
                <field name="hold_on"/>
                <field name="hold_days"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="document"/>
                        <field name="partner_id"/>
                        <field name="reason_id"/>
                        <field name="amount"/>
                        <field name="hold_on"/>
                        <field name="hold_days"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hold_request" model="ir.actions.act_window">
        <field name="name">Order Holds</field>
        <field name="res_model">hold.desk.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Name the order, pick the reason, place it on hold and release it with a dated trace.</p>
        </field>
    </record>

</odoo>
