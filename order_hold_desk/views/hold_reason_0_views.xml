<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hold_reason_list" model="ir.ui.view">
        <field name="name">hold.desk.reason.list</field>
        <field name="model">hold.desk.reason</field>
        <field name="arch" type="xml">
            <list string="Hold Reasons">
                <field name="sequence"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="open_count"/>
                <field name="request_count"/>
                <field name="active"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hold_reason_form" model="ir.ui.view">
        <field name="name">hold.desk.reason.form</field>
        <field name="model">hold.desk.reason</field>
        <field name="arch" type="xml">
            <form string="Hold Reasons">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Reason">
    <field name="code"/>
    <field name="name"/>
    <field name="active"/>
    <field name="sequence"/>
                        </group>
                        <group string="Rules">
    <field name="company_id"/>
                        </group>
                        <group string="Counters">
    <field name="request_count"/>
    <field name="open_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="When To Use" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hold_reason_search" model="ir.ui.view">
        <field name="name">hold.desk.reason.search</field>
        <field name="model">hold.desk.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active Holds" domain="[('open_count','&gt;',0)]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hold_reason" model="ir.actions.act_window">
        <field name="name">Hold Reasons</field>
        <field name="res_model">hold.desk.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Why orders stop: one reason, one code, one history.</p>
        </field>
    </record>

</odoo>
