<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_meeting_agenda_log_list" model="ir.ui.view">
        <field name="name">meeting.agenda.log.list</field>
        <field name="model">meeting.agenda.log</field>
        <field name="arch" type="xml">
            <list string="Meeting Agendas" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="meeting_date"/>
                <field name="organizer_id"/>
                <field name="attendee_names"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_meeting_agenda_log_form" model="ir.ui.view">
        <field name="name">meeting.agenda.log.form</field>
        <field name="model">meeting.agenda.log</field>
        <field name="arch" type="xml">
            <form string="Meeting Agendas">
                <header>
                    <button name="action_plan" type="object" string="Plan" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state in ('done','cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state in ('draft','planned')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Meeting">
    <field name="name"/>
    <field name="meeting_date"/>
    <field name="organizer_id"/>
    <field name="attendee_names"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agenda" name="agenda">
                            <field name="agenda"/>
                        </page>
                        <page string="Outcomes / Decisions" name="outcomes">
                            <field name="outcomes"/>
                        </page>
                        <page string="Action Items" name="actionitems">
                            <field name="action_items"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_meeting_agenda_log_search" model="ir.ui.view">
        <field name="name">meeting.agenda.log.search</field>
        <field name="model">meeting.agenda.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="organizer_id"/>
                <field name="attendee_names"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="planned" string="Planned" domain="[('state','=','planned')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_organizer" string="Organizer" context="{'group_by': 'organizer_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_meeting_agenda_log" model="ir.actions.act_window">
        <field name="name">Meeting Agendas</field>
        <field name="res_model">meeting.agenda.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create and track meeting agendas and actions.</p>
        </field>
    </record>

</odoo>
