<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_training_type_list" model="ir.ui.view">
        <field name="name">employee.training.type.list</field>
        <field name="model">employee.training.type</field>
        <field name="arch" type="xml">
            <list string="Training Types">
                <field name="name"/>
                <field name="validity_days"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_employee_training_type_form" model="ir.ui.view">
        <field name="name">employee.training.type.form</field>
        <field name="model">employee.training.type</field>
        <field name="arch" type="xml">
            <form string="Training Types">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Type">
    <field name="name"/>
    <field name="validity_days"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_training_type_search" model="ir.ui.view">
        <field name="name">employee.training.type.search</field>
        <field name="model">employee.training.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_employee_training_type" model="ir.actions.act_window">
        <field name="name">Training Types</field>
        <field name="res_model">employee.training.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define training types and their default validity.</p>
        </field>
    </record>

</odoo>
