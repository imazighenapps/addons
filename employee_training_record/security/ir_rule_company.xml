<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_employee_training_type_company" model="ir.rule">
        <field name="name">employee.training.type: own company only</field>
        <field name="model_id" ref="model_employee_training_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_employee_training_record_company" model="ir.rule">
        <field name="name">employee.training.record: own company only</field>
        <field name="model_id" ref="model_employee_training_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
