<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_employeetrai_user" model="res.groups">
        <field name="name">Employee Training Record User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_employeetrai_manager" model="res.groups">
        <field name="name">Employee Training Record Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('employee_training_record.group_employeetrai_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
