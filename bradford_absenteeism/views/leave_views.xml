<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_type_bradford" model="ir.ui.view">
        <field name="name">hr.work.entry.type.bradford</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_holidays.hr_work_entry_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Bradford" name="bradford">
                    <field name="bradford_included"/>
                    <field name="bradford_code"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
