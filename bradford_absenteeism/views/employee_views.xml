<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_bradford" model="ir.ui.view">
        <field name="name">hr.employee.bradford</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Bradford Absenteeism (52w)" name="bradford">
                    <field name="bradford_score"/>
                    <field name="bradford_band"/>
                    <field name="bradford_s"/>
                    <field name="bradford_d"/>
                    <field name="bradford_date"/>
                </group>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_bradford_recompute" string="Recompute Bradford" type="object"/>
            </xpath>
        </field>
    </record>
    <record id="view_bradford_spell_list" model="ir.ui.view">
        <field name="name">bradford.spell.list</field>
        <field name="model">bradford.spell</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="days"/>
            </list>
        </field>
    </record>
    <record id="action_bradford_spell" model="ir.actions.act_window">
        <field name="name">Absence Spells</field>
        <field name="res_model">bradford.spell</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
