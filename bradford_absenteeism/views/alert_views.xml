<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bradford_alert_list" model="ir.ui.view">
        <field name="name">bradford.alert.list</field>
        <field name="model">bradford.alert</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="threshold_id"/>
                <field name="score_snapshot"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-info="state == 'acknowledged'" decoration-warning="state == 'open'"/>
                <field name="due_date"/>
            </list>
        </field>
    </record>
    <record id="view_bradford_alert_form" model="ir.ui.view">
        <field name="name">bradford.alert.form</field>
        <field name="model">bradford.alert</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="employee_id"/>
                    <group>
                        <field name="threshold_id"/>
                        <field name="score_snapshot"/>
                        <field name="state"/>
                        <field name="due_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bradford_alert" model="ir.actions.act_window">
        <field name="name">Alerts</field>
        <field name="res_model">bradford.alert</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
