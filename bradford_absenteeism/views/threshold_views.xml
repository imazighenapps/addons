<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bradford_threshold_list" model="ir.ui.view">
        <field name="name">bradford.threshold.list</field>
        <field name="model">bradford.threshold</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="min_score"/>
                <field name="action"/>
                <field name="role_notified"/>
            </list>
        </field>
    </record>
    <record id="view_bradford_threshold_form" model="ir.ui.view">
        <field name="name">bradford.threshold.form</field>
        <field name="model">bradford.threshold</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <field name="sequence"/>
                        <field name="min_score"/>
                        <field name="action"/>
                        <field name="role_notified"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bradford_threshold" model="ir.actions.act_window">
        <field name="name">Thresholds</field>
        <field name="res_model">bradford.threshold</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
