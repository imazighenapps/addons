<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_deposit_list" model="ir.ui.view">
        <field name="name">customer.deposit.list</field>
        <field name="model">customer.deposit</field>
        <field name="arch" type="xml">
            <list string="Customer Deposits" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="payment_method"/>
                <field name="amount" string="Deposit" sum="Total Deposit"/>
                <field name="allocated_amount" string="Allocated" sum="Total Allocated"/>
                <field name="remaining_amount" string="Remaining" sum="Total Remaining"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_customer_deposit_form" model="ir.ui.view">
        <field name="name">customer.deposit.form</field>
        <field name="model">customer.deposit</field>
        <field name="arch" type="xml">
            <form string="Customer Deposits">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_refund" type="object" string="Refund Remaining" class="btn-primary" invisible="state not in ('confirmed', 'partial') or remaining_amount == 0"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state in ('applied', 'refunded', 'cancelled') or allocated_amount > 0"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state == 'draft' or refund_amount > 0 or allocated_amount > 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,partial,applied,refunded,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="DEP/2026/0001"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
    <field name="partner_id"/>
    <field name="company_id"/>
    <field name="date"/>
    <field name="payment_method"/>
    <field name="journal_id"/>
    <field name="reference"/>
                        </group>
                        <group string="Amounts">
    <field name="amount"/>
    <field name="allocated_amount"/>
    <field name="remaining_amount"/>
    <field name="refund_amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Status">
    <field name="allocation_count"/>
                        </group>
                        <group string="Refund">
    <field name="refund_date"/>
    <field name="refund_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocations" name="allocationids">
                            <field name="allocation_ids"><list editable="bottom"><field name="invoice_id"/><field name="date"/><field name="amount" sum="Total Allocated"/><field name="note"/><field name="currency_id" column_invisible="1"/></list></field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_customer_deposit_search" model="ir.ui.view">
        <field name="name">customer.deposit.search</field>
        <field name="model">customer.deposit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <filter name="to_apply" string="To Apply" domain="[('state','=','confirmed')]"/>
                <filter name="partial" string="Partially Applied" domain="[('state','=','partial')]"/>
                <filter name="applied" string="Fully Applied" domain="[('state','=','applied')]"/>
                <filter name="refunded" string="Refunded" domain="[('state','=','refunded')]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_customer_deposit" model="ir.actions.act_window">
        <field name="name">Customer Deposits</field>
        <field name="res_model">customer.deposit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a customer deposit, confirm it, then apply it to the invoices.</p>
        </field>
    </record>

</odoo>
