<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_deposit_allocation_list" model="ir.ui.view">
        <field name="name">deposit.allocation.list</field>
        <field name="model">deposit.allocation</field>
        <field name="arch" type="xml">
            <list string="Deposit Allocations">
                <field name="deposit_id"/>
                <field name="invoice_id"/>
                <field name="date"/>
                <field name="amount" sum="Total Amount"/>
                <field name="currency_id" optional="hide"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_deposit_allocation_form" model="ir.ui.view">
        <field name="name">deposit.allocation.form</field>
        <field name="model">deposit.allocation</field>
        <field name="arch" type="xml">
            <form string="Deposit Allocations">
                <sheet>
                    <group>
                        <group string="Allocation">
    <field name="deposit_id"/>
    <field name="invoice_id"/>
    <field name="date"/>
    <field name="amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Notes">
    <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deposit_allocation_search" model="ir.ui.view">
        <field name="name">deposit.allocation.search</field>
        <field name="model">deposit.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="deposit_id"/>
                <field name="invoice_id"/>
                <filter name="this_month" string="This Month" domain="[('date','&gt;=',(context_today().strftime('%Y-%m-01')))]"/>
                <separator/>
                <filter name="group_deposit" string="Deposit" context="{'group_by': 'deposit_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_deposit_allocation" model="ir.actions.act_window">
        <field name="name">Deposit Allocations</field>
        <field name="res_model">deposit.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every deposit applied to an invoice, with its date and amount.</p>
        </field>
    </record>

</odoo>
