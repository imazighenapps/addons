<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_advance_request_list" model="ir.ui.view">
        <field name="name">advance.request.list</field>
        <field name="model">advance.request</field>
        <field name="arch" type="xml">
            <list string="Advance Requests" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="request_date"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="amount"/>
                <field name="repaid_amount"/>
                <field name="remaining_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_advance_request_form" model="ir.ui.view">
        <field name="name">advance.request.form</field>
        <field name="model">advance.request</field>
        <field name="arch" type="xml">
            <form string="Advance Requests">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state == 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state == 'submitted'"/>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-secondary" invisible="state in ('draft', 'submitted')"/>
                    <button name="action_close" type="object" string="Close Repaid" class="btn-secondary" invisible="state == 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="s,t,a,t,e"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Request">
    <field name="name"/>
    <field name="employee_id"/>
    <field name="amount"/>
    <field name="currency_id"/>
    <field name="request_date"/>
    <field name="approval_date"/>
    <field name="company_id"/>
                        </group>
                        <group string="Balance">
    <field name="repaid_amount"/>
    <field name="remaining_amount"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason" name="reason">
                            <field name="reason"/>
                        </page>
                        <page string="Repayments" name="lineids">
                            <field name="line_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_advance_request_search" model="ir.ui.view">
        <field name="name">advance.request.search</field>
        <field name="model">advance.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="open_balance" string="Open Balance" domain="[('remaining_amount','&gt;',0),('state','=','approved')]"/>
                <separator/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_advance_request_kanban" model="ir.ui.view">
        <field name="name">advance.request.kanban</field>
        <field name="model">advance.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="amount"/>
                <field name="remaining_amount"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="amount"/>
                        <field name="remaining_amount"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_advance_request" model="ir.actions.act_window">
        <field name="name">Advance Requests</field>
        <field name="res_model">advance.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Salary advances with a clear repayment plan and balance.</p>
        </field>
    </record>

</odoo>
