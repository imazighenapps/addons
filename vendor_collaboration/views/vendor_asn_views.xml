<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_asn_list" model="ir.ui.view">
        <field name="name">vendor.asn.list</field>
        <field name="model">vendor.asn</field>
        <field name="arch" type="xml">
            <list string="Vendor ASNs">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <field name="expected_date"/>
                <field name="carrier_name"/>
                <field name="tracking_ref"/>
                <field name="state" widget="badge" decoration-success="state=='received'" decoration-info="state=='submitted'"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_asn_form" model="ir.ui.view">
        <field name="name">vendor.asn.form</field>
        <field name="model">vendor.asn</field>
        <field name="arch" type="xml">
            <form string="Vendor ASN">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state!='draft'"/>
                    <button name="action_receive" type="object" string="Mark Received" class="btn-primary" invisible="state!='submitted'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','submitted')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state!='cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,received"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="purchase_id"/>
                            <field name="picking_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="expected_date"/>
                            <field name="carrier_name"/>
                            <field name="tracking_ref"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty_expected"/>
                                    <field name="qty_received"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="note"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_vendor_asn" model="ir.actions.act_window">
        <field name="name">Vendor ASNs</field>
        <field name="res_model">vendor.asn</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
