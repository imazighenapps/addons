<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_vendor_asn" model="ir.sequence">
        <field name="name">Vendor ASN</field>
        <field name="code">vendor.asn</field>
        <field name="prefix">ASN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_vendor_chargeback" model="ir.sequence">
        <field name="name">Vendor Chargeback</field>
        <field name="code">vendor.chargeback</field>
        <field name="prefix">VCB/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
