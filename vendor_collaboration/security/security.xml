<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vendor_collaboration" model="ir.module.category">
        <field name="name">Vendor Collaboration</field>
        <field name="sequence">41</field>
    </record>
    <record id="group_vendor_collab_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_vendor_collaboration"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="group_vendor_collab_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_vendor_collaboration"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_collab_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_vendor_asn_company" model="ir.rule">
        <field name="name">Vendor ASN multi-company</field>
        <field name="model_id" ref="model_vendor_asn"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_vendor_chargeback_company" model="ir.rule">
        <field name="name">Vendor Chargeback multi-company</field>
        <field name="model_id" ref="model_vendor_chargeback"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_vendor_catalog_company" model="ir.rule">
        <field name="name">Vendor Catalog multi-company</field>
        <field name="model_id" ref="model_vendor_catalog_item"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
</odoo>
