<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vendor_collaboration_privilege" model="res.groups.privilege"><field name="name">Vendor Collaboration</field><field name="sequence">10</field></record>
    <record id="group_vendor_collab_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="module_category_vendor_collaboration_privilege"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="group_vendor_collab_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="module_category_vendor_collaboration_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_collab_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
