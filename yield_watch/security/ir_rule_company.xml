<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_yield_run_company" model="ir.rule">
        <field name="name">yield.run: own company only</field>
        <field name="model_id" ref="model_yield_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_yield_loss_company" model="ir.rule">
        <field name="name">yield.loss: own company only</field>
        <field name="model_id" ref="model_yield_loss"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
