<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_yield_loss_list" model="ir.ui.view">
        <field name="name">yield.loss.list</field>
        <field name="model">yield.loss</field>
        <field name="arch" type="xml">
            <list string="Loss Lines">
                <field name="run_id"/>
                <field name="reason"/>
                <field name="step"/>
                <field name="quantity" sum="Total Quantity"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_yield_loss_form" model="ir.ui.view">
        <field name="name">yield.loss.form</field>
        <field name="model">yield.loss</field>
        <field name="arch" type="xml">
            <form string="Loss Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reason" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Loss">
    <field name="run_id"/>
    <field name="sequence"/>
    <field name="reason"/>
    <field name="step"/>
                        </group>
                        <group string="Quantity">
    <field name="quantity"/>
    <field name="note"/>
    <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_yield_loss_search" model="ir.ui.view">
        <field name="name">yield.loss.search</field>
        <field name="model">yield.loss</field>
        <field name="arch" type="xml">
            <search>
                <field name="reason"/>
                <field name="step"/>
                <field name="run_id"/>
                <separator/>
                <filter name="group_run" string="Run" context="{'group_by': 'run_id'}"/>
                <filter name="group_reason" string="Reason" context="{'group_by': 'reason'}"/>
            </search>
        </field>
    </record>

    <record id="action_yield_loss" model="ir.actions.act_window">
        <field name="name">Loss Lines</field>
        <field name="res_model">yield.loss</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every named loss across all production runs.</p>
        </field>
    </record>

</odoo>
