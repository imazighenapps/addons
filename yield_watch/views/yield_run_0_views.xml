<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_yield_run_list" model="ir.ui.view">
        <field name="name">yield.run.list</field>
        <field name="model">yield.run</field>
        <field name="arch" type="xml">
            <list string="Yield Runs" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="run_date"/>
                <field name="name"/>
                <field name="product_name"/>
                <field name="responsible_id"/>
                <field name="planned_qty" sum="Total Planned Qty"/>
                <field name="actual_qty" sum="Total Actual Qty"/>
                <field name="loss_qty" sum="Total Loss Qty"/>
                <field name="yield_rate"/>
                <field name="loss_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_yield_run_form" model="ir.ui.view">
        <field name="name">yield.run.form</field>
        <field name="model">yield.run</field>
        <field name="arch" type="xml">
            <form string="Yield Runs">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'running'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Run">
    <field name="name"/>
    <field name="product_name"/>
    <field name="run_date"/>
    <field name="responsible_id"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Output">
    <field name="planned_qty"/>
    <field name="actual_qty"/>
    <field name="loss_qty"/>
    <field name="yield_rate"/>
    <field name="state"/>
                        </group>
                        <group string="Loss Summary">
    <field name="loss_count"/>
    <field name="line_loss_qty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Losses" name="lossids">
                            <field name="loss_ids" readonly="state == 'closed'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="reason"/>
                            <field name="step" optional="show"/>
                            <field name="quantity" sum="Lost"/>
                            <field name="note" optional="hide"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_yield_run_search" model="ir.ui.view">
        <field name="name">yield.run.search</field>
        <field name="model">yield.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_name"/>
                <field name="responsible_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="running" string="Running" domain="[('state','=','running')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <filter name="losses" string="With Losses" domain="[('loss_qty','&gt;',0)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_yield_run" model="ir.actions.act_window">
        <field name="name">Yield Runs</field>
        <field name="res_model">yield.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record planned and actual output per run and name every loss.</p>
        </field>
    </record>

</odoo>
