<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_followup_reminder" model="mail.template">
            <field name="name">Follow-up Reminder</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Follow-up: {{ object.name }} - {{ object.partner_id.name }}</field>
<field name="body_html" type="html">
    <div>
        <p>Dear <t t-out="object.partner_id.name"/>,</p>

        <p>
            I hope this message finds you well. I wanted to follow up on the quotation
            <strong><t t-out="object.name"/></strong>
            sent on <t t-out="format_date(object.date_order)"/>
            for a total of
            <strong><t t-out="format_amount(object.amount_total, object.currency_id)"/></strong>.
        </p>

        <p>
            Please feel free to reach out if you have any questions or need any adjustments
            to the quotation.
        </p>

        <p>
            Best regards,<br/>
            <t t-out="object.user_id.name"/><br/>
            <t t-out="object.company_id.name"/>
        </p>
    </div>


            </field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="email_from">{{ object.user_id.email_formatted or object.company_id.email_formatted }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
