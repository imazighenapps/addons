<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="smart_followup_reminder_followup_config_view_form" model="ir.ui.view">
        <field name="name">followup.config.form</field>
        <field name="model">followup.config</field>
        <field name="arch" type="xml">
            <form string="Follow-up Configuration">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="team_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Delays (days)">
                            <field name="delay_1"/>
                            <field name="delay_2"/>
                            <field name="delay_3"/>
                        </group>
                    </group>
                    <group>
                        <group string="Conditions">
                            <!--
                                FIX: Ajout du widget monetary + currency pour
                                afficher le montant correctement.
                            -->
                            <field name="min_amount" widget="monetary"/>
                        </group>
                        <group string="Email">
                            <field name="template_id"/>
                        </group>
                    </group>
                    <!-- AMÉLIORATION: Alerte visuelle si les délais sont incohérents -->
                    <div class="alert alert-warning" role="alert"
                         invisible="delay_1 == 0 or delay_2 == 0 or delay_3 == 0 or (delay_1 &lt; delay_2 and delay_2 &lt; delay_3)">
                        ⚠️ Delays must be in increasing order: 1st &lt; 2nd &lt; Escalation.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="smart_followup_reminder_followup_config_view_list" model="ir.ui.view">
        <field name="name">followup.config.list</field>
        <field name="model">followup.config</field>
        <field name="arch" type="xml">
            <list string="Follow-up Configurations">
                <field name="name"/>
                <field name="team_id"/>
                <field name="delay_1"/>
                <field name="delay_2"/>
                <field name="delay_3"/>
                <!-- FIX: Ajout du widget monetary pour l'affichage du montant -->
                <field name="min_amount" widget="monetary"/>
                <field name="template_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="smart_followup_reminder_action_followup_config" model="ir.actions.act_window">
        <field name="name">Follow-up Configurations</field>
        <field name="res_model">followup.config</field>
        <field name="view_mode">list,form</field>
        <!-- FIX: Afficher uniquement les configs actives par défaut -->
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>