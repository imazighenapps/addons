<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_software_license_list" model="ir.ui.view">
        <field name="name">software.license.list</field>
        <field name="model">software.license</field>
        <field name="arch" type="xml">
            <list string="Software Licenses" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="vendor"/>
                <field name="seats"/>
                <field name="owner_id"/>
                <field name="date_purchase"/>
                <field name="date_expiry"/>
                <field name="is_expired" widget="boolean"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_software_license_form" model="ir.ui.view">
        <field name="name">software.license.form</field>
        <field name="model">software.license</field>
        <field name="arch" type="xml">
            <form string="Software Licenses">
                <header>
                    <button name="action_mark_expired" type="object" string="Mark Expired" class="btn-secondary" invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state == 'cancelled'"/>
                    <button name="action_reset" type="object" string="Reset to Active" class="btn-link" invisible="state == 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="License">
    <field name="name"/>
    <field name="vendor"/>
    <field name="license_key"/>
    <field name="seats"/>
    <field name="owner_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Dates">
    <field name="date_purchase"/>
    <field name="date_expiry"/>
    <field name="is_expired"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_software_license_search" model="ir.ui.view">
        <field name="name">software.license.search</field>
        <field name="model">software.license</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vendor"/>
                <field name="license_key"/>
                <field name="owner_id"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="expired" string="Expired" domain="[('state','=','expired')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor'}"/>
                <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_software_license" model="ir.actions.act_window">
        <field name="name">Software Licenses</field>
        <field name="res_model">software.license</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track software licenses and renewals.</p>
        </field>
    </record>

</odoo>
