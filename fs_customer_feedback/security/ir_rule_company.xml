<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_customer_feedback_topic_company" model="ir.rule">
        <field name="name">customer.feedback.topic: own company only</field>
        <field name="model_id" ref="model_customer_feedback_topic"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_customer_feedback_company" model="ir.rule">
        <field name="name">customer.feedback: own company only</field>
        <field name="model_id" ref="model_customer_feedback"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
