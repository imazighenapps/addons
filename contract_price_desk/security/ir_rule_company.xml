<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_contract_price_entry_company" model="ir.rule">
        <field name="name">contract_price.entry: own company only</field>
        <field name="model_id" ref="model_contract_price_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_contract_price_item_company" model="ir.rule">
        <field name="name">contract_price.item: own company only</field>
        <field name="model_id" ref="model_contract_price_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
