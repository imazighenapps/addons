<odoo>
    <record id="view_qms_certification_list" model="ir.ui.view">
        <field name="name">qms.certification.list</field>
        <field name="model">qms.certification</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="standard_id"/>
                <field name="certificate_number"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="view_qms_certification_form" model="ir.ui.view">
        <field name="name">qms.certification.form</field>
        <field name="model">qms.certification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_suspend" type="object" string="Suspend" invisible="status in ('suspended','expired','renewed')"/>
                    <button name="action_mark_renewed" type="object" string="Mark Renewed" invisible="status not in ('expired','expiring')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,expiring,expired,suspended,renewed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="standard_id"/>
                            <field name="certificate_number"/>
                            <field name="certification_body_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="company_id"/>
                            <field name="audit_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Related Records">
                        <field name="audit_ids" widget="many2many_tags"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <notebook>
                        <page string="Scope">
                            <field name="scope"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_qms_certification" model="ir.actions.act_window">
        <field name="name">Certifications</field>
        <field name="res_model">qms.certification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
