<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shelf_lot_list" model="ir.ui.view">
        <field name="name">shelf.lot.list</field>
        <field name="model">shelf.lot</field>
        <field name="arch" type="xml">
            <list string="Perishable Lots" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="product_name"/>
                <field name="location_name"/>
                <field name="quantity"/>
                <field name="received_date"/>
                <field name="expiry_date"/>
                <field name="days_left"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_shelf_lot_form" model="ir.ui.view">
        <field name="name">shelf.lot.form</field>
        <field name="model">shelf.lot</field>
        <field name="arch" type="xml">
            <form string="Perishable Lots">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Lot">
    <field name="name"/>
    <field name="product_name"/>
    <field name="location_name"/>
    <field name="quantity"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Dates">
    <field name="received_date"/>
    <field name="expiry_date"/>
    <field name="warning_days"/>
    <field name="days_left"/>
                        </group>
                        <group string="Status">
    <field name="state"/>
    <field name="is_alert"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_shelf_lot_search" model="ir.ui.view">
        <field name="name">shelf.lot.search</field>
        <field name="model">shelf.lot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_name"/>
                <field name="location_name"/>
                <filter name="expiring" string="Expiring Soon" domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="alerts" string="Alerts" domain="[('is_alert', '=', True)]"/>
                <filter name="quarantined" string="Quarantined" domain="[('state', '=', 'quarantined')]"/>
                <separator/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_name'}"/>
                <filter name="group_location" string="Location" context="{'group_by': 'location_name'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_shelf_lot_kanban" model="ir.ui.view">
        <field name="name">shelf.lot.kanban</field>
        <field name="model">shelf.lot</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="product_name"/>
                <field name="expiry_date"/>
                <field name="days_left"/>
                <field name="quantity"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="product_name"/>
                        <field name="expiry_date"/>
                        <field name="days_left"/>
                        <field name="quantity"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_shelf_lot" model="ir.actions.act_window">
        <field name="name">Perishable Lots</field>
        <field name="res_model">shelf.lot</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every perishable lot with its expiry clock and current status.</p>
        </field>
    </record>

</odoo>
