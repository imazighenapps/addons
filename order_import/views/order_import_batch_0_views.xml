<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_import_batch_list" model="ir.ui.view">
        <field name="name">order.import.batch.list</field>
        <field name="model">order.import.batch</field>
        <field name="arch" type="xml">
            <list string="Import Batches" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="import_date"/>
                <field name="source_file"/>
                <field name="line_count"/>
                <field name="accepted_count"/>
                <field name="rejected_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_order_import_batch_form" model="ir.ui.view">
        <field name="name">order.import.batch.form</field>
        <field name="model">order.import.batch</field>
        <field name="arch" type="xml">
            <form string="Import Batches">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Batch">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="import_date"/>
    <field name="source_file"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Counts">
    <field name="line_count"/>
    <field name="accepted_count"/>
    <field name="rejected_count"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lineids">
                            <field name="line_ids"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_order_import_batch_search" model="ir.ui.view">
        <field name="name">order.import.batch.search</field>
        <field name="model">order.import.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="source_file"/>
                <filter name="with_errors" string="With Errors" domain="[('rejected_count','&gt;',0)]"/>
                <filter name="accepted" string="All Accepted" domain="[('rejected_count','=',0),('state','!=','draft')]"/>
                <filter name="processed" string="Processed" domain="[('state','=','processed')]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_order_import_batch_kanban" model="ir.ui.view">
        <field name="name">order.import.batch.kanban</field>
        <field name="model">order.import.batch</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="import_date"/>
                <field name="accepted_count"/>
                <field name="rejected_count"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="import_date"/>
                        <field name="accepted_count"/>
                        <field name="rejected_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_order_import_batch" model="ir.actions.act_window">
        <field name="name">Import Batches</field>
        <field name="res_model">order.import.batch</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Each customer file as a batch: validate it, see the errors and process only what is clean.</p>
        </field>
    </record>

</odoo>
