<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ehs_incident_company" model="ir.rule">
        <field name="name">ehs.incident: own company only</field>
        <field name="model_id" ref="model_ehs_incident"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_ehs_action_company" model="ir.rule">
        <field name="name">ehs.action: own company only</field>
        <field name="model_id" ref="model_ehs_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
