<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="saft_export_company_rule" model="ir.access">
            <field name="name">Export SAF-T : société</field>
            <field name="model_id" ref="model_saft_export"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="saft_profile_company_rule" model="ir.access">
            <field name="name">Profil SAF-T : société</field>
            <field name="model_id" ref="model_saft_country_profile"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
