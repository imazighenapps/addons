<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_saft_profile_form" model="ir.ui.view">
            <field name="name">saft.country.profile.form</field>
            <field name="model">saft.country.profile</field>
            <field name="arch" type="xml">
                <form string="Profil pays SAF-T">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="country_id"/>
                                <field name="country_code"/>
                                <field name="namespace"/>
                                <field name="schema_version"/>
                                <field name="tax_accounting_basis"/>
                            </group>
                            <group>
                                <field name="require_explicit_account_map"/>
                                <field name="active"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Mappings de comptes">
                                <field name="account_map_ids">
                                    <list editable="bottom">
                                        <field name="account_id"/>
                                        <field name="saft_account_type"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Mappings de taxes">
                                <field name="tax_map_ids">
                                    <list editable="bottom">
                                        <field name="tax_id"/>
                                        <field name="saft_tax_code"/>
                                        <field name="saft_tax_type"/>
                                        <field name="saft_tax_rate"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_saft_profile_list" model="ir.ui.view">
            <field name="name">saft.country.profile.list</field>
            <field name="model">saft.country.profile</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="country_id"/>
                    <field name="schema_version"/>
                    <field name="require_explicit_account_map"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
