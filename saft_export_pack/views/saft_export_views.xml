<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_saft_export_form" model="ir.ui.view">
            <field name="name">saft.export.form</field>
            <field name="model">saft.export</field>
            <field name="arch" type="xml">
                <form string="Export SAF-T">
                    <header>
                        <button name="action_check_completeness" type="object"
                                string="Contrôles de complétude"
                                class="btn-secondary" invisible="state == 'generated'"/>
                        <button name="action_generate" type="object"
                                string="Générer le fichier SAF-T"
                                class="btn-primary" invisible="state == 'generated'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Paramètres">
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="country_profile_id"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="fiscal_year"/>
                            </group>
                            <group string="Résultats">
                                <field name="file_name" readonly="1"/>
                                <field name="file_data" readonly="1" filename="file_name"/>
                                <field name="generated_at" readonly="1"/>
                                <field name="entry_count" readonly="1"/>
                                <field name="line_count" readonly="1"/>
                                <field name="account_count" readonly="1"/>
                                <field name="total_debit" readonly="1"/>
                                <field name="total_credit" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <group string="Contrôles de complétude">
                            <field name="warnings" nolabel="1" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_saft_export_list" model="ir.ui.view">
            <field name="name">saft.export.list</field>
            <field name="model">saft.export</field>
            <field name="arch" type="xml">
                <list decoration-success="state == 'generated'">
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="country_profile_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="entry_count"/>
                    <field name="total_debit"/>
                    <field name="total_credit"/>
                    <field name="state"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
