<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_price_watch_rule_list" model="ir.ui.view">
        <field name="name">price.watch.rule.list</field>
        <field name="model">price.watch.rule</field>
        <field name="arch" type="xml">
            <list string="Watch Rules">
                <field name="name"/>
                <field name="threshold_pct"/>
                <field name="notify_user_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_price_watch_rule_form" model="ir.ui.view">
        <field name="name">price.watch.rule.form</field>
        <field name="model">price.watch.rule</field>
        <field name="arch" type="xml">
            <form string="Watch Rules">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Threshold">
    <field name="name"/>
    <field name="threshold_pct"/>
    <field name="notify_user_id"/>
                        </group>
                        <group string="Company">
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_price_watch_rule_search" model="ir.ui.view">
        <field name="name">price.watch.rule.search</field>
        <field name="model">price.watch.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter name="group_notify_user_id" string="Owner" context="{'group_by': 'notify_user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_price_watch_rule" model="ir.actions.act_window">
        <field name="name">Watch Rules</field>
        <field name="res_model">price.watch.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The variation a supplier may show before it is alerted.</p>
        </field>
    </record>

</odoo>
