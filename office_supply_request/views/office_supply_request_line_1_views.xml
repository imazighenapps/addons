<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_office_supply_request_line_list" model="ir.ui.view">
        <field name="name">office.supply.request.line.list</field>
        <field name="model">office.supply.request.line</field>
        <field name="arch" type="xml">
            <list string="Request Lines">
                <field name="request_id"/>
                <field name="sequence"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="note"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_office_supply_request_line_form" model="ir.ui.view">
        <field name="name">office.supply.request.line.form</field>
        <field name="model">office.supply.request.line</field>
        <field name="arch" type="xml">
            <form string="Request Lines">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Line">
    <field name="request_id"/>
    <field name="sequence"/>
    <field name="name"/>
    <field name="quantity"/>
    <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_office_supply_request_line_search" model="ir.ui.view">
        <field name="name">office.supply.request.line.search</field>
        <field name="model">office.supply.request.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_id"/>
                <field name="name"/>
                <field name="note"/>
                <separator/>
                <filter name="group_request" string="Request" context="{'group_by': 'request_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_office_supply_request_line" model="ir.actions.act_window">
        <field name="name">Request Lines</field>
        <field name="res_model">office.supply.request.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Lines of office supply requests.</p>
        </field>
    </record>

</odoo>
