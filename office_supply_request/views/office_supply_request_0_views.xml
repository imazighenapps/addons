<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_office_supply_request_list" model="ir.ui.view">
        <field name="name">office.supply.request.list</field>
        <field name="model">office.supply.request</field>
        <field name="arch" type="xml">
            <list string="Supply Requests" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date_request"/>
                <field name="date_needed"/>
                <field name="priority"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_office_supply_request_form" model="ir.ui.view">
        <field name="name">office.supply.request.form</field>
        <field name="model">office.supply.request</field>
        <field name="arch" type="xml">
            <form string="Supply Requests">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_fulfill" type="object" string="Mark Fulfilled" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state in ('fulfilled','cancelled')"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,fulfilled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Request">
    <field name="name"/>
    <field name="requester_id"/>
    <field name="employee_id"/>
    <field name="department_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Planning">
    <field name="date_request"/>
    <field name="date_needed"/>
    <field name="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lineids">
                            <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="note"/>
                            <field name="company_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_office_supply_request_search" model="ir.ui.view">
        <field name="name">office.supply.request.search</field>
        <field name="model">office.supply.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="fulfilled" string="Fulfilled" domain="[('state','=','fulfilled')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_requester" string="Requester" context="{'group_by': 'requester_id'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_office_supply_request" model="ir.actions.act_window">
        <field name="name">Supply Requests</field>
        <field name="res_model">office.supply.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create and track internal office supply requests.</p>
        </field>
    </record>

</odoo>
