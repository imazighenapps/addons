<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_pel_employee" model="hr.employee">
        <field name="name">Demo Expense Requester</field>
    </record>
    <record id="demo_pel_1" model="petty.expense.log">
        <field name="name">PEL-DEMO-001</field>
        <field name="employee_id" ref="demo_pel_employee"/>
        <field name="expense_date" eval="(DateTime.now() - relativedelta(days=3)).strftime('%Y-%m-%d')"/>
        <field name="amount">25.0</field>
        <field name="category">Office Supplies</field>
        <field name="purpose">Printer paper and pens.</field>
        <field name="state">reimbursed</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="demo_pel_2" model="petty.expense.log">
        <field name="name">PEL-DEMO-002</field>
        <field name="employee_id" ref="demo_pel_employee"/>
        <field name="expense_date" eval="DateTime.now().strftime('%Y-%m-%d')"/>
        <field name="amount">12.5</field>
        <field name="category">Transport</field>
        <field name="purpose">Local taxi fare.</field>
        <field name="state">draft</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
</odoo>
