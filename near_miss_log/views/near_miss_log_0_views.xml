<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_near_miss_log_list" model="ir.ui.view">
        <field name="name">near.miss.log.list</field>
        <field name="model">near.miss.log</field>
        <field name="arch" type="xml">
            <list string="Near Misses" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="event_date"/>
                <field name="location"/>
                <field name="severity" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="reporter_id"/>
                <field name="responsible_id"/>
            </list>
        </field>
    </record>

    <record id="view_near_miss_log_form" model="ir.ui.view">
        <field name="name">near.miss.log.form</field>
        <field name="model">near.miss.log</field>
        <field name="arch" type="xml">
            <form string="Near Misses">
                <header>
                    <button name="action_report" type="object" string="Report" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_investigate" type="object" string="Investigate" class="btn-primary" invisible="state != 'reported'"/>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'investigating'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reported,investigating,closed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Event">
    <field name="name"/>
    <field name="event_date"/>
    <field name="location"/>
    <field name="severity"/>
    <field name="reporter_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Follow-up">
    <field name="responsible_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Corrective Action" name="correctiveaction">
                            <field name="corrective_action"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_near_miss_log_search" model="ir.ui.view">
        <field name="name">near.miss.log.search</field>
        <field name="model">near.miss.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location"/>
                <field name="reporter_id"/>
                <field name="responsible_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="reported" string="Reported" domain="[('state','=','reported')]"/>
                <filter name="investigating" string="Investigating" domain="[('state','=','investigating')]"/>
                <filter name="high" string="High Severity" domain="[('severity','=','high')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                <filter name="group_location" string="Location" context="{'group_by': 'location'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_near_miss_log_graph" model="ir.ui.view">
        <field name="name">near.miss.log.graph</field>
        <field name="model">near.miss.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_near_miss_log" model="ir.actions.act_window">
        <field name="name">Near Misses</field>
        <field name="res_model">near.miss.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Report near misses and track corrective actions.</p>
        </field>
    </record>

</odoo>
