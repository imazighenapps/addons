<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_expiry_category_list" model="ir.ui.view">
        <field name="name">expiry.category.list</field>
        <field name="model">expiry.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="code"/>
                <field name="name"/>
                <field name="default_validity_days"/>
                <field name="reminder_days"/>
                <field name="document_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_expiry_category_form" model="ir.ui.view">
        <field name="name">expiry.category.form</field>
        <field name="model">expiry.category</field>
        <field name="arch" type="xml">
            <form string="Categories">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Category">
    <field name="code"/>
    <field name="name"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Defaults">
    <field name="default_validity_days"/>
    <field name="reminder_days"/>
    <field name="document_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents" name="documentids">
                            <field name="document_ids">
                        <list>
                            <field name="reference"/>
                            <field name="name"/>
                            <field name="expiry_date"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_expiry_category_search" model="ir.ui.view">
        <field name="name">expiry.category.search</field>
        <field name="model">expiry.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_expiry_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">expiry.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set the default validity and the reminder lead time once per document family.</p>
        </field>
    </record>

</odoo>
