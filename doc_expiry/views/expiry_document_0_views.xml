<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_expiry_document_list" model="ir.ui.view">
        <field name="name">expiry.document.list</field>
        <field name="model">expiry.document</field>
        <field name="arch" type="xml">
            <list string="Documents" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="reference"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="partner_id"/>
                <field name="expiry_date"/>
                <field name="days_left"/>
                <field name="owner_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_expiry_document_form" model="ir.ui.view">
        <field name="name">expiry.document.form</field>
        <field name="model">expiry.document</field>
        <field name="arch" type="xml">
            <form string="Documents">
                <header>
                    <button name="action_renew" type="object" string="Renew" class="btn-primary" invisible="not active"/>
                    <button name="action_archive" type="object" string="Archive" class="btn-secondary" invisible="not active"/>
                    <button name="action_activate" type="object" string="Restore" class="btn-link" invisible="active"/>
                    <field name="state" widget="statusbar" statusbar_visible="valid,expiring,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Document">
    <field name="reference"/>
    <field name="name"/>
    <field name="category_id"/>
    <field name="partner_id"/>
    <field name="owner_id"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Validity">
    <field name="issue_date"/>
    <field name="expiry_date"/>
    <field name="reminder_days"/>
    <field name="reminder_date"/>
    <field name="days_left"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Renewal History" name="logids">
                            <field name="log_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="date"/>
                            <field name="action" widget="badge"/>
                            <field name="old_expiry"/>
                            <field name="new_expiry"/>
                            <field name="user_id"/>
                            <field name="note"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_expiry_document_search" model="ir.ui.view">
        <field name="name">expiry.document.search</field>
        <field name="model">expiry.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <filter name="expiring" string="Expiring Soon" domain="[('state','=','expiring')]"/>
                <filter name="expired" string="Expired" domain="[('state','=','expired')]"/>
                <filter name="valid" string="Valid" domain="[('state','=','valid')]"/>
                <filter name="mine" string="My Documents" domain="[('owner_id','=',uid)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_owner" string="Responsible" context="{'group_by': 'owner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_expiry_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">expiry.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track the expiry date of every contract, policy, certificate and licence, and renew it in one click.</p>
        </field>
    </record>

</odoo>
