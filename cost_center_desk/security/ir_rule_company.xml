<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_cost_center_entry_company" model="ir.rule">
        <field name="name">cost_center.entry: own company only</field>
        <field name="model_id" ref="model_cost_center_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_cost_center_item_company" model="ir.rule">
        <field name="name">cost_center.item: own company only</field>
        <field name="model_id" ref="model_cost_center_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
