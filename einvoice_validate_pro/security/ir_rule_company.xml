<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_einvoice_check_company" model="ir.rule">
        <field name="name">einvoice.check: own company only</field>
        <field name="model_id" ref="model_einvoice_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_einvoice_issue_company" model="ir.rule">
        <field name="name">einvoice.issue: own company only</field>
        <field name="model_id" ref="model_einvoice_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
