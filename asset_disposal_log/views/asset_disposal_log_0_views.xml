<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_disposal_log_list" model="ir.ui.view">
        <field name="name">asset.disposal.log.list</field>
        <field name="model">asset.disposal.log</field>
        <field name="arch" type="xml">
            <list string="Asset Disposals" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="asset_ref"/>
                <field name="asset_name"/>
                <field name="asset_category"/>
                <field name="disposal_method"/>
                <field name="disposal_date"/>
                <field name="residual_value"/>
                <field name="state" widget="badge"/>
                <field name="approver_id"/>
            </list>
        </field>
    </record>

    <record id="view_asset_disposal_log_form" model="ir.ui.view">
        <field name="name">asset.disposal.log.form</field>
        <field name="model">asset.disposal.log</field>
        <field name="arch" type="xml">
            <form string="Asset Disposals">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_dispose" type="object" string="Mark Disposed" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('disposed', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,disposed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Asset">
    <field name="name"/>
    <field name="asset_ref"/>
    <field name="asset_name"/>
    <field name="asset_category"/>
    <field name="company_id"/>
                        </group>
                        <group string="Disposal">
    <field name="disposal_method"/>
    <field name="disposal_date"/>
    <field name="acquisition_value"/>
    <field name="residual_value"/>
    <field name="requester_id"/>
    <field name="approver_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason" name="reason">
                            <field name="reason"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_disposal_log_search" model="ir.ui.view">
        <field name="name">asset.disposal.log.search</field>
        <field name="model">asset.disposal.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_ref"/>
                <field name="asset_name"/>
                <field name="requester_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="disposed" string="Disposed" domain="[('state','=','disposed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_asset_category" string="Category" context="{'group_by': 'asset_category'}"/>
                <filter name="group_disposal_method" string="Disposal Method" context="{'group_by': 'disposal_method'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_asset_disposal_log_graph" model="ir.ui.view">
        <field name="name">asset.disposal.log.graph</field>
        <field name="model">asset.disposal.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_asset_disposal_log" model="ir.actions.act_window">
        <field name="name">Asset Disposals</field>
        <field name="res_model">asset.disposal.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Document asset disposal requests and approvals.</p>
        </field>
    </record>

</odoo>
