<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_advance_list" model="ir.ui.view">
        <field name="name">employee.advance.list</field>
        <field name="model">employee.advance</field>
        <field name="arch" type="xml">
            <list string="Employee Advances" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="state" widget="badge"/>
                <field name="amount_requested" sum="Total Amount Requested"/>
                <field name="amount_approved" sum="Total Amount Approved"/>
                <field name="amount_cleared" sum="Total Amount Cleared"/>
                <field name="amount_outstanding" sum="Total Amount Outstanding"/>
                <field name="date_request"/>
                <field name="date_paid"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_employee_advance_form" model="ir.ui.view">
        <field name="name">employee.advance.form</field>
        <field name="model">employee.advance</field>
        <field name="arch" type="xml">
            <form string="Employee Advances">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_pay" type="object" string="Mark Paid" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state in ('paid','partial','cleared','cancelled')"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,paid,partial,cleared"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Advance">
    <field name="name"/>
    <field name="employee_id"/>
    <field name="department_id"/>
    <field name="purpose"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Amounts">
    <field name="currency_id"/>
    <field name="amount_requested"/>
    <field name="amount_approved"/>
    <field name="amount_cleared"/>
    <field name="amount_outstanding"/>
                        </group>
                        <group string="Dates">
    <field name="date_request"/>
    <field name="date_paid"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clearings" name="clearingids">
                            <field name="clearing_ids" readonly="state in ('draft','approved','cancelled','cleared')">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="clearing_type"/>
                            <field name="amount" sum="Cleared"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="note"/>
                            <field name="company_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_advance_search" model="ir.ui.view">
        <field name="name">employee.advance.search</field>
        <field name="model">employee.advance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="purpose"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <filter name="partial" string="Partially Cleared" domain="[('state','=','partial')]"/>
                <filter name="cleared" string="Cleared" domain="[('state','=','cleared')]"/>
                <filter name="outstanding" string="Outstanding" domain="[('state','in',('paid','partial'))]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_employee_advance" model="ir.actions.act_window">
        <field name="name">Employee Advances</field>
        <field name="res_model">employee.advance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register employee cash advances and track their clearing until the balance is zero.</p>
        </field>
    </record>

</odoo>
