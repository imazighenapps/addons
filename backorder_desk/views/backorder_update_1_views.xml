<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_backorder_update_list" model="ir.ui.view">
        <field name="name">backorder.update.list</field>
        <field name="model">backorder.update</field>
        <field name="arch" type="xml">
            <list string="Backorder Updates">
                <field name="update_date"/>
                <field name="case_id"/>
                <field name="partner_id"/>
                <field name="new_promised_date"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_backorder_update_form" model="ir.ui.view">
        <field name="name">backorder.update.form</field>
        <field name="model">backorder.update</field>
        <field name="arch" type="xml">
            <form string="Backorder Updates">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Update">
    <field name="name"/>
    <field name="case_id"/>
    <field name="partner_id"/>
    <field name="update_date"/>
    <field name="company_id"/>
                        </group>
                        <group string="Promise">
    <field name="new_promised_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message" name="message">
                            <field name="message"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_backorder_update_search" model="ir.ui.view">
        <field name="name">backorder.update.search</field>
        <field name="model">backorder.update</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="case_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="group_case" string="Case" context="{'group_by': 'case_id'}"/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_backorder_update_kanban" model="ir.ui.view">
        <field name="name">backorder.update.kanban</field>
        <field name="model">backorder.update</field>
        <field name="arch" type="xml">
            <kanban default_group_by="case_id" sample="1">
                <field name="case_id"/>
                <field name="name"/>
                <field name="update_date"/>
                <field name="new_promised_date"/>
                <field name="partner_id"/>
                <templates>
                    <t t-name="card">
                        <field name="case_id" class="fw-bold"/>
                        <field name="name"/>
                        <field name="update_date"/>
                        <field name="new_promised_date"/>
                        <field name="partner_id"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_backorder_update" model="ir.actions.act_window">
        <field name="name">Backorder Updates</field>
        <field name="res_model">backorder.update</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">A dated log of every message and promise change sent for a shortage.</p>
        </field>
    </record>

</odoo>
