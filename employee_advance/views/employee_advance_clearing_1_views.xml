<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_advance_clearing_list" model="ir.ui.view">
        <field name="name">employee.advance.clearing.list</field>
        <field name="model">employee.advance.clearing</field>
        <field name="arch" type="xml">
            <list string="Advance Clearings">
                <field name="advance_id"/>
                <field name="date"/>
                <field name="clearing_type"/>
                <field name="amount" sum="Total Amount"/>
                <field name="note"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_employee_advance_clearing_form" model="ir.ui.view">
        <field name="name">employee.advance.clearing.form</field>
        <field name="model">employee.advance.clearing</field>
        <field name="arch" type="xml">
            <form string="Advance Clearings">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="advance_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Clearing">
    <field name="advance_id"/>
    <field name="date"/>
    <field name="clearing_type"/>
    <field name="amount"/>
    <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_advance_clearing_search" model="ir.ui.view">
        <field name="name">employee.advance.clearing.search</field>
        <field name="model">employee.advance.clearing</field>
        <field name="arch" type="xml">
            <search>
                <field name="advance_id"/>
                <field name="note"/>
                <filter name="expense" string="Expense" domain="[('clearing_type','=','expense')]"/>
                <filter name="return" string="Cash Return" domain="[('clearing_type','=','return')]"/>
                <separator/>
                <filter name="group_type" string="Type" context="{'group_by': 'clearing_type'}"/>
                <filter name="group_advance" string="Advance" context="{'group_by': 'advance_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_employee_advance_clearing" model="ir.actions.act_window">
        <field name="name">Advance Clearings</field>
        <field name="res_model">employee.advance.clearing</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">All clearing lines recorded against employee advances.</p>
        </field>
    </record>

</odoo>
