<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_employee_advance_company" model="ir.rule">
        <field name="name">employee.advance: own company only</field>
        <field name="model_id" ref="model_employee_advance"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_employee_advance_clearing_company" model="ir.rule">
        <field name="name">employee.advance.clearing: own company only</field>
        <field name="model_id" ref="model_employee_advance_clearing"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
