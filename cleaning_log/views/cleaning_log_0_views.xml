<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cleaning_log_list" model="ir.ui.view">
        <field name="name">cleaning.log.list</field>
        <field name="model">cleaning.log</field>
        <field name="arch" type="xml">
            <list string="Cleaning Tasks" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date_planned"/>
                <field name="area"/>
                <field name="task"/>
                <field name="responsible_id"/>
                <field name="date_done"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cleaning_log_form" model="ir.ui.view">
        <field name="name">cleaning.log.form</field>
        <field name="model">cleaning.log</field>
        <field name="arch" type="xml">
            <form string="Cleaning Tasks">
                <header>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_missed" type="object" string="Mark Missed" class="btn-secondary" invisible="state != 'planned'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state in ('done','cancelled')"/>
                    <button name="action_reset" type="object" string="Reset to Planned" class="btn-link" invisible="state == 'planned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done,missed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Task">
    <field name="name"/>
    <field name="area"/>
    <field name="task"/>
    <field name="responsible_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Schedule">
    <field name="date_planned"/>
    <field name="date_done"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cleaning_log_search" model="ir.ui.view">
        <field name="name">cleaning.log.search</field>
        <field name="model">cleaning.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="area"/>
                <field name="task"/>
                <field name="responsible_id"/>
                <filter name="planned" string="Planned" domain="[('state','=','planned')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="missed" string="Missed" domain="[('state','=','missed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_area" string="Area" context="{'group_by': 'area'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_cleaning_log" model="ir.actions.act_window">
        <field name="name">Cleaning Tasks</field>
        <field name="res_model">cleaning.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log and track cleaning and sanitation tasks.</p>
        </field>
    </record>

</odoo>
