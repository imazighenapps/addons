<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_permit_to_entry_company" model="ir.rule">
        <field name="name">permit_to.entry: own company only</field>
        <field name="model_id" ref="model_permit_to_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_permit_to_item_company" model="ir.rule">
        <field name="name">permit_to.item: own company only</field>
        <field name="model_id" ref="model_permit_to_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
