<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_customer_tier_entry_company" model="ir.rule">
        <field name="name">customer_tier.entry: own company only</field>
        <field name="model_id" ref="model_customer_tier_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_customer_tier_item_company" model="ir.rule">
        <field name="name">customer_tier.item: own company only</field>
        <field name="model_id" ref="model_customer_tier_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
