<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wst_collection_list" model="ir.ui.view">
        <field name="name">wst.collection.list</field>
        <field name="model">wst.collection</field>
        <field name="arch" type="xml">
            <list string="Collection Log" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="collected_on"/>
                <field name="name"/>
                <field name="stream_id"/>
                <field name="quantity"/>
                <field name="unit_name"/>
                <field name="contractor_ref"/>
                <field name="receipt_no"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_wst_collection_form" model="ir.ui.view">
        <field name="name">wst.collection.form</field>
        <field name="model">wst.collection</field>
        <field name="arch" type="xml">
            <form string="Collection Log">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Collection">
    <field name="name"/>
    <field name="stream_id"/>
    <field name="collected_on"/>
    <field name="quantity"/>
    <field name="unit_name"/>
    <field name="company_id"/>
                        </group>
                        <group string="Receipt">
    <field name="contractor_ref"/>
    <field name="receipt_no"/>
    <field name="filed_on"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_wst_collection_search" model="ir.ui.view">
        <field name="name">wst.collection.search</field>
        <field name="model">wst.collection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="stream_id"/>
                <field name="contractor_ref"/>
                <field name="receipt_no"/>
                <filter name="pending" string="Receipt Pending" domain="[('state', 'in', ('planned', 'collected'))]"/>
                <filter name="filed" string="Filed" domain="[('state', '=', 'filed')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_stream" string="Stream" context="{'group_by': 'stream_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_wst_collection_kanban" model="ir.ui.view">
        <field name="name">wst.collection.kanban</field>
        <field name="model">wst.collection</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="stream_id"/>
                <field name="collected_on"/>
                <field name="quantity"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="stream_id"/>
                        <field name="collected_on"/>
                        <field name="quantity"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_wst_collection" model="ir.actions.act_window">
        <field name="name">Collection Log</field>
        <field name="res_model">wst.collection</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every waste collection with its dated receipt.</p>
        </field>
    </record>

</odoo>
