<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mail_waiting_list" model="ir.ui.view">
        <field name="name">mail.item.list</field>
        <field name="model">mail.item</field>
        <field name="arch" type="xml">
            <list string="Pickup Status">
                <field name="logged_on"/>
                <field name="name"/>
                <field name="direction"/>
                <field name="partner_name"/>
                <field name="tracking_number"/>
            </list>
        </field>
    </record>

    <record id="view_mail_waiting_form" model="ir.ui.view">
        <field name="name">mail.item.form</field>
        <field name="model">mail.item</field>
        <field name="arch" type="xml">
            <form string="Pickup Status">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Mail">
    <field name="name"/>
    <field name="direction"/>
    <field name="partner_name"/>
    <field name="tracking_number"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Follow Up">
    <field name="logged_on"/>
    <field name="state"/>
    <field name="collected_on"/>
    <field name="collected_by"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mail_waiting_search" model="ir.ui.view">
        <field name="name">mail.item.search</field>
        <field name="model">mail.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_name"/>
                <field name="tracking_number"/>
                <separator/>
                <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
            </search>
        </field>
    </record>

    <record id="action_mail_waiting" model="ir.actions.act_window">
        <field name="name">Pickup Status</field>
        <field name="res_model">mail.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registered mail still waiting to be collected.</p>
        </field>
    </record>

</odoo>
