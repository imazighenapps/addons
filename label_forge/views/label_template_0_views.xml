<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_label_template_list" model="ir.ui.view">
        <field name="name">label.template.list</field>
        <field name="model">label.template</field>
        <field name="arch" type="xml">
            <list string="Label Templates">
                <field name="name"/>
                <field name="code"/>
                <field name="label_type"/>
                <field name="width_mm"/>
                <field name="height_mm"/>
                <field name="job_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_label_template_form" model="ir.ui.view">
        <field name="name">label.template.form</field>
        <field name="model">label.template</field>
        <field name="arch" type="xml">
            <form string="Label Templates">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Template">
    <field name="name"/>
    <field name="code"/>
    <field name="label_type"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Size">
    <field name="width_mm"/>
    <field name="height_mm"/>
                        </group>
                        <group string="Counters">
    <field name="job_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="content"/>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_label_template_search" model="ir.ui.view">
        <field name="name">label.template.search</field>
        <field name="model">label.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="group_label_type" string="Label Type" context="{'group_by': 'label_type'}"/>
            </search>
        </field>
    </record>

    <record id="view_label_template_kanban" model="ir.ui.view">
        <field name="name">label.template.kanban</field>
        <field name="model">label.template</field>
        <field name="arch" type="xml">
            <kanban default_group_by="label_type" sample="1">
                <field name="label_type"/>
                <field name="name"/>
                <field name="code"/>
                <field name="width_mm"/>
                <field name="height_mm"/>
                <field name="job_count"/>
                <templates>
                    <t t-name="card">
                        <field name="label_type" class="fw-bold"/>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="width_mm"/>
                        <field name="height_mm"/>
                        <field name="job_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_label_template" model="ir.actions.act_window">
        <field name="name">Label Templates</field>
        <field name="res_model">label.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Design consistent label templates for your warehouse.</p>
        </field>
    </record>

</odoo>
