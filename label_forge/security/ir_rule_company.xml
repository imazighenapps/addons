<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_label_template_company" model="ir.rule">
        <field name="name">label.template: own company only</field>
        <field name="model_id" ref="model_label_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_label_job_company" model="ir.rule">
        <field name="name">label.job: own company only</field>
        <field name="model_id" ref="model_label_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
