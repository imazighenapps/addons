<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_shopify_connection_company" model="ir.rule">
        <field name="name">shopify.connection: own company only</field>
        <field name="model_id" ref="model_shopify_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_shopify_record_company" model="ir.rule">
        <field name="name">shopify.record: own company only</field>
        <field name="model_id" ref="model_shopify_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
