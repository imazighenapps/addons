<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_subs_plan_list" model="ir.ui.view">
        <field name="name">subs.plan.list</field>
        <field name="model">subs.plan</field>
        <field name="arch" type="xml">
            <list string="Plans">
                <field name="sequence"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="interval"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_subs_plan_form" model="ir.ui.view">
        <field name="name">subs.plan.form</field>
        <field name="model">subs.plan</field>
        <field name="arch" type="xml">
            <form string="Plans">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Plan">
    <field name="name"/>
    <field name="product_id"/>
    <field name="amount"/>
    <field name="currency_id"/>
    <field name="interval"/>
    <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subs_plan_search" model="ir.ui.view">
        <field name="name">subs.plan.search</field>
        <field name="model">subs.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <separator/>
                <filter name="group_interval" string="Period" context="{'group_by': 'interval'}"/>
            </search>
        </field>
    </record>

    <record id="action_subs_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">subs.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define what you sell every month, quarter or year.</p>
        </field>
    </record>

</odoo>
