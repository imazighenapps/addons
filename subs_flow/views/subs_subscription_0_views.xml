<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_subs_subscription_list" model="ir.ui.view">
        <field name="name">subs.subscription.list</field>
        <field name="model">subs.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="date_start"/>
                <field name="date_next_invoice"/>
                <field name="amount" sum="Total Amount"/>
                <field name="mrr" sum="Total Mrr"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_subs_subscription_form" model="ir.ui.view">
        <field name="name">subs.subscription.form</field>
        <field name="model">subs.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscriptions">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_pause" type="object" string="Pause" class="btn-secondary" invisible="state != 'running'"/>
                    <button name="action_resume" type="object" string="Resume" class="btn-primary" invisible="state != 'paused'"/>
                    <button name="action_invoice_now" type="object" string="Invoice Now" class="btn-primary" invisible="state == 'closed'"/>
                    <button name="action_close" type="object" string="Close" class="btn-link" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,paused,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Customer">
    <field name="partner_id"/>
    <field name="plan_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Billing">
    <field name="amount"/>
    <field name="currency_id"/>
    <field name="interval"/>
    <field name="date_start"/>
    <field name="date_next_invoice"/>
    <field name="mrr"/>
    <field name="arr"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoices" name="invoiceids">
                            <field name="invoice_ids" readonly="1"><list><field name="name"/><field name="invoice_date"/><field name="amount_total" sum="Total"/><field name="state" widget="badge"/></list></field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_subs_subscription_search" model="ir.ui.view">
        <field name="name">subs.subscription.search</field>
        <field name="model">subs.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="running" string="Running" domain="[('state','=','running')]"/>
                <filter name="paused" string="Paused" domain="[('state','=','paused')]"/>
                <filter name="due" string="To Invoice" domain="[('state','=','running'),('date_next_invoice','&lt;=',context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_subs_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">subs.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a subscription and let Odoo invoice it every period.</p>
        </field>
    </record>

</odoo>
