<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cash_count_log_list" model="ir.ui.view">
        <field name="name">cash.count.log.list</field>
        <field name="model">cash.count.log</field>
        <field name="arch" type="xml">
            <list string="Cash Counts" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="count_date"/>
                <field name="location"/>
                <field name="counter_id"/>
                <field name="expected_amount"/>
                <field name="counted_amount"/>
                <field name="difference"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cash_count_log_form" model="ir.ui.view">
        <field name="name">cash.count.log.form</field>
        <field name="model">cash.count.log</field>
        <field name="arch" type="xml">
            <form string="Cash Counts">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Count">
    <field name="name"/>
    <field name="count_date"/>
    <field name="location"/>
    <field name="counter_id"/>
    <field name="reviewer_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amounts">
    <field name="currency_id"/>
    <field name="expected_amount"/>
    <field name="counted_amount"/>
    <field name="difference"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cash_count_log_search" model="ir.ui.view">
        <field name="name">cash.count.log.search</field>
        <field name="model">cash.count.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location"/>
                <field name="counter_id"/>
                <field name="reviewer_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="validated" string="Validated" domain="[('state','=','validated')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_counter" string="Counted By" context="{'group_by': 'counter_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_cash_count_log_graph" model="ir.ui.view">
        <field name="name">cash.count.log.graph</field>
        <field name="model">cash.count.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="difference" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_cash_count_log" model="ir.actions.act_window">
        <field name="name">Cash Counts</field>
        <field name="res_model">cash.count.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record and reconcile cash counts.</p>
        </field>
    </record>

</odoo>
