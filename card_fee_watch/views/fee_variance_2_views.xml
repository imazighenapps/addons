<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fee_variance_list" model="ir.ui.view">
        <field name="name">fee.line.list</field>
        <field name="model">fee.line</field>
        <field name="arch" type="xml">
            <list string="Variance Report" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="billed_on"/>
                <field name="contract_id"/>
                <field name="settled_amount"/>
                <field name="expected_fee"/>
                <field name="charged_fee"/>
                <field name="variance_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fee_variance_form" model="ir.ui.view">
        <field name="name">fee.line.form</field>
        <field name="model">fee.line</field>
        <field name="arch" type="xml">
            <form string="Variance Report">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Fee">
    <field name="name"/>
    <field name="contract_id"/>
    <field name="billed_on"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amounts">
    <field name="settled_amount"/>
    <field name="charged_fee"/>
    <field name="expected_fee"/>
    <field name="variance_amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Resolution">
    <field name="state"/>
    <field name="recovered_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fee_variance_search" model="ir.ui.view">
        <field name="name">fee.line.search</field>
        <field name="model">fee.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contract_id"/>
                <separator/>
                <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_fee_variance" model="ir.actions.act_window">
        <field name="name">Variance Report</field>
        <field name="res_model">fee.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every billed fee that differs from the signed contract.</p>
        </field>
    </record>

</odoo>
