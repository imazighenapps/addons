<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduflow_level_list" model="ir.ui.view">
        <field name="name">eduflow.level.list</field>
        <field name="model">eduflow.level</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="cycle"/>
            </list>
        </field>
    </record>

    <record id="view_eduflow_level_form" model="ir.ui.view">
        <field name="name">eduflow.level.form</field>
        <field name="model">eduflow.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="cycle"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eduflow_level" model="ir.actions.act_window">
        <field name="name">Levelx</field>
        <field name="res_model">eduflow.level</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
