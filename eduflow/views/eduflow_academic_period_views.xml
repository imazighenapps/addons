<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduflow_academic_period_list" model="ir.ui.view">
        <field name="name">eduflow.academic.period.list</field>
        <field name="model">eduflow.academic.period</field>
        <field name="arch" type="xml">
            <list>
                <field name="year_id"/>
                <field name="name"/>
                <field name="type"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="view_eduflow_academic_period_form" model="ir.ui.view">
        <field name="name">eduflow.academic.period.form</field>
        <field name="model">eduflow.academic.period</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="year_id"/>
                        <field name="name"/>
                        <field name="type"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eduflow_academic_period" model="ir.actions.act_window">
        <field name="name">Academic Periods</field>
        <field name="res_model">eduflow.academic.period</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
