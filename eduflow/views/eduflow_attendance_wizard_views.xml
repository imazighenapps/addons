<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduflow_attendance_wizard_form" model="ir.ui.view">
        <field name="name">eduflow.attendance.wizard.form</field>
        <field name="model">eduflow.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Faire l'appel">
                <group>
                    <group>
                        <field name="classroom_id"/>
                        <field name="session_id"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="notify_absentees"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="student_id" readonly="1"/>
                        <field name="state" widget="radio" options="{'horizontal': true}"/>
                        <field name="reason"/>
                        <field name="attendance_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_validate" string="Valider l'appel" type="object"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eduflow_attendance_wizard" model="ir.actions.act_window">
        <field name="name">Faire l'appel</field>
        <field name="res_model">eduflow.attendance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
