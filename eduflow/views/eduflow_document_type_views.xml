<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduflow_document_type_list" model="ir.ui.view">
        <field name="name">eduflow.document.type.list</field>
        <field name="model">eduflow.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="level_id"/>
                <field name="required"/>
            </list>
        </field>
    </record>

    <record id="action_eduflow_document_type" model="ir.actions.act_window">
        <field name="name">Admission Document Types</field>
        <field name="res_model">eduflow.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
