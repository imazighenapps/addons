<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduflow_academic_year_list" model="ir.ui.view">
        <field name="name">eduflow.academic.year.list</field>
        <field name="model">eduflow.academic.year</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" decoration-success="state == 'open'" decoration-muted="state == 'close'"/>
                <field name="active_year" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_eduflow_academic_year_form" model="ir.ui.view">
        <field name="name">eduflow.academic.year.form</field>
        <field name="model">eduflow.academic.year</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" string="Ouvrir" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'open'"/>
                    <button name="action_set_draft" string="Repasser en brouillon" type="object"
                            invisible="state != 'close'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,close"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex: 2026/2027"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="active_year"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Academic Periods">
                            <field name="period_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="sequence" widget="handle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eduflow_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">eduflow.academic.year</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
