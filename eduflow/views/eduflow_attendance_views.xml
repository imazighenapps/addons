<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduflow_attendance_list" model="ir.ui.view">
        <field name="name">eduflow.attendance.list</field>
        <field name="model">eduflow.attendance</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="state == 'absent'"
                  decoration-warning="state == 'late'">
                <field name="date"/>
                <field name="classroom_id"/>
                <field name="student_id"/>
                <field name="state"/>
                <field name="reason"/>
                <field name="notified_parent"/>
            </list>
        </field>
    </record>

    <record id="view_eduflow_attendance_search" model="ir.ui.view">
        <field name="name">eduflow.attendance.search</field>
        <field name="model">eduflow.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="classroom_id"/>
                <filter string="Absents" name="absent" domain="[('state','=','absent')]"/>
                <filter string="Lates" name="late" domain="[('state','=','late')]"/>
                <group>
                    <filter string="Class" name="group_classroom" context="{'group_by':'classroom_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_eduflow_attendance_form" model="ir.ui.view">
        <field name="name">eduflow.attendance.form</field>
        <field name="model">eduflow.attendance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_notify_parent" string="Notifier le responsable" type="object"
                            invisible="notified_parent or state == 'present'" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="classroom_id"/>
                            <field name="session_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="reason"/>
                            <field name="justification_document" widget="binary"/>
                            <field name="notified_parent" readonly="1"/>
                        </group>
                    </group>
                    <field name="comment" placeholder="Comment..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_eduflow_attendance_pivot" model="ir.ui.view">
        <field name="name">eduflow.attendance.pivot</field>
        <field name="model">eduflow.attendance</field>
        <field name="arch" type="xml">
            <pivot string="Attendance">
                <field name="classroom_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="state" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_eduflow_attendance_graph" model="ir.ui.view">
        <field name="name">eduflow.attendance.graph</field>
        <field name="model">eduflow.attendance</field>
        <field name="arch" type="xml">
            <graph string="Attendance by class" type="bar">
                <field name="classroom_id" type="row"/>
                <field name="state" type="col"/>
            </graph>
        </field>
    </record>

    <record id="action_eduflow_attendance" model="ir.actions.act_window">
        <field name="name">Attendance Records</field>
        <field name="res_model">eduflow.attendance</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_eduflow_attendance_search"/>
    </record>
</odoo>
