<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduflow_subject_list" model="ir.ui.view">
        <field name="name">eduflow.subject.list</field>
        <field name="model">eduflow.subject</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="level_id"/>
                <field name="coefficient"/>
                <field name="hours"/>
                <field name="teacher_id"/>
            </list>
        </field>
    </record>

    <record id="view_eduflow_subject_form" model="ir.ui.view">
        <field name="name">eduflow.subject.form</field>
        <field name="model">eduflow.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="level_id"/>
                        </group>
                        <group>
                            <field name="coefficient"/>
                            <field name="hours"/>
                            <field name="teacher_id"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eduflow_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">eduflow.subject</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
