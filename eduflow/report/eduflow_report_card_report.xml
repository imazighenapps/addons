<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_eduflow_report_card" model="ir.actions.report">
        <field name="name">Report Card</field>
        <field name="model">eduflow.report.card</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eduflow.report_card_document</field>
        <field name="report_file">eduflow.report_card_document</field>
        <field name="print_report_name">'Report Card - %s - %s' % (object.student_id.display_name, object.period_id.name)</field>
        <field name="binding_model_id" ref="model_eduflow_report_card"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_eduflow_payment_receipt" model="ir.actions.report">
        <field name="name">Payment Receipt</field>
        <field name="model">eduflow.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eduflow.payment_receipt_document</field>
        <field name="report_file">eduflow.payment_receipt_document</field>
        <field name="print_report_name">'Recu - %s' % object.name</field>
        <field name="binding_model_id" ref="model_eduflow_payment"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
