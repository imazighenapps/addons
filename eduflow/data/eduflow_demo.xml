<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Academic Year -->
    <record id="demo_year_2026" model="eduflow.academic.year">
        <field name="name">2026/2027</field>
        <field name="date_start">2026-09-01</field>
        <field name="date_end">2027-06-30</field>
        <field name="state">open</field>
        <field name="active_year">True</field>
    </record>

    <record id="demo_period_t1" model="eduflow.academic.period">
        <field name="name">Trimester 1</field>
        <field name="year_id" ref="demo_year_2026"/>
        <field name="date_start">2026-09-01</field>
        <field name="date_end">2026-12-20</field>
        <field name="sequence">10</field>
    </record>

    <!-- Levelx -->
    <record id="demo_level_primary" model="eduflow.level">
        <field name="name">Primary</field>
        <field name="cycle">primary</field>
        <field name="sequence">10</field>
    </record>

    <!-- Class -->
    <record id="demo_classroom_1a" model="eduflow.classroom">
        <field name="name">1st Year A</field>
        <field name="year_id" ref="demo_year_2026"/>
        <field name="level_id" ref="demo_level_primary"/>
        <field name="capacity">30</field>
    </record>

    <!-- Subjects -->
    <record id="demo_subject_math" model="eduflow.subject">
        <field name="code">MATH</field>
        <field name="name">Mathematics</field>
        <field name="coefficient">4</field>
        <field name="level_id" ref="demo_level_primary"/>
    </record>

    <record id="demo_subject_french" model="eduflow.subject">
        <field name="code">FR</field>
        <field name="name">French</field>
        <field name="coefficient">3</field>
        <field name="level_id" ref="demo_level_primary"/>
    </record>

    <!-- Teacher -->
    <record id="demo_teacher_1" model="eduflow.teacher">
        <field name="name">Nadia Kaci</field>
        <field name="specialty">Mathematics</field>
        <field name="email">nadia.kaci@example.com</field>
    </record>

    <!-- Parent -->
    <record id="demo_parent_1" model="eduflow.parent">
        <field name="name">Ahmed Benali</field>
        <field name="phone">+213 555 00 00 00</field>
        <field name="email">ahmed.benali@example.com</field>
    </record>

    <!-- Student -->
    <record id="demo_student_1" model="eduflow.student">
        <field name="firstname">Yasmine</field>
        <field name="name">Benali</field>
        <field name="birth_date">2018-04-12</field>
        <field name="gender">f</field>
        <field name="status">active</field>
    </record>

    <record id="demo_student_parent_rel_1" model="eduflow.student.parent.rel">
        <field name="student_id" ref="demo_student_1"/>
        <field name="parent_id" ref="demo_parent_1"/>
        <field name="relation">father</field>
        <field name="is_primary">True</field>
        <field name="is_financial">True</field>
    </record>

    <!-- Enrollment -->
    <record id="demo_enrollment_1" model="eduflow.enrollment">
        <field name="student_id" ref="demo_student_1"/>
        <field name="year_id" ref="demo_year_2026"/>
        <field name="level_id" ref="demo_level_primary"/>
        <field name="classroom_id" ref="demo_classroom_1a"/>
        <field name="state">active</field>
    </record>

    <!-- Fees -->
    <record id="demo_fee_type_tuition" model="eduflow.fee.type">
        <field name="name">Tuition</field>
        <field name="amount">60000</field>
    </record>

    <record id="demo_fee_1" model="eduflow.fee">
        <field name="student_id" ref="demo_student_1"/>
        <field name="fee_type_id" ref="demo_fee_type_tuition"/>
        <field name="year_id" ref="demo_year_2026"/>
        <field name="installment_name">Due 1/3</field>
        <field name="amount">20000</field>
        <field name="due_date">2026-10-15</field>
    </record>

</odoo>
