<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_eduflow" model="ir.module.category">
        <field name="name">EduFlow - School Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_eduflow_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="category_id" ref="module_category_eduflow"/>
    </record>

    <record id="group_eduflow_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="category_id" ref="module_category_eduflow"/>
    </record>

    <record id="group_eduflow_administration" model="res.groups">
        <field name="name">Administration scolaire</field>
        <field name="category_id" ref="module_category_eduflow"/>
        <field name="implied_ids" eval="[(4, ref('group_eduflow_accountant'))]"/>
    </record>

    <record id="group_eduflow_direction" model="res.groups">
        <field name="name">Management</field>
        <field name="category_id" ref="module_category_eduflow"/>
    </record>

    <record id="group_eduflow_admin" model="res.groups">
        <field name="name">System Administrator</field>
        <field name="category_id" ref="module_category_eduflow"/>
        <field name="implied_ids" eval="[(4, ref('group_eduflow_administration')),
                                          (4, ref('group_eduflow_direction')),
                                          (4, ref('group_eduflow_teacher'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_eduflow_parent_portal" model="res.groups">
        <field name="name">Parent (portail)</field>
        <field name="category_id" ref="module_category_eduflow"/>
    </record>
</odoo>
