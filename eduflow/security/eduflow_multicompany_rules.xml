<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- F4.1: standard multi-company rules: every transactional model
         (student, enrollment, exam, grade, attendance, fee, payment,
         timetable, teacher, subject, admission, program, report card...)
         is only visible/editable for the companies the current user has
         access to. No group_id set => applies globally, on top of the
         functional (portal/teacher) rules already defined in
         eduflow_record_rules.xml. -->

    <record id="rule_multicompany_student" model="ir.rule">
        <field name="name">eduflow.student: multi-company</field>
        <field name="model_id" ref="model_eduflow_student"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

