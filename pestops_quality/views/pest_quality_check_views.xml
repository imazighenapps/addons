<odoo>
    <record id="view_pest_quality_check_list" model="ir.ui.view">
        <field name="name">pest.quality.check.list</field>
        <field name="model">pest.quality.check</field>
        <field name="arch" type="xml">
            <list decoration-danger="result == 'non_compliant'" decoration-success="result == 'compliant'">
                <field name="name"/>
                <field name="visit_id"/>
                <field name="site_id"/>
                <field name="procedure_id"/>
                <field name="checklist_id"/>
                <field name="technician_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="result"/>
                <field name="nonconformity_count"/>
                <field name="open_nonconformity_count"/>
            </list>
        </field>
    </record>
    <record id="view_pest_quality_check_form" model="ir.ui.view">
        <field name="name">pest.quality.check.form</field>
        <field name="model">pest.quality.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_complete" type="object" string="Complete Check" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_view_nonconformities" type="object" string="Non-Conformities" invisible="not nonconformity_count"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="visit_id" readonly="1"/>
                            <field name="site_id" readonly="1"/>
                            <field name="technician_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="procedure_id" readonly="state == 'done'"/>
                            <field name="checklist_id" readonly="state == 'done'" domain="[('procedure_id', '=', procedure_id), ('active', '=', True)]"/>
                            <field name="date"/>
                            <field name="result" readonly="1"/>
                            <field name="nonconformity_count" readonly="1"/>
                            <field name="open_nonconformity_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist Responses">
                            <field name="line_ids">
                                <list editable="bottom" create="false">
                                    <field name="sequence" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="question" readonly="1"/>
                                    <field name="response_type" readonly="1"/>
                                    <field name="mandatory" readonly="1"/>
                                    <field name="response"/>
                                    <field name="text_value"/>
                                    <field name="numeric_value"/>
                                    <field name="passed" readonly="1"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Non-Conformities">
                            <field name="nonconformity_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="severity"/>
                                    <field name="state"/>
                                    <field name="responsible_user_id"/>
                                    <field name="due_date"/>
                                    <field name="action_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_pest_quality_check_line_form" model="ir.ui.view">
        <field name="name">pest.quality.check.line.form</field>
        <field name="model">pest.quality.check.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="check_id"/>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="question"/>
                        <field name="response_type"/>
                        <field name="mandatory"/>
                        <field name="failure_severity"/>
                        <field name="response"/>
                        <field name="numeric_value"/>
                        <field name="text_value"/>
                        <field name="passed"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_pest_quality_checks" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">pest.quality.check</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_in_progress': 1}</field>
    </record>

    <record id="view_pest_quality_check_search" model="ir.ui.view">
        <field name="name">pest.quality.check.search</field>
        <field name="model">pest.quality.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="visit_id"/>
                <field name="site_id"/>
                <field name="procedure_id"/>
                <field name="technician_id"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'done')]"/>
                <filter name="non_compliant" string="Non-Compliant" domain="[('result', '=', 'non_compliant')]"/>
                <filter name="open_nc" string="Open Non-Conformities" domain="[('open_nonconformity_count', '>', 0)]"/>
                <group>
                    <filter name="group_procedure" string="Procedure" context="{'group_by': 'procedure_id'}"/>
                    <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_technician" string="Technician" context="{'group_by': 'technician_id'}"/>
                    <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
