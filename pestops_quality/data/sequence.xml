<odoo>
    <record id="seq_pest_quality_check" model="ir.sequence">
        <field name="name">PestOps Quality Check</field>
        <field name="code">pest.quality.check</field>
        <field name="prefix">QC/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_pest_quality_nonconformity" model="ir.sequence">
        <field name="name">PestOps Quality Non-Conformity</field>
        <field name="code">pest.quality.nonconformity</field>
        <field name="prefix">NCR/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_pest_quality_action" model="ir.sequence">
        <field name="name">PestOps Quality Action</field>
        <field name="code">pest.quality.action</field>
        <field name="prefix">CAPA/</field>
        <field name="padding">5</field>
    </record>
</odoo>
