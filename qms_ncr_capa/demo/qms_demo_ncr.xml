        <field name="action_description">Install tool-life counters and alerts on CNC machines.</field>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="status">in_progress</field>
    </record>
    <record id="demo_cost" model="qms.quality.cost">
        <field name="name">Scrap batch B-DEMO-01</field>
        <field name="date">2026-09-10</field>
        <field name="cost_type">internal_failure</field>
        <field name="amount">4250.0</field>
    </record>
</odoo>
