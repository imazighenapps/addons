<odoo>
    <record id="demo_ncr" model="qms.ncr">
        <field name="name">Nonconforming batch B-DEMO-01</field>
        <field name="source">process</field>
        <field name="severity">major</field>
        <field name="description">Batch out of tolerance on diameter.</field>
        <field name="containment">Batch quarantined in MRB area.</field>
        <field name="root_cause">Worn cutting tool not replaced per schedule.</field>
        <field name="status">action</field>
    </record>
    <record id="demo_capa" model="qms.capa">
        <field name="name">Implement tool-life monitoring (Demo)</field>
