<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_cross_dock_entry_company" model="ir.rule">
        <field name="name">cross_dock.entry: own company only</field>
        <field name="model_id" ref="model_cross_dock_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_cross_dock_item_company" model="ir.rule">
        <field name="name">cross_dock.item: own company only</field>
        <field name="model_id" ref="model_cross_dock_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
