<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_staff_award_log_list" model="ir.ui.view">
        <field name="name">staff.award.log.list</field>
        <field name="model">staff.award.log</field>
        <field name="arch" type="xml">
            <list string="Staff Awards" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="award_type"/>
                <field name="award_date"/>
                <field name="awarded_by_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_staff_award_log_form" model="ir.ui.view">
        <field name="name">staff.award.log.form</field>
        <field name="model">staff.award.log</field>
        <field name="arch" type="xml">
            <form string="Staff Awards">
                <header>
                    <button name="action_announce" type="object" string="Announce" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,announced,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Award">
    <field name="name"/>
    <field name="employee_id"/>
    <field name="award_type"/>
    <field name="award_date"/>
    <field name="awarded_by_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Details">
    <field name="value_note"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason" name="reason">
                            <field name="reason"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_staff_award_log_search" model="ir.ui.view">
        <field name="name">staff.award.log.search</field>
        <field name="model">staff.award.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="awarded_by_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="announced" string="Announced" domain="[('state','=','announced')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'award_type'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_staff_award_log_graph" model="ir.ui.view">
        <field name="name">staff.award.log.graph</field>
        <field name="model">staff.award.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="award_type"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_staff_award_log" model="ir.actions.act_window">
        <field name="name">Staff Awards</field>
        <field name="res_model">staff.award.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record and track employee recognitions and awards.</p>
        </field>
    </record>

</odoo>
