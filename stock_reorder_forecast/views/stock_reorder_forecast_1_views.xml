<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_reorder_forecast_form" model="ir.ui.view">
        <field name="name">stock.reorder.forecast.form</field>
        <field name="model">stock.reorder.forecast</field>
        <field name="arch" type="xml">
            <form string="Run Forecast">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="location_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Window">
    <field name="lookback_days"/>
    <field name="horizon_days"/>
                        </group>
                        <group string="Scope">
    <field name="location_id"/>
    <field name="category_id"/>
    <field name="only_needed"/>
    <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <footer><button name="action_run" type="object" string="Run" class="btn-primary"/><button string="Cancel" class="btn-secondary" special="cancel"/></footer>
            </form>
        </field>
    </record>

    <record id="action_stock_reorder_forecast" model="ir.actions.act_window">
        <field name="name">Run Forecast</field>
        <field name="res_model">stock.reorder.forecast</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Compute suggestions from consumption and stock levels.</p>
        </field>
    </record>

</odoo>
