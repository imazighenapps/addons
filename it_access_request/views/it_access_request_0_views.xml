<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_access_request_list" model="ir.ui.view">
        <field name="name">it.access.request.list</field>
        <field name="model">it.access.request</field>
        <field name="arch" type="xml">
            <list string="Access Requests" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="system_name"/>
                <field name="access_type"/>
                <field name="date_request"/>
                <field name="date_needed"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_it_access_request_form" model="ir.ui.view">
        <field name="name">it.access.request.form</field>
        <field name="model">it.access.request</field>
        <field name="arch" type="xml">
            <form string="Access Requests">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-secondary" invisible="state != 'submitted'"/>
                    <button name="action_grant" type="object" string="Mark Granted" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_revoke" type="object" string="Revoke" class="btn-secondary" invisible="state != 'granted'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state in ('draft','submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,granted,revoked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Request">
    <field name="name"/>
    <field name="requester_id"/>
    <field name="employee_id"/>
    <field name="department_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Access">
    <field name="system_name"/>
    <field name="access_type"/>
    <field name="date_request"/>
    <field name="date_needed"/>
                        </group>
                        <group string="Fulfillment">
    <field name="date_granted"/>
    <field name="date_revoked"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Justification" name="justification">
                            <field name="justification"/>
                        </page>
                        <page string="Reviewer Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_it_access_request_search" model="ir.ui.view">
        <field name="name">it.access.request.search</field>
        <field name="model">it.access.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="employee_id"/>
                <field name="system_name"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="refused" string="Refused" domain="[('state','=','refused')]"/>
                <filter name="granted" string="Granted" domain="[('state','=','granted')]"/>
                <filter name="revoked" string="Revoked" domain="[('state','=','revoked')]"/>
                <separator/>
                <filter name="group_requester" string="Requester" context="{'group_by': 'requester_id'}"/>
                <filter name="group_system" string="System" context="{'group_by': 'system_name'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_it_access_request" model="ir.actions.act_window">
        <field name="name">Access Requests</field>
        <field name="res_model">it.access.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Submit and track IT access requests.</p>
        </field>
    </record>

</odoo>
