<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_dhl_express_connection_company" model="ir.rule">
        <field name="name">dhl_express.connection: own company only</field>
        <field name="model_id" ref="model_dhl_express_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_dhl_express_record_company" model="ir.rule">
        <field name="name">dhl_express.record: own company only</field>
        <field name="model_id" ref="model_dhl_express_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
