<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_commission_user" model="res.groups">
        <field name="name">Commission User</field>
        <field name="comment">View commission lines and statements.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_commission_manager" model="res.groups">
        <field name="name">Commission Manager</field>
        <field name="comment">Configure rules, approve and pay statements.</field>
        <field name="implied_ids" eval="[(4, ref('commission_desk.group_commission_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
