<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_credit_limit_entry_company" model="ir.rule">
        <field name="name">credit_limit.entry: own company only</field>
        <field name="model_id" ref="model_credit_limit_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_credit_limit_item_company" model="ir.rule">
        <field name="name">credit_limit.item: own company only</field>
        <field name="model_id" ref="model_credit_limit_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
