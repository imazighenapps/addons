<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_backorder_promise_entry_company" model="ir.rule">
        <field name="name">backorder_promise.entry: own company only</field>
        <field name="model_id" ref="model_backorder_promise_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_backorder_promise_item_company" model="ir.rule">
        <field name="name">backorder_promise.item: own company only</field>
        <field name="model_id" ref="model_backorder_promise_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
