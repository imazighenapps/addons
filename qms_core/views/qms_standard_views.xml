<odoo>
    <record id="view_qms_standard_list" model="ir.ui.view">
        <field name="name">qms.standard.list</field>
        <field name="model">qms.standard</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="version"/>
                <field name="edition"/>
                <field name="standard_family"/>
                <field name="lifecycle_status" widget="badge"/>
                <field name="issuing_body"/>
                <field name="is_certifiable"/>
                <field name="clause_count"/>
                <field name="requirement_count"/>
                <field name="publication_date"/>
                <field name="effective_date"/>
                <field name="review_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_qms_standard_form" model="ir.ui.view">
        <field name="name">qms.standard.form</field>
        <field name="model">qms.standard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" invisible="active" class="btn-primary"/>
                    <button name="action_set_current" type="object" string="Set Current" class="btn-primary" invisible="lifecycle_status == 'current' or not active"/>
                    <button name="action_supersede" type="object" string="Supersede" invisible="lifecycle_status == 'superseded'"/>
                    <button name="action_archive" type="object" string="Archive" invisible="not active"/>
                    <field name="lifecycle_status" widget="statusbar" statusbar_visible="draft,current,superseded,withdrawn"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="Overview" col="4">
                        <field name="code"/>
                        <field name="version"/>
                        <field name="edition"/>
                        <field name="standard_family"/>
                        <field name="is_certifiable"/>
                        <field name="issuing_body"/>
                        <field name="publication_date"/>
                        <field name="effective_date"/>
                        <field name="review_date"/>
                        <field name="clause_count" readonly="1"/>
                        <field name="requirement_count" readonly="1"/>
                        <field name="source_url" widget="url"/>
                        <field name="supersedes_id"/>
                        <field name="transition_due_date"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Scope &amp; Notes">
                            <field name="description" widget="html"/>
                            <field name="transition_note"/>
                        </page>
                        <page string="Clauses">
                            <field name="clause_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="parent_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Requirements">
                            <field name="requirement_ids" mode="list">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="implementation_status"/>
                                    <field name="compliance_state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_qms_standard_search" model="ir.ui.view">
        <field name="name">qms.standard.search</field>
        <field name="model">qms.standard</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="version"/>
                <field name="edition"/>
                <field name="standard_family"/>
                <field name="lifecycle_status"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="current" string="Current Editions" domain="[('lifecycle_status', '=', 'current')]"/>
                <group>
                    <filter name="group_family" string="Standard Family" context="{'group_by': 'standard_family'}"/>
                    <filter name="group_lifecycle" string="Lifecycle" context="{'group_by': 'lifecycle_status'}"/>
                    <filter name="group_issuing_body" string="Issuing Body" context="{'group_by': 'issuing_body'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_qms_standard" model="ir.actions.act_window">
        <field name="name">Standards</field>
        <field name="res_model">qms.standard</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qms_standard_search"/>
    </record>
</odoo>
