<odoo>
    <record id="view_qms_control_list" model="ir.ui.view">
        <field name="name">qms.control.list</field>
        <field name="model">qms.control</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="process_id"/>
                <field name="control_type"/>
                <field name="frequency"/>
                <field name="owner_id"/>
                <field name="evidence_expected"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_qms_control_form" model="ir.ui.view">
        <field name="name">qms.control.form</field>
        <field name="model">qms.control</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="code" readonly="1"/>
                    <field name="process_id"/>
                    <field name="control_type"/>
                    <field name="frequency"/>
                    <field name="owner_id"/>
                    <field name="evidence_expected"/>
                    <field name="active"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <notebook>
                        <page string="Control Definition">
                            <field name="description"/>
                            <separator string="Expected Operation"/>
                            <field name="operation"/>
                        </page>
                        <page string="Traceability">
                            <field name="requirement_ids" widget="many2many_tags"/>
                            <field name="risk_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_qms_control_search" model="ir.ui.view">
        <field name="name">qms.control.search</field>
        <field name="model">qms.control</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="process_id"/>
                <field name="owner_id"/>
                <filter name="evidence" string="Evidence Required" domain="[('evidence_expected', '=', True)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'control_type'}"/>
                    <filter name="group_frequency" string="Frequency" context="{'group_by': 'frequency'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_qms_control" model="ir.actions.act_window">
        <field name="name">Controls</field>
        <field name="res_model">qms.control</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qms_control_search"/>
    </record>
</odoo>
