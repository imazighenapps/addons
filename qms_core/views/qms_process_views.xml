<odoo>
    <record id="view_qms_process_list" model="ir.ui.view">
        <field name="name">qms.process.list</field>
        <field name="model">qms.process</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="requirement_count"/>
                <field name="risk_count"/>
                <field name="control_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_qms_process_form" model="ir.ui.view">
        <field name="name">qms.process.form</field>
        <field name="model">qms.process</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="code"/>
                    <field name="owner_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="sequence"/>
                    <field name="active"/>
                    <group string="Linked Requirements">
                        <field name="requirement_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Purpose">
                            <field name="objective"/>
                            <field name="input_description"/>
                            <field name="output_description"/>
                        </page>
                        <page string="Risks &amp; Controls">
                            <field name="risk_ids" widget="many2many_tags"/>
                            <field name="control_ids">
                                <list editable="bottom">
                                    <field name="code" readonly="1"/>
                                    <field name="name"/>
                                    <field name="control_type"/>
                                    <field name="frequency"/>
                                    <field name="evidence_expected"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_qms_process_search" model="ir.ui.view">
        <field name="name">qms.process.search</field>
        <field name="model">qms.process</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="owner_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <group>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_qms_process" model="ir.actions.act_window">
        <field name="name">Processes</field>
        <field name="res_model">qms.process</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qms_process_search"/>
    </record>
</odoo>
