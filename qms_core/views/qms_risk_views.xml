<odoo>
    <record id="view_qms_risk_list" model="ir.ui.view">
        <field name="name">qms.risk.list</field>
        <field name="model">qms.risk</field>
        <field name="arch" type="xml">
            <list decoration-danger="inherent_level == 'critical'" decoration-warning="inherent_level == 'high'" decoration-success="inherent_level == 'low'">
                <field name="code"/>
                <field name="name"/>
                <field name="process_id"/>
                <field name="category"/>
                <field name="likelihood"/>
                <field name="impact"/>
                <field name="inherent_score"/>
                <field name="inherent_level" widget="badge"/>
                <field name="residual_score"/>
                <field name="residual_level" widget="badge"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_qms_risk_form" model="ir.ui.view">
        <field name="name">qms.risk.form</field>
        <field name="model">qms.risk</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="identified,assessed,treated,accepted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="code" readonly="1"/>
                    <field name="process_id"/>
                    <field name="category"/>
                    <field name="owner_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="treatment_due_date"/>
                    <group string="Risk Description">
                        <field name="description"/>
                    </group>
                    <group string="Linked Requirements">
                        <field name="requirement_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Inherent Risk">
                            <field name="likelihood"/>
                            <field name="impact"/>
                            <field name="inherent_score" readonly="1"/>
                            <field name="inherent_level" readonly="1"/>
                        </page>
                        <page string="Controls &amp; Residual Risk">
                            <field name="control_ids" widget="many2many_tags"/>
                            <field name="residual_likelihood"/>
                            <field name="residual_impact"/>
                            <field name="residual_score" readonly="1"/>
                            <field name="residual_level" readonly="1"/>
                            <field name="treatment"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_qms_risk_search" model="ir.ui.view">
        <field name="name">qms.risk.search</field>
        <field name="model">qms.risk</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="process_id"/>
                <field name="owner_id"/>
                <filter name="critical" string="Critical" domain="[('residual_level', '=', 'critical')]"/>
                <filter name="high" string="High" domain="[('residual_level', '=', 'high')]"/>
                <group>
                    <filter name="group_process" string="Process" context="{'group_by': 'process_id'}"/>
                    <filter name="group_level" string="Level" context="{'group_by': 'residual_level'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_qms_risk" model="ir.actions.act_window">
        <field name="name">Risks</field>
        <field name="res_model">qms.risk</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qms_risk_search"/>
    </record>
</odoo>
