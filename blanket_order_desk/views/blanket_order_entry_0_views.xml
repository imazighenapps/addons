<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_blanket_order_entry_list" model="ir.ui.view">
        <field name="name">blanket_order.entry.list</field>
        <field name="model">blanket_order.entry</field>
        <field name="arch" type="xml">
            <list string="BlanketDesk" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date_start"/>
                <field name="partner_id"/>
                <field name="responsible_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_blanket_order_entry_form" model="ir.ui.view">
        <field name="name">blanket_order.entry.form</field>
        <field name="model">blanket_order.entry</field>
        <field name="arch" type="xml">
            <form string="BlanketDesk">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('done','cancelled')"/>
                    <button name="action_draft" type="object" string="Reset to Draft" class="btn-secondary" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Details">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="responsible_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Schedule">
    <field name="date_start"/>
    <field name="date_end"/>
    <field name="amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Status">
    <field name="state"/>
    <field name="active"/>
    <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lineids">
                            <field name="line_ids"/>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_blanket_order_entry_search" model="ir.ui.view">
        <field name="name">blanket_order.entry.search</field>
        <field name="model">blanket_order.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="responsible_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_blanket_order_entry_kanban" model="ir.ui.view">
        <field name="name">blanket_order.entry.kanban</field>
        <field name="model">blanket_order.entry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="date_start"/>
                        <field name="partner_id"/>
                        <field name="amount"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_blanket_order_entry" model="ir.actions.act_window">
        <field name="name">BlanketDesk</field>
        <field name="res_model">blanket_order.entry</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Manage framework orders with scheduled call-offs and always know the quantity and value still to release.</p>
        </field>
    </record>

</odoo>
