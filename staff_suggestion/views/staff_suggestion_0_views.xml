<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_staff_suggestion_list" model="ir.ui.view">
        <field name="name">staff.suggestion.list</field>
        <field name="model">staff.suggestion</field>
        <field name="arch" type="xml">
            <list string="Suggestions" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="submitter_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date"/>
                <field name="category"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_staff_suggestion_form" model="ir.ui.view">
        <field name="name">staff.suggestion.form</field>
        <field name="model">staff.suggestion</field>
        <field name="arch" type="xml">
            <form string="Suggestions">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Start Review" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_accept" type="object" string="Accept" class="btn-primary" invisible="state != 'under_review'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state != 'under_review'"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'accepted'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state in ('draft','submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,accepted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Suggestion">
    <field name="name"/>
    <field name="submitter_id"/>
    <field name="employee_id"/>
    <field name="department_id"/>
    <field name="date"/>
    <field name="category"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Expected Benefit" name="expectedbenefit">
                            <field name="expected_benefit"/>
                        </page>
                        <page string="Reviewer Notes" name="reviewernote">
                            <field name="reviewer_note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_staff_suggestion_search" model="ir.ui.view">
        <field name="name">staff.suggestion.search</field>
        <field name="model">staff.suggestion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="submitter_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="under_review" string="Under Review" domain="[('state','=','under_review')]"/>
                <filter name="accepted" string="Accepted" domain="[('state','=','accepted')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_staff_suggestion" model="ir.actions.act_window">
        <field name="name">Suggestions</field>
        <field name="res_model">staff.suggestion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Collect and review employee suggestions.</p>
        </field>
    </record>

</odoo>
