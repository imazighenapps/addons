<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_staffsuggest_user" model="res.groups">
        <field name="name">Staff Suggestion User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_staffsuggest_manager" model="res.groups">
        <field name="name">Staff Suggestion Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('staff_suggestion.group_staffsuggest_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
