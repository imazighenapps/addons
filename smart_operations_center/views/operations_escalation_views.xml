<odoo>
    <record id="view_operations_escalation_list" model="ir.ui.view">
        <field name="name">smart.operations.escalation.list</field>
        <field name="model">smart.operations.escalation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="first_delay_hours"/>
                <field name="first_user_id"/>
                <field name="second_delay_hours"/>
                <field name="second_user_id"/>
                <field name="notify_activity"/>
            </list>
        </field>
    </record>
    <record id="view_operations_escalation_form" model="ir.ui.view">
        <field name="name">smart.operations.escalation.form</field>
        <field name="model">smart.operations.escalation</field>
        <field name="arch" type="xml">
            <form string="Escalation Policy">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="notify_activity"/>
                    </group>
                    <group string="First Escalation">
                        <field name="first_delay_hours"/>
                        <field name="first_user_id"/>
                    </group>
                    <group string="Second Escalation">
                        <field name="second_delay_hours"/>
                        <field name="second_user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_operations_escalations" model="ir.actions.act_window">
        <field name="name">Escalation Policies</field>
        <field name="res_model">smart.operations.escalation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
