<odoo>
    <record id="view_operations_rule_list" model="ir.ui.view"><field name="name">smart.operations.rule.list</field><field name="model">smart.operations.rule</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="active" widget="boolean_toggle"/><field name="model_id"/><field name="rule_issue_type"/><field name="severity"/><field name="responsible_id"/><field name="action_create_activity"/></list></field></record>
    <record id="view_operations_rule_form" model="ir.ui.view"><field name="name">smart.operations.rule.form</field><field name="model">smart.operations.rule</field><field name="arch" type="xml"><form string="Monitoring Rule"><sheet><group><group><field name="name"/><field name="active"/><field name="sequence"/><field name="model_id"/></group><group><field name="rule_issue_type"/><field name="severity"/><field name="risk_weight"/><field name="responsible_id"/></group></group><group><field name="domain" placeholder="[('state', '=', 'purchase')]" widget="text"/><field name="description"/></group><group string="Actions"><field name="action_create_activity"/><field name="action_email"/><field name="escalation_policy_id"/><field name="max_records_per_run"/></group></sheet></form></field></record>
    <record id="action_operations_rules" model="ir.actions.act_window"><field name="name">Monitoring Rules</field><field name="res_model">smart.operations.rule</field><field name="view_mode">list,form</field></record>
</odoo>
