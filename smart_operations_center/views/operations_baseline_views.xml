<odoo>
    <record id="view_operations_baseline_list" model="ir.ui.view">
        <field name="name">smart.operations.baseline.list</field>
        <field name="model">smart.operations.baseline</field>
        <field name="arch" type="xml">
            <list>
                <field name="process_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="sample_count"/>
                <field name="average_days"/>
                <field name="median_days"/>
                <field name="p75_days"/>
                <field name="p90_days"/>
                <field name="current_days"/>
                <field name="deviation_percent"/>
                <field name="health" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_operations_baseline_form" model="ir.ui.view">
        <field name="name">smart.operations.baseline.form</field>
        <field name="model">smart.operations.baseline</field>
        <field name="arch" type="xml">
            <form string="Process Baseline">
                <sheet>
                    <group>
                        <field name="process_id"/>
                        <field name="period_start"/>
                        <field name="period_end"/>
                        <field name="sample_count"/>
                    </group>
                    <group string="Historical Performance">
                        <field name="average_days"/>
                        <field name="median_days"/>
                        <field name="p75_days"/>
                        <field name="p90_days"/>
                        <field name="minimum_days"/>
                        <field name="maximum_days"/>
                    </group>
                    <group string="Current Performance">
                        <field name="current_days"/>
                        <field name="deviation_percent"/>
                        <field name="health" widget="badge"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_operations_baselines" model="ir.actions.act_window">
        <field name="name">Process Baselines</field>
        <field name="res_model">smart.operations.baseline</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
