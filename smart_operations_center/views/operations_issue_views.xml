<odoo>
    <record id="view_operations_issue_list" model="ir.ui.view"><field name="name">smart.operations.issue.list</field><field name="model">smart.operations.issue</field><field name="arch" type="xml"><list decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-success="state == 'resolved'"><field name="name"/><field name="issue_type"/><field name="severity" widget="badge"/><field name="state" widget="badge"/><field name="root_reference"/><field name="responsible_id"/><field name="risk_score"/><field name="business_impact"/><field name="delay_days"/><field name="detected_at"/></list></field></record>
    <record id="view_operations_issue_form" model="ir.ui.view"><field name="name">smart.operations.issue.form</field><field name="model">smart.operations.issue</field><field name="arch" type="xml"><form string="Operational Issue"><header><button name="action_investigate" type="object" string="Investigate" class="btn-primary" invisible="state in ('resolved','ignored')"/><button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state == 'resolved'"/><button name="action_mark_action_required" type="object" string="Action Required" invisible="state in ('resolved','ignored')"/><button name="action_snooze" type="object" string="Snooze" invisible="state in ('resolved','ignored')"/><button name="action_ignore" type="object" string="Ignore" invisible="state in ('resolved','ignored')"/><field name="state" widget="statusbar" statusbar_visible="new,investigating,action_required,escalated,resolved"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="issue_type"/><field name="severity"/><field name="risk_score"/><field name="responsible_id"/><field name="company_id"/></group><group><field name="root_reference"/><field name="root_cause_reference"/><field name="process_id"/><field name="rule_id"/><field name="detected_at"/><field name="due_date"/><field name="delay_days"/></group></group><notebook><page string="Business Impact"><group><field name="business_impact"/><field name="affected_customer_count"/><field name="affected_order_count"/><field name="affected_delivery_count"/><field name="affected_manufacturing_count"/><field name="affected_purchase_count"/><field name="affected_quantity"/></group><field name="impact_summary"/><field name="impact_path" widget="text"/><field name="impact_ids" readonly="1"><list><field name="relation_type"/><field name="model_id"/><field name="res_id"/><field name="quantity"/><field name="monetary_value"/></list></field></page><page string="Risk Analysis"><field name="risk_explanation"/></page><page string="Resolution"><field name="resolution_reason"/><field name="resolution_notes"/><field name="resolved_at"/><field name="resolution_duration_hours"/></page><page string="Actions"><field name="action_ids"><list editable="bottom"><field name="name"/><field name="action_type"/><field name="responsible_id"/><field name="due_date"/><field name="state"/><button name="action_complete" type="object" icon="fa-check" invisible="state != 'pending'"/></list></field></page><page string="Chatter"><field name="message_follower_ids" widget="mail_followers"/><field name="activity_ids" widget="mail_activity"/><field name="message_ids" widget="mail_thread"/></page></notebook></sheet></form></field></record>
    <record id="view_operations_issue_search" model="ir.ui.view"><field name="name">smart.operations.issue.search</field><field name="model">smart.operations.issue</field><field name="arch" type="xml"><search><field name="name"/><field name="root_reference"/><field name="responsible_id"/><field name="issue_type"/><field name="severity"/><field name="state"/><field name="company_id"/><filter name="critical" string="Critical" domain="[('severity','=','critical'),('state','not in',('resolved','ignored'))]"/><filter name="open" string="Open" domain="[('state','not in',('resolved','ignored'))]"/><filter name="high_impact" string="High Impact" domain="[('business_impact','>',10000)]"/><separator/><filter name="group_severity" string="Severity" context="{'group_by':'severity'}"/><filter name="group_state" string="State" context="{'group_by':'state'}"/><filter name="group_issue_type" string="Issue Type" context="{'group_by':'issue_type'}"/><filter name="group_responsible" string="Responsible" context="{'group_by':'responsible_id'}"/></search></field></record>
    <record id="action_operations_issues" model="ir.actions.act_window"><field name="name">Operational Issues</field><field name="res_model">smart.operations.issue</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_operations_issue_search"/></record>
</odoo>
