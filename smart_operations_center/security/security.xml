<odoo>
    <record id="group_operations_user" model="res.groups">
        <field name="name">Operations Center User</field>
    </record>
    <record id="group_operations_manager" model="res.groups">
        <field name="name">Operations Center Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_operations_user'))]"/>
    </record>
    <record id="group_operations_admin" model="res.groups">
        <field name="name">Operations Center Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_operations_manager'))]"/>
    </record>
    <record id="rule_issue_company" model="ir.rule">
        <field name="name">Operations issues: company</field>
        <field name="model_id" ref="model_smart_operations_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_operations_user'))]"/>
    </record>
</odoo>
