<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_policy_acknowledgement_list" model="ir.ui.view">
        <field name="name">policy.acknowledgement.list</field>
        <field name="model">policy.acknowledgement</field>
        <field name="arch" type="xml">
            <list string="Acknowledgements" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="policy_id"/>
                <field name="employee_id"/>
                <field name="date_ack"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_policy_acknowledgement_form" model="ir.ui.view">
        <field name="name">policy.acknowledgement.form</field>
        <field name="model">policy.acknowledgement</field>
        <field name="arch" type="xml">
            <form string="Acknowledgements">
                <header>
                    <button name="action_acknowledge" type="object" string="Mark Acknowledged" class="btn-primary" invisible="state == 'acknowledged'"/>
                    <button name="action_reset" type="object" string="Reset to Pending" class="btn-link" invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,acknowledged"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="policy_id" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Acknowledgement">
    <field name="policy_id"/>
    <field name="employee_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Details">
    <field name="date_ack"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_policy_acknowledgement_search" model="ir.ui.view">
        <field name="name">policy.acknowledgement.search</field>
        <field name="model">policy.acknowledgement</field>
        <field name="arch" type="xml">
            <search>
                <field name="policy_id"/>
                <field name="employee_id"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="acknowledged" string="Acknowledged" domain="[('state','=','acknowledged')]"/>
                <separator/>
                <filter name="group_policy" string="Policy" context="{'group_by': 'policy_id'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_policy_acknowledgement" model="ir.actions.act_window">
        <field name="name">Acknowledgements</field>
        <field name="res_model">policy.acknowledgement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track employee acknowledgements of company policies.</p>
        </field>
    </record>

</odoo>
