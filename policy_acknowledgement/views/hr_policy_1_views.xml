<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_policy_list" model="ir.ui.view">
        <field name="name">hr.policy.list</field>
        <field name="model">hr.policy</field>
        <field name="arch" type="xml">
            <list string="Policies">
                <field name="name"/>
                <field name="version"/>
                <field name="date_effective"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hr_policy_form" model="ir.ui.view">
        <field name="name">hr.policy.form</field>
        <field name="model">hr.policy</field>
        <field name="arch" type="xml">
            <form string="Policies">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Policy">
    <field name="name"/>
    <field name="version"/>
    <field name="date_effective"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_policy_search" model="ir.ui.view">
        <field name="name">hr.policy.search</field>
        <field name="model">hr.policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="version"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_policy" model="ir.actions.act_window">
        <field name="name">Policies</field>
        <field name="res_model">hr.policy</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define company policies to be acknowledged.</p>
        </field>
    </record>

</odoo>
