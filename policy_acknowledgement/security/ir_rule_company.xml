<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hr_policy_company" model="ir.rule">
        <field name="name">hr.policy: own company only</field>
        <field name="model_id" ref="model_hr_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_policy_acknowledgement_company" model="ir.rule">
        <field name="name">policy.acknowledgement: own company only</field>
        <field name="model_id" ref="model_policy_acknowledgement"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
