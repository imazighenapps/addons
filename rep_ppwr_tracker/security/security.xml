<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_rep_user" model="res.groups">
        <field name="name">REP User</field>
        <field name="comment">Work on packaging sheets, ledger and declarations.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rep_manager" model="res.groups">
        <field name="name">REP Manager</field>
        <field name="comment">Full administration of materials, tariffs and declarations.</field>
        <field name="implied_ids" eval="[(4, ref('rep_ppwr_tracker.group_rep_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
