<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_rep" model="ir.ui.view">
        <field name="name">product.template.rep</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="REP Packaging" name="rep_packaging">
                    <field name="rep_packaging_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_picking_rep" model="ir.ui.view">
        <field name="name">stock.picking.rep</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_rep_generate" string="Generate REP Lines" type="object"/>
            </xpath>
        </field>
    </record>
</odoo>
