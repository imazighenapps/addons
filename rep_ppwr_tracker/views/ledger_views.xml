<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rep_ledger_list" model="ir.ui.view">
        <field name="name">rep.ledger.list</field>
        <field name="model">rep.ledger</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="packaging_id"/>
                <field name="weight_kg"/>
                <field name="amount"/>
                <field name="source"/>
                <field name="origin"/>
            </list>
        </field>
    </record>
    <record id="view_rep_ledger_form" model="ir.ui.view">
        <field name="name">rep.ledger.form</field>
        <field name="model">rep.ledger</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <field name="date"/>
                        <field name="company_id"/>
                        <field name="country_id"/>
                        <field name="packaging_id"/>
                        <field name="weight_kg"/>
                        <field name="tariff_id"/>
                        <field name="amount"/>
                        <field name="source"/>
                        <field name="state"/>
                        <field name="origin"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rep_ledger" model="ir.actions.act_window">
        <field name="name">Packaging Ledger</field>
        <field name="res_model">rep.ledger</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
