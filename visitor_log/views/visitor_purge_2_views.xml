<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_visitor_purge_form" model="ir.ui.view">
        <field name="name">visitor.purge.wizard.form</field>
        <field name="model">visitor.purge.wizard</field>
        <field name="arch" type="xml">
            <form string="Purge Register">
                <sheet>
                    <group>
                        <group string="Purge">
    <field name="name"/>
    <field name="date_limit"/>
                        </group>
                    </group>
                </sheet>
                <footer><button name="action_purge" type="object" string="Purge" class="btn-primary"/><button special="cancel" string="Cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>

    <record id="action_visitor_purge" model="ir.actions.act_window">
        <field name="name">Purge Register</field>
        <field name="res_model">visitor.purge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
