<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_visitor_host_list" model="ir.ui.view">
        <field name="name">visitor.log.list</field>
        <field name="model">visitor.log</field>
        <field name="arch" type="xml">
            <list string="Hosts" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="host_id"/>
                <field name="visitor_name"/>
                <field name="company_name"/>
                <field name="purpose"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_visitor_host_form" model="ir.ui.view">
        <field name="name">visitor.log.form</field>
        <field name="model">visitor.log</field>
        <field name="arch" type="xml">
            <form string="Hosts">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="visitor_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Host">
    <field name="host_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Visitor">
    <field name="company_name"/>
    <field name="phone"/>
    <field name="email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_visitor_host_search" model="ir.ui.view">
        <field name="name">visitor.log.search</field>
        <field name="model">visitor.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="visitor_name"/>
                <field name="host_id"/>
                <filter name="on_site" string="On Site" domain="[('state','=','on_site')]"/>
                <separator/>
                <filter name="group_host" string="Host" context="{'group_by': 'host_id'}"/>
                <filter name="group_purpose" string="Purpose" context="{'group_by': 'purpose'}"/>
            </search>
        </field>
    </record>

    <record id="action_visitor_host" model="ir.actions.act_window">
        <field name="name">Hosts</field>
        <field name="res_model">visitor.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Who is expected, who is still inside, grouped by the employee who hosts the visitor.</p>
        </field>
    </record>

</odoo>
