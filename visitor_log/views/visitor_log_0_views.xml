<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_visitor_log_list" model="ir.ui.view">
        <field name="name">visitor.log.list</field>
        <field name="model">visitor.log</field>
        <field name="arch" type="xml">
            <list string="Visitors" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="visitor_name"/>
                <field name="company_name"/>
                <field name="host_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="state" widget="badge"/>
                <field name="duration_hours"/>
            </list>
        </field>
    </record>

    <record id="view_visitor_log_form" model="ir.ui.view">
        <field name="name">visitor.log.form</field>
        <field name="model">visitor.log</field>
        <field name="arch" type="xml">
            <form string="Visitors">
                <header>
                    <button name="action_check_in" type="object" string="Check in" class="btn-primary" invisible="state == 'on_site'"/>
                    <button name="action_check_out" type="object" string="Check out" class="btn-primary" invisible="state != 'on_site'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('checked_out', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="expected,on_site,checked_out,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="visitor_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Visitor">
    <field name="name"/>
    <field name="company_name"/>
    <field name="phone"/>
    <field name="email"/>
    <field name="badge"/>
                        </group>
                        <group string="Host">
    <field name="host_id"/>
    <field name="purpose"/>
    <field name="company_id"/>
                        </group>
                        <group string="Visit">
    <field name="check_in"/>
    <field name="check_out"/>
    <field name="duration_hours"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_visitor_log_search" model="ir.ui.view">
        <field name="name">visitor.log.search</field>
        <field name="model">visitor.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="visitor_name"/>
                <field name="company_name"/>
                <field name="phone"/>
                <field name="badge"/>
                <filter name="on_site" string="On Site" domain="[('state','=','on_site')]"/>
                <filter name="checked_out" string="Checked Out" domain="[('state','=','checked_out')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_host" string="Host" context="{'group_by': 'host_id'}"/>
                <filter name="group_purpose" string="Purpose" context="{'group_by': 'purpose'}"/>
            </search>
        </field>
    </record>

    <record id="view_visitor_log_kanban" model="ir.ui.view">
        <field name="name">visitor.log.kanban</field>
        <field name="model">visitor.log</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="visitor_name"/>
                <field name="company_name"/>
                <field name="host_id"/>
                <field name="check_in"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="visitor_name"/>
                        <field name="company_name"/>
                        <field name="host_id"/>
                        <field name="check_in"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_visitor_log" model="ir.actions.act_window">
        <field name="name">Visitors</field>
        <field name="res_model">visitor.log</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sign a visitor in, hand over a badge, then check them out and the duration is computed for you.</p>
        </field>
    </record>

</odoo>
