<odoo>
    <record id="view_pest_analytics_company_kpi_form" model="ir.ui.view">
        <field name="name">pest.analytics.company.kpi.form</field>
        <field name="model">pest.analytics.company.kpi</field>
        <field name="arch" type="xml">
            <form string="Executive KPI" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="company_id"/></h1>
                    </div>
                    <group string="Operations">
                        <group>
                            <field name="active_site_count"/>
                            <field name="active_contract_count"/>
                            <field name="visits_next_7d"/>
                            <field name="visits_done_30d"/>
                            <field name="late_visit_count"/>
                        </group>
                        <group>
                            <field name="open_anomaly_count"/>
                            <field name="critical_anomaly_count"/>
                            <field name="open_reservice_count"/>
                            <field name="open_quality_nc_count"/>
                            <field name="critical_quality_nc_count"/>
                        </group>
                    </group>
                    <group string="Resources">
                        <group>
                            <field name="stock_alert_count"/>
                            <field name="stock_consumption_30d_qty"/>
                        </group>
                        <group>
                            <field name="equipment_due_count"/>
                            <field name="maintenance_cost_30d" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                    <group string="Billing">
                        <field name="billing_to_invoice_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="invoiced_30d_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pest_analytics_company_kpi_list" model="ir.ui.view">
        <field name="name">pest.analytics.company.kpi.list</field>
        <field name="model">pest.analytics.company.kpi</field>
        <field name="arch" type="xml">
            <list string="Executive KPIs" create="0" edit="0" delete="0">
                <field name="company_id"/>
                <field name="active_site_count"/>
                <field name="active_contract_count"/>
                <field name="visits_next_7d"/>
                <field name="visits_done_30d"/>
                <field name="late_visit_count"/>
                <field name="open_anomaly_count"/>
                <field name="open_quality_nc_count"/>
                <field name="stock_alert_count"/>
                <field name="equipment_due_count"/>
                <field name="billing_to_invoice_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="invoiced_30d_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pest_analytics_visit_list" model="ir.ui.view">
        <field name="name">pest.analytics.visit.report.list</field>
        <field name="model">pest.analytics.visit.report</field>
        <field name="arch" type="xml">
            <list string="Visit Analytics" create="0" edit="0" delete="0">
                <field name="period_date"/>
                <field name="visit_id"/>
                <field name="company_id"/>
                <field name="site_id"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="technician_id"/>
                <field name="state"/>
                <field name="completion_outcome"/>
                <field name="duration_hours" sum="Hours"/>
                <field name="inspection_count" sum="Inspections"/>
                <field name="treatment_count" sum="Treatments"/>
                <field name="anomaly_count" sum="Anomalies"/>
                <field name="open_anomaly_count" sum="Open Anomalies"/>
                <field name="reservice_count" sum="Re-Services"/>
                <field name="quality_check_count" sum="Quality Checks"/>
                <field name="stock_consumption_qty" sum="Consumed"/>
                <field name="billable_amount" widget="monetary" sum="Billable" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pest_analytics_visit_pivot" model="ir.ui.view">
        <field name="name">pest.analytics.visit.report.pivot</field>
        <field name="model">pest.analytics.visit.report</field>
        <field name="arch" type="xml">
            <pivot string="Visit Analytics">
                <field name="period_date" type="row" interval="month"/>
                <field name="technician_id" type="row"/>
                <field name="site_id" type="col"/>
                <field name="duration_hours" type="measure"/>
                <field name="inspection_count" type="measure"/>
                <field name="treatment_count" type="measure"/>
                <field name="anomaly_count" type="measure"/>
                <field name="reservice_count" type="measure"/>
                <field name="stock_consumption_qty" type="measure"/>
                <field name="billable_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pest_analytics_visit_graph" model="ir.ui.view">
        <field name="name">pest.analytics.visit.report.graph</field>
        <field name="model">pest.analytics.visit.report</field>
        <field name="arch" type="xml">
            <graph string="Visits by Month" type="bar">
                <field name="period_date" interval="month"/>
                <field name="visit_id" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_pest_analytics_site_list" model="ir.ui.view">
        <field name="name">pest.analytics.site.kpi.list</field>
        <field name="model">pest.analytics.site.kpi</field>
        <field name="arch" type="xml">
            <list string="Site Performance" create="0" edit="0" delete="0">
                <field name="site_id"/>
                <field name="partner_id"/>
                <field name="site_type"/>
                <field name="risk_level_id"/>
                <field name="visit_count" sum="Visits"/>
                <field name="done_visit_count" sum="Done"/>
                <field name="late_visit_count" sum="Late"/>
                <field name="treatment_count" sum="Treatments"/>
                <field name="open_anomaly_count" sum="Open Anomalies"/>
                <field name="critical_anomaly_count" sum="Critical"/>
                <field name="open_reservice_count" sum="Re-Services"/>
                <field name="open_quality_nc_count" sum="Quality NC"/>
                <field name="stock_consumption_qty" sum="Consumed"/>
                <field name="billable_amount" widget="monetary" sum="Billable" options="{'currency_field': 'currency_id'}"/>
                <field name="maintenance_cost" widget="monetary" sum="Maintenance" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pest_analytics_technician_list" model="ir.ui.view">
        <field name="name">pest.analytics.technician.kpi.list</field>
        <field name="model">pest.analytics.technician.kpi</field>
        <field name="arch" type="xml">
            <list string="Technician Performance" create="0" edit="0" delete="0">
                <field name="technician_id"/>
                <field name="company_id"/>
                <field name="visit_count" sum="Visits"/>
                <field name="done_visit_count" sum="Done"/>
                <field name="high_priority_done_count" sum="High Priority"/>
                <field name="duration_hours" sum="Hours"/>
                <field name="treatment_count" sum="Treatments"/>
                <field name="anomaly_count" sum="Anomalies"/>
                <field name="open_anomaly_count" sum="Open"/>
                <field name="reservice_count" sum="Re-Services"/>
                <field name="quality_check_count" sum="Quality Checks"/>
                <field name="failed_quality_check_count" sum="Failed QC"/>
                <field name="open_quality_nc_count" sum="Open NC"/>
                <field name="stock_consumption_qty" sum="Consumed"/>
                <field name="visit_billable_amount" widget="monetary" sum="Billable" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pest_analytics_contract_list" model="ir.ui.view">
        <field name="name">pest.analytics.contract.kpi.list</field>
        <field name="model">pest.analytics.contract.kpi</field>
        <field name="arch" type="xml">
            <list string="Contract Portfolio" create="0" edit="0" delete="0">
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="service_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_remaining"/>
                <field name="site_count"/>
                <field name="visit_count"/>
                <field name="done_visit_count"/>
                <field name="late_visit_count"/>
                <field name="open_anomaly_count"/>
                <field name="open_reservice_count"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="to_invoice_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="invoiced_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="billed_ratio" widget="percentage"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pest_analytics_financial_list" model="ir.ui.view">
        <field name="name">pest.analytics.financial.report.list</field>
        <field name="model">pest.analytics.financial.report</field>
        <field name="arch" type="xml">
            <list string="Financial Analytics" create="0" edit="0" delete="0">
                <field name="invoice_month"/>
                <field name="invoice_date"/>
                <field name="billing_item_id"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="visit_id"/>
                <field name="source_type"/>
                <field name="state"/>
                <field name="product_id"/>
                <field name="quantity" sum="Qty"/>
                <field name="unit_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount" widget="monetary" sum="Amount" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pest_analytics_financial_pivot" model="ir.ui.view">
        <field name="name">pest.analytics.financial.report.pivot</field>
        <field name="model">pest.analytics.financial.report</field>
        <field name="arch" type="xml">
            <pivot string="Financial Analytics">
                <field name="invoice_month" type="row" interval="month"/>
                <field name="source_type" type="col"/>
                <field name="state" type="row"/>
                <field name="quantity" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pest_analytics_financial_graph" model="ir.ui.view">
        <field name="name">pest.analytics.financial.report.graph</field>
        <field name="model">pest.analytics.financial.report</field>
        <field name="arch" type="xml">
            <graph string="Billing by Month" type="bar">
                <field name="invoice_month" interval="month"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
</odoo>
