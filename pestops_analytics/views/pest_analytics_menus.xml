        <field name="view_mode">form,list</field>
        <field name="view_id" ref="view_pest_analytics_company_kpi_form"/>
    </record>

    <record id="action_pest_analytics_visits" model="ir.actions.act_window">
        <field name="name">Visit Analytics</field>
        <field name="res_model">pest.analytics.visit.report</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="view_pest_analytics_visit_graph"/>
    </record>

    <record id="action_pest_analytics_sites" model="ir.actions.act_window">
        <field name="name">Site Performance</field>
        <field name="res_model">pest.analytics.site.kpi</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_pest_analytics_site_list"/>
