        <field name="res_model">pest.analytics.contract.kpi</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_pest_analytics_contract_list"/>
    </record>

    <record id="action_pest_analytics_financial" model="ir.actions.act_window">
        <field name="name">Financial Analytics</field>
        <field name="res_model">pest.analytics.financial.report</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="view_pest_analytics_financial_graph"/>
    </record>

    <menuitem id="menu_pestops_analytics" name="Analytics" parent="pestops_core.menu_pestops_root" sequence="40" groups="pestops_core.group_pestops_supervisor,pestops_core.group_pestops_operations,pestops_core.group_pestops_manager,pestops_core.group_pestops_admin"/>
