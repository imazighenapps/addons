    <menuitem id="menu_pestops_analytics_visits" name="Visit Analytics" parent="menu_pestops_analytics" action="action_pest_analytics_visits" sequence="10"/>
    <menuitem id="menu_pestops_analytics_sites" name="Site Performance" parent="menu_pestops_analytics" action="action_pest_analytics_sites" sequence="20"/>
    <menuitem id="menu_pestops_analytics_technicians" name="Technician Performance" parent="menu_pestops_analytics" action="action_pest_analytics_technicians" sequence="30"/>
    <menuitem id="menu_pestops_analytics_contracts" name="Contract Portfolio" parent="menu_pestops_analytics" action="action_pest_analytics_contracts" sequence="40"/>
    <menuitem id="menu_pestops_analytics_financial" name="Financial Analytics" parent="menu_pestops_analytics" action="action_pest_analytics_financial" sequence="50"/>
