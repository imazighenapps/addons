<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gapless_rule_list" model="ir.ui.view">
        <field name="name">gapless.rule.list</field>
        <field name="model">gapless.rule</field>
        <field name="arch" type="xml">
            <list string="Rules">
                <field name="name"/>
                <field name="company_id"/>
                <field name="journal_id"/>
                <field name="mode"/>
                <field name="tolerance"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_gapless_rule_form" model="ir.ui.view">
        <field name="name">gapless.rule.form</field>
        <field name="model">gapless.rule</field>
        <field name="arch" type="xml">
            <form string="Rules">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Scope">
    <field name="name"/>
    <field name="company_id"/>
    <field name="journal_id"/>
    <field name="active"/>
                        </group>
                        <group string="Control">
    <field name="mode"/>
    <field name="tolerance"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gapless_rule_search" model="ir.ui.view">
        <field name="name">gapless.rule.search</field>
        <field name="model">gapless.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="journal_id"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_gapless_rule" model="ir.actions.act_window">
        <field name="name">Rules</field>
        <field name="res_model">gapless.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set one rule per company or per journal, with a tolerance and a control mode.</p>
        </field>
    </record>

</odoo>
