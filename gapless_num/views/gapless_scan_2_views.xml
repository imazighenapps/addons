<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gapless_scan_form" model="ir.ui.view">
        <field name="name">gapless.scan.form</field>
        <field name="model">gapless.scan</field>
        <field name="arch" type="xml">
            <form string="Scan Numbers">
                <sheet>
                    <group>
                        <group string="Period">
    <field name="date_from"/>
    <field name="date_to"/>
                        </group>
                        <group string="Scope">
    <field name="company_id"/>
    <field name="journal_ids"/>
    <field name="rule_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gapless_scan" model="ir.actions.act_window">
        <field name="name">Scan Numbers</field>
        <field name="res_model">gapless.scan</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
