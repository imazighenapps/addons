<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gapless_issue_list" model="ir.ui.view">
        <field name="name">gapless.issue.list</field>
        <field name="model">gapless.issue</field>
        <field name="arch" type="xml">
            <list string="Anomalies" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="kind" widget="badge"/>
                <field name="move_name"/>
                <field name="expected"/>
                <field name="found"/>
                <field name="issue_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_gapless_issue_form" model="ir.ui.view">
        <field name="name">gapless.issue.form</field>
        <field name="model">gapless.issue</field>
        <field name="arch" type="xml">
            <form string="Anomalies">
                <header>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_ignore" type="object" string="Ignore" class="btn-secondary" invisible="state != 'open'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" invisible="state == 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,resolved,ignored"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Anomaly">
    <field name="journal_id"/>
    <field name="kind"/>
    <field name="move_id"/>
    <field name="move_name"/>
                        </group>
                        <group string="Sequence">
    <field name="expected"/>
    <field name="found"/>
    <field name="issue_date"/>
    <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gapless_issue_search" model="ir.ui.view">
        <field name="name">gapless.issue.search</field>
        <field name="model">gapless.issue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="move_name"/>
                <field name="journal_id"/>
                <filter name="open" string="Open" domain="[('state','=','open')]"/>
                <filter name="resolved" string="Resolved" domain="[('state','=','resolved')]"/>
                <filter name="gaps" string="Missing Numbers" domain="[('kind','=','gap')]"/>
                <separator/>
                <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_gapless_issue_kanban" model="ir.ui.view">
        <field name="name">gapless.issue.kanban</field>
        <field name="model">gapless.issue</field>
        <field name="arch" type="xml">
            <kanban default_group_by="kind" sample="1">
                <field name="kind"/>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="move_name"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="kind" class="fw-bold"/>
                        <field name="name"/>
                        <field name="journal_id"/>
                        <field name="move_name"/>
                        <field name="state"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_gapless_issue_graph" model="ir.ui.view">
        <field name="name">gapless.issue.graph</field>
        <field name="model">gapless.issue</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="issue_date" interval="month"/>
            </graph>
        </field>
    </record>

    <record id="view_gapless_issue_pivot" model="ir.ui.view">
        <field name="name">gapless.issue.pivot</field>
        <field name="model">gapless.issue</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="kind" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_gapless_issue" model="ir.actions.act_window">
        <field name="name">Anomalies</field>
        <field name="res_model">gapless.issue</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run a scan to list every missing, duplicated or manually changed legal number.</p>
        </field>
    </record>

</odoo>
