<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecast_reorder_tree" model="ir.ui.view">
        <field name="name">forecast.reorder.tree</field>
        <field name="model">forecast.reorder</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="current_min"/>
                <field name="optimal_min_qty"/>
                <field name="current_max"/>
                <field name="optimal_max_qty"/>
                <field name="improvement_potential"/>
                <field name="last_computation"/>
            </list>
        </field>
    </record>

    <record id="view_forecast_reorder_form" model="ir.ui.view">
        <field name="name">forecast.reorder.form</field>
        <field name="model">forecast.reorder</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply_to_odoo" string="Apply to Odoo Rules" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group>
                            <field name="lead_time_days"/>
                            <field name="service_level"/>
                            <field name="auto_apply"/>
                        </group>
                    </group>
                    <group string="Optimized Values">
                        <group>
                            <label for="optimal_min_qty"/>
                            <div class="o_row">
                                <field name="optimal_min_qty"/>
                                <span class="text-muted ml8">(Current: <field name="current_min" readonly="1"/>)</span>
                            </div>
                            <label for="optimal_max_qty"/>
                            <div class="o_row">
                                <field name="optimal_max_qty"/>
                                <span class="text-muted ml8">(Current: <field name="current_max" readonly="1"/>)</span>
                            </div>
                        </group>
                        <group>
                            <field name="optimal_order_qty"/>
                            <field name="safety_stock"/>
                        </group>
                    </group>
                    <group string="Statistics">
                        <field name="avg_daily_demand"/>
                        <field name="demand_std_dev"/>
                        <field name="improvement_potential" widget="percentage"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_forecast_reorder" model="ir.actions.act_window">
        <field name="name">AI Reorder Rules</field>
        <field name="res_model">forecast.reorder</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
