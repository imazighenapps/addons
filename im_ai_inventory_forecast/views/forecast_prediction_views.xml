<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecast_prediction_tree" model="ir.ui.view">
        <field name="name">forecast.prediction.tree</field>
        <field name="model">forecast.prediction</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="predicted_demand"/>
                <field name="confidence_lower"/>
                <field name="confidence_upper"/>
                <field name="trend" widget="badge"/>
                <field name="algorithm_used"/>
            </list>
        </field>
    </record>

    <record id="view_forecast_prediction_form" model="ir.ui.view">
        <field name="name">forecast.prediction.form</field>
        <field name="model">forecast.prediction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_alert" string="Create Alert" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="warehouse_id"/>
                            <field name="date"/>
                            <field name="current_stock"/>
                        </group>
                        <group>
                            <field name="predicted_demand"/>
                            <field name="confidence_lower"/>
                            <field name="confidence_upper"/>
                            <field name="trend"/>
                        </group>
                    </group>
                    <group>
                        <field name="algorithm_used"/>
                        <field name="accuracy_score"/>
                        <field name="is_anomaly"/>
                        <field name="seasonality_detected"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_forecast_prediction_graph" model="ir.ui.view">
        <field name="name">forecast.prediction.graph</field>
        <field name="model">forecast.prediction</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="date"/>
                <field name="predicted_demand" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_forecast_prediction" model="ir.actions.act_window">
        <field name="name">Predictions</field>
        <field name="res_model">forecast.prediction</field>
        <field name="view_mode">list,form,graph</field>
    </record>
</odoo>
