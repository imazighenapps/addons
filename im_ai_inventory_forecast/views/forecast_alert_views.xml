<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecast_alert_tree" model="ir.ui.view">
        <field name="name">forecast.alert.tree</field>
        <field name="model">forecast.alert</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity=='critical'" decoration-warning="severity=='high'">
                <field name="date_detection"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="alert_type" widget="badge"/>
                <field name="severity" widget="badge"/>
                <field name="message"/>
                <field name="status" widget="badge"/>
                <field name="days_until_event"/>
            </list>
        </field>
    </record>

    <record id="view_forecast_alert_form" model="ir.ui.view">
        <field name="name">forecast.alert.form</field>
        <field name="model">forecast.alert</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_acknowledge" string="Acknowledge" type="object" invisible="status != 'new'"/>
                    <button name="action_resolve" string="Resolve" type="object" class="btn-primary" invisible="status == 'resolved'"/>
                    <button name="action_ignore" string="Ignore" type="object" invisible="status == 'ignored'"/>
                    <button name="action_create_purchase_order" string="Create PO" type="object" class="btn-success" invisible="alert_type != 'stockout' or status == 'resolved'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_product" type="object" class="oe_stat_button" icon="fa-cube">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Product</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="warehouse_id"/>
                            <field name="alert_type"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="date_detection"/>
                            <field name="date_expected"/>
                            <field name="days_until_event"/>
                            <field name="assigned_to"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="recommended_action"/>
                        <field name="estimated_impact" widget="monetary"/>
                    </group>
                    <group string="Actions Taken" invisible="not purchase_order_id">
                        <field name="purchase_order_id"/>
                        <field name="sale_order_id"/>
                    </group>
                    <field name="notes" placeholder="Add notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_forecast_alert" model="ir.actions.act_window">
        <field name="name">Alerts</field>
        <field name="res_model">forecast.alert</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ['new', 'acknowledged'])]</field>
    </record>
</odoo>
