<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_sales_target_entry_company" model="ir.rule">
        <field name="name">sales_target.entry: own company only</field>
        <field name="model_id" ref="model_sales_target_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_sales_target_item_company" model="ir.rule">
        <field name="name">sales_target.item: own company only</field>
        <field name="model_id" ref="model_sales_target_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
