<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_round_cleared_list" model="ir.ui.view">
        <field name="name">round.writeoff.list</field>
        <field name="model">round.writeoff</field>
        <field name="arch" type="xml">
            <list string="Cleared Queue">
                <field name="posted_on"/>
                <field name="name"/>
                <field name="rule_id"/>
                <field name="source_ref"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="view_round_cleared_form" model="ir.ui.view">
        <field name="name">round.writeoff.form</field>
        <field name="model">round.writeoff</field>
        <field name="arch" type="xml">
            <form string="Cleared Queue">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Write-Off">
    <field name="name"/>
    <field name="rule_id"/>
    <field name="source_ref"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amount">
    <field name="amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Status">
    <field name="writeoff_on"/>
    <field name="state"/>
    <field name="posted_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_round_cleared_search" model="ir.ui.view">
        <field name="name">round.writeoff.search</field>
        <field name="model">round.writeoff</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="rule_id"/>
                <field name="source_ref"/>
                <separator/>
                <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_round_cleared" model="ir.actions.act_window">
        <field name="name">Cleared Queue</field>
        <field name="res_model">round.writeoff</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every rounding difference that has been posted and cleared.</p>
        </field>
    </record>

</odoo>
