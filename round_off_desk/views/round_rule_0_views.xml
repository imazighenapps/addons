<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_round_rule_list" model="ir.ui.view">
        <field name="name">round.rule.list</field>
        <field name="model">round.rule</field>
        <field name="arch" type="xml">
            <list string="Write-Off Rules">
                <field name="name"/>
                <field name="reason"/>
                <field name="max_amount"/>
                <field name="writeoff_count"/>
                <field name="cleared_amount"/>
            </list>
        </field>
    </record>

    <record id="view_round_rule_form" model="ir.ui.view">
        <field name="name">round.rule.form</field>
        <field name="model">round.rule</field>
        <field name="arch" type="xml">
            <form string="Write-Off Rules">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Rule">
    <field name="name"/>
    <field name="reason"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Limit">
    <field name="max_amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Counters">
    <field name="writeoff_count"/>
    <field name="cleared_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_round_rule_search" model="ir.ui.view">
        <field name="name">round.rule.search</field>
        <field name="model">round.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reason"/>
            </search>
        </field>
    </record>

    <record id="view_round_rule_kanban" model="ir.ui.view">
        <field name="name">round.rule.kanban</field>
        <field name="model">round.rule</field>
        <field name="arch" type="xml">
            <kanban default_group_by="reason" sample="1">
                <field name="name"/>
                <field name="reason"/>
                <field name="max_amount"/>
                <field name="cleared_amount"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="max_amount"/>
                        <field name="cleared_amount"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_round_rule" model="ir.actions.act_window">
        <field name="name">Write-Off Rules</field>
        <field name="res_model">round.rule</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The limits and reasons you accept for small differences.</p>
        </field>
    </record>

</odoo>
