<odoo>
  <record id="rule_cutoff_rule_company_user" model="ir.rule">
    <field name="name">Warehouse cut-off rules: company scope</field>
    <field name="model_id" ref="model_fs_warehouse_cutoff_rule"/>
    <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_cutoff_rule_company_manager" model="ir.rule">
    <field name="name">Warehouse cut-off rules manager: company scope</field>
    <field name="model_id" ref="model_fs_warehouse_cutoff_rule"/>
    <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_cutoff_monitor_company_user" model="ir.rule">
    <field name="name">Warehouse cut-off monitor: company scope</field>
    <field name="model_id" ref="model_fs_warehouse_cutoff_monitor"/>
    <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_cutoff_monitor_company_manager" model="ir.rule">
    <field name="name">Warehouse cut-off monitor manager: company scope</field>
    <field name="model_id" ref="model_fs_warehouse_cutoff_monitor"/>
    <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
