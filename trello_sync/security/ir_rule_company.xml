<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_trello_connection_company" model="ir.rule">
        <field name="name">trello.connection: own company only</field>
        <field name="model_id" ref="model_trello_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_trello_record_company" model="ir.rule">
        <field name="name">trello.record: own company only</field>
        <field name="model_id" ref="model_trello_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
