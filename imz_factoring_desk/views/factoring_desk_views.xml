<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="view_factoring_assignment_form" model="ir.ui.view">
  <field name="name">factoring.assignment.form</field><field name="model">factoring.assignment</field>
  <field name="arch" type="xml"><form string="Affacturage">
    <header>
      <button name="action_assign" type="object" string="Céder" class="btn-primary" invisible="state!='draft'"/>
      <button name="action_advance" type="object" string="Verser l'avance" invisible="state!='assigned'"/>
      <button name="action_release" type="object" string="Débloquer" invisible="state!='advanced'"/>
      <button name="action_close" type="object" string="Clôturer" invisible="state!='released'"/>
      <field name="state" widget="statusbar" statusbar_visible="draft,assigned,advanced,released,closed"/>
    </header>
    <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group>
        <field name="company_id" groups="base.group_multi_company"/><field name="factor_name"/>
        <field name="invoice_id"/><field name="partner_id"/><field name="cession_date"/>
      </group><group>
        <field name="invoice_amount"/><field name="advance_rate"/><field name="commission_rate"/><field name="retention_rate"/>
        <field name="advance_amount"/><field name="commission_amount"/><field name="retention_amount"/>
        <field name="released_amount"/><field name="currency_id" invisible="1"/>
      </group></group>
      <group string="Notes"><field name="notes" nolabel="1"/></group>
    </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
  </form></field>
</record>
<record id="view_factoring_assignment_list" model="ir.ui.view">
  <field name="name">factoring.assignment.list</field><field name="model">factoring.assignment</field>
  <field name="arch" type="xml"><list decoration-success="state=='closed'">
    <field name="name"/><field name="factor_name"/><field name="invoice_id"/><field name="partner_id"/>
    <field name="invoice_amount"/><field name="advance_amount"/><field name="commission_amount"/><field name="state"/>
  </list></field>
</record>
</data></odoo>
