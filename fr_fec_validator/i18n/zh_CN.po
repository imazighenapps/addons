#. module: fr_fec_validator
msgid "%s doit être une date AAAAMMJJ valide (reçu « %s »)."
msgstr "%s 必须是有效的 YYYYMMDD 日期（收到“%s”）。"

#. module: fr_fec_validator
msgid "%s manquant (ligne %d)."
msgstr "%s 缺失（第 %d 行）。"

#. module: fr_fec_validator
msgid "%s trop long (%d caractères, max %d)."
msgstr "%s 过长（%d 个字符，最大 %d）。"

#. module: fr_fec_validator
msgid "AccountNum doit être numérique (reçu « %s »)."
msgstr "AccountNum 必须为数字（收到“%s”）。"

#. module: fr_fec_validator
msgid "Analyser le fichier"
msgstr "分析文件"

#. module: fr_fec_validator
msgid "Anomalies"
msgstr "异常"

#. module: fr_fec_validator
msgid "Aucun séparateur reconnu (tabulation, pipe ou point-virgule) dans l'en-tête."
msgstr "表头中没有可识别的分隔符（制表符、竖线或分号）。"

#. module: fr_fec_validator
msgid "Avertissements"
msgstr "警告"

#. module: fr_fec_validator
msgid "Balance déséquilibrée : débit %.2f ≠ crédit %.2f (écart %.2f)."
msgstr "余额不平衡：借方 %.2f ≠ 贷方 %.2f（差额 %.2f）。"

#. module: fr_fec_validator
msgid "Champ"
msgstr "字段"

#. module: fr_fec_validator
msgid "Champs obligatoires absents de l'en-tête : %s."
msgstr "表头缺少必填字段：%s。"

#. module: fr_fec_validator
msgid "Colonnes non réglementaires : %s."
msgstr "不符合规定的列：%s。"

#. module: fr_fec_validator
msgid "CompNumMvt doit être un entier (reçu « %s »)."
msgstr "CompNumMvt 必须为整数（收到“%s”）。"

#. module: fr_fec_validator
msgid "CompPieceNum de la ligne en anomalie, si identifiée."
msgstr "异常行的 CompPieceNum（若已识别）。"

#. module: fr_fec_validator
msgid "Credit invalide (reçu « %s »)."
msgstr "贷方无效（收到“%s”）。"

#. module: fr_fec_validator
msgid "Debit invalide (reçu « %s »)."
msgstr "借方无效（收到“%s”）。"

#. module: fr_fec_validator
msgid "Débit et crédit tous deux positifs sur la même ligne."
msgstr "同一行借方和贷方均为正数。"

#. module: fr_fec_validator
msgid "EcritureLet renseigné sans DateLet."
msgstr "填写了 EcritureLet 但缺少 DateLet。"

#. module: fr_fec_validator
msgid "EcritureNum %s non croissant pour le journal %s (précédent %d)."
msgstr "日记账 %s 的 EcritureNum %s 未递增（前值 %d）。"

#. module: fr_fec_validator
msgid "EcritureNum doit être un entier (reçu « %s »)."
msgstr "EcritureNum 必须为整数（收到“%s”）。"

#. module: fr_fec_validator
msgid "Enregistrements"
msgstr "记录数"

#. module: fr_fec_validator
msgid "Erreurs"
msgstr "错误"

#. module: fr_fec_validator
msgid "Fichier"
msgstr "文件"

#. module: fr_fec_validator
msgid "Fichier FEC"
msgstr "FEC 文件"

#. module: fr_fec_validator
msgid "L'en-tête n'a que %d colonnes (18 obligatoires)."
msgstr "表头只有 %d 列（要求 18 列）。"

#. module: fr_fec_validator
msgid "La ligne a %d colonnes (attendu %d)."
msgstr "该行有 %d 列（应为 %d 列）。"

#. module: fr_fec_validator
msgid "La pièce %s a plusieurs numéros de mouvement (%s, %s)."
msgstr "单据 %s 有多个业务编号（%s、%s）。"

#. module: fr_fec_validator
msgid "Le fichier est vide."
msgstr "文件为空。"

#. module: fr_fec_validator
msgid "Les 18 champs ne sont pas dans l'ordre réglementaire."
msgstr "18 个字段不符合规定顺序。"

#. module: fr_fec_validator
msgid "Ligne du fichier"
msgstr "文件行"

#. module: fr_fec_validator
msgid "Ligne à montant nul."
msgstr "金额为零的行。"

#. module: fr_fec_validator
msgid "Message"
msgstr "消息"

#. module: fr_fec_validator
msgid "Montants négatifs interdits."
msgstr "禁止负数金额。"

#. module: fr_fec_validator
msgid "Nom"
msgstr "名称"

#. module: fr_fec_validator
msgid "Nom du fichier"
msgstr "文件名"

#. module: fr_fec_validator
msgid "Ouvrir l'écriture"
msgstr "打开分录"

#. module: fr_fec_validator
msgid "Référence de pièce"
msgstr "单据引用"

#. module: fr_fec_validator
msgid "Réinitialiser"
msgstr "重置"

#. module: fr_fec_validator
msgid "Résultat"
msgstr "结果"

#. module: fr_fec_validator
msgid "Résultats"
msgstr "结果"

#. module: fr_fec_validator
msgid "Société"
msgstr "公司"

#. module: fr_fec_validator
msgid "Séparateur détecté"
msgstr "检测到的分隔符"

#. module: fr_fec_validator
msgid "Sévérité"
msgstr "严重性"

#. module: fr_fec_validator
msgid "Total crédit"
msgstr "贷方合计"

#. module: fr_fec_validator
msgid "Total débit"
msgstr "借方合计"

#. module: fr_fec_validator
msgid "Type"
msgstr "类型"

#. module: fr_fec_validator
msgid "ValidDate antérieure à EcritureDate."
msgstr "ValidDate 早于 EcritureDate。"

#. module: fr_fec_validator
msgid "Validateur FEC"
msgstr "FEC 校验器"

#. module: fr_fec_validator
msgid "Écart de balance"
msgstr "余额差额"

#. module: fr_fec_validator
msgid "Écriture dupliquée %s/%s/%s."
msgstr "重复的分录 %s/%s/%s。"
