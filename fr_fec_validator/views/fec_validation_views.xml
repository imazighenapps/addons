<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fec_validation_form" model="ir.ui.view">
        <field name="name">fec.validation.form</field>
        <field name="model">fec.validation</field>
        <field name="arch" type="xml">
            <form string="Validateur FEC">
                <header>
                    <button name="action_validate" type="object"
                            string="Analyser le fichier" class="btn-primary"/>
                    <button name="action_reset" type="object"
                            string="Réinitialiser" class="btn-secondary"
                            invisible="state == 'draft' and not line_ids"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Contrôle FEC..."/></h1>
                    </div>
                    <group>
                        <group string="Fichier">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="file_name" invisible="1"/>
                            <field name="source_file" filename="file_name"/>
                            <field name="detected_separator"/>
                        </group>
                        <group string="Résultats">
                            <field name="record_count"/>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                            <field name="balance_gap"/>
                            <field name="error_count"/>
                            <field name="warning_count"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Anomalies">
                            <field name="line_ids" nolabel="1">
                                <list create="0" delete="0" editable="bottom"
                                      decoration-danger="severity == 'error'"
                                      decoration-warning="severity == 'warning'">
                                    <field name="severity"/>
                                    <field name="line_number"/>
                                    <field name="code"/>
                                    <field name="field_name"/>
                                    <field name="message"/>
                                    <field name="move_ref"/>
                                    <button name="action_open_move" type="object"
                                            string="Ouvrir l'écriture" icon="fa-external-link"
                                            invisible="not move_ref"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fec_validation_list" model="ir.ui.view">
        <field name="name">fec.validation.list</field>
        <field name="model">fec.validation</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'with_errors'"
                  decoration-success="state == 'validated'">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="file_name"/>
                <field name="record_count"/>
                <field name="error_count"/>
                <field name="warning_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>
</odoo>
