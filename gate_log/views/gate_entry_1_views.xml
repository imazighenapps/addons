<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gate_entry_list" model="ir.ui.view">
        <field name="name">gate.entry.list</field>
        <field name="model">gate.entry</field>
        <field name="arch" type="xml">
            <list string="Entries" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="entered_at"/>
                <field name="gate_id"/>
                <field name="truck_plate"/>
                <field name="carrier_id"/>
                <field name="driver_name"/>
                <field name="purpose"/>
                <field name="wait_minutes" sum="Total Wait Minutes"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_gate_entry_form" model="ir.ui.view">
        <field name="name">gate.entry.form</field>
        <field name="model">gate.entry</field>
        <field name="arch" type="xml">
            <form string="Entries">
                <header>
                    <button name="action_close" type="object" string="Mark Exit" class="btn-primary" invisible="state != 'on_site'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-link" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="on_site,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Visit">
    <field name="name"/>
    <field name="gate_id"/>
    <field name="truck_plate"/>
    <field name="carrier_id"/>
    <field name="driver_name"/>
    <field name="purpose"/>
    <field name="company_id"/>
                        </group>
                        <group string="Times">
    <field name="entered_at"/>
    <field name="exited_at"/>
    <field name="wait_minutes"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gate_entry_search" model="ir.ui.view">
        <field name="name">gate.entry.search</field>
        <field name="model">gate.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="truck_plate"/>
                <field name="carrier_id"/>
                <field name="driver_name"/>
                <field name="gate_id"/>
                <filter name="on_site" string="On Site" domain="[('state','=','on_site')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="group_gate" string="Gate" context="{'group_by': 'gate_id'}"/>
                <filter name="group_purpose" string="Purpose" context="{'group_by': 'purpose'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_gate_entry_kanban" model="ir.ui.view">
        <field name="name">gate.entry.kanban</field>
        <field name="model">gate.entry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="truck_plate"/>
                <field name="gate_id"/>
                <field name="entered_at"/>
                <field name="carrier_id"/>
                <field name="purpose"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="truck_plate"/>
                        <field name="gate_id"/>
                        <field name="entered_at"/>
                        <field name="carrier_id"/>
                        <field name="purpose"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_gate_entry" model="ir.actions.act_window">
        <field name="name">Entries</field>
        <field name="res_model">gate.entry</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log every truck arriving at and leaving the site.</p>
        </field>
    </record>

</odoo>
