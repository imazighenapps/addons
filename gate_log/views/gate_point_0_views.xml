<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gate_point_list" model="ir.ui.view">
        <field name="name">gate.point.list</field>
        <field name="model">gate.point</field>
        <field name="arch" type="xml">
            <list string="Gates">
                <field name="code"/>
                <field name="name"/>
                <field name="location"/>
                <field name="entry_count"/>
                <field name="open_entry_count"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_gate_point_form" model="ir.ui.view">
        <field name="name">gate.point.form</field>
        <field name="model">gate.point</field>
        <field name="arch" type="xml">
            <form string="Gates">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Gate">
    <field name="code"/>
    <field name="name"/>
    <field name="location"/>
    <field name="active"/>
    <field name="company_id"/>
                        </group>
                        <group string="Counters">
    <field name="entry_count"/>
    <field name="open_entry_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gate_point_search" model="ir.ui.view">
        <field name="name">gate.point.search</field>
        <field name="model">gate.point</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="location"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="view_gate_point_kanban" model="ir.ui.view">
        <field name="name">gate.point.kanban</field>
        <field name="model">gate.point</field>
        <field name="arch" type="xml">
            <kanban default_group_by="company_id" sample="1">
                <field name="company_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="location"/>
                <field name="open_entry_count"/>
                <templates>
                    <t t-name="card">
                        <field name="company_id" class="fw-bold"/>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="location"/>
                        <field name="open_entry_count"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_gate_point" model="ir.actions.act_window">
        <field name="name">Gates</field>
        <field name="res_model">gate.point</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register each gate point that controls site access.</p>
        </field>
    </record>

</odoo>
