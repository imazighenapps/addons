<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_fx_revaluation_company" model="ir.rule">
        <field name="name">fx.revaluation: own company only</field>
        <field name="model_id" ref="model_fx_revaluation"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_fx_revaluation_line_company" model="ir.rule">
        <field name="name">fx.revaluation.line: own company only</field>
        <field name="model_id" ref="model_fx_revaluation_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
