<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fx_revaluation_list" model="ir.ui.view">
        <field name="name">fx.revaluation.list</field>
        <field name="model">fx.revaluation</field>
        <field name="arch" type="xml">
            <list string="Revaluations" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="currency_id"/>
                <field name="rate"/>
                <field name="journal_id"/>
                <field name="total_gain" sum="Total Total Gain"/>
                <field name="total_loss" sum="Total Total Loss"/>
                <field name="net_gain_loss" sum="Total Net Gain Loss"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fx_revaluation_form" model="ir.ui.view">
        <field name="name">fx.revaluation.form</field>
        <field name="model">fx.revaluation</field>
        <field name="arch" type="xml">
            <form string="Revaluations">
                <header>
                    <button name="action_compute" type="object" string="Compute Open Items" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Post Entry" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Revaluation">
    <field name="name"/>
    <field name="date"/>
    <field name="currency_id"/>
    <field name="rate"/>
    <field name="company_currency_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Posting">
    <field name="journal_id"/>
    <field name="gain_account_id"/>
    <field name="loss_account_id"/>
    <field name="move_id"/>
                        </group>
                        <group string="Result">
    <field name="total_gain"/>
    <field name="total_loss"/>
    <field name="net_gain_loss"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Open Items" name="lineids">
                            <field name="line_ids" readonly="state == 'posted'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="partner_id"/>
                            <field name="reference"/>
                            <field name="amount_currency" sum="Total in Currency"/>
                            <field name="balance_company" sum="Total Book Value"/>
                            <field name="new_balance" sum="Total Revalued"/>
                            <field name="gain_loss" sum="Total Gain/Loss"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="company_currency_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fx_revaluation_search" model="ir.ui.view">
        <field name="name">fx.revaluation.search</field>
        <field name="model">fx.revaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="currency_id"/>
                <field name="journal_id"/>
                <field name="move_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="gain" string="Net Gain" domain="[('net_gain_loss','&gt;',0)]"/>
                <filter name="loss" string="Net Loss" domain="[('net_gain_loss','&lt;',0)]"/>
                <filter name="mine" string="My Revaluations" domain="[('create_uid','=',uid)]"/>
                <separator/>
                <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_fx_revaluation" model="ir.actions.act_window">
        <field name="name">Revaluations</field>
        <field name="res_model">fx.revaluation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enter the foreign currency and the closing rate, compute the open items, then post the revaluation entry.</p>
        </field>
    </record>

</odoo>
