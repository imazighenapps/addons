<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_canteen_draft_list" model="ir.ui.view">
        <field name="name">canteen.count.list</field>
        <field name="model">canteen.count</field>
        <field name="arch" type="xml">
            <list string="Draft Counts">
                <field name="meal_date"/>
                <field name="team_name"/>
                <field name="employee_id"/>
                <field name="meal_count"/>
                <field name="cutoff_time"/>
            </list>
        </field>
    </record>

    <record id="view_canteen_draft_form" model="ir.ui.view">
        <field name="name">canteen.count.form</field>
        <field name="model">canteen.count</field>
        <field name="arch" type="xml">
            <form string="Draft Counts">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="team_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Headcount">
    <field name="name"/>
    <field name="meal_date"/>
    <field name="team_name"/>
    <field name="employee_id"/>
    <field name="company_id"/>
    <field name="active"/>
                        </group>
                        <group string="Order">
    <field name="meal_count"/>
    <field name="cutoff_time"/>
    <field name="state"/>
    <field name="sent_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_canteen_draft_search" model="ir.ui.view">
        <field name="name">canteen.count.search</field>
        <field name="model">canteen.count</field>
        <field name="arch" type="xml">
            <search>
                <field name="team_name"/>
                <field name="employee_id"/>
                <separator/>
                <filter name="group_date" string="Meal Date" context="{'group_by': 'meal_date'}"/>
            </search>
        </field>
    </record>

    <record id="action_canteen_draft" model="ir.actions.act_window">
        <field name="name">Draft Counts</field>
        <field name="res_model">canteen.count</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Headcounts still to be sent before the cut-off.</p>
        </field>
    </record>

</odoo>
