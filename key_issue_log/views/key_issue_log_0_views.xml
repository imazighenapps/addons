<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_key_issue_log_list" model="ir.ui.view">
        <field name="name">key.issue.log.list</field>
        <field name="model">key.issue.log</field>
        <field name="arch" type="xml">
            <list string="Key Issues" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="key_label"/>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="issue_date"/>
                <field name="expected_return_date"/>
                <field name="state" widget="badge"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_key_issue_log_form" model="ir.ui.view">
        <field name="name">key.issue.log.form</field>
        <field name="model">key.issue.log</field>
        <field name="arch" type="xml">
            <form string="Key Issues">
                <header>
                    <button name="action_issue" type="object" string="Mark Issued" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_return" type="object" string="Mark Returned" class="btn-primary" invisible="state != 'issued'"/>
                    <button name="action_lost" type="object" string="Mark Lost" class="btn-secondary" invisible="state != 'issued'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state not in ('returned', 'lost')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued,returned,lost"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Key">
    <field name="name"/>
    <field name="key_label"/>
    <field name="employee_id"/>
    <field name="partner_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Dates">
    <field name="issue_date"/>
    <field name="expected_return_date"/>
    <field name="return_date"/>
    <field name="user_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Condition / Notes" name="conditionnote">
                            <field name="condition_note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_key_issue_log_search" model="ir.ui.view">
        <field name="name">key.issue.log.search</field>
        <field name="model">key.issue.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="key_label"/>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="issued" string="Issued" domain="[('state','=','issued')]"/>
                <filter name="returned" string="Returned" domain="[('state','=','returned')]"/>
                <filter name="lost" string="Lost" domain="[('state','=','lost')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_employee" string="Holder (Employee)" context="{'group_by': 'employee_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_key_issue_log_graph" model="ir.ui.view">
        <field name="name">key.issue.log.graph</field>
        <field name="model">key.issue.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_key_issue_log" model="ir.actions.act_window">
        <field name="name">Key Issues</field>
        <field name="res_model">key.issue.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track key issues and returns.</p>
        </field>
    </record>

</odoo>
