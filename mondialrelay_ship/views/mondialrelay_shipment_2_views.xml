<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mondialrelay_shipment_list" model="ir.ui.view">
        <field name="name">mondialrelay.shipment.list</field>
        <field name="model">mondialrelay.shipment</field>
        <field name="arch" type="xml">
            <list string="Shipments" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="partner_id"/>
                <field name="relay_point_id"/>
                <field name="tracking_number"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_mondialrelay_shipment_form" model="ir.ui.view">
        <field name="name">mondialrelay.shipment.form</field>
        <field name="model">mondialrelay.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipments">
                <header>
                    <button name="action_prepare" type="object" string="Prepare" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_label" type="object" string="Create Label" class="btn-primary" invisible="state != 'ready'"/>
                    <button name="action_ship" type="object" string="Mark Shipped" class="btn-secondary" invisible="state != 'label'"/>
                    <button name="action_deliver" type="object" string="Mark Delivered" class="btn-secondary" invisible="state != 'in_transit'"/>
                    <button name="action_reset" type="object" string="Reset" class="btn-secondary" invisible="state == 'delivered'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,label,in_transit,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Shipment">
    <field name="name"/>
    <field name="connection_id"/>
    <field name="company_id"/>
    <field name="state"/>
                        </group>
                        <group string="Delivery">
    <field name="picking_id"/>
    <field name="partner_id"/>
    <field name="relay_point_id"/>
                        </group>
                        <group string="Parcel">
    <field name="weight"/>
    <field name="parcel_count"/>
    <field name="label_ref"/>
    <field name="tracking_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                        <page string="Events" name="eventids">
                            <field name="event_ids" readonly="1">
                        <list><field name="create_date"/><field name="status"/><field name="message"/></list>
                     </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mondialrelay_shipment_search" model="ir.ui.view">
        <field name="name">mondialrelay.shipment.search</field>
        <field name="model">mondialrelay.shipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tracking_number"/>
                <field name="partner_id"/>
                <field name="picking_id"/>
                <filter name="ready" string="Ready" domain="[('state','=','ready')]"/>
                <filter name="transit" string="In Transit" domain="[('state','=','in_transit')]"/>
                <filter name="delivered" string="Delivered" domain="[('state','=','delivered')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_relay" string="Relay Point" context="{'group_by': 'relay_point_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_mondialrelay_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">mondialrelay.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Prepare and track Mondial Relay shipments.</p>
        </field>
    </record>

</odoo>
