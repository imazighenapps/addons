<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mondialrelay_point_list" model="ir.ui.view">
        <field name="name">mondialrelay.point.list</field>
        <field name="model">mondialrelay.point</field>
        <field name="arch" type="xml">
            <list string="Relay Points">
                <field name="relay_code"/>
                <field name="name"/>
                <field name="zip"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mondialrelay_point_form" model="ir.ui.view">
        <field name="name">mondialrelay.point.form</field>
        <field name="model">mondialrelay.point</field>
        <field name="arch" type="xml">
            <form string="Relay Points">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Point">
    <field name="relay_code"/>
    <field name="name"/>
    <field name="active"/>
                        </group>
                        <group string="Address">
    <field name="street"/>
    <field name="zip"/>
    <field name="city"/>
    <field name="country_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mondialrelay_point_search" model="ir.ui.view">
        <field name="name">mondialrelay.point.search</field>
        <field name="model">mondialrelay.point</field>
        <field name="arch" type="xml">
            <search>
                <field name="relay_code"/>
                <field name="name"/>
                <field name="city"/>
                <field name="zip"/>
                <separator/>
                <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_mondialrelay_point" model="ir.actions.act_window">
        <field name="name">Relay Points</field>
        <field name="res_model">mondialrelay.point</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Directory of Mondial Relay pickup points.</p>
        </field>
    </record>

</odoo>
