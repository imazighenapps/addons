<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_match_check_list" model="ir.ui.view">
        <field name="name">match.check.list</field>
        <field name="model">match.check</field>
        <field name="arch" type="xml">
            <list string="Three-Way Checks" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <field name="picking_id"/>
                <field name="bill_id"/>
                <field name="total_ordered" sum="Total Total Ordered"/>
                <field name="total_received" sum="Total Total Received"/>
                <field name="total_billed" sum="Total Total Billed"/>
                <field name="variance_amount" sum="Total Variance Amount"/>
                <field name="tolerance_pct"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_match_check_form" model="ir.ui.view">
        <field name="name">match.check.form</field>
        <field name="model">match.check</field>
        <field name="arch" type="xml">
            <form string="Three-Way Checks">
                <header>
                    <button name="action_run" type="object" string="Run Match" class="btn-primary" invisible="state == 'validated'"/>
                    <button name="action_flag_exception" type="object" string="Flag Exception" class="btn-secondary" invisible="state == 'validated'"/>
                    <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state in ('draft', 'validated')"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ok,exception,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Match check reference"/></h1>
                    </div>
                    <group>
                        <group string="Documents">
    <field name="partner_id"/>
    <field name="purchase_id"/>
    <field name="picking_id"/>
    <field name="bill_id"/>
    <field name="date"/>
    <field name="company_id"/>
                        </group>
                        <group string="Result">
    <field name="tolerance_pct"/>
    <field name="total_ordered"/>
    <field name="total_received"/>
    <field name="total_billed"/>
    <field name="variance_amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Exception">
    <field name="exception_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Match Lines" name="lineids">
                            <field name="line_ids" readonly="1">
                        <list>
                            <field name="product_id"/>
                            <field name="qty_ordered" sum="Total Ordered"/>
                            <field name="qty_received" sum="Total Received"/>
                            <field name="qty_billed" sum="Total Billed"/>
                            <field name="price_ordered"/>
                            <field name="price_billed"/>
                            <field name="status" widget="badge"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_match_check_search" model="ir.ui.view">
        <field name="name">match.check.search</field>
        <field name="model">match.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <field name="bill_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="ok" string="Matched" domain="[('state','=','ok')]"/>
                <filter name="exception" string="Exceptions" domain="[('state','=','exception')]"/>
                <filter name="validated" string="Validated" domain="[('state','=','validated')]"/>
                <filter name="variance" string="With Variance" domain="[('variance_amount','!=',0)]"/>
                <separator/>
                <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_match_check" model="ir.actions.act_window">
        <field name="name">Three-Way Checks</field>
        <field name="res_model">match.check</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a check for a vendor bill, then run the match against the purchase order and the receipt.</p>
        </field>
    </record>

</odoo>
