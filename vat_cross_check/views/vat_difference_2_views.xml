<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vat_difference_list" model="ir.ui.view">
        <field name="name">vat.check.line.list</field>
        <field name="model">vat.check.line</field>
        <field name="arch" type="xml">
            <list string="Differences">
                <field name="check_id"/>
                <field name="box_name"/>
                <field name="reported_amount"/>
                <field name="ledger_amount"/>
                <field name="difference_amount"/>
                <field name="reviewed"/>
            </list>
        </field>
    </record>

    <record id="view_vat_difference_form" model="ir.ui.view">
        <field name="name">vat.check.line.form</field>
        <field name="model">vat.check.line</field>
        <field name="arch" type="xml">
            <form string="Differences">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="box_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Box">
    <field name="check_id"/>
    <field name="box_name"/>
    <field name="reviewed"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amounts">
    <field name="reported_amount"/>
    <field name="ledger_amount"/>
    <field name="difference_amount"/>
    <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Explanation" name="explanation">
                            <field name="explanation"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vat_difference_search" model="ir.ui.view">
        <field name="name">vat.check.line.search</field>
        <field name="model">vat.check.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="box_name"/>
                <field name="check_id"/>
                <separator/>
                <filter name="group_check" string="Cross Check" context="{'group_by': 'check_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_vat_difference" model="ir.actions.act_window">
        <field name="name">Differences</field>
        <field name="res_model">vat.check.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Boxes that still differ or have not been reviewed.</p>
        </field>
    </record>

</odoo>
