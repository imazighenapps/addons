<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vat_check_line_list" model="ir.ui.view">
        <field name="name">vat.check.line.list</field>
        <field name="model">vat.check.line</field>
        <field name="arch" type="xml">
            <list string="VAT Boxes">
                <field name="check_id"/>
                <field name="box_name"/>
                <field name="reported_amount"/>
                <field name="ledger_amount"/>
                <field name="difference_amount"/>
                <field name="reviewed"/>
            </list>
        </field>
    </record>

    <record id="view_vat_check_line_form" model="ir.ui.view">
        <field name="name">vat.check.line.form</field>
        <field name="model">vat.check.line</field>
        <field name="arch" type="xml">
            <form string="VAT Boxes">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="box_name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Box">
    <field name="check_id"/>
    <field name="box_name"/>
    <field name="reviewed"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amounts">
    <field name="reported_amount"/>
    <field name="ledger_amount"/>
    <field name="difference_amount"/>
    <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Explanation" name="explanation">
                            <field name="explanation"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vat_check_line_search" model="ir.ui.view">
        <field name="name">vat.check.line.search</field>
        <field name="model">vat.check.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="box_name"/>
                <field name="check_id"/>
                <filter name="to_review" string="To Review" domain="[('reviewed','=',False)]"/>
                <filter name="with_gap" string="With Difference" domain="[('difference_amount','!=',0.0)]"/>
                <separator/>
                <filter name="group_check" string="Cross Check" context="{'group_by': 'check_id'}"/>
                <filter name="group_reviewed" string="Reviewed" context="{'group_by': 'reviewed'}"/>
            </search>
        </field>
    </record>

    <record id="view_vat_check_line_kanban" model="ir.ui.view">
        <field name="name">vat.check.line.kanban</field>
        <field name="model">vat.check.line</field>
        <field name="arch" type="xml">
            <kanban default_group_by="check_id" sample="1">
                <field name="check_id"/>
                <field name="box_name"/>
                <field name="reported_amount"/>
                <field name="ledger_amount"/>
                <field name="difference_amount"/>
                <field name="reviewed"/>
                <templates>
                    <t t-name="card">
                        <field name="check_id" class="fw-bold"/>
                        <field name="box_name"/>
                        <field name="reported_amount"/>
                        <field name="ledger_amount"/>
                        <field name="difference_amount"/>
                        <field name="reviewed"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_vat_check_line" model="ir.actions.act_window">
        <field name="name">VAT Boxes</field>
        <field name="res_model">vat.check.line</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Reported and ledger amounts for every VAT box.</p>
        </field>
    </record>

</odoo>
