<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_min_exception_list" model="ir.ui.view">
        <field name="name">order.min.exception.list</field>
        <field name="model">order.min.exception</field>
        <field name="arch" type="xml">
            <list string="Order Check" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="reference"/>
                <field name="rule_id"/>
                <field name="order_amount"/>
                <field name="order_quantity"/>
                <field name="shortfall"/>
                <field name="decided_on"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_order_min_exception_form" model="ir.ui.view">
        <field name="name">order.min.exception.form</field>
        <field name="model">order.min.exception</field>
        <field name="arch" type="xml">
            <form string="Order Check">
                <header>
                    <button name="action_allow" type="object" string="Allow" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-secondary" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,allowed,refused"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Order">
    <field name="name"/>
    <field name="reference"/>
    <field name="rule_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Values">
    <field name="order_amount"/>
    <field name="order_quantity"/>
    <field name="shortfall"/>
                        </group>
                        <group string="Decision">
    <field name="state"/>
    <field name="reason"/>
    <field name="decided_by"/>
    <field name="decided_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_order_min_exception_search" model="ir.ui.view">
        <field name="name">order.min.exception.search</field>
        <field name="model">order.min.exception</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="rule_id"/>
                <filter name="pending" string="Still Pending" domain="[('state','=','pending')]"/>
                <filter name="allowed" string="Allowed Anyway" domain="[('state','=','allowed')]"/>
                <filter name="refused" string="Refused" domain="[('state','=','refused')]"/>
                <separator/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'rule_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_order_min_exception_kanban" model="ir.ui.view">
        <field name="name">order.min.exception.kanban</field>
        <field name="model">order.min.exception</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="reference"/>
                <field name="rule_id"/>
                <field name="shortfall"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="reference"/>
                        <field name="rule_id"/>
                        <field name="shortfall"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_order_min_exception" model="ir.actions.act_window">
        <field name="name">Order Check</field>
        <field name="res_model">order.min.exception</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every order below its minimum, decided on the spot with a written trace.</p>
        </field>
    </record>

</odoo>
