<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_quote_expiry_entry_company" model="ir.rule">
        <field name="name">quote_expiry.entry: own company only</field>
        <field name="model_id" ref="model_quote_expiry_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_quote_expiry_item_company" model="ir.rule">
        <field name="name">quote_expiry.item: own company only</field>
        <field name="model_id" ref="model_quote_expiry_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
