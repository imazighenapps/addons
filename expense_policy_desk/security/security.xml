<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_expensepolic_user" model="res.groups">
        <field name="name">Expense Policy Desk User</field>
        <field name="comment">View and use the module.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_expensepolic_manager" model="res.groups">
        <field name="name">Expense Policy Desk Manager</field>
        <field name="comment">Configure and administer the module.</field>
        <field name="implied_ids" eval="[(4, ref('expense_policy_desk.group_expensepolic_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
