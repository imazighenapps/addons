<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_sdl_1" model="safety.drill.log">
        <field name="name">SDL-DEMO-001</field>
        <field name="drill_type">fire</field>
        <field name="planned_date" eval="(DateTime.now() - relativedelta(days=10)).strftime('%Y-%m-%d')"/>
        <field name="drill_date" eval="(DateTime.now() - relativedelta(days=10)).strftime('%Y-%m-%d')"/>
        <field name="location">Main Warehouse</field>
        <field name="participant_count">18</field>
        <field name="observations">Evacuation completed in 4 minutes; one exit partially blocked.</field>
        <field name="corrective_action">Clear exit area and add signage.</field>
        <field name="state">done</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="demo_sdl_2" model="safety.drill.log">
        <field name="name">SDL-DEMO-002</field>
        <field name="drill_type">evacuation</field>
        <field name="planned_date" eval="(DateTime.now() + relativedelta(days=20)).strftime('%Y-%m-%d')"/>
        <field name="drill_date" eval="(DateTime.now() + relativedelta(days=20)).strftime('%Y-%m-%d')"/>
        <field name="location">Office Building</field>
        <field name="state">draft</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
</odoo>
