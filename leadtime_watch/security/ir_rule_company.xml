<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_leadtime_watch_entry_company" model="ir.rule">
        <field name="name">leadtime_watch.entry: own company only</field>
        <field name="model_id" ref="model_leadtime_watch_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_leadtime_watch_item_company" model="ir.rule">
        <field name="name">leadtime_watch.item: own company only</field>
        <field name="model_id" ref="model_leadtime_watch_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
