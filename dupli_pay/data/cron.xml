<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_dupli_scan" model="ir.cron">
        <field name="name">DupliPay: scan duplicates</field>
        <field name="model_id" ref="model_dupli_scanner"/>
        <field name="state">code</field>
        <field name="code">model.action_scan()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
