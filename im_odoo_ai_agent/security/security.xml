<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_ai_agent_category" model="ir.module.category">
        <field name="name">AI Agent</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_ai_agent_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ai_agent_manager" model="res.groups">
        <field name="name">Manager / Admin</field>
        <field name="implied_ids" eval="[(4, ref('group_ai_agent_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    
    <record id="rule_ai_chat_session_own" model="ir.rule">
        <field name="name">AI Chat Sessions: own user access</field>
        <field name="model_id" ref="model_ai_chat_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_agent_user'))]"/>
    </record>

    
    <record id="rule_ai_chat_session_manager" model="ir.rule">
        <field name="name">AI Chat Sessions: manager access</field>
        <field name="model_id" ref="model_ai_chat_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_agent_manager'))]"/>
    </record>
</odoo>
