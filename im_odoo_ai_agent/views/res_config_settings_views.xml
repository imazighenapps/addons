<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.agent</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
            <div id="ai_agent_settings">
                <h2>AI Agent (GPT4All)</h2>
                <div class="row mt16">
                    <div class="col-12 col-lg-6">
                        <div class="o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_model_name" string="GPT4All Model"/>
                                <div class="text-muted">
                                    Name of the .gguf file to use
                                </div>
                                <div class="content-group mt8">
                                    <field name="ai_model_name" class="o_light_label"
                                           placeholder="Meta-Llama-3-8B-Instruct.Q4_0.gguf"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_model_path" string="Models Directory"/>
                                <div class="text-muted">
                                    Directory containing the .gguf files
                                </div>
                                <div class="content-group mt8">
                                    <field name="ai_model_path" class="o_light_label"
                                           placeholder="/root/.local/share/nomic.ai/GPT4All/"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_language" string="Response Language"/>
                                <div class="content-group mt8">
                                    <field name="ai_language" class="o_light_label"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_max_tokens" string="Max Tokens"/>
                                <div class="content-group mt8">
                                    <field name="ai_max_tokens" class="o_light_label"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
        </field>
    </record>
</odoo>
