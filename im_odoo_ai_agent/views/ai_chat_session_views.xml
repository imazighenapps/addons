<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="action_ai_chat" model="ir.actions.client">
        <field name="name">AI Assistant</field>
        <field name="tag">ai_agent.ChatInterface</field>
        <field name="target">current</field>
    </record>

    
    <record id="view_ai_chat_session_list" model="ir.ui.view">
        <field name="name">ai.chat.session.list</field>
        <field name="model">ai.chat.session</field>
        <field name="arch" type="xml">
            <list string="AI Conversations">
                <field name="title"/>
                <field name="user_id"/>
                <field name="message_count"/>
                <field name="create_date"/>
                <field name="is_pinned" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    
    <record id="view_ai_chat_session_form" model="ir.ui.view">
        <field name="name">ai.chat.session.form</field>
        <field name="model">ai.chat.session</field>
        <field name="arch" type="xml">
            <form string="AI Conversation">
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="user_id"/>
                        <field name="is_pinned"/>
                        <field name="message_count"/>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids" readonly="1">
                                <list>
                                    <field name="role"/>
                                    <field name="content"/>
                                    <field name="response_time"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_chat_sessions" model="ir.actions.act_window">
        <field name="name">Conversation History</field>
        <field name="res_model">ai.chat.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
