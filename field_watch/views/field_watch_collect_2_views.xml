<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_watch_collect_form" model="ir.ui.view">
        <field name="name">field.watch.collect.form</field>
        <field name="model">field.watch.collect</field>
        <field name="arch" type="xml">
            <form string="Collect Changes">
                <sheet>
                    <group>
                        <group string="Period">
    <field name="date_from"/>
    <field name="date_to"/>
                        </group>
                        <group string="Scope">
    <field name="company_id"/>
    <field name="model_ids"/>
    <field name="rule_ids"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_field_watch_collect" model="ir.actions.act_window">
        <field name="name">Collect Changes</field>
        <field name="res_model">field.watch.collect</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
