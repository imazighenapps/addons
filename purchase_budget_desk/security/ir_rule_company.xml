<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_purchase_budget_entry_company" model="ir.rule">
        <field name="name">purchase_budget.entry: own company only</field>
        <field name="model_id" ref="model_purchase_budget_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_purchase_budget_item_company" model="ir.rule">
        <field name="name">purchase_budget.item: own company only</field>
        <field name="model_id" ref="model_purchase_budget_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
