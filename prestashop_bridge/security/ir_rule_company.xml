<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_prestashop_connection_company" model="ir.rule">
        <field name="name">prestashop.connection: own company only</field>
        <field name="model_id" ref="model_prestashop_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_prestashop_record_company" model="ir.rule">
        <field name="name">prestashop.record: own company only</field>
        <field name="model_id" ref="model_prestashop_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
