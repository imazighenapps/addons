<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hazard_report_log_list" model="ir.ui.view">
        <field name="name">hazard.report.log.list</field>
        <field name="model">hazard.report.log</field>
        <field name="arch" type="xml">
            <list string="Hazard Reports" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="report_date"/>
                <field name="reporter_id"/>
                <field name="location"/>
                <field name="hazard_type"/>
                <field name="severity" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_hazard_report_log_form" model="ir.ui.view">
        <field name="name">hazard.report.log.form</field>
        <field name="model">hazard.report.log</field>
        <field name="arch" type="xml">
            <form string="Hazard Reports">
                <header>
                    <button name="action_report" type="object" string="Report" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'reported'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state != 'progress'"/>
                    <button name="action_dismiss" type="object" string="Dismiss" class="btn-secondary" invisible="state not in ('reported', 'progress')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state not in ('dismissed', 'resolved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reported,progress,resolved,dismissed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Report">
    <field name="name"/>
    <field name="report_date"/>
    <field name="reporter_id"/>
    <field name="location"/>
    <field name="company_id"/>
                        </group>
                        <group string="Hazard">
    <field name="hazard_type"/>
    <field name="severity"/>
    <field name="user_id"/>
    <field name="state"/>
    <field name="resolution_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Corrective Action" name="correctiveaction">
                            <field name="corrective_action"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hazard_report_log_search" model="ir.ui.view">
        <field name="name">hazard.report.log.search</field>
        <field name="model">hazard.report.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reporter_id"/>
                <field name="location"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="reported" string="Reported" domain="[('state','=','reported')]"/>
                <filter name="progress" string="In Progress" domain="[('state','=','progress')]"/>
                <filter name="resolved" string="Resolved" domain="[('state','=','resolved')]"/>
                <filter name="dismissed" string="Dismissed" domain="[('state','=','dismissed')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'hazard_type'}"/>
                <filter name="group_responsible" string="Responsible" context="{'group_by': 'user_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_hazard_report_log_graph" model="ir.ui.view">
        <field name="name">hazard.report.log.graph</field>
        <field name="model">hazard.report.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="severity"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_hazard_report_log" model="ir.actions.act_window">
        <field name="name">Hazard Reports</field>
        <field name="res_model">hazard.report.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Report and track workplace hazards.</p>
        </field>
    </record>

</odoo>
