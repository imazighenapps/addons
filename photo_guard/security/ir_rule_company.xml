<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_photo_audit_company" model="ir.rule">
        <field name="name">photo.audit: own company only</field>
        <field name="model_id" ref="model_photo_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_photo_issue_company" model="ir.rule">
        <field name="name">photo.issue: own company only</field>
        <field name="model_id" ref="model_photo_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
