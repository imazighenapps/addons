<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_fuel_vehicle_company" model="ir.rule">
        <field name="name">fuel.vehicle: own company only</field>
        <field name="model_id" ref="model_fuel_vehicle"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_fuel_log_company" model="ir.rule">
        <field name="name">fuel.log: own company only</field>
        <field name="model_id" ref="model_fuel_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
