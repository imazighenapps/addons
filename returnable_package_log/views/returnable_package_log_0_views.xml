<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_returnable_package_log_list" model="ir.ui.view">
        <field name="name">returnable.package.log.list</field>
        <field name="model">returnable.package.log</field>
        <field name="arch" type="xml">
            <list string="Packaging Movements" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="package_type"/>
                <field name="quantity"/>
                <field name="movement_type"/>
                <field name="movement_date"/>
                <field name="due_date"/>
                <field name="state" widget="badge"/>
                <field name="deposit_amount"/>
            </list>
        </field>
    </record>

    <record id="view_returnable_package_log_form" model="ir.ui.view">
        <field name="name">returnable.package.log.form</field>
        <field name="model">returnable.package.log</field>
        <field name="arch" type="xml">
            <form string="Packaging Movements">
                <header>
                    <button name="action_send" type="object" string="Send" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_return" type="object" string="Mark Returned" class="btn-primary" invisible="state != 'sent'"/>
                    <button name="action_mark_lost" type="object" string="Mark Lost" class="btn-secondary" invisible="state != 'sent'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('returned', 'lost', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-link" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,returned,lost,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Movement">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="package_type"/>
    <field name="quantity"/>
    <field name="movement_type"/>
    <field name="company_id"/>
                        </group>
                        <group string="Dates and Deposit">
    <field name="movement_date"/>
    <field name="due_date"/>
    <field name="return_date"/>
    <field name="deposit_amount"/>
    <field name="user_id"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_returnable_package_log_search" model="ir.ui.view">
        <field name="name">returnable.package.log.search</field>
        <field name="model">returnable.package.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="package_type"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="sent" string="Sent" domain="[('state','=','sent')]"/>
                <filter name="returned" string="Returned" domain="[('state','=','returned')]"/>
                <filter name="lost" string="Lost" domain="[('state','=','lost')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                <filter name="group_package_type" string="Packaging Type" context="{'group_by': 'package_type'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_returnable_package_log_graph" model="ir.ui.view">
        <field name="name">returnable.package.log.graph</field>
        <field name="model">returnable.package.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="state"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_returnable_package_log" model="ir.actions.act_window">
        <field name="name">Packaging Movements</field>
        <field name="res_model">returnable.package.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track returnable packaging sent to partners and returned.</p>
        </field>
    </record>

</odoo>
