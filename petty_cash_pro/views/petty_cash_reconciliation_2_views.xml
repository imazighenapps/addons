<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_petty_cash_reconciliation_list" model="ir.ui.view">
        <field name="name">petty.cash.reconciliation.list</field>
        <field name="model">petty.cash.reconciliation</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Reconciliations" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="date"/>
                <field name="fund_id"/>
                <field name="theoretical_balance" sum="Total Theoretical Balance"/>
                <field name="counted_cash" sum="Total Counted Cash"/>
                <field name="difference" sum="Total Difference"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_reconciliation_form" model="ir.ui.view">
        <field name="name">petty.cash.reconciliation.form</field>
        <field name="model">petty.cash.reconciliation</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Reconciliations">
                <header>
                    <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <group>
                        <group string="Reconciliation">
    <field name="fund_id"/>
    <field name="date"/>
    <field name="theoretical_balance"/>
    <field name="counted_cash"/>
    <field name="difference"/>
    <field name="currency_id"/>
    <field name="close_fund"/>
                        </group>
                        <group string="Validation">
    <field name="state"/>
    <field name="validated_by"/>
    <field name="validated_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_petty_cash_reconciliation_search" model="ir.ui.view">
        <field name="name">petty.cash.reconciliation.search</field>
        <field name="model">petty.cash.reconciliation</field>
        <field name="arch" type="xml">
            <search>
                <field name="fund_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="validated" string="Validated" domain="[('state','=','validated')]"/>
                <separator/>
                <filter name="group_fund" string="Fund" context="{'group_by': 'fund_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_petty_cash_reconciliation" model="ir.actions.act_window">
        <field name="name">Petty Cash Reconciliations</field>
        <field name="res_model">petty.cash.reconciliation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Count the cash, compare it with the theoretical balance, and explain any gap.</p>
        </field>
    </record>

</odoo>
