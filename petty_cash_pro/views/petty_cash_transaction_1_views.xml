<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_petty_cash_transaction_list" model="ir.ui.view">
        <field name="name">petty.cash.transaction.list</field>
        <field name="model">petty.cash.transaction</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Transactions" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="date"/>
                <field name="fund_id"/>
                <field name="type"/>
                <field name="name"/>
                <field name="category"/>
                <field name="partner_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_transaction_form" model="ir.ui.view">
        <field name="name">petty.cash.transaction.form</field>
        <field name="model">petty.cash.transaction</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Transactions">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-link" invisible="state == 'cancelled'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Taxi to the notary"/></h1>
                    </div>
                    <group>
                        <group string="Transaction">
    <field name="fund_id"/>
    <field name="date"/>
    <field name="type"/>
    <field name="name"/>
    <field name="category"/>
    <field name="partner_id"/>
    <field name="amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Status">
    <field name="state"/>
    <field name="confirmed_by"/>
    <field name="confirmed_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Receipt" name="receipt">
                            <field name="receipt"/>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_petty_cash_transaction_search" model="ir.ui.view">
        <field name="name">petty.cash.transaction.search</field>
        <field name="model">petty.cash.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="fund_id"/>
                <field name="partner_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="expenses" string="Expenses" domain="[('type','=','expense')]"/>
                <filter name="topups" string="Top-Ups" domain="[('type','=','top_up')]"/>
                <separator/>
                <filter name="group_fund" string="Fund" context="{'group_by': 'fund_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'type'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_petty_cash_transaction" model="ir.actions.act_window">
        <field name="name">Petty Cash Transactions</field>
        <field name="res_model">petty.cash.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a top-up, an expense with its receipt, or a return to the fund.</p>
        </field>
    </record>

</odoo>
