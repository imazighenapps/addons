<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_asana_connection_company" model="ir.rule">
        <field name="name">asana.connection: own company only</field>
        <field name="model_id" ref="model_asana_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_asana_record_company" model="ir.rule">
        <field name="name">asana.record: own company only</field>
        <field name="model_id" ref="model_asana_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
