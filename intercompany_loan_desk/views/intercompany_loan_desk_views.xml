<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="view_intercompany_loan_form" model="ir.ui.view">
  <field name="name">intercompany.loan.form</field><field name="model">intercompany.loan</field>
  <field name="arch" type="xml"><form string="Prêt intersociétés">
    <header>
      <button name="action_start" type="object" string="Démarrer" class="btn-primary" invisible="state!='draft'"/>
      <button name="action_close" type="object" string="Solder" invisible="state!='running'"/>
      <button name="action_cancel" type="object" string="Annuler" invisible="state in ('closed','cancelled')"/>
      <field name="state" widget="statusbar" statusbar_visible="draft,running,closed"/>
    </header>
    <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group>
        <field name="company_id"/><field name="borrower_company_id"/>
        <field name="principal_amount"/><field name="interest_rate"/><field name="term_months"/>
      </group><group>
        <field name="start_date"/><field name="maturity_date"/><field name="monthly_payment"/>
        <field name="total_interest"/><field name="outstanding_amount"/><field name="currency_id" invisible="1"/>
      </group></group>
      <group string="Notes / convention"><field name="notes" nolabel="1"/></group>
    </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
  </form></field>
</record>
<record id="view_intercompany_loan_list" model="ir.ui.view">
  <field name="name">intercompany.loan.list</field><field name="model">intercompany.loan</field>
  <field name="arch" type="xml"><list decoration-success="state=='closed'">
    <field name="name"/><field name="company_id"/><field name="borrower_company_id"/>
    <field name="principal_amount"/><field name="interest_rate"/><field name="maturity_date"/><field name="state"/>
  </list></field>
</record>
</data></odoo>
