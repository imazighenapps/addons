        <field name="name">activity_sla.entry: own company only</field>
        <field name="model_id" ref="model_activity_sla_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_activity_sla_item_company" model="ir.rule">
        <field name="name">activity_sla.item: own company only</field>
        <field name="model_id" ref="model_activity_sla_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
