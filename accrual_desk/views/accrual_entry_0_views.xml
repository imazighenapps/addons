<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_accrual_entry_list" model="ir.ui.view">
        <field name="name">accrual.entry.list</field>
        <field name="model">accrual.entry</field>
        <field name="arch" type="xml">
            <list string="Accruals" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="period_date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="owner_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="reverse_on"/>
                <field name="booked_on"/>
                <field name="reversed_on"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_accrual_entry_form" model="ir.ui.view">
        <field name="name">accrual.entry.form</field>
        <field name="model">accrual.entry</field>
        <field name="arch" type="xml">
            <form string="Accruals">
                <header>
                    <button name="action_book" type="object" string="Book" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reverse" type="object" string="Reverse" class="btn-secondary" invisible="state != 'booked'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" class="btn-link" invisible="state == 'booked'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,booked,reversed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Accrual">
    <field name="name"/>
    <field name="partner_id"/>
    <field name="owner_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Amounts">
    <field name="amount"/>
    <field name="currency_id"/>
                        </group>
                        <group string="Dates">
    <field name="period_date"/>
    <field name="reverse_on"/>
    <field name="booked_on"/>
    <field name="reversed_on"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_accrual_entry_search" model="ir.ui.view">
        <field name="name">accrual.entry.search</field>
        <field name="model">accrual.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="owner_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="booked" string="Booked" domain="[('state','=','booked')]"/>
                <filter name="reversed" string="Reversed" domain="[('state','=','reversed')]"/>
                <filter name="mine" string="My Accruals" domain="[('owner_id','=',uid)]"/>
                <separator/>
                <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                <filter name="group_period" string="Period" context="{'group_by': 'period_date'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_accrual_entry_kanban" model="ir.ui.view">
        <field name="name">accrual.entry.kanban</field>
        <field name="model">accrual.entry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="period_date"/>
                <field name="reverse_on"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="amount"/>
                        <field name="period_date"/>
                        <field name="reverse_on"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_accrual_entry" model="ir.actions.act_window">
        <field name="name">Accruals</field>
        <field name="res_model">accrual.entry</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record month-end accruals and reverse them when the next period opens.</p>
        </field>
    </record>

</odoo>
