<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qonto_transaction_list" model="ir.ui.view">
        <field name="name">qonto.transaction.list</field>
        <field name="model">qonto.transaction</field>
        <field name="arch" type="xml">
            <list string="Transactions" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="date"/>
                <field name="label"/>
                <field name="counterpart"/>
                <field name="direction"/>
                <field name="amount" sum="Total Amount"/>
                <field name="state" widget="badge"/>
                <field name="external_id"/>
            </list>
        </field>
    </record>

    <record id="view_qonto_transaction_form" model="ir.ui.view">
        <field name="name">qonto.transaction.form</field>
        <field name="model">qonto.transaction</field>
        <field name="arch" type="xml">
            <form string="Transactions">
                <header>
                    <button name="action_match" type="object" string="Match" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_ignore" type="object" string="Ignore" class="btn-secondary" invisible="state == 'matched'"/>
                    <button name="action_reset" type="object" string="Reset" class="btn-secondary" invisible="state == 'new'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,matched,ignored"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Transaction">
    <field name="name"/>
    <field name="connection_id"/>
    <field name="company_id"/>
    <field name="date"/>
    <field name="direction"/>
    <field name="state"/>
                        </group>
                        <group string="Details">
    <field name="label"/>
    <field name="counterpart"/>
    <field name="amount"/>
    <field name="currency_id"/>
    <field name="external_id"/>
    <field name="attachment_ref"/>
                        </group>
                        <group string="Accounting">
    <field name="move_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qonto_transaction_search" model="ir.ui.view">
        <field name="name">qonto.transaction.search</field>
        <field name="model">qonto.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="label"/>
                <field name="counterpart"/>
                <field name="external_id"/>
                <filter name="new" string="New" domain="[('state','=','new')]"/>
                <filter name="matched" string="Matched" domain="[('state','=','matched')]"/>
                <filter name="ignored" string="Ignored" domain="[('state','=','ignored')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
            </search>
        </field>
    </record>

    <record id="action_qonto_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">qonto.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Review and match Qonto transactions.</p>
        </field>
    </record>

</odoo>
