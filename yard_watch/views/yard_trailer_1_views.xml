<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_yard_trailer_list" model="ir.ui.view">
        <field name="name">yard.trailer.list</field>
        <field name="model">yard.trailer</field>
        <field name="arch" type="xml">
            <list string="Trailer Log" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="arrived_on"/>
                <field name="name"/>
                <field name="carrier"/>
                <field name="slot_id"/>
                <field name="wait_hours"/>
                <field name="docked_on"/>
                <field name="departed_on"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_yard_trailer_form" model="ir.ui.view">
        <field name="name">yard.trailer.form</field>
        <field name="model">yard.trailer</field>
        <field name="arch" type="xml">
            <form string="Trailer Log">
                <header>
                    <button name="action_dock" type="object" string="Move to Dock" class="btn-primary" invisible="state != 'waiting'"/>
                    <button name="action_depart" type="object" string="Depart" class="btn-secondary" invisible="state == 'departed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="waiting,docked,departed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Trailer">
    <field name="name"/>
    <field name="carrier"/>
    <field name="slot_id"/>
    <field name="company_id"/>
                        </group>
                        <group string="Timing">
    <field name="arrived_on"/>
    <field name="docked_on"/>
    <field name="departed_on"/>
    <field name="wait_hours"/>
    <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_yard_trailer_search" model="ir.ui.view">
        <field name="name">yard.trailer.search</field>
        <field name="model">yard.trailer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="carrier"/>
                <field name="slot_id"/>
                <filter name="waiting" string="Waiting" domain="[('state','=','waiting')]"/>
                <filter name="docked" string="Docked" domain="[('state','=','docked')]"/>
                <filter name="departed" string="Departed" domain="[('state','=','departed')]"/>
                <separator/>
                <filter name="group_slot" string="Slot" context="{'group_by': 'slot_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_yard_trailer_kanban" model="ir.ui.view">
        <field name="name">yard.trailer.kanban</field>
        <field name="model">yard.trailer</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="carrier"/>
                <field name="slot_id"/>
                <field name="arrived_on"/>
                <field name="wait_hours"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="carrier"/>
                        <field name="slot_id"/>
                        <field name="arrived_on"/>
                        <field name="wait_hours"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_yard_trailer" model="ir.actions.act_window">
        <field name="name">Trailer Log</field>
        <field name="res_model">yard.trailer</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log every trailer arrival and follow it until it leaves the yard.</p>
        </field>
    </record>

</odoo>
