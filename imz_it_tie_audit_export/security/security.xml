<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="tie_export_company_rule" model="ir.access">
            <field name="name">Export TIE : société</field>
            <field name="model_id" ref="model_tie_export"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="tie_registry_company_rule" model="ir.access">
            <field name="name">Mapping registres TIE : société</field>
            <field name="model_id" ref="model_tie_registry_map"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
