<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_nis2_user" model="res.groups">
        <field name="name">NIS2 User</field>
        <field name="comment">Work on NIS2 assets, risks, incidents and evidence.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_nis2_manager" model="res.groups">
        <field name="name">NIS2 Manager</field>
        <field name="comment">Full administration of the NIS2 compliance kit.</field>
        <field name="implied_ids" eval="[(4, ref('nis2_compliance_kit.group_nis2_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
