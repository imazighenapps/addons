<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nis2_training_list" model="ir.ui.view">
        <field name="name">nis2.training.list</field>
        <field name="model">nis2.training</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="audience"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'assigned'" decoration-danger="state == 'overdue'"/>
                <field name="due_date"/>
            </list>
        </field>
    </record>
    <record id="view_nis2_training_form" model="ir.ui.view">
        <field name="name">nis2.training.form</field>
        <field name="model">nis2.training</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <field name="user_id"/>
                        <field name="audience"/>
                        <field name="state"/>
                        <field name="due_date"/>
                        <field name="done_date"/>
                    </group>
                    <field name="proof"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_nis2_training" model="ir.actions.act_window">
        <field name="name">Training Register</field>
        <field name="res_model">nis2.training</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
