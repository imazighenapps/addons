<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nis2_control_list" model="ir.ui.view">
        <field name="name">nis2.control.list</field>
        <field name="model">nis2.control</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="maturity" widget="badge" decoration-success="maturity == 'done'" decoration-info="maturity == 'partial'" decoration-warning="maturity == 'planned'" decoration-danger="maturity == 'none'"/>
                <field name="next_review"/>
            </list>
        </field>
    </record>
    <record id="view_nis2_control_form" model="ir.ui.view">
        <field name="name">nis2.control.form</field>
        <field name="model">nis2.control</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule_review" string="Schedule Review" type="object"/>
                </header>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Control">
                            <field name="code"/>
                            <field name="recyf_ref"/>
                            <field name="owner_id"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Maturity">
                            <field name="maturity" widget="radio"/>
                            <field name="review_frequency"/>
                            <field name="next_review"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="evidence_ids" widget="many2many_tags"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_nis2_control_graph" model="ir.ui.view">
        <field name="name">nis2.control.graph</field>
        <field name="model">nis2.control</field>
        <field name="arch" type="xml">
            <graph>
                <field name="maturity"/>
            </graph>
        </field>
    </record>
    <record id="action_nis2_control" model="ir.actions.act_window">
        <field name="name">Article 21 Controls</field>
        <field name="res_model">nis2.control</field>
        <field name="view_mode">list,form,graph</field>
    </record>
</odoo>
