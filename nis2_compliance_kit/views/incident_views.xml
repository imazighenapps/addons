<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nis2_incident_list" model="ir.ui.view">
        <field name="name">nis2.incident.list</field>
        <field name="model">nis2.incident</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="title"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'"/>
                <field name="state"/>
                <field name="sla_status" widget="badge" decoration-success="sla_status == 'ok'" decoration-warning="sla_status == 'risk'" decoration-danger="sla_status == 'breached'"/>
                <field name="knowledge_datetime"/>
            </list>
        </field>
    </record>
    <record id="view_nis2_incident_form" model="ir.ui.view">
        <field name="name">nis2.incident.form</field>
        <field name="model">nis2.incident</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_triage" string="Start Triage" type="object"/>
                    <button name="action_analyze" string="Analyze" type="object"/>
                    <button name="action_mark_reportable" string="Reportable" type="object"/>
                    <button name="action_mark_not_reportable" string="Not Reportable" type="object"/>
                    <button name="action_early_sent" string="Early Warning Sent" type="object"/>
                    <button name="action_notified" string="Notified 72h" type="object"/>
                    <button name="action_interim" string="Interim Report" type="object"/>
                    <button name="action_final" string="Final Report" type="object"/>
                    <button name="action_close" string="Close" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="detected,reportable,early,notified,final,closed"/>
                </header>
                <sheet>
                    <field name="title"/>
                    <group>
                        <group string="Incident">
                            <field name="name"/>
                            <field name="severity"/>
                            <field name="significant"/>
                            <field name="significance_note"/>
                            <field name="malicious_suspect"/>
                            <field name="cross_border"/>
                        </group>
                        <group string="Deadlines (Art. 23)">
                            <field name="detection_datetime"/>
                            <field name="knowledge_datetime"/>
                            <field name="early_deadline"/>
                            <field name="notify_deadline"/>
                            <field name="final_deadline"/>
                            <field name="sla_status"/>
                        </group>
                    </group>
                    <field name="asset_ids" widget="many2many_tags"/>
                    <field name="description"/>
                    <field name="report_ids" readonly="1">
                        <list>
                            <field name="kind"/>
                            <field name="submitted_at"/>
                            <field name="checksum"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_nis2_incident" model="ir.actions.act_window">
        <field name="name">Incidents</field>
        <field name="res_model">nis2.incident</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
