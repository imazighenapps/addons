<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nis2_profile_list" model="ir.ui.view">
        <field name="name">nis2.profile.list</field>
        <field name="model">nis2.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="candidacy" widget="badge" decoration-success="candidacy == 'essential'" decoration-info="candidacy == 'important'" decoration-muted="candidacy == 'out'"/>
                <field name="review_state"/>
            </list>
        </field>
    </record>
    <record id="view_nis2_profile_form" model="ir.ui.view">
        <field name="name">nis2.profile.form</field>
        <field name="model">nis2.profile</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_suggest_candidacy" string="Suggest Candidacy" type="object" class="btn-primary"/>
                    <field name="review_state" widget="statusbar" statusbar_visible="draft,reviewed,validated"/>
                </header>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Entity">
                            <field name="company_id"/>
                            <field name="sector_ids" widget="many2many_tags"/>
                            <field name="note"/>
                        </group>
                        <group string="Qualification">
                            <field name="employees"/>
                            <field name="turnover"/>
                            <field name="balance_sheet"/>
                            <field name="size_hint"/>
                            <field name="candidacy"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_nis2_profile" model="ir.actions.act_window">
        <field name="name">Applicability Profiles</field>
        <field name="res_model">nis2.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
