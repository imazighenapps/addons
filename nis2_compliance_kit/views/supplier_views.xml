<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nis2_supplier_list" model="ir.ui.view">
        <field name="name">nis2.supplier.list</field>
        <field name="model">nis2.supplier</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="criticality"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state == 'inreview'" decoration-warning="state in ('toreview', 'exception')" decoration-danger="state in ('rejected', 'expired')"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>
    <record id="view_nis2_supplier_form" model="ir.ui.view">
        <field name="name">nis2.supplier.form</field>
        <field name="model">nis2.supplier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="Supplier">
                            <field name="partner_id"/>
                            <field name="criticality"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Review">
                            <field name="state"/>
                            <field name="last_review"/>
                            <field name="expiry_date"/>
                            <field name="expired"/>
                            <field name="security_clause"/>
                        </group>
                    </group>
                    <field name="attestation"/>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_nis2_supplier" model="ir.actions.act_window">
        <field name="name">Supplier Reviews</field>
        <field name="res_model">nis2.supplier</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
