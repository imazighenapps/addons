<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nis2_action_list" model="ir.ui.view">
        <field name="name">nis2.action.list</field>
        <field name="model">nis2.action</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source"/>
                <field name="owner_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'progress'" decoration-warning="state == 'open'" decoration-danger="state == 'overdue'"/>
                <field name="deadline"/>
            </list>
        </field>
    </record>
    <record id="view_nis2_action_form" model="ir.ui.view">
        <field name="name">nis2.action.form</field>
        <field name="model">nis2.action</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <field name="source"/>
                        <field name="owner_id"/>
                        <field name="deadline"/>
                        <field name="state"/>
                        <field name="company_id"/>
                    </group>
                    <field name="result"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_nis2_action" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field>
        <field name="res_model">nis2.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
