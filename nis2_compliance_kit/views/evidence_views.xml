<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nis2_evidence_list" model="ir.ui.view">
        <field name="name">nis2.evidence.list</field>
        <field name="model">nis2.evidence</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="evidence_type"/>
                <field name="lifecycle" widget="badge" decoration-success="lifecycle == 'valid'" decoration-warning="lifecycle == 'draft'" decoration-danger="lifecycle == 'expired'"/>
                <field name="valid_until"/>
            </list>
        </field>
    </record>
    <record id="view_nis2_evidence_form" model="ir.ui.view">
        <field name="name">nis2.evidence.form</field>
        <field name="model">nis2.evidence</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <group>
                        <field name="evidence_type"/>
                        <field name="lifecycle"/>
                        <field name="valid_until"/>
                        <field name="attachment_id"/>
                        <field name="company_id"/>
                    </group>
                    <field name="control_ids" widget="many2many_tags"/>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_nis2_evidence" model="ir.actions.act_window">
        <field name="name">Evidence Vault</field>
        <field name="res_model">nis2.evidence</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
