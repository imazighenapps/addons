<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_forklift_defect_list" model="ir.ui.view">
        <field name="name">forklift.defect.list</field>
        <field name="model">forklift.defect</field>
        <field name="arch" type="xml">
            <list string="Forklift Defects" decoration-muted="state in ('cancelled', 'refused')" decoration-success="state in ('paid', 'done', 'approved', 'active')" decoration-warning="state in ('submitted', 'pending', 'blocked')" decoration-info="state in ('confirmed', 'sent')">
                <field name="name"/>
                <field name="check_id"/>
                <field name="severity"/>
                <field name="state" widget="badge"/>
                <field name="signed_off_on"/>
            </list>
        </field>
    </record>

    <record id="view_forklift_defect_form" model="ir.ui.view">
        <field name="name">forklift.defect.form</field>
        <field name="model">forklift.defect</field>
        <field name="arch" type="xml">
            <form string="Forklift Defects">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder=""/></h1>
                    </div>
                    <group>
                        <group string="Defect">
    <field name="name"/>
    <field name="check_id"/>
    <field name="severity"/>
    <field name="state"/>
    <field name="signed_off_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail" name="detail">
                            <field name="detail"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_forklift_defect_search" model="ir.ui.view">
        <field name="name">forklift.defect.search</field>
        <field name="model">forklift.defect</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="check_id"/>
                <filter name="open" string="Open" domain="[('state','=','open')]"/>
                <filter name="fixed" string="Fixed" domain="[('state','=','fixed')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
            </search>
        </field>
    </record>

    <record id="view_forklift_defect_kanban" model="ir.ui.view">
        <field name="name">forklift.defect.kanban</field>
        <field name="model">forklift.defect</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="check_id"/>
                <field name="severity"/>
                <field name="signed_off_on"/>
                <templates>
                    <t t-name="card">
                        <field name="state" class="fw-bold"/>
                        <field name="name"/>
                        <field name="check_id"/>
                        <field name="severity"/>
                        <field name="signed_off_on"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_forklift_defect" model="ir.actions.act_window">
        <field name="name">Forklift Defects</field>
        <field name="res_model">forklift.defect</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Defects found during inspections and their repair sign-off.</p>
        </field>
    </record>

</odoo>
