<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_forklift_check_company" model="ir.rule">
        <field name="name">forklift.check: own company only</field>
        <field name="model_id" ref="model_forklift_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_forklift_defect_company" model="ir.rule">
        <field name="name">forklift.defect: own company only</field>
        <field name="model_id" ref="model_forklift_defect"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
